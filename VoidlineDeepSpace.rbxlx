  <Item class="StarterPlayer" referent="87">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="88">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="89">
        <Properties>
          <string name="Name">Voidline</string>
        </Properties>
        <Item class="Folder" referent="90">
          <Properties>
            <string name="Name">Client</string>
          </Properties>
          <Item class="ModuleScript" referent="91">
            <Properties>
              <string name="Name">ClientState</string>
              <string name="Source"><![CDATA[--!strict
-- Client replica of the local pilot's profile plus the latest store, squad
-- and onboarding state. Only server remotes write here; controllers read it
-- and subscribe to the keys they draw.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local ProfileSchema = require(Voidline.Modules.ProfileSchema)
local StoreRules = require(Voidline.Rules.StoreRules)
local ContentIndex = require(Voidline.Content.ContentIndex)
local Remotes = require(Voidline.Remotes)

export type Changed = { [string]: boolean }
type Listener = (Changed) -> ()

local ClientState = {}

ClientState.Profile = ProfileSchema.Default() :: any
ClientState.Loaded = false
ClientState.Store = { GamePasses = {}, PaidRandomRestricted = true } :: {
	GamePasses: { [string]: boolean },
	PaidRandomRestricted: boolean,
}
ClientState.Squad = { SquadId = nil, Members = {} } :: { [string]: any }
ClientState.Tutorial = nil :: { [string]: any }?
ClientState.CodexCount = 0

local listeners: { Listener } = {}

function ClientState.OnChanged(fn: Listener): () -> ()
	table.insert(listeners, fn)
	return function()
		local index = table.find(listeners, fn)
		if index then
			table.remove(listeners, index)
		end
	end
end

local function emit(changed: Changed)
	for _, fn in table.clone(listeners) do
		task.spawn(fn, changed)
	end
end

local function countCodex(profile: any): number
	local n = 0
	for id in profile.Codex do
		if ContentIndex.IsCodexId(id) then
			n += 1
		end
	end
	return n
end

function ClientState.Apply(payload: any)
	if type(payload) ~= "table" then
		return
	end
	local changed: Changed = {}
	if payload.Full == true and type(payload.Data) == "table" then
		ClientState.Profile = ProfileSchema.Migrate(payload.Data)
		ClientState.Loaded = true
		changed.Loaded = true
		for key in ClientState.Profile do
			changed[key] = true
		end
	else
		local profile = ClientState.Profile
		if type(payload.Set) == "table" then
			for key, value in payload.Set do
				profile[key] = value
				changed[key] = true
			end
		end
		if type(payload.Sub) == "table" then
			for key, patch in payload.Sub do
				if type(patch) ~= "table" then
					continue
				end
				local target = profile[key]
				if type(target) ~= "table" then
					target = {}
					profile[key] = target
				end
				for subKey, value in patch do
					target[subKey] = if value == ProfileSchema.REMOVED then nil else value
				end
				changed[key] = true
			end
		end
	end
	if changed.Codex then
		ClientState.CodexCount = countCodex(ClientState.Profile)
	end
	if next(changed) then
		emit(changed)
	end
end

function ClientState.Perks(): { [string]: boolean }
	return StoreRules.EffectivePerks(ClientState.Profile, os.time(), ClientState.Store.GamePasses)
end

function ClientState.HasPerk(perkId: string): boolean
	return ClientState.Perks()[perkId] == true
end

-- Display-only economy context (the server recomputes everything it charges).
function ClientState.Ctx(): { [string]: any }
	local boost = Workspace:GetAttribute("EventCreditMult")
	return {
		Perks = ClientState.Perks(),
		CreditBoost = if type(boost) == "number" then boost else 1,
		CodexMult = ContentIndex.CodexMultiplier(ClientState.CodexCount),
	}
end

function ClientState.Fire(remoteName: string, ...: any)
	Remotes.Get(remoteName):FireServer(...)
end

function ClientState.Init()
	Remotes.Get("DataSnapshot").OnClientEvent:Connect(ClientState.Apply)
	Remotes.Get("StoreState").OnClientEvent:Connect(function(state: any)
		if type(state) ~= "table" then
			return
		end
		ClientState.Store = {
			GamePasses = if type(state.GamePasses) == "table" then state.GamePasses else {},
			PaidRandomRestricted = state.PaidRandomRestricted ~= false,
		}
		emit({ Store = true })
	end)
	Remotes.Get("SquadUpdate").OnClientEvent:Connect(function(state: any)
		if type(state) ~= "table" then
			return
		end
		ClientState.Squad = state
		emit({ Squad = true })
	end)
	Remotes.Get("TutorialProgress").OnClientEvent:Connect(function(state: any)
		if type(state) ~= "table" then
			return
		end
		ClientState.Tutorial = state
		emit({ Tutorial = true })
	end)
end

function ClientState.LocalPlayer(): Player
	return Players.LocalPlayer
end

return ClientState
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="92">
            <Properties>
              <string name="Name">Ui</string>
              <string name="Source"><![CDATA[--!strict
-- Glass UI kit: themed panels, labels and buttons with short tweens
-- (0.2-0.3 s). Every interactive element is at least Ui.TOUCH px tall so the
-- same layout works for touch.
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local FormatNumber = require(ReplicatedStorage:WaitForChild("Voidline").Modules.FormatNumber)

local Ui = {}

Ui.Colors = {
	Glass = Color3.fromRGB(16, 13, 28),
	GlassLight = Color3.fromRGB(34, 28, 56),
	Gold = Color3.fromRGB(232, 186, 74),
	GoldBright = Color3.fromRGB(255, 220, 120),
	Text = Color3.fromRGB(244, 240, 255),
	Muted = Color3.fromRGB(170, 160, 200),
	Void = Color3.fromRGB(170, 120, 255),
	Cyan = Color3.fromRGB(90, 220, 255),
	Good = Color3.fromRGB(110, 255, 170),
	Warn = Color3.fromRGB(255, 120, 110),
	Shadow = Color3.fromRGB(4, 3, 10),
}

Ui.StyleColors = {
	info = Ui.Colors.Text,
	good = Ui.Colors.Good,
	gold = Ui.Colors.GoldBright,
	void = Ui.Colors.Void,
	warn = Ui.Colors.Warn,
} :: { [string]: Color3 }

Ui.Font = {
	Title = Enum.Font.GothamBlack,
	Bold = Enum.Font.GothamBold,
	Body = Enum.Font.GothamMedium,
}

Ui.TOUCH = 48
Ui.ReducedMotion = false

function Ui.Motion(seconds: number): number
	return if Ui.ReducedMotion then 0 else seconds
end

function Ui.Tween(
	instance: Instance,
	seconds: number,
	goals: { [string]: any },
	style: Enum.EasingStyle?,
	direction: Enum.EasingDirection?
): Tween
	local info =
		TweenInfo.new(Ui.Motion(seconds), style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out)
	local tween = TweenService:Create(instance, info, goals)
	tween:Play()
	return tween
end

-- Endless back-and-forth pulse (skipped with reduced motion).
function Ui.Loop(instance: Instance, seconds: number, goals: { [string]: any }): Tween?
	if Ui.ReducedMotion then
		return nil
	end
	local info = TweenInfo.new(seconds, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
	local tween = TweenService:Create(instance, info, goals)
	tween:Play()
	return tween
end

function Ui.Make(className: string, props: { [string]: any }, children: { Instance }?): any
	local instance = Instance.new(className)
	for key, value in props do
		if key ~= "Parent" then
			(instance :: any)[key] = value
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

function Ui.Corner(parent: Instance, radius: number?): UICorner
	return Ui.Make("UICorner", { CornerRadius = UDim.new(0, radius or 12), Parent = parent })
end

function Ui.Stroke(parent: Instance, color: Color3?, thickness: number?, transparency: number?): UIStroke
	return Ui.Make("UIStroke", {
		Color = color or Ui.Colors.Gold,
		Thickness = thickness or 1.5,
		Transparency = transparency or 0.55,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function Ui.Padding(parent: Instance, px: number, py: number?): UIPadding
	local y = py or px
	return Ui.Make("UIPadding", {
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		PaddingTop = UDim.new(0, y),
		PaddingBottom = UDim.new(0, y),
		Parent = parent,
	})
end

function Ui.List(
	parent: Instance,
	direction: Enum.FillDirection,
	padding: number,
	align: Enum.HorizontalAlignment?,
	valign: Enum.VerticalAlignment?
): UIListLayout
	return Ui.Make("UIListLayout", {
		FillDirection = direction,
		Padding = UDim.new(0, padding),
		HorizontalAlignment = align or Enum.HorizontalAlignment.Center,
		VerticalAlignment = valign or Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = parent,
	})
end

function Ui.Screen(name: string, order: number): ScreenGui
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local existing = playerGui:FindFirstChild(name)
	if existing then
		existing:Destroy()
	end
	return Ui.Make("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = order,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		Parent = playerGui,
	})
end

-- Frosted obsidian panel with a thin gold edge.
function Ui.Glass(props: { [string]: any }): Frame
	local frame = Ui.Make("Frame", {
		BackgroundColor3 = Ui.Colors.Glass,
		BackgroundTransparency = 0.18,
		BorderSizePixel = 0,
	}) :: Frame
	for key, value in props do
		if key ~= "Parent" then
			(frame :: any)[key] = value
		end
	end
	Ui.Corner(frame, props.CornerRadius or 14)
	Ui.Stroke(frame)
	Ui.Make("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(1, 0.2),
		}),
		Color = ColorSequence.new(Ui.Colors.GlassLight, Ui.Colors.Glass),
		Parent = frame,
	})
	if props.Parent then
		frame.Parent = props.Parent
	end
	return frame
end

function Ui.Label(props: { [string]: any }): TextLabel
	local label = Ui.Make("TextLabel", {
		BackgroundTransparency = 1,
		Font = Ui.Font.Body,
		TextColor3 = Ui.Colors.Text,
		TextSize = 16,
		TextWrapped = true,
	}) :: TextLabel
	for key, value in props do
		if key ~= "Parent" then
			(label :: any)[key] = value
		end
	end
	if props.Parent then
		label.Parent = props.Parent
	end
	return label
end

local function pressScale(button: GuiObject): UIScale
	local scale = button:FindFirstChild("PressScale") :: UIScale?
	if scale then
		return scale
	end
	return Ui.Make("UIScale", { Name = "PressScale", Parent = button })
end

-- A tappable button. `onActivate` runs on click/tap with a small squash.
function Ui.Button(props: { [string]: any }, onActivate: (() -> ())?): TextButton
	local button = Ui.Make("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = Ui.Colors.GlassLight,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		Font = Ui.Font.Bold,
		TextColor3 = Ui.Colors.Text,
		TextSize = 16,
		Size = UDim2.fromOffset(120, Ui.TOUCH),
	}) :: TextButton
	for key, value in props do
		if key ~= "Parent" then
			(button :: any)[key] = value
		end
	end
	Ui.Corner(button, 10)
	local stroke = Ui.Stroke(button, Ui.Colors.Gold, 1.5, 0.6)
	local scale = pressScale(button)
	button.MouseEnter:Connect(function()
		Ui.Tween(stroke, 0.15, { Transparency = 0.1 })
	end)
	button.MouseLeave:Connect(function()
		Ui.Tween(stroke, 0.2, { Transparency = 0.6 })
	end)
	button.Activated:Connect(function()
		scale.Scale = if Ui.ReducedMotion then 1 else 0.92
		Ui.Tween(scale, 0.22, { Scale = 1 }, Enum.EasingStyle.Back)
		if onActivate then
			onActivate()
		end
	end)
	if props.Parent then
		button.Parent = props.Parent
	end
	return button
end

function Ui.SetEnabled(button: TextButton, enabled: boolean)
	button.Active = enabled
	button.AutoButtonColor = false
	button.TextTransparency = if enabled then 0 else 0.45
	button.BackgroundTransparency = if enabled then 0.1 else 0.45
end

-- Quick scale-in for anything that just appeared.
function Ui.Pop(gui: GuiObject, from: number?)
	local scale = gui:FindFirstChild("PopScale") :: UIScale?
	if not scale then
		scale = Ui.Make("UIScale", { Name = "PopScale", Parent = gui })
	end
	local s = scale :: UIScale
	s.Scale = if Ui.ReducedMotion then 1 else (from or 0.85)
	Ui.Tween(s, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
end

function Ui.Compact(n: number): string
	return FormatNumber.Compact(n)
end

function Ui.Clock(seconds: number): string
	local s = math.max(0, math.floor(seconds))
	return ("%d:%02d"):format(s // 60, s % 60)
end

function Ui.IsTouch(): boolean
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

function Ui.ClearChildren(parent: Instance, keepClass: string?)
	for _, child in parent:GetChildren() do
		if not child:IsA("UIComponent") and (keepClass == nil or not child:IsA(keepClass)) then
			child:Destroy()
		end
	end
end

return Ui
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="93">
          <Properties>
            <string name="Name">ClientBoot</string>
            <string name="Source"><![CDATA[--!strict
-- Voidline: Deep Space — client boot. Controllers subscribe first; the
-- profile replica connects last so the queued first snapshot reaches all of them.
local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local Client = script.Parent.Client
local Ui = require(Client.Ui)
local ClientState = require(Client.ClientState)

local Controllers = script.Parent.Controllers
local HUDController = require(Controllers.HUDController)
local HotbarController = require(Controllers.HotbarController)
local OnboardingController = require(Controllers.OnboardingController)
local CameraController = require(Controllers.CameraController)
local TowController = require(Controllers.TowController)
local DroneController = require(Controllers.DroneController)
local WorldController = require(Controllers.WorldController)
local VFXController = require(Controllers.VFXController)
local StoreController = require(Controllers.StoreController)
local MenuController = require(Controllers.MenuController)
local InteractController = require(Controllers.InteractController)
local JuiceController = require(Controllers.JuiceController)
local AudioController = require(Controllers.AudioController)
local MovementController = require(Controllers.MovementController)
local ThrusterCosmeticController = require(Controllers.ThrusterCosmeticController)

-- Input pings keep the server's idle detector honest without any anti-idle
-- tricks: they only fire on real player input.
local ACTIVITY_PING_SECONDS = 30

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

local function systemReducedMotion(): boolean
	local ok, value = pcall(function()
		return GuiService.ReducedMotionEnabled
	end)
	return ok and value == true
end

local function applySettings()
	local settings = ClientState.Profile.Settings
	Ui.ReducedMotion = settings.ReducedMotion == true or systemReducedMotion()
	local perf = settings.PerfMode == true
	DroneController.SetPerfMode(perf)
	WorldController.SetPerfMode(perf)
	VFXController.SetPerfMode(perf)
end

local function applyClipMode()
	local clip = ClientState.Profile.Settings.ClipMode == true
	if clip then
		StoreController.Close()
		MenuController.Close()
	end
	VFXController.SetClipHidden(clip)
	HUDController.SetVisible(not clip)
	HotbarController.SetVisible(not clip)
	MovementController.SetVisible(not clip)
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, not clip)
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, not clip)
	end)
end

local function toggleClip()
	ClientState.Fire("SettingsUpdate", { ClipMode = ClientState.Profile.Settings.ClipMode ~= true })
	task.defer(applyClipMode)
end

local function openStore(tab: string?)
	MenuController.Close()
	StoreController.Open(tab)
end

local function openMenu(tab: string?)
	StoreController.Close()
	MenuController.Toggle(tab)
end

HUDController.Init()
VFXController.Init()
CameraController.Init()
TowController.Init()
DroneController.Init()
WorldController.Init()
OnboardingController.Init()
StoreController.Init()
MenuController.Init()
HotbarController.Init({
	OpenStore = function()
		if StoreController.IsOpen() then
			StoreController.Close()
		else
			openStore(nil)
		end
	end,
	OpenMenu = openMenu,
	ToggleClip = toggleClip,
})
JuiceController.Init()
AudioController.Init()
MovementController.Init()
ThrusterCosmeticController.Init()

TowController.OnArrive(function(tow)
	if tow.Owner ~= Players.LocalPlayer.UserId then
		return
	end
	VFXController.Popup("TOW HOME", Ui.Colors.GoldBright, tow.To)
	CameraController.Shake(0.28, 0.28)
end)
task.spawn(InteractController.Init, {
	OpenStore = openStore,
	OpenMenu = function(tab: string?)
		StoreController.Close()
		MenuController.Open(tab)
	end,
})

ClientState.OnChanged(function(changed)
	if changed.Settings or changed.Loaded then
		applySettings()
		applyClipMode()
	end
end)
applySettings()
applyClipMode()

local lastPing = -math.huge
UserInputService.InputBegan:Connect(function()
	local now = os.clock()
	if now - lastPing >= ACTIVITY_PING_SECONDS then
		lastPing = now
		ClientState.Fire("PlayerInput")
	end
end)

ClientState.Init()
print(("[Voidline] Client online for %s"):format(Players.LocalPlayer.Name))
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="94">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="95">
            <Properties>
              <string name="Name">AudioController</string>
              <string name="Source"><![CDATA[--!strict
-- Optional one-shot SFX on JuiceEvent kinds. Uses AudioConfig placeholders only;
-- gameplay does not depend on audio loading or playing.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local AudioConfig = require(Voidline.Config.AudioConfig)
local Remotes = require(Voidline.Remotes)

local AudioController = {}

local player = Players.LocalPlayer

local KIND_TO_KEY: { [string]: string } = {
	Ore = "Mine",
	Sell = "Sell",
	Upgrade = "Upgrade",
	BridgeIgnite = "BridgeIgnite",
	ContestShare = "TowArrive",
	WorldEvent = "Starfall",
	Rebirth = "Rebirth",
	PassGranted = "StoreSuccess",
	Store = "StoreSuccess",
}

local folder: Folder
local cache: { [string]: Sound } = {}

local function getOrCreate(key: string): Sound?
	local spec = AudioConfig.Sounds[key]
	if not spec or type(spec.AssetId) ~= "string" or spec.AssetId == "" then
		return nil
	end
	local sound = cache[key]
	if sound and sound.Parent then
		return sound
	end
	local newSound = Instance.new("Sound")
	newSound.Name = "Voidline_" .. key
	newSound.SoundId = spec.AssetId
	newSound.Volume = (spec.Volume or 0.5) * (AudioConfig.MasterVolume or 1)
	newSound.RollOffMaxDistance = 0
	newSound.Parent = folder
	cache[key] = newSound
	return newSound
end

local PITCH_BAND: { [string]: { number } } = {
	Mine = { 0.95, 1.05 },
	Sell = { 0.98, 1.08 },
	Upgrade = { 0.92, 1.02 },
	TowArrive = { 0.94, 1.04 },
	Starfall = { 0.9, 1.0 },
	Rebirth = { 0.88, 0.98 },
	StoreSuccess = { 1.0, 1.1 },
	BridgeIgnite = { 0.96, 1.06 },
}

local function playKey(key: string)
	local sound = getOrCreate(key)
	if not sound then
		return
	end
	local band = PITCH_BAND[key]
	if band then
		sound.PlaybackSpeed = band[1] + math.random() * (band[2] - band[1])
	end
	sound.TimePosition = 0
	sound:Play()
end

local function onJuice(message: any)
	if type(message) ~= "table" or type(message.Kind) ~= "string" then
		return
	end
	if message.Kind == "Store" and message.Ok ~= true then
		return
	end
	if message.Kind == "Rebirth" and message.Ok ~= true then
		return
	end
	if message.Kind == "WorldEvent" and message.Phase ~= "start" then
		return
	end
	local key = KIND_TO_KEY[message.Kind]
	if key then
		playKey(key)
	end
end

function AudioController.Init()
	folder = Instance.new("Folder")
	folder.Name = "VoidlineAudio"
	folder.Parent = player:WaitForChild("PlayerGui")
	Remotes.Get("JuiceEvent").OnClientEvent:Connect(onJuice)
end

return AudioController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="96">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[--!strict
-- Camera feel layered on top of the default camera: a smooth FOV pullback
-- while the Orbital Beam-Link is engaged, short FOV punches and small,
-- quickly decaying shakes. Reduced Motion turns shakes off and halves FOV moves.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Client = script.Parent.Parent.Client
local Ui = require(Client.Ui)

local TowController = require(script.Parent.TowController)

local CameraController = {}

local BASE_FOV = 70
local BEAM_LINK_FOV = 8
local TOW_FOV = 5
local HALO_FOV = 4
local FOV_RATE = 4
local MAX_SHAKE = 1.2

local player = Players.LocalPlayer
local currentFov = BASE_FOV
local punch = 0
local punchUntil = 0
local shakeAmount = 0
local shakeUntil = 0
local shakeDuration = 1

local function beamLinkEngaged(): boolean
	local targets = player:GetAttribute("DroneTargets")
	return player:GetAttribute("Formation") == 2 and type(targets) == "string" and targets ~= ""
end

local function sovereignHalo(): boolean
	return player:GetAttribute("Formation") == 3
end

local function localTowActive(): boolean
	for _, tow in TowController.ForUser(player.UserId) do
		if tow.Alpha < 0.98 then
			return true
		end
	end
	return false
end

function CameraController.Punch(fovDelta: number, seconds: number)
	punch = fovDelta * (if Ui.ReducedMotion then 0.5 else 1)
	punchUntil = os.clock() + seconds
end

function CameraController.Shake(intensity: number, seconds: number)
	if Ui.ReducedMotion then
		return
	end
	shakeAmount = math.min(MAX_SHAKE, math.max(shakeAmount, intensity))
	shakeDuration = math.max(0.05, seconds)
	shakeUntil = os.clock() + shakeDuration
end

local function step(dt: number)
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local now = os.clock()
	local target = BASE_FOV
	local motion = if Ui.ReducedMotion then 0.5 else 1
	if beamLinkEngaged() then
		target += BEAM_LINK_FOV * motion
	elseif sovereignHalo() then
		target += HALO_FOV * motion
	end
	if localTowActive() then
		target += TOW_FOV * motion
	end
	if now < punchUntil then
		target += punch
	end
	currentFov += (target - currentFov) * (1 - math.exp(-dt * FOV_RATE))
	camera.FieldOfView = currentFov
	if now < shakeUntil then
		local fade = (shakeUntil - now) / shakeDuration
		local amount = math.rad(shakeAmount * fade)
		camera.CFrame *= CFrame.Angles(
			(math.random() - 0.5) * amount,
			(math.random() - 0.5) * amount,
			(math.random() - 0.5) * amount * 0.5
		)
	else
		shakeAmount = 0
	end
end

function CameraController.Init()
	RunService:BindToRenderStep("VoidlineCamera", Enum.RenderPriority.Camera.Value + 1, step)
end

return CameraController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="97">
            <Properties>
              <string name="Name">DroneController</string>
              <string name="Source"><![CDATA[--!strict
-- Renders every pilot's drone swarm from the compact state the server
-- replicates as Player attributes (count, formation, target rock ids, look).
-- Drones are pooled local parts moved with BulkMoveTo; lasers and tow tethers
-- are Beams; thruster Trails and hit sparks are cut in Performance Mode.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local DroneConfig = require(Voidline.Config.DroneConfig)
local DroneRegistry = require(Voidline.Content.DroneRegistry)

local Client = script.Parent.Parent.Client
local Ui = require(Client.Ui)
local TowController = require(script.Parent.TowController)

local DroneController = {}

type Drone = {
	Body: Part,
	Fin: Part,
	Attach: Attachment,
	Laser: Beam,
	Tether: Beam,
	Trail: Trail,
	Position: Vector3,
	Index: number,
}

type Fleet = {
	Player: Player,
	Drones: { Drone },
	Links: { Beam },
	LookKey: string,
	LaserColor: Color3,
	LaserWidth: number,
	LaserStyle: string,
	HitColor: Color3,
	Seed: number,
}

local HIDDEN = CFrame.new(0, -1000, 0)
local ROCK_TAG = "VoidRock"
local LASER_RANGE = 46
local FOLLOW_RATE = 6
local SNAP_DISTANCE = 220
local FAR_DISTANCE = 260
local OTHER_PILOT_CAP_PERF = 3
local LINK_POOL_MAX = 14
local GOLDEN_ANGLE = 2.39996

local MUTATION_MATERIAL: { [string]: Enum.Material } = {
	["drone.mut.shiny"] = Enum.Material.Glass,
	["drone.mut.golden"] = Enum.Material.Foil,
	["drone.mut.void_corrupted"] = Enum.Material.ForceField,
	["drone.mut.starforged"] = Enum.Material.Neon,
	["drone.mut.crystalline"] = Enum.Material.Glass,
	["drone.mut.obsidian"] = Enum.Material.Basalt,
}

local folder: Folder
local pool: { Drone } = {}
local linkPool: { Beam } = {}
local fleets: { [Player]: Fleet } = {}
local rockById: { [number]: BasePart } = {}
local aimAttachments: { [BasePart]: Attachment } = {}
local hitEmitters: { [BasePart]: ParticleEmitter } = {}
local perfMode = false

-- Rocks -----------------------------------------------------------------------

local function indexRock(instance: Instance)
	if not instance:IsA("BasePart") then
		return
	end
	local part = instance :: BasePart
	local function update()
		for id, known in rockById do
			if known == part then
				rockById[id] = nil
			end
		end
		local id = part:GetAttribute("RockId")
		if type(id) == "number" then
			rockById[id] = part
		end
	end
	part:GetAttributeChangedSignal("RockId"):Connect(update)
	update()
end

local function aimAttachment(part: BasePart): Attachment
	local existing = aimAttachments[part]
	if existing and existing.Parent then
		return existing
	end
	local attachment = Ui.Make("Attachment", { Name = "VoidlineAim", Parent = part }) :: Attachment
	aimAttachments[part] = attachment
	return attachment
end

local function hitEmitter(part: BasePart): ParticleEmitter
	local existing = hitEmitters[part]
	if existing and existing.Parent then
		return existing
	end
	local emitter = Ui.Make("ParticleEmitter", {
		Name = "VoidlineHit",
		Enabled = false,
		Rate = 18,
		Lifetime = NumberRange.new(0.25, 0.45),
		Speed = NumberRange.new(6, 12),
		SpreadAngle = Vector2.new(180, 180),
		Size = NumberSequence.new(0.35, 0),
		LightEmission = 1,
		LightInfluence = 0,
		Parent = aimAttachment(part),
	}) :: ParticleEmitter
	hitEmitters[part] = emitter
	return emitter
end

local function parseTargets(value: any): { BasePart }
	local out = {}
	if type(value) ~= "string" or value == "" then
		return out
	end
	for _, token in string.split(value, ",") do
		local id = tonumber(token)
		local part = if id then rockById[id] else nil
		if part and part.Parent and part:GetAttribute("Hidden") ~= true then
			table.insert(out, part)
		end
	end
	return out
end

-- Pools -------------------------------------------------------------------------

local function newDrone(): Drone
	local body = Ui.Make("Part", {
		Name = "Drone",
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
		Shape = Enum.PartType.Ball,
		Material = Enum.Material.Metal,
		Size = Vector3.new(1.3, 1.3, 1.3),
		CFrame = HIDDEN,
		Parent = folder,
	}) :: Part
	local fin = Ui.Make("Part", {
		Name = "Fin",
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
		Material = Enum.Material.Neon,
		Size = Vector3.new(2.2, 0.12, 0.5),
		CFrame = HIDDEN,
		Parent = folder,
	}) :: Part
	local attach = Ui.Make("Attachment", { Name = "Emitter", Position = Vector3.new(0, 0, -0.6), Parent = body })
	local tail0 = Ui.Make("Attachment", { Name = "Tail0", Position = Vector3.new(0, 0.2, 0.6), Parent = body })
	local tail1 = Ui.Make("Attachment", { Name = "Tail1", Position = Vector3.new(0, -0.2, 0.6), Parent = body })
	local laser = Ui.Make("Beam", {
		Name = "Laser",
		Attachment0 = attach,
		Enabled = false,
		FaceCamera = true,
		LightEmission = 1,
		LightInfluence = 0,
		Segments = 1,
		Width0 = 0.25,
		Width1 = 0.15,
		Parent = body,
	}) :: Beam
	local tether = Ui.Make("Beam", {
		Name = "Tether",
		Attachment0 = attach,
		Enabled = false,
		FaceCamera = true,
		LightEmission = 1,
		LightInfluence = 0,
		Segments = 10,
		CurveSize0 = 1.5,
		CurveSize1 = -1.5,
		Width0 = 0.35,
		Width1 = 0.35,
		Color = ColorSequence.new(Color3.fromRGB(150, 230, 255), Color3.fromRGB(255, 230, 150)),
		Transparency = NumberSequence.new(0.2, 0.5),
		Parent = body,
	}) :: Beam
	local trail = Ui.Make("Trail", {
		Name = "Thruster",
		Attachment0 = tail0,
		Attachment1 = tail1,
		Enabled = false,
		Lifetime = 0.35,
		LightEmission = 1,
		LightInfluence = 0,
		Transparency = NumberSequence.new(0.3, 1),
		WidthScale = NumberSequence.new(1, 0),
		Parent = body,
	}) :: Trail
	return {
		Body = body,
		Fin = fin,
		Attach = attach,
		Laser = laser,
		Tether = tether,
		Trail = trail,
		Position = HIDDEN.Position,
		Index = 0,
	}
end

local function acquireDrone(): Drone
	return table.remove(pool) or newDrone()
end

local function releaseDrone(drone: Drone)
	drone.Laser.Enabled = false
	drone.Tether.Enabled = false
	drone.Trail.Enabled = false
	drone.Body.CFrame = HIDDEN
	drone.Fin.CFrame = HIDDEN
	drone.Position = HIDDEN.Position
	table.insert(pool, drone)
end

local function acquireLink(): Beam
	local beam = table.remove(linkPool)
	if beam then
		return beam
	end
	return Ui.Make("Beam", {
		Name = "Link",
		Enabled = false,
		FaceCamera = true,
		LightEmission = 1,
		LightInfluence = 0,
		Segments = 1,
		Width0 = 0.18,
		Width1 = 0.18,
		Transparency = NumberSequence.new(0.35),
		Parent = folder,
	})
end

local function releaseLinks(fleet: Fleet)
	for _, beam in fleet.Links do
		beam.Enabled = false
		beam.Attachment0 = nil
		beam.Attachment1 = nil
		table.insert(linkPool, beam)
	end
	table.clear(fleet.Links)
end

-- Look --------------------------------------------------------------------------

local function laserStyleWidth(style: string): (number, number, number, number)
	-- width0, width1, curve0, curve1
	if style == "Helix" then
		return 0.22, 0.22, 2, -2
	elseif style == "Ribbon" then
		return 0.6, 0.12, 0, 0
	elseif style == "Needle" then
		return 0.08, 0.08, 0, 0
	elseif style == "Flare" then
		return 0.15, 0.9, 0, 0
	elseif style == "Overclock" then
		return 0.4, 0.25, 0, 0
	end
	return 0.25, 0.15, 0, 0
end

local function applyLook(fleet: Fleet)
	local player = fleet.Player
	local evoId = player:GetAttribute("DroneEvo")
	local evolution = if type(evoId) == "string" then DroneRegistry.ById[evoId] else nil
	evolution = evolution or DroneRegistry.EvolutionFor(1, "")
	local mutationId = player:GetAttribute("DroneMutation")
	local mutation = if type(mutationId) == "string" and mutationId ~= "" then DroneRegistry.ById[mutationId] else nil
	local shaderId = player:GetAttribute("LaserShader")
	local shader = if type(shaderId) == "string" and shaderId ~= "" then DroneRegistry.ById[shaderId] else nil
	local hitId = player:GetAttribute("HitEffect")
	local hit = if type(hitId) == "string" and hitId ~= "" then DroneRegistry.ById[hitId] else nil
	local thrusterId = player:GetAttribute("Thruster")
	local thruster = if type(thrusterId) == "string" and thrusterId ~= "" then DroneRegistry.ById[thrusterId] else nil
	local colorName = player:GetAttribute("LaserColor")
	local baseLaser = DroneConfig.LaserColors[if type(colorName) == "string" then colorName else "Gold"]
		or DroneConfig.LaserColors.Gold

	fleet.LaserColor = if shader then shader.Color else baseLaser
	fleet.LaserStyle = if shader then shader.Style else "Plain"
	fleet.LaserWidth = 1 + (evolution.Stage - 1) * 0.06
	fleet.HitColor = if hit then hit.Color else fleet.LaserColor

	local bodyColor = if mutation then mutation.Color else evolution.Color
	local finColor = if mutation then mutation.Accent else evolution.Glow
	local material = if mutation then MUTATION_MATERIAL[mutation.Id] or Enum.Material.Metal else Enum.Material.Metal
	local scale = evolution.BodyScale
	local w0, w1, c0, c1 = laserStyleWidth(fleet.LaserStyle)
	local laserColor = ColorSequence.new(fleet.LaserColor, if shader then shader.Accent else fleet.LaserColor)
	local trailColor = if thruster
		then ColorSequence.new(thruster.Color, thruster.Accent)
		else ColorSequence.new(evolution.Glow, evolution.Color)
	for _, drone in fleet.Drones do
		drone.Body.Color = bodyColor
		drone.Body.Material = material
		drone.Body.Size = Vector3.new(1.3, 1.3, 1.3) * scale
		drone.Fin.Color = finColor
		drone.Fin.Size = Vector3.new(1.4 + 0.12 * evolution.FinCount, 0.12, 0.5) * scale
		drone.Laser.Color = laserColor
		drone.Laser.Width0 = w0 * fleet.LaserWidth
		drone.Laser.Width1 = w1 * fleet.LaserWidth
		drone.Laser.CurveSize0 = c0
		drone.Laser.CurveSize1 = c1
		drone.Trail.Color = trailColor
	end
end

local function lookKey(player: Player, count: number): string
	return table.concat({
		tostring(count),
		tostring(player:GetAttribute("DroneEvo")),
		tostring(player:GetAttribute("DroneMutation")),
		tostring(player:GetAttribute("LaserShader")),
		tostring(player:GetAttribute("LaserColor")),
		tostring(player:GetAttribute("HitEffect")),
		tostring(player:GetAttribute("Thruster")),
	}, "|")
end

-- Fleets ------------------------------------------------------------------------

local function fleetFor(player: Player): Fleet
	local fleet = fleets[player]
	if fleet then
		return fleet
	end
	local created: Fleet = {
		Player = player,
		Drones = {},
		Links = {},
		LookKey = "",
		LaserColor = DroneConfig.LaserColors.Gold,
		LaserWidth = 1,
		LaserStyle = "Plain",
		HitColor = DroneConfig.LaserColors.Gold,
		Seed = (player.UserId % 997) * 0.37,
	}
	fleets[player] = created
	return created
end

local function disposeFleet(player: Player)
	local fleet = fleets[player]
	if not fleet then
		return
	end
	for _, drone in fleet.Drones do
		releaseDrone(drone)
	end
	releaseLinks(fleet)
	fleets[player] = nil
end

local function desiredCount(player: Player): number
	local count = player:GetAttribute("DroneCount")
	local n = if type(count) == "number" then math.clamp(math.floor(count), 0, DroneConfig.MaxDrones) else 0
	if perfMode and player ~= Players.LocalPlayer then
		n = math.min(n, OTHER_PILOT_CAP_PERF)
	end
	return n
end

local function resize(fleet: Fleet, n: number)
	while #fleet.Drones > n do
		local drone = table.remove(fleet.Drones)
		if drone then
			releaseDrone(drone)
		end
	end
	while #fleet.Drones < n do
		local drone = acquireDrone()
		drone.Index = #fleet.Drones + 1
		table.insert(fleet.Drones, drone)
	end
	for i, drone in fleet.Drones do
		drone.Index = i
	end
end

-- Positions -------------------------------------------------------------------------

local function radiusOf(part: BasePart): number
	return part.Size.X / 2
end

local function idlePoint(center: Vector3, i: number, n: number, t: number, slow: boolean): Vector3
	local speed = if slow then 0.25 else 0.6
	local angle = t * speed + (i / math.max(1, n)) * math.pi * 2
	local radius = DroneConfig.IdleOrbitRadius * (if i % 2 == 0 then 0.75 else 1)
	return center + Vector3.new(math.cos(angle) * radius, 3 + math.sin(t + i) * 0.6, math.sin(angle) * radius)
end

local function stepFleet(
	fleet: Fleet,
	dt: number,
	t: number,
	cameraPos: Vector3,
	parts: { BasePart },
	cframes: { CFrame },
	hitParts: { [BasePart]: Color3 }
)
	local player = fleet.Player
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local n = #fleet.Drones
	if not root or n == 0 then
		for _, drone in fleet.Drones do
			drone.Laser.Enabled = false
			drone.Tether.Enabled = false
			drone.Trail.Enabled = false
			table.insert(parts, drone.Body)
			table.insert(cframes, HIDDEN)
			table.insert(parts, drone.Fin)
			table.insert(cframes, HIDDEN)
		end
		releaseLinks(fleet)
		return
	end
	local anchor = root.Position
	local far = (anchor - cameraPos).Magnitude > FAR_DISTANCE
	local afk = player:GetAttribute("Afk") == true
	local formation = player:GetAttribute("Formation")
	local targets = if afk then {} else parseTargets(player:GetAttribute("DroneTargets"))
	local tows = TowController.ForUser(player.UserId)
	local isLocal = player == Players.LocalPlayer
	local follow = 1 - math.exp(-dt * FOLLOW_RATE)
	local towCount = math.min(#tows, math.max(0, n - 1), 3)
	local miners = n - towCount
	local tseed = t + fleet.Seed

	for i, drone in fleet.Drones do
		local desired: Vector3
		local aim: BasePart? = nil
		local tow = if i > miners then tows[i - miners] else nil
		if tow then
			local toward = tow.To - tow.Position
			local dir = if toward.Magnitude > 0.1 then toward.Unit else Vector3.new(0, 1, 0)
			desired = tow.Position + dir * (radiusOf(tow.Part) + 2.5) + Vector3.new(0, 1.2, 0)
		elseif #targets > 0 and formation == 2 then
			local target = targets[1]
			local angle = tseed * 0.6 + (i / miners) * math.pi * 2
			local radius = radiusOf(target) + 4
			desired = target.Position
				+ Vector3.new(math.cos(angle) * radius, 2 + math.sin(tseed + i) * 0.4, math.sin(angle) * radius)
			aim = target
		elseif formation == 3 then
			local angle = tseed * 1.2 + (i / n) * math.pi * 2
			local radius = 2.8 + 0.15 * n
			desired = anchor + Vector3.new(math.cos(angle) * radius, 3.4, math.sin(angle) * radius)
			aim = targets[1]
		elseif #targets > 0 then
			local target = targets[(i - 1) % #targets + 1]
			local angle = tseed * 0.9 + i * GOLDEN_ANGLE
			local radius = radiusOf(target) + 3 + (i % 3) * 0.8
			desired = target.Position
				+ Vector3.new(math.cos(angle) * radius, 1.5 + math.sin(tseed * 1.7 + i), math.sin(angle) * radius)
			aim = target
		else
			desired = idlePoint(anchor, i, n, tseed, afk)
		end

		if (drone.Position - desired).Magnitude > SNAP_DISTANCE then
			drone.Position = desired
		else
			drone.Position = drone.Position:Lerp(desired, follow)
		end
		local lookAt = if aim then aim.Position elseif tow then tow.To else anchor + Vector3.new(0, 3, 0)
		local cf = if (lookAt - drone.Position).Magnitude > 0.05
			then CFrame.lookAt(drone.Position, lookAt)
			else CFrame.new(drone.Position)
		table.insert(parts, drone.Body)
		table.insert(cframes, cf)
		table.insert(parts, drone.Fin)
		table.insert(cframes, cf * CFrame.new(0, 0, 0.15))

		local laserOn = aim ~= nil and not far and (aim.Position - drone.Position).Magnitude <= LASER_RANGE
		if laserOn and aim then
			drone.Laser.Attachment1 = aimAttachment(aim)
			if fleet.LaserStyle == "Pulse" then
				drone.Laser.Transparency = NumberSequence.new(0.25 + 0.25 * math.sin(t * 12 + i))
			end
			if not perfMode or isLocal then
				hitParts[aim] = fleet.HitColor
			end
		end
		drone.Laser.Enabled = laserOn
		if tow and not far then
			drone.Tether.Attachment1 = aimAttachment(tow.Part)
			drone.Tether.Enabled = true
		else
			drone.Tether.Enabled = false
		end
		drone.Trail.Enabled = not far and not perfMode and (isLocal or (drone.Position - cameraPos).Magnitude < 120)
	end

	-- Orbital Beam-Link: chain the ring of drones around the shared target.
	local linkCount = if formation == 2 and #targets > 0 and miners >= 3 and not far then miners else 0
	while #fleet.Links > linkCount do
		local beam = table.remove(fleet.Links)
		if beam then
			beam.Enabled = false
			table.insert(linkPool, beam)
		end
	end
	while #fleet.Links < linkCount and #fleet.Links < LINK_POOL_MAX do
		table.insert(fleet.Links, acquireLink())
	end
	for i, beam in fleet.Links do
		local a = fleet.Drones[i]
		local b = fleet.Drones[i % miners + 1]
		beam.Attachment0 = a.Attach
		beam.Attachment1 = b.Attach
		beam.Color = ColorSequence.new(fleet.LaserColor)
		beam.Enabled = true
	end
end

local function step(dt: number)
	local camera = Workspace.CurrentCamera
	local cameraPos = if camera then camera.CFrame.Position else Vector3.zero
	local t = os.clock()
	local parts: { BasePart } = {}
	local cframes: { CFrame } = {}
	local hitParts: { [BasePart]: Color3 } = {}
	for _, player in Players:GetPlayers() do
		local fleet = fleetFor(player)
		local n = desiredCount(player)
		if #fleet.Drones ~= n then
			resize(fleet, n)
			fleet.LookKey = ""
		end
		local key = lookKey(player, n)
		if key ~= fleet.LookKey then
			fleet.LookKey = key
			applyLook(fleet)
		end
		stepFleet(fleet, dt, t, cameraPos, parts, cframes, hitParts)
	end
	if #parts > 0 then
		Workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end
	for part, emitter in hitEmitters do
		if not part.Parent then
			hitEmitters[part] = nil
			continue
		end
		if hitParts[part] then
			emitter.Enabled = true
			emitter.Color = ColorSequence.new(hitParts[part])
			emitter.Rate = if perfMode then 6 else 18
		else
			emitter.Enabled = false
		end
	end
	for part in hitParts do
		if not hitEmitters[part] then
			local emitter = hitEmitter(part)
			emitter.Color = ColorSequence.new(hitParts[part])
			emitter.Enabled = true
		end
	end
end

function DroneController.SetPerfMode(on: boolean)
	perfMode = on
end

-- World position of a pilot's first drone (VFX anchor), if rendered.
function DroneController.LeadPosition(player: Player): Vector3?
	local fleet = fleets[player]
	local drone = fleet and fleet.Drones[1]
	return if drone then drone.Position else nil
end

function DroneController.Init()
	folder = Ui.Make("Folder", { Name = "VoidlineDrones", Parent = Workspace })
	CollectionService:GetInstanceAddedSignal(ROCK_TAG):Connect(indexRock)
	for _, part in CollectionService:GetTagged(ROCK_TAG) do
		indexRock(part)
	end
	Players.PlayerRemoving:Connect(disposeFleet)
	RunService.RenderStepped:Connect(step)
end

return DroneController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="98">
            <Properties>
              <string name="Name">HUDController</string>
              <string name="Source"><![CDATA[--!strict
-- Compact HUD: a top pill (Credits, Ore, Shards, Tokens), a one-line world
-- clock under it, 3 s banners, a toast stack for rewards and the soft-contest
-- bar for boss meteors. Everything hides in Clean Clip Mode.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local JuiceConfig = require(Voidline.Config.JuiceConfig)
local EconomyRules = require(Voidline.Rules.EconomyRules)
local BiomeRegistry = require(Voidline.Content.BiomeRegistry)
local WorldEventRegistry = require(Voidline.Content.WorldEventRegistry)
local Remotes = require(Voidline.Remotes)

local Client = script.Parent.Parent.Client
local Ui = require(Client.Ui)
local ClientState = require(Client.ClientState)

local HUDController = {}

local BANNER_QUEUE_MAX = 4
local TOAST_SECONDS = 3.5
local TOAST_MAX = 3
local CONTEST_RANGE = 220
local CONTEST_TIMEOUT = 4

type Chip = { Frame: Frame, Value: TextLabel, Shown: number, Target: number, Format: (number) -> string }

local gui: ScreenGui
local pill: Frame
local chips: { [string]: Chip } = {}
local worldLine: TextLabel
local eventLine: TextLabel
local bannerFrame: Frame
local bannerText: TextLabel
local toastHolder: Frame
local contestFrame: Frame
local contestTitle: TextLabel
local contestFill: Frame
local contestTop: TextLabel
local cargoTag: TextLabel

local bannerQueue: { { Text: string, Style: string, Seconds: number } } = {}
local bannerBusy = false
local contest: { Id: number, Seen: number, Done: boolean }? = nil
local visible = true

local function makeChip(order: number, icon: string, color: Color3, format: (number) -> string): Chip
	local frame = Ui.Make("Frame", {
		Name = "Chip" .. order,
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 36),
		LayoutOrder = order,
		Parent = pill,
	}) :: Frame
	Ui.List(frame, Enum.FillDirection.Horizontal, 4)
	Ui.Label({
		Name = "Icon",
		Text = icon,
		TextColor3 = color,
		Font = Ui.Font.Title,
		TextSize = 18,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 36),
		LayoutOrder = 1,
		Parent = frame,
	})
	local value = Ui.Label({
		Name = "Value",
		Text = "0",
		Font = Ui.Font.Bold,
		TextSize = 18,
		TextWrapped = false,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 36),
		LayoutOrder = 2,
		Parent = frame,
	})
	return { Frame = frame, Value = value, Shown = 0, Target = 0, Format = format }
end

local function build()
	gui = Ui.Screen("VoidlineHUD", 5)

	pill = Ui.Glass({
		Name = "TopPill",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.fromOffset(0, 44),
		AutomaticSize = Enum.AutomaticSize.X,
		CornerRadius = 22,
		Parent = gui,
	})
	Ui.Padding(pill, 16, 4)
	Ui.List(pill, Enum.FillDirection.Horizontal, 18)
	chips.Credits = makeChip(1, "◆", Ui.Colors.GoldBright, Ui.Compact)
	chips.Ore = makeChip(2, "⬢", Color3.fromRGB(255, 170, 90), function(n)
		return ("%d/%d"):format(n, EconomyRules.CargoCap(ClientState.Profile))
	end)
	chips.Shards = makeChip(3, "✦", Ui.Colors.Void, Ui.Compact)
	chips.Tokens = makeChip(4, "⬡", Ui.Colors.Cyan, Ui.Compact)
	cargoTag = Ui.Label({
		Name = "CargoFull",
		Text = "FULL · REFINE",
		Font = Ui.Font.Title,
		TextSize = 12,
		TextColor3 = Ui.Colors.Shadow,
		BackgroundColor3 = Ui.Colors.GoldBright,
		BackgroundTransparency = 0,
		Size = UDim2.fromOffset(96, 20),
		Visible = false,
		LayoutOrder = 5,
		Parent = pill,
	})
	Ui.Corner(cargoTag, 10)

	worldLine = Ui.Label({
		Name = "WorldClock",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 52),
		Size = UDim2.new(0.9, 0, 0, 18),
		Font = Ui.Font.Bold,
		TextSize = 13,
		TextColor3 = Ui.Colors.Muted,
		TextStrokeTransparency = 0.6,
		Text = "",
		Parent = gui,
	})
	eventLine = Ui.Label({
		Name = "EventClock",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 70),
		Size = UDim2.new(0.9, 0, 0, 18),
		Font = Ui.Font.Bold,
		TextSize = 13,
		TextColor3 = Ui.Colors.GoldBright,
		TextStrokeTransparency = 0.6,
		Text = "",
		Parent = gui,
	})

	bannerFrame = Ui.Glass({
		Name = "Banner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 96),
		Size = UDim2.new(0.8, 0, 0, 46),
		Visible = false,
		Parent = gui,
	})
	Ui.Make("UISizeConstraint", { MaxSize = Vector2.new(560, 46), Parent = bannerFrame })
	bannerText = Ui.Label({
		Name = "Text",
		Size = UDim2.fromScale(1, 1),
		Font = Ui.Font.Title,
		TextSize = 18,
		TextWrapped = true,
		Parent = bannerFrame,
	})

	toastHolder = Ui.Make("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.45, 0),
		Size = UDim2.fromOffset(290, 240),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	Ui.List(toastHolder, Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Top)

	contestFrame = Ui.Glass({
		Name = "Contest",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 148),
		Size = UDim2.fromOffset(340, 64),
		Visible = false,
		Parent = gui,
	})
	contestTitle = Ui.Label({
		Name = "Title",
		Position = UDim2.fromOffset(12, 4),
		Size = UDim2.new(1, -24, 0, 20),
		Font = Ui.Font.Title,
		TextSize = 14,
		TextColor3 = Ui.Colors.GoldBright,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = contestFrame,
	})
	local track = Ui.Make("Frame", {
		Name = "Track",
		Position = UDim2.fromOffset(12, 26),
		Size = UDim2.new(1, -24, 0, 10),
		BackgroundColor3 = Ui.Colors.Shadow,
		BorderSizePixel = 0,
		Parent = contestFrame,
	}) :: Frame
	Ui.Corner(track, 5)
	contestFill = Ui.Make("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Ui.Colors.Void,
		BorderSizePixel = 0,
		Parent = track,
	}) :: Frame
	Ui.Corner(contestFill, 5)
	contestTop = Ui.Label({
		Name = "Top",
		Position = UDim2.fromOffset(12, 40),
		Size = UDim2.new(1, -24, 0, 18),
		TextSize = 13,
		TextColor3 = Ui.Colors.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = contestFrame,
	})
end

-- Banners ---------------------------------------------------------------------

local function nextBanner()
	local entry = table.remove(bannerQueue, 1)
	if not entry then
		bannerBusy = false
		return
	end
	bannerBusy = true
	bannerText.Text = entry.Text
	bannerText.TextColor3 = Ui.StyleColors[entry.Style] or Ui.Colors.Text
	bannerFrame.Visible = visible
	bannerText.TextTransparency = 0
	Ui.Pop(bannerFrame, 0.9)
	task.delay(entry.Seconds, function()
		Ui.Tween(bannerText, 0.25, { TextTransparency = 1 })
		task.wait(Ui.Motion(0.25))
		bannerFrame.Visible = false
		nextBanner()
	end)
end

function HUDController.Banner(text: string, style: string?, seconds: number?)
	for _, queued in bannerQueue do
		if queued.Text == text then
			return
		end
	end
	if #bannerQueue >= BANNER_QUEUE_MAX then
		table.remove(bannerQueue, 1)
	end
	table.insert(
		bannerQueue,
		{ Text = text, Style = style or "info", Seconds = seconds or JuiceConfig.EventBannerSeconds }
	)
	if not bannerBusy then
		nextBanner()
	end
end

-- Toasts ----------------------------------------------------------------------

function HUDController.Toast(title: string, body: string?, color: Color3?)
	local toasts = {}
	for _, child in toastHolder:GetChildren() do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	while #toasts >= TOAST_MAX do
		local oldest = table.remove(toasts, 1)
		if oldest then
			oldest:Destroy()
		end
	end
	local card = Ui.Glass({
		Name = "Toast",
		Size = UDim2.fromOffset(280, if body and body ~= "" then 62 else 40),
		Parent = toastHolder,
	})
	local accent = color or Ui.Colors.GoldBright
	Ui.Label({
		Name = "Title",
		Position = UDim2.fromOffset(12, 6),
		Size = UDim2.new(1, -24, 0, 24),
		Font = Ui.Font.Title,
		TextSize = 15,
		TextColor3 = accent,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Text = title,
		Parent = card,
	})
	if body and body ~= "" then
		Ui.Label({
			Name = "Body",
			Position = UDim2.fromOffset(12, 30),
			Size = UDim2.new(1, -24, 0, 24),
			TextSize = 13,
			TextColor3 = Ui.Colors.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Text = body,
			Parent = card,
		})
	end
	Ui.Pop(card, 0.8)
	task.delay(TOAST_SECONDS, function()
		if card.Parent then
			Ui.Tween(card, 0.25, { BackgroundTransparency = 1 })
			task.wait(Ui.Motion(0.25))
			card:Destroy()
		end
	end)
end

-- Pill ------------------------------------------------------------------------

local function setTargets()
	local profile = ClientState.Profile
	chips.Credits.Target = profile.Credits
	chips.Ore.Target = profile.Ore
	chips.Shards.Target = profile.VoidShards
	chips.Tokens.Target = profile.VoidlineTokens
	local full = profile.Ore >= EconomyRules.CargoCap(profile) and profile.Ore > 0
	if full ~= cargoTag.Visible then
		cargoTag.Visible = full
		if full then
			Ui.Pop(cargoTag, 0.6)
		end
	end
	chips.Ore.Value.TextColor3 = if full then Ui.Colors.GoldBright else Ui.Colors.Text
end

local function stepChips(dt: number)
	local k = if Ui.ReducedMotion then 1 else 1 - math.exp(-dt * 10)
	for _, chip in chips do
		if chip.Shown ~= chip.Target then
			local diff = chip.Target - chip.Shown
			if math.abs(diff) < 1 then
				chip.Shown = chip.Target
			else
				chip.Shown += diff * k
			end
			chip.Value.Text = chip.Format(math.floor(chip.Shown + 0.5))
		end
	end
end

function HUDController.Pulse(statName: string)
	local chip = chips[statName]
	if chip then
		Ui.Pop(chip.Frame, 1.25)
	end
end

-- World clock -----------------------------------------------------------------

local function updateClock()
	local now = Workspace:GetServerTimeNow()
	local anomalyId = Workspace:GetAttribute("AnomalyId")
	local biome = if type(anomalyId) == "string" then BiomeRegistry.ById[anomalyId] else nil
	local anomalyEnds = Workspace:GetAttribute("AnomalyEndsAt")
	if biome then
		local left = if type(anomalyEnds) == "number" then anomalyEnds - now else 0
		worldLine.Text = ("ANOMALY · %s · %s"):format(string.upper(biome.Name), Ui.Clock(left))
	else
		worldLine.Text = ""
	end
	local parts = {}
	local eventId = Workspace:GetAttribute("EventId")
	local event = if type(eventId) == "string" and eventId ~= "" then WorldEventRegistry.ById[eventId] else nil
	if event then
		local ends = Workspace:GetAttribute("EventEndsAt")
		table.insert(
			parts,
			("EVENT · %s · %s"):format(
				string.upper(event.Name),
				Ui.Clock(if type(ends) == "number" then ends - now else 0)
			)
		)
	else
		local nextAt = Workspace:GetAttribute("NextEventAt")
		if type(nextAt) == "number" and nextAt > now then
			table.insert(parts, "NEXT EVENT " .. Ui.Clock(nextAt - now))
		end
	end
	local surge = Workspace:GetAttribute("LuckSurgeEndsAt")
	if type(surge) == "number" and surge > now then
		table.insert(parts, "LUCK SURGE " .. Ui.Clock(surge - now))
	end
	local starfall = Workspace:GetAttribute("StarfallEndsAt")
	if type(starfall) == "number" and starfall > now then
		table.insert(parts, "STARFALL " .. Ui.Clock(starfall - now))
	end
	eventLine.Text = table.concat(parts, "  ·  ")
end

-- Soft contests -----------------------------------------------------------------

local function rockPart(id: number): BasePart?
	for _, part in CollectionService:GetTagged("VoidRock") do
		if part:GetAttribute("RockId") == id and part:IsA("BasePart") then
			return part
		end
	end
	return nil
end

local function onContest(update: any)
	if type(update) ~= "table" or type(update.Id) ~= "number" then
		return
	end
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local part = rockPart(update.Id)
	if root and part and (part.Position - root.Position).Magnitude > CONTEST_RANGE and not update.Done then
		return
	end
	if contest and contest.Id ~= update.Id and not contest.Done and os.clock() - contest.Seen < 1 then
		-- Another contest is already on screen and fresh; keep it.
		return
	end
	contest = { Id = update.Id, Seen = os.clock(), Done = update.Done == true }
	contestFrame.Visible = visible
	local max = if type(update.Max) == "number" and update.Max > 0 then update.Max else 1
	local health = if type(update.Health) == "number" then update.Health else 0
	contestTitle.Text = ("%s · %d%%"):format(
		string.upper(tostring(update.Label or "Meteor")),
		math.ceil(health / max * 100)
	)
	Ui.Tween(contestFill, 0.2, { Size = UDim2.fromScale(math.clamp(health / max, 0, 1), 1) })
	local rows = {}
	if type(update.Top) == "table" then
		for i, row in update.Top do
			if type(row) == "table" then
				table.insert(
					rows,
					("%d. %s %d%%"):format(i, tostring(row.Name), math.floor((row.Share or 0) * 100 + 0.5))
				)
			end
		end
	end
	contestTop.Text = if #rows > 0 then table.concat(rows, "   ") else "Mine it to claim a share (5% qualifies)"
end

local function stepContest()
	local current = contest
	if not current then
		return
	end
	local age = os.clock() - current.Seen
	if (current.Done and age > 2.5) or age > CONTEST_TIMEOUT then
		contest = nil
		contestFrame.Visible = false
	end
end

function HUDController.SetVisible(on: boolean)
	visible = on
	gui.Enabled = on
end

function HUDController.Gui(): ScreenGui
	return gui
end

function HUDController.Init()
	build()
	setTargets()
	ClientState.OnChanged(function(changed)
		if
			changed.Credits
			or changed.Ore
			or changed.VoidShards
			or changed.VoidlineTokens
			or changed.CargoLevel
			or changed.Loaded
		then
			setTargets()
		end
		if changed.Settings or changed.Loaded then
			HUDController.SetVisible(ClientState.Profile.Settings.ClipMode ~= true)
		end
	end)
	Remotes.GetUnreliable("SoftContestUpdate").OnClientEvent:Connect(onContest)
	RunService.RenderStepped:Connect(stepChips)
	task.spawn(function()
		while gui.Parent do
			updateClock()
			stepContest()
			task.wait(0.5)
		end
	end)
end

return HUDController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="99">
            <Properties>
              <string name="Name">HotbarController</string>
              <string name="Source"><![CDATA[--!strict
-- Bottom hotbar: Quick Upgrade, the three formations, Store, Menu, Home warp
-- and (with Auto-Sell Warp Link) remote Sell. Every key has an on-screen
-- button of at least 48 px, so touch players get the same actions.
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local EconomyConfig = require(Voidline.Config.EconomyConfig)
local DroneConfig = require(Voidline.Config.DroneConfig)
local EconomyRules = require(Voidline.Rules.EconomyRules)

local Client = script.Parent.Parent.Client
local Ui = require(Client.Ui)
local ClientState = require(Client.ClientState)

local HotbarController = {}

export type Actions = {
	OpenStore: () -> (),
	OpenMenu: (tab: string?) -> (),
	ToggleClip: () -> (),
}

local SLOT = 56
local FORMATION_GLYPHS = { "✶", "⟐", "♛" }

local gui: ScreenGui
local bar: Frame
local upgradeButton: TextButton
local upgradeDetail: TextLabel
local formationButtons: { TextButton } = {}
local sellButton: TextButton
local actions: Actions

-- Next upgrade worth showing (affordable or not): tutorial order first, then
-- the cheapest available upgrade.
function HotbarController.NextUpgrade(profile: any, ctx: any): (string?, number?)
	if not profile.TutorialComplete then
		for _, entry in { { "Drill", "Drill" }, { "Cargo", "Cargo" }, { "Drone", "DroneSlot" } } do
			if not profile.TutorialFlags[entry[1]] then
				return entry[2], EconomyRules.UpgradeCost(profile, entry[2], ctx)
			end
		end
	end
	local best, bestCost = nil, math.huge
	for _, id in EconomyConfig.UpgradeOrder do
		local ok, reason = EconomyRules.CanUpgrade(profile, id, ctx)
		if ok or reason == "funds" then
			local cost = EconomyRules.UpgradeCost(profile, id, ctx) :: number
			if cost < bestCost then
				best, bestCost = id, cost
			end
		end
	end
	if best then
		return best, bestCost
	end
	return nil, nil
end

local function keyHint(parent: Instance, key: string)
	if Ui.IsTouch() then
		return
	end
	local hint = Ui.Label({
		Name = "Key",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -4, 0, 2),
		Size = UDim2.fromOffset(16, 14),
		Text = key,
		TextSize = 11,
		Font = Ui.Font.Bold,
		TextColor3 = Ui.Colors.Muted,
		ZIndex = 3,
		Parent = parent,
	})
	hint.TextXAlignment = Enum.TextXAlignment.Right
end

local function slotButton(
	name: string,
	glyph: string,
	caption: string,
	key: string,
	order: number,
	onActivate: () -> ()
): TextButton
	local button = Ui.Button({
		Name = name,
		Size = UDim2.fromOffset(SLOT, SLOT),
		Text = "",
		LayoutOrder = order,
		Parent = bar,
	}, onActivate)
	Ui.Label({
		Name = "Glyph",
		Size = UDim2.new(1, 0, 0, 34),
		Position = UDim2.fromOffset(0, 4),
		Text = glyph,
		Font = Ui.Font.Title,
		TextSize = 24,
		TextColor3 = Ui.Colors.GoldBright,
		Parent = button,
	})
	Ui.Label({
		Name = "Caption",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, -3),
		Size = UDim2.new(1, 0, 0, 14),
		Text = caption,
		Font = Ui.Font.Bold,
		TextSize = 10,
		TextColor3 = Ui.Colors.Muted,
		Parent = button,
	})
	keyHint(button, key)
	return button
end

local function quickUpgrade()
	ClientState.Fire("QuickUpgrade")
end

local function setFormation(n: number)
	if ClientState.Profile.Formation == n then
		return
	end
	ClientState.Fire("SetFormation", n)
end

local function refresh()
	local profile = ClientState.Profile
	local ctx = ClientState.Ctx()
	local id, cost = HotbarController.NextUpgrade(profile, ctx)
	if id and cost then
		local def = EconomyConfig.Upgrades[id]
		local affordable = profile.Credits >= cost
		upgradeDetail.Text = ("%s · ◆%s"):format(def.Label, Ui.Compact(cost))
		upgradeDetail.TextColor3 = if affordable then Ui.Colors.GoldBright else Ui.Colors.Muted
		local stroke = upgradeButton:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Transparency = if affordable then 0.1 else 0.6
		end
	else
		upgradeDetail.Text = "ALL MAXED"
		upgradeDetail.TextColor3 = Ui.Colors.Muted
	end
	for n, button in formationButtons do
		local selected = profile.Formation == n
		button.BackgroundColor3 = if selected then Ui.Colors.Gold else Ui.Colors.GlassLight
		local glyph = button:FindFirstChild("Glyph") :: TextLabel?
		if glyph then
			glyph.TextColor3 = if selected then Ui.Colors.Shadow else Ui.Colors.GoldBright
		end
	end
	sellButton.Visible = ClientState.HasPerk("AutoSellWarpLink")
end

local function bindKey(name: string, fn: () -> (), ...: Enum.KeyCode)
	ContextActionService:BindAction(name, function(_, state)
		if state == Enum.UserInputState.Begin then
			fn()
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, ...)
end

function HotbarController.SetVisible(on: boolean)
	gui.Enabled = on
end

function HotbarController.Init(hotbarActions: Actions)
	actions = hotbarActions
	gui = Ui.Screen("VoidlineHotbar", 6)
	bar = Ui.Glass({
		Name = "Hotbar",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.fromOffset(0, SLOT + 16),
		AutomaticSize = Enum.AutomaticSize.X,
		CornerRadius = 18,
		Parent = gui,
	})
	Ui.Padding(bar, 8)
	Ui.List(bar, Enum.FillDirection.Horizontal, 8)

	upgradeButton = Ui.Button({
		Name = "Upgrade",
		Size = UDim2.fromOffset(176, SLOT),
		Text = "",
		LayoutOrder = 1,
		Parent = bar,
	}, quickUpgrade)
	Ui.Label({
		Name = "Title",
		Position = UDim2.fromOffset(0, 6),
		Size = UDim2.new(1, 0, 0, 22),
		Text = "UPGRADE",
		Font = Ui.Font.Title,
		TextSize = 18,
		TextColor3 = Ui.Colors.Text,
		Parent = upgradeButton,
	})
	upgradeDetail = Ui.Label({
		Name = "Detail",
		Position = UDim2.fromOffset(4, 30),
		Size = UDim2.new(1, -8, 0, 18),
		Text = "",
		Font = Ui.Font.Bold,
		TextSize = 13,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = upgradeButton,
	})
	keyHint(upgradeButton, "U")

	for n = 1, 3 do
		local caption = string.split(DroneConfig.FormationLabels[n], " ")
		formationButtons[n] = slotButton(
			"Formation" .. n,
			FORMATION_GLYPHS[n],
			caption[#caption],
			tostring(n),
			1 + n,
			function()
				setFormation(n)
			end
		)
	end
	slotButton("Store", "⬡", "STORE", "B", 10, function()
		actions.OpenStore()
	end)
	slotButton("Menu", "☰", "CODEX", "C", 11, function()
		actions.OpenMenu(nil)
	end)
	slotButton("Home", "⌂", "HOME", "H", 12, function()
		ClientState.Fire("WarpRequest", "Home")
	end)
	sellButton = slotButton("Sell", "⇪", "SELL", "R", 13, function()
		ClientState.Fire("SellOre")
	end)
	if Ui.IsTouch() then
		slotButton("Clip", "▣", "CLIP", "K", 14, function()
			actions.ToggleClip()
		end)
	end

	bindKey("VoidlineUpgrade", quickUpgrade, Enum.KeyCode.U)
	bindKey("VoidlineFormation1", function()
		setFormation(1)
	end, Enum.KeyCode.One)
	bindKey("VoidlineFormation2", function()
		setFormation(2)
	end, Enum.KeyCode.Two)
	bindKey("VoidlineFormation3", function()
		setFormation(3)
	end, Enum.KeyCode.Three)
	bindKey("VoidlineStore", function()
		actions.OpenStore()
	end, Enum.KeyCode.B)
	bindKey("VoidlineMenu", function()
		actions.OpenMenu(nil)
	end, Enum.KeyCode.C)
	bindKey("VoidlineHome", function()
		ClientState.Fire("WarpRequest", "Home")
	end, Enum.KeyCode.H)
	bindKey("VoidlineSell", function()
		if ClientState.HasPerk("AutoSellWarpLink") then
			ClientState.Fire("SellOre")
		end
	end, Enum.KeyCode.R)
	bindKey("VoidlineClipMode", function()
		actions.ToggleClip()
	end, Enum.KeyCode.K)

	refresh()
	ClientState.OnChanged(function(changed)
		if
			changed.Credits
			or changed.Formation
			or changed.TutorialFlags
			or changed.Store
			or changed.OwnedPerks
			or changed.TrialVouchers
			or changed.Loaded
			or changed.DrillLevel
			or changed.CargoLevel
			or changed.DroneSlots
			or changed.StationTier
			or changed.DroneTier
		then
			refresh()
		end
		if changed.Settings or changed.Loaded then
			HotbarController.SetVisible(ClientState.Profile.Settings.ClipMode ~= true)
		end
	end)
end

return HotbarController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="100">
            <Properties>
              <string name="Name">InteractController</string>
              <string name="Source"><![CDATA[--!strict
-- Client-only ProximityPrompts for hub kiosks that just open UI (the Code
-- Terminal, the Summon pad, the streak board in the lounge) and a "Pilot
-- Card" prompt on other pilots. Prompts work with touch, mouse, keys and pads.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local Client = script.Parent.Parent.Client
local Ui = require(Client.Ui)
local ClientState = require(Client.ClientState)

local InteractController = {}

export type Actions = {
	OpenStore: (tab: string?) -> (),
	OpenMenu: (tab: string?) -> (),
}

local player = Players.LocalPlayer
local cardPrompts: { [Player]: ProximityPrompt } = {}

local function prompt(parent: Instance, action: string, object: string, onTrigger: () -> ()): ProximityPrompt
	local existing = parent:FindFirstChild("VoidlineLocalPrompt")
	if existing then
		existing:Destroy()
	end
	local p = Ui.Make("ProximityPrompt", {
		Name = "VoidlineLocalPrompt",
		ActionText = action,
		ObjectText = object,
		HoldDuration = 0,
		MaxActivationDistance = 12,
		RequiresLineOfSight = false,
		KeyboardKeyCode = Enum.KeyCode.E,
		Parent = parent,
	}) :: ProximityPrompt
	p.Triggered:Connect(onTrigger)
	return p
end

local function addCardPrompt(other: Player, character: Model)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not root then
		return
	end
	local existing = cardPrompts[other]
	if existing then
		existing:Destroy()
	end
	local p = Ui.Make("ProximityPrompt", {
		Name = "VoidlinePilotCard",
		ActionText = "Pilot Card",
		ObjectText = other.DisplayName,
		HoldDuration = 0.2,
		MaxActivationDistance = 10,
		RequiresLineOfSight = false,
		KeyboardKeyCode = Enum.KeyCode.F,
		Parent = root,
	}) :: ProximityPrompt
	p.Triggered:Connect(function()
		ClientState.Fire("InspectPilot", other.UserId)
	end)
	cardPrompts[other] = p
end

local function watchPlayer(other: Player)
	if other == player then
		return
	end
	other.CharacterAdded:Connect(function(character)
		addCardPrompt(other, character)
	end)
	if other.Character then
		task.spawn(addCardPrompt, other, other.Character)
	end
end

function InteractController.Init(actions: Actions)
	local map = Workspace:WaitForChild("VoidlineMap", 30)
	local hub = map and map:WaitForChild("Hub", 30)
	if hub then
		local terminal = hub:WaitForChild("CodeTerminal", 10)
		if terminal then
			prompt(terminal, "Enter Code", "Code Terminal", function()
				actions.OpenMenu("Codes")
			end)
		end
		local summon = hub:WaitForChild("SummonPad", 10)
		if summon then
			prompt(summon, "Server Summons", "Summon Pad", function()
				actions.OpenStore("Summons")
			end)
		end
		local lounge = hub:WaitForChild("VipLounge", 10)
		if lounge then
			prompt(lounge, "Daily Streak", "Sovereign Lounge", function()
				actions.OpenMenu("Daily")
			end)
		end
	end
	for _, other in Players:GetPlayers() do
		watchPlayer(other)
	end
	Players.PlayerAdded:Connect(watchPlayer)
	Players.PlayerRemoving:Connect(function(other)
		local p = cardPrompts[other]
		if p then
			p:Destroy()
			cardPrompts[other] = nil
		end
	end)
end

return InteractController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="101">
            <Properties>
              <string name="Name">JuiceController</string>
              <string name="Source"><![CDATA[--!strict
-- Turns server JuiceEvent messages into feedback: banners, toasts, popups,
-- camera nudges and world VFX. Gameplay never depends on any of this.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local EconomyConfig = require(Voidline.Config.EconomyConfig)
local PlotLayout = require(Voidline.Modules.PlotLayout)
local ContentIndex = require(Voidline.Content.ContentIndex)
local OreRegistry = require(Voidline.Content.OreRegistry)
local RelicRegistry = require(Voidline.Content.RelicRegistry)
local DroneRegistry = require(Voidline.Content.DroneRegistry)
local Remotes = require(Voidline.Remotes)

local Client = script.Parent.Parent.Client
local Ui = require(Client.Ui)
local HUDController = require(script.Parent.HUDController)
local VFXController = require(script.Parent.VFXController)
local CameraController = require(script.Parent.CameraController)
local OnboardingController = require(script.Parent.OnboardingController)
local WorldController = require(script.Parent.WorldController)
local MenuController = require(script.Parent.MenuController)

local JuiceController = {}

local HAZARD_BANNER_RANGE = 140

local player = Players.LocalPlayer

local STORE_REASONS: { [string]: string } = {
	tokens = "Not enough Voidline Tokens",
	owned = "You already own that",
	unavailable = "Not available yet",
	restricted = "Not available in your region",
	unknown = "That item does not exist",
}

local UPGRADE_REASONS: { [string]: string } = {
	funds = "Not enough Credits",
	locked = "Raise your Station Tier first",
	max = "Already maxed",
	unknown = "Unknown upgrade",
}

local WARP_REASONS: { [string]: string } = {
	pass = "Use the hub gate, or get the Deep-Space Warp Pass to warp from anywhere",
	closed = "The Void Rift is closed until its event",
	unknown = "Unknown destination",
}

local CODE_REASONS: { [string]: string } = {
	invalid = "Codes are letters and numbers only",
	unknown = "That code is not valid",
	used = "You already redeemed that code",
}

local SQUAD_REASONS: { [string]: string } = {
	target = "That pilot is not here",
	busy = "That pilot is already in a squad or has pending invites",
	full = "Your squad is full",
	leader = "Only the squad leader can invite",
}

local FORGE_REASONS: { [string]: string } = {
	shards = "The forge needs 25 Void Shards",
	busy = "The forge is busy",
	artifacts = "No artifacts to turn in",
}

local function nameOf(id: any): string
	if type(id) ~= "string" then
		return ""
	end
	local entry = ContentIndex.Get(id)
	return if entry and entry.Name then entry.Name else id
end

local function rootPosition(): Vector3?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	return if root then root.Position else nil
end

local function rewardText(credits: any, shards: any, extra: any): string
	local parts = {}
	if type(credits) == "number" and credits > 0 then
		table.insert(parts, "+◆" .. Ui.Compact(credits))
	end
	if type(shards) == "number" and shards > 0 then
		table.insert(parts, "+✦" .. Ui.Compact(shards))
	end
	if type(extra) == "string" and extra ~= "" then
		table.insert(parts, extra)
	end
	return table.concat(parts, "  ")
end

local HANDLERS: { [string]: (any) -> () } = {}

HANDLERS.Banner = function(m)
	HUDController.Banner(tostring(m.Text or ""), if type(m.Style) == "string" then m.Style else "info")
end

HANDLERS.Ore = function(m)
	local amount = if type(m.Amount) == "number" then m.Amount else 0
	local ore = if type(m.OreId) == "string" then OreRegistry.ById[m.OreId] else nil
	local position = if typeof(m.Position) == "Vector3"
		then m.Position
		else VFXController.OwnPlotWorld(PlotLayout.Grinder)
	if amount > 0 then
		VFXController.Popup(
			("+%d %s"):format(amount, if ore then ore.Name else "ore"),
			if ore then ore.Glow else nil,
			position
		)
		HUDController.Pulse("Ore")
		VFXController.GrinderPulse()
	end
	if type(m.Refined) == "number" and m.Refined > 0 then
		VFXController.Popup("+◆" .. Ui.Compact(m.Refined) .. " (overflow refined)", Ui.Colors.GoldBright, nil)
		HUDController.Pulse("Credits")
	end
end

HANDLERS.Sell = function(m)
	local credits = if type(m.Credits) == "number" then m.Credits else 0
	VFXController.Popup(
		"+◆" .. Ui.Compact(credits),
		Ui.Colors.GoldBright,
		VFXController.OwnPlotWorld(PlotLayout.Refinery)
	)
	HUDController.Pulse("Credits")
	CameraController.Shake(0.22, 0.2)
end

HANDLERS.Credits = function(m)
	if type(m.Amount) == "number" and m.Amount > 0 then
		VFXController.Popup("+◆" .. Ui.Compact(m.Amount), Ui.Colors.GoldBright, nil)
		HUDController.Pulse("Credits")
	end
end

HANDLERS.Shards = function(m)
	if type(m.Amount) == "number" and m.Amount > 0 then
		VFXController.Popup("+✦" .. Ui.Compact(m.Amount) .. " Void Shards", Ui.Colors.Void, nil)
		HUDController.Pulse("Shards")
	end
end

HANDLERS.Tokens = function(m)
	HUDController.Toast(
		"+⬡" .. tostring(m.Amount or 0) .. " VOIDLINE TOKENS",
		"Spend them in the Store (B)",
		Ui.Colors.Cyan
	)
	HUDController.Pulse("Tokens")
end

HANDLERS.Upgrade = function(m)
	local def = if type(m.Id) == "string" then EconomyConfig.Upgrades[m.Id] else nil
	local label = if def then def.Label else "Upgrade"
	VFXController.Popup(("%s · Lv %s"):format(label, tostring(m.Level or "")), Ui.Colors.Good, rootPosition())
	if type(m.Id) == "string" then
		VFXController.PadFlash(m.Id)
	end
	CameraController.Shake(0.2, 0.25)
end

HANDLERS.UpgradeFail = function(m)
	HUDController.Banner(UPGRADE_REASONS[tostring(m.Reason)] or "Cannot upgrade yet", "warn", 2)
end

HANDLERS.BridgeIgnite = function(m)
	VFXController.BridgeSweep()
	OnboardingController.Finale()
	local bonus = if type(m.Bonus) == "number" then m.Bonus else 0
	HUDController.Banner(("ENERGY BRIDGE ONLINE · +%d CREDITS"):format(bonus), "gold", 4)
	HUDController.Pulse("Credits")
end

HANDLERS.CargoFull = function()
	HUDController.Banner("Cargo full · refine at your gold pad", "gold")
end

HANDLERS.Evolution = function(m)
	local evolution = if type(m.Id) == "string" then DroneRegistry.ById[m.Id] else nil
	HUDController.Toast("DRONES EVOLVED", if evolution then evolution.Name else "", Ui.Colors.GoldBright)
	CameraController.Shake(0.35, 0.3)
	CameraController.Punch(4, 0.8)
end

HANDLERS.Mutation = function(m)
	local mutation = if type(m.Id) == "string" then DroneRegistry.ById[m.Id] else nil
	HUDController.Toast(
		"MUTATION · " .. (if mutation then string.upper(mutation.Name) else "?"),
		"Equip it in the Locker (C)",
		if mutation then mutation.Accent else Ui.Colors.Void
	)
end

HANDLERS.Achievement = function(m)
	HUDController.Toast(
		"ACHIEVEMENT · " .. tostring(m.Name or ""),
		rewardText(
			m.Credits,
			m.Shards,
			if type(m.Title) == "string" and m.Title ~= "" then "Title: " .. nameOf(m.Title) else nil
		),
		Ui.Colors.GoldBright
	)
end

HANDLERS.Quest = function(m)
	HUDController.Toast(
		"QUEST COMPLETE · " .. tostring(m.Name or ""),
		rewardText(m.Credits, m.Shards, if type(m.Unlock) == "string" and m.Unlock ~= "" then nameOf(m.Unlock) else nil),
		Ui.Colors.Good
	)
end

HANDLERS.Relic = function(m)
	local relic = if type(m.Id) == "string" then RelicRegistry.ById[m.Id] else nil
	if m.New then
		HUDController.Toast(
			"RELIC FOUND · " .. (if relic then relic.Name else "?"),
			if relic then relic.Rarity .. " · " .. relic.SetName else "",
			if relic then relic.Glow else Ui.Colors.Void
		)
		CameraController.Punch(3, 0.6)
	else
		HUDController.Toast(
			"DUPLICATE RELIC",
			("+✦%d Void Shards"):format(if type(m.DuplicateShards) == "number" then m.DuplicateShards else 0),
			Ui.Colors.Void
		)
	end
end

HANDLERS.Codex = function(m)
	VFXController.Popup(
		("CODEX +1 · %s (%s/%s)"):format(nameOf(m.Id), tostring(m.Count or "?"), tostring(m.Total or "?")),
		Ui.Colors.Cyan,
		nil
	)
end

HANDLERS.CodexMilestone = function(m)
	HUDController.Banner(
		("CODEX MILESTONE · %s ENTRIES · x%.2f CREDITS"):format(
			tostring(m.Count or "?"),
			if type(m.Multiplier) == "number" then m.Multiplier else 1
		),
		"gold"
	)
end

HANDLERS.ContestShare = function(m)
	local share = if type(m.Share) == "number" then math.floor(m.Share * 100 + 0.5) else 0
	HUDController.Banner(
		("%s%s · %d%% SHARE · %s"):format(
			if m.Top then "TOP CONTRIBUTOR · " else "",
			string.upper(tostring(m.Label or m.Kind or "Meteor")),
			share,
			rewardText(nil, m.Shards, ("+%d ore towed home"):format(if type(m.Ore) == "number" then m.Ore else 0))
		),
		if m.Top then "gold" else "good"
	)
end

HANDLERS.PassGranted = function(m)
	HUDController.Banner(tostring(m.Name or "Pass") .. " unlocked", "gold")
	VFXController.ScreenFlash(Ui.Colors.GoldBright, 0.5)
end

HANDLERS.Store = function(m)
	if m.Ok then
		HUDController.Banner(
			if m.Currency == "Robux" then "Summon queued · thank you!" else "Purchased · enjoy!",
			"good"
		)
	else
		HUDController.Banner(STORE_REASONS[tostring(m.Reason)] or "Purchase failed", "warn")
	end
end

HANDLERS.Equip = function(m)
	if m.Ok then
		VFXController.Popup(if m.Id == "" then "Unequipped" else "Equipped · " .. nameOf(m.Id), Ui.Colors.Good, nil)
	else
		HUDController.Banner("You have not unlocked that yet", "warn", 2)
	end
end

HANDLERS.SquadInvite = function(m)
	if type(m.FromUserId) == "number" then
		MenuController.ShowInvite(m.FromUserId, tostring(m.FromName or "A pilot"), m.Seconds)
	end
end

HANDLERS.SquadError = function(m)
	HUDController.Banner(SQUAD_REASONS[tostring(m.Reason)] or "Squad request failed", "warn", 2)
end

HANDLERS.SquadChallenge = function(m)
	HUDController.Toast("SQUAD CHALLENGE COMPLETE", rewardText(m.Credits, m.Shards, nil), Ui.Colors.Cyan)
end

HANDLERS.Warp = function()
	VFXController.ScreenFlash(Ui.Colors.Void, 0.5)
end

HANDLERS.WarpLocked = function(m)
	HUDController.Banner(WARP_REASONS[tostring(m.Reason)] or "Cannot warp there yet", "warn")
end

HANDLERS.VoidCatch = function()
	VFXController.ScreenFlash(Ui.Colors.Void, 0.6)
	HUDController.Banner("The Voidline caught you · warped home", "void")
end

HANDLERS.Code = function(m)
	local text = if m.Ok
		then ("%s  %s"):format(tostring(m.Message or "Code redeemed"), rewardText(m.Credits, m.Shards, nil))
		else CODE_REASONS[tostring(m.Reason)] or "That code did not work"
	MenuController.CodeResult(text)
	HUDController.Banner(text, if m.Ok then "gold" else "warn")
end

HANDLERS.Daily = function(m)
	if m.Ok then
		HUDController.Toast(
			("DAY %s STREAK CLAIMED"):format(tostring(m.Day or "?")),
			rewardText(m.Credits, m.Shards, if type(m.Trial) == "string" then m.Trial .. " trial (24h)" else nil),
			Ui.Colors.GoldBright
		)
	else
		HUDController.Banner("Already claimed today · come back tomorrow", "info", 2)
	end
end

HANDLERS.DailyReady = function(m)
	HUDController.Banner(("Daily streak ready · Day %s · open the menu (C)"):format(tostring(m.Day or 1)), "gold")
end

HANDLERS.Rebirth = function(m)
	if m.Ok then
		HUDController.Banner(
			("VOID REBIRTH %s · x%.2f CREDITS · +✦%s"):format(
				tostring(m.Count or "?"),
				if type(m.Multiplier) == "number" then m.Multiplier else 1,
				tostring(m.Shards or 0)
			),
			"void",
			4
		)
		VFXController.ScreenFlash(Ui.Colors.Void, 0.8)
		CameraController.Shake(0.6, 0.6)
	else
		HUDController.Banner(("Rebirth needs Station Tier %s"):format(tostring(m.Required or "?")), "warn")
	end
end

HANDLERS.Forge = function(m)
	if m.Phase == "start" then
		HUDController.Banner(
			("Forging an artifact · %ds%s"):format(
				math.ceil(if type(m.Seconds) == "number" then m.Seconds else 0),
				if m.Cooling then " (cooling)" else ""
			),
			"void"
		)
	elseif m.Phase == "done" then
		HUDController.Toast("ARTIFACT FORGED", "Turn it in for Voidline Tokens", Ui.Colors.Void)
	elseif m.Phase == "busy" then
		HUDController.Banner("The forge is still working", "info", 2)
	else
		HUDController.Banner(FORGE_REASONS[tostring(m.Reason)] or "The forge cannot start", "warn", 2)
	end
end

HANDLERS.LaserTuned = function()
	VFXController.Popup("Laser retuned", Ui.Colors.Cyan, rootPosition())
end

HANDLERS.AfkIdle = function()
	HUDController.Banner("Idle orbit · your drones rest until you move", "info", 4)
end

HANDLERS.AfkResume = function()
	HUDController.Banner("Welcome back, pilot", "good", 2)
end

HANDLERS.RiftCleared = function()
	HUDController.Toast("VOID RIFT CLEARED", "Cache claimed", Ui.Colors.Void)
	VFXController.ScreenFlash(Ui.Colors.Void, 0.5)
end

HANDLERS.Hazard = function(m)
	WorldController.Hazard(m)
	local position = rootPosition()
	if m.Phase == "telegraph" and position and typeof(m.Position) == "Vector3" then
		if (position - m.Position).Magnitude <= HAZARD_BANNER_RANGE then
			HUDController.Banner(string.upper(nameOf(m.Id)) .. " INCOMING", "warn", 2)
		end
	end
end

HANDLERS.WorldEvent = function(m)
	if m.Phase == "start" then
		CameraController.Punch(3, 0.8)
	end
end

function JuiceController.Handle(message: any)
	if type(message) ~= "table" or type(message.Kind) ~= "string" then
		return
	end
	local handler = HANDLERS[message.Kind]
	if handler then
		handler(message)
	end
end

function JuiceController.Kinds(): { string }
	local out = {}
	for kind in HANDLERS do
		table.insert(out, kind)
	end
	table.sort(out)
	return out
end

function JuiceController.Init()
	Remotes.Get("JuiceEvent").OnClientEvent:Connect(JuiceController.Handle)
end

return JuiceController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="102">
            <Properties>
              <string name="Name">MenuController</string>
              <string name="Source"><![CDATA[--!strict
-- The pilot menu: Pilot card + forge/rebirth/evolution, daily and weekly
-- quests, Codex progress, cosmetics locker, 7-day streak, squads, the Code
-- Terminal and settings. Also shows other pilots' cards (InspectResult) and
-- squad invites with Accept / Decline.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local DroneConfig = require(Voidline.Config.DroneConfig)
local DailyConfig = require(Voidline.Config.DailyConfig)
local RebirthConfig = require(Voidline.Config.RebirthConfig)
local ForgeConfig = require(Voidline.Config.ForgeConfig)
local SquadConfig = require(Voidline.Config.SquadConfig)
local EconomyRules = require(Voidline.Rules.EconomyRules)
local ProgressionRules = require(Voidline.Rules.ProgressionRules)
local ContentIndex = require(Voidline.Content.ContentIndex)
local DroneRegistry = require(Voidline.Content.DroneRegistry)
local TitleRegistry = require(Voidline.Content.TitleRegistry)
local CitadelRegistry = require(Voidline.Content.CitadelRegistry)
local AchievementRegistry = require(Voidline.Content.AchievementRegistry)
local Remotes = require(Voidline.Remotes)

local Client = script.Parent.Parent.Client
local Ui = require(Client.Ui)
local ClientState = require(Client.ClientState)

local MenuController = {}

local TABS = { "Pilot", "Quests", "Codex", "Locker", "Daily", "Squad", "Codes", "Settings" }
local INVITE_SECONDS = 30
local NEARBY_LIMIT = 8
local VOLUME_STEPS = { 0, 0.25, 0.5, 0.75, 1 }

local player = Players.LocalPlayer
local gui: ScreenGui
local panel: Frame
local content: ScrollingFrame
local tabButtons: { [string]: TextButton } = {}
local currentTab = "Pilot"
local codeBox: TextBox? = nil
local codeResult = ""
local cardGui: ScreenGui
local inviteGui: ScreenGui
local onOpened: (() -> ())? = nil

-- Small builders -------------------------------------------------------------------

local order = 0
local function nextOrder(): number
	order += 1
	return order
end

local function heading(text: string)
	Ui.Label({
		Name = "Heading",
		Size = UDim2.new(1, -8, 0, 26),
		Text = text,
		Font = Ui.Font.Title,
		TextSize = 15,
		TextColor3 = Ui.Colors.GoldBright,
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = nextOrder(),
		Parent = content,
	})
end

local function line(text: string, color: Color3?)
	Ui.Label({
		Name = "Line",
		Size = UDim2.new(1, -8, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Text = text,
		TextSize = 14,
		TextColor3 = color or Ui.Colors.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = nextOrder(),
		Parent = content,
	})
end

local function rowFrame(height: number): Frame
	local frame = Ui.Make("Frame", {
		Name = "Row",
		Size = UDim2.new(1, -8, 0, height),
		BackgroundColor3 = Ui.Colors.GlassLight,
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		LayoutOrder = nextOrder(),
		Parent = content,
	}) :: Frame
	Ui.Corner(frame, 10)
	return frame
end

local function rowLabel(frame: Frame, text: string, sub: string?, rightInset: number)
	Ui.Label({
		Name = "Text",
		Position = UDim2.fromOffset(12, if sub then 6 else 0),
		Size = UDim2.new(1, -(rightInset + 20), 0, if sub then 22 else frame.Size.Y.Offset),
		Text = text,
		Font = Ui.Font.Bold,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = frame,
	})
	if sub then
		Ui.Label({
			Name = "Sub",
			Position = UDim2.fromOffset(12, 28),
			Size = UDim2.new(1, -(rightInset + 20), 0, 18),
			Text = sub,
			TextSize = 12,
			TextColor3 = Ui.Colors.Muted,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = frame,
		})
	end
end

local function rowButton(frame: Frame, text: string, width: number, onActivate: () -> ()): TextButton
	return Ui.Button({
		Name = "Action",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(width, Ui.TOUCH),
		Text = text,
		TextSize = 14,
		Parent = frame,
	}, onActivate)
end

local function progressBar(frame: Frame, fraction: number, color: Color3)
	local track = Ui.Make("Frame", {
		Name = "Track",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 12, 1, -6),
		Size = UDim2.new(1, -24, 0, 6),
		BackgroundColor3 = Ui.Colors.Shadow,
		BorderSizePixel = 0,
		Parent = frame,
	}) :: Frame
	Ui.Corner(track, 3)
	local fill = Ui.Make("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Parent = track,
	}) :: Frame
	Ui.Corner(fill, 3)
end

local function count(map: { [any]: any }): number
	local n = 0
	for _ in map do
		n += 1
	end
	return n
end

-- Tabs ---------------------------------------------------------------------------------

local function renderPilot()
	local profile = ClientState.Profile
	local evolution = DroneRegistry.EvolutionFor(profile.DroneTier, profile.DroneBranch)
	local title = TitleRegistry.ById[profile.Cosmetics.Title]
	local citadel = CitadelRegistry.ForTier(profile.StationTier)
	heading(("%s%s"):format(player.DisplayName, if title then " · " .. title.Name else ""))
	line(("Citadel: %s (Station Tier %d)"):format(citadel.Name, profile.StationTier))
	line(
		("Drones: %s × %d · %s"):format(
			evolution.Name,
			(player:GetAttribute("DroneCount") or 1) :: number,
			DroneConfig.FormationLabels[profile.Formation] or ""
		)
	)
	line(
		("Rebirths: %d (x%.2f Credits) · Codex %d/%d · Relics %d · Achievements %d"):format(
			profile.Rebirths,
			RebirthConfig.CreditMultiplier(profile.Rebirths),
			ClientState.CodexCount,
			ContentIndex.CodexTotal,
			count(profile.Relics),
			count(profile.Achievements)
		),
		Ui.Colors.Muted
	)

	-- Branch choice right before the evolution tree splits.
	if profile.DroneTier == DroneConfig.BranchStage - 1 and profile.DroneBranch == "" then
		heading("CHOOSE YOUR EVOLUTION LINE")
		local cost = EconomyRules.UpgradeCost(profile, "DroneTier", ClientState.Ctx()) or 0
		for _, branchId in DroneConfig.BranchOrder do
			local frame = rowFrame(56)
			local branch = DroneConfig.Branches[branchId]
			local next = DroneRegistry.EvolutionFor(DroneConfig.BranchStage, branchId)
			rowLabel(frame, ("%s · %s"):format(branch.Label, next.Name), next.Flavor, 150)
			rowButton(frame, ("EVOLVE ◆%s"):format(Ui.Compact(cost)), 140, function()
				ClientState.Fire("RequestUpgrade", "DroneTier", branchId)
			end)
		end
	end

	heading("ARTIFACT FORGE")
	local shards = profile.VoidShards
	local forging = profile.ForgeJobEndsAt > 0
	local forgeRow = rowFrame(56)
	rowLabel(
		forgeRow,
		("Void Shards %d / %d per artifact"):format(shards, ForgeConfig.ShardsPerArtifact),
		if forging
			then "Forging… collect when the timer ends"
			else ("Artifacts %d · each turns into %d Tokens"):format(
				profile.Artifacts,
				ForgeConfig.TokensPerArtifact
			),
		260
	)
	local buttons = Ui.Make("Frame", {
		Name = "Buttons",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(252, Ui.TOUCH),
		BackgroundTransparency = 1,
		Parent = forgeRow,
	})
	Ui.List(buttons, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Right)
	Ui.Button({
		Name = "Forge",
		Size = UDim2.fromOffset(120, Ui.TOUCH),
		Text = if forging then "COLLECT" else "FORGE",
		Parent = buttons,
	}, function()
		ClientState.Fire("RequestForge")
	end)
	Ui.Button(
		{ Name = "TurnIn", Size = UDim2.fromOffset(120, Ui.TOUCH), Text = "TURN IN", Parent = buttons },
		function()
			ClientState.Fire("TurnInArtifact")
		end
	)
	if ProgressionRules.ForgeCooling(profile) then
		line("The forge is cooling for today: slower, never stopped.", Ui.Colors.Muted)
	end

	heading("VOID REBIRTH")
	local canRebirth = ProgressionRules.CanRebirth(profile)
	local rebirthRow = rowFrame(56)
	rowLabel(
		rebirthRow,
		("Rebirth %d → x%.2f Credits"):format(
			profile.Rebirths + 1,
			RebirthConfig.CreditMultiplier(profile.Rebirths + 1)
		),
		if canRebirth
			then "Resets station upgrades; keeps Codex, relics, titles and passes"
			else ("Needs Station Tier %d"):format(RebirthConfig.RequiredStationTier),
		150
	)
	local rebirthButton = rowButton(rebirthRow, "REBIRTH", 130, function()
		ClientState.Fire("RequestRebirth")
	end)
	Ui.SetEnabled(rebirthButton, canRebirth)
end

local function renderQuests()
	local quests = ClientState.Profile.Quests
	for _, section in { { "DAILY QUESTS", quests.Daily }, { "WEEKLY QUESTS", quests.Weekly } } do
		heading(section[1])
		local listed = section[2]
		if type(listed) ~= "table" or #listed == 0 then
			line("New quests arrive at the next reset.", Ui.Colors.Muted)
			continue
		end
		for _, quest in listed do
			local frame = rowFrame(58)
			local target = math.max(1, quest.Target or 1)
			local progress = math.min(quest.Progress or 0, target)
			rowLabel(
				frame,
				(if quest.Done then "✓ " else "") .. tostring(quest.Name),
				("%d / %d"):format(progress, target),
				12
			)
			progressBar(frame, progress / target, if quest.Done then Ui.Colors.Good else Ui.Colors.Gold)
		end
	end
end

local function renderCodex()
	local profile = ClientState.Profile
	local mult = ContentIndex.CodexMultiplier(ClientState.CodexCount)
	heading(("CODEX · %d / %d DISCOVERED"):format(ClientState.CodexCount, ContentIndex.CodexTotal))
	line(("Codex bonus: x%.2f Credits"):format(mult), Ui.Colors.GoldBright)
	for _, milestone in ContentIndex.CodexMilestones do
		if ClientState.CodexCount < milestone.Count then
			line(
				("Next milestone: %d discoveries (+%d%%)"):format(
					milestone.Count,
					math.floor(milestone.Bonus * 100 + 0.5)
				),
				Ui.Colors.Muted
			)
			break
		end
	end
	local found: { [string]: number } = {}
	for id in profile.Codex do
		local _, kind = ContentIndex.Get(id)
		if kind then
			found[kind] = (found[kind] or 0) + 1
		end
	end
	for _, info in ContentIndex.Registries do
		if not info.Codex then
			continue
		end
		local frame = rowFrame(52)
		local have = found[info.Kind] or 0
		rowLabel(frame, info.Label, ("%d / %d"):format(have, info.Registry.Count), 12)
		progressBar(frame, have / math.max(1, info.Registry.Count), Ui.Colors.Void)
	end
	heading(("ACHIEVEMENTS · %d / %d"):format(count(profile.Achievements), AchievementRegistry.Count))
end

local function equipRow(slot: string, id: string, name: string, sub: string, equipped: boolean)
	local frame = rowFrame(52)
	rowLabel(frame, name, sub, 130)
	rowButton(frame, if equipped then "UNEQUIP" else "EQUIP", 120, function()
		ClientState.Fire("EquipCosmetic", slot, if equipped then "" else id)
	end)
end

local function renderLocker()
	local profile = ClientState.Profile
	heading("TITLES")
	local any = false
	for _, title in TitleRegistry.List do
		if profile.Titles[title.Id] == true then
			any = true
			equipRow(
				"Title",
				title.Id,
				title.Name,
				title.Rarity .. " · " .. title.Source,
				profile.Cosmetics.Title == title.Id
			)
		end
	end
	if not any then
		line("Earn titles from achievements, rebirths, relic sets and codes.", Ui.Colors.Muted)
	end
	for _, slot in
		{
			{ "DroneMutation", "Mutation", "MUTATIONS" },
			{ "LaserShader", "Laser", "LASER SHADERS" },
			{ "HitEffect", "HitEffect", "HIT EFFECTS" },
			{ "Thruster", "Thruster", "THRUSTERS" },
		}
	do
		heading(slot[3])
		local owned = 0
		for _, cosmetic in DroneRegistry.ByCategory(slot[2]) do
			if profile.Unlocks[cosmetic.Id] == true then
				owned += 1
				equipRow(
					slot[1],
					cosmetic.Id,
					cosmetic.Name,
					cosmetic.Rarity,
					profile.Cosmetics[slot[1]] == cosmetic.Id
				)
			end
		end
		if owned == 0 then
			line("None yet: quests, achievements and evolutions unlock these.", Ui.Colors.Muted)
		end
	end
end

local function renderDaily()
	local profile = ClientState.Profile
	local canClaim = ProgressionRules.CanClaimDaily(profile, os.time())
	local today = math.max(1, profile.DailyStreak)
	heading(("7-DAY STREAK · DAY %d"):format(today))
	for day = 1, DailyConfig.CycleLength do
		local reward = DailyConfig.Rewards[day]
		local frame = rowFrame(52)
		local parts = { ("◆%d"):format(reward.Credits) }
		if reward.VoidShards > 0 then
			table.insert(parts, ("✦%d"):format(reward.VoidShards))
		end
		if reward.TrialPerk then
			table.insert(parts, ("%dh %s trial"):format(reward.TrialHours or 24, reward.TrialPerk))
		end
		local status = if day < today or (day == today and not canClaim) then "✓ " else ""
		rowLabel(frame, ("%sDay %d"):format(status, day), table.concat(parts, " · "), 130)
		if day == today then
			local button = rowButton(frame, if canClaim then "CLAIM" else "CLAIMED", 120, function()
				ClientState.Fire("RedeemDaily")
			end)
			Ui.SetEnabled(button, canClaim)
		end
	end
end

local function distanceTo(other: Player): number
	local a = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local b = other.Character and other.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if a and b then
		return (a.Position - b.Position).Magnitude
	end
	return math.huge
end

local function renderSquad()
	local squad = ClientState.Squad
	local members = if type(squad.Members) == "table" then squad.Members else {}
	local inSquad = squad.SquadId ~= nil and #members > 0
	local memberIds: { [number]: boolean } = {}
	if inSquad then
		heading(("YOUR SQUAD · %d / %d"):format(#members, SquadConfig.MaxSize))
		local leader = false
		for _, member in members do
			memberIds[member.UserId] = true
			if member.UserId == player.UserId and member.Leader then
				leader = true
			end
		end
		for _, member in members do
			local frame = rowFrame(52)
			rowLabel(frame, (if member.Leader then "★ " else "") .. tostring(member.Name), nil, 120)
			if leader and member.UserId ~= player.UserId then
				rowButton(frame, "KICK", 100, function()
					ClientState.Fire("SquadKick", member.UserId)
				end)
			end
		end
		local challenge = squad.Challenge
		if type(challenge) == "table" then
			local frame = rowFrame(58)
			rowLabel(
				frame,
				"SQUAD CHALLENGE",
				("%d / %d rocks together"):format(challenge.Progress or 0, challenge.Goal or 1),
				12
			)
			progressBar(frame, (challenge.Progress or 0) / math.max(1, challenge.Goal or 1), Ui.Colors.Cyan)
		end
		local leaveRow = rowFrame(52)
		rowLabel(
			leaveRow,
			("Linked squads find shards +%d%% more often"):format(
				math.floor((squad.LuckBonus or SquadConfig.LinkedShardLuckBonus) * 100 + 0.5)
			),
			nil,
			120
		)
		rowButton(leaveRow, "LEAVE", 100, function()
			ClientState.Fire("SquadLeave")
		end)
	else
		heading("SQUADS")
		line(
			("Team up with %d-%d pilots for shared challenges and shard luck."):format(
				SquadConfig.MinSize,
				SquadConfig.MaxSize
			),
			Ui.Colors.Muted
		)
	end
	heading("PILOTS NEARBY")
	local others = {}
	for _, other in Players:GetPlayers() do
		if other ~= player and not memberIds[other.UserId] then
			table.insert(others, other)
		end
	end
	table.sort(others, function(a, b)
		return distanceTo(a) < distanceTo(b)
	end)
	if #others == 0 then
		line("No other pilots in this server yet.", Ui.Colors.Muted)
	end
	for i, other in others do
		if i > NEARBY_LIMIT then
			break
		end
		local frame = rowFrame(52)
		local title = other:GetAttribute("Title")
		rowLabel(frame, other.DisplayName, if type(title) == "string" and title ~= "" then title else nil, 240)
		local buttons = Ui.Make("Frame", {
			Name = "Buttons",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -8, 0.5, 0),
			Size = UDim2.fromOffset(232, Ui.TOUCH),
			BackgroundTransparency = 1,
			Parent = frame,
		})
		Ui.List(buttons, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Right)
		Ui.Button({ Name = "Card", Size = UDim2.fromOffset(100, Ui.TOUCH), Text = "CARD", Parent = buttons }, function()
			ClientState.Fire("InspectPilot", other.UserId)
		end)
		Ui.Button(
			{ Name = "Invite", Size = UDim2.fromOffset(110, Ui.TOUCH), Text = "INVITE", Parent = buttons },
			function()
				ClientState.Fire("SquadInvite", other.UserId)
			end
		)
	end
end

local function renderCodes()
	heading("CODE TERMINAL")
	line("Enter a code from the community. Each code works once per pilot.", Ui.Colors.Muted)
	local frame = rowFrame(60)
	local box = Ui.Make("TextBox", {
		Name = "CodeBox",
		Position = UDim2.fromOffset(10, 6),
		Size = UDim2.new(1, -150, 0, Ui.TOUCH),
		BackgroundColor3 = Ui.Colors.Shadow,
		BackgroundTransparency = 0.2,
		Font = Ui.Font.Bold,
		TextSize = 18,
		TextColor3 = Ui.Colors.Text,
		PlaceholderText = "ENTER CODE",
		PlaceholderColor3 = Ui.Colors.Muted,
		ClearTextOnFocus = false,
		Text = "",
		Parent = frame,
	}) :: TextBox
	Ui.Corner(box, 8)
	codeBox = box
	local function submit()
		local text = string.sub(box.Text, 1, 64)
		if text ~= "" then
			ClientState.Fire("RedeemCode", text)
		end
	end
	box.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			submit()
		end
	end)
	rowButton(frame, "REDEEM", 120, submit)
	if codeResult ~= "" then
		line(codeResult, Ui.Colors.GoldBright)
	end
end

local function toggleRow(label: string, key: string, sub: string)
	local settings = ClientState.Profile.Settings
	local on = settings[key] == true
	local frame = rowFrame(56)
	rowLabel(frame, label, sub, 110)
	rowButton(frame, if on then "ON" else "OFF", 90, function()
		ClientState.Fire("SettingsUpdate", { [key] = not on })
	end)
end

local function stepRow(label: string, key: string)
	local settings = ClientState.Profile.Settings
	local value = settings[key]
	local current = if type(value) == "number" then value else 0.5
	local frame = rowFrame(56)
	rowLabel(frame, label, ("%d%%"):format(math.floor(current * 100 + 0.5)), 110)
	rowButton(frame, "CHANGE", 90, function()
		local nextValue = VOLUME_STEPS[1]
		for i, step in VOLUME_STEPS do
			if math.abs(step - current) < 0.01 then
				nextValue = VOLUME_STEPS[i % #VOLUME_STEPS + 1]
			end
		end
		ClientState.Fire("SettingsUpdate", { [key] = nextValue })
	end)
end

local function renderSettings()
	heading("SETTINGS")
	toggleRow("Performance Mode", "PerfMode", "Fewer particles, trails and distant drones")
	toggleRow("Clean Clip Mode", "ClipMode", "Hide the HUD for recording (K toggles)")
	toggleRow("Reduced Motion", "ReducedMotion", "No camera shake, calmer UI")
	stepRow("Music volume", "MusicVolume")
	stepRow("Effects volume", "SfxVolume")
	local settings = ClientState.Profile.Settings
	local frame = rowFrame(56)
	rowLabel(frame, "Laser colour", tostring(settings.LaserColor), 110)
	rowButton(frame, "CYCLE", 90, function()
		local colors = DroneConfig.LaserColorOrder
		local index = table.find(colors, settings.LaserColor) or 0
		ClientState.Fire("SettingsUpdate", { LaserColor = colors[index % #colors + 1] })
	end)
end

local RENDERERS: { [string]: () -> () } = {
	Pilot = renderPilot,
	Quests = renderQuests,
	Codex = renderCodex,
	Locker = renderLocker,
	Daily = renderDaily,
	Squad = renderSquad,
	Codes = renderCodes,
	Settings = renderSettings,
}

local function render()
	if not gui.Enabled then
		return
	end
	-- Do not rebuild under a pilot who is typing a code.
	if currentTab == "Codes" and codeBox and codeBox.Parent and codeBox:IsFocused() then
		return
	end
	Ui.ClearChildren(content)
	codeBox = nil
	order = 0
	for name, button in tabButtons do
		local selected = name == currentTab
		button.BackgroundColor3 = if selected then Ui.Colors.Gold else Ui.Colors.GlassLight
		button.TextColor3 = if selected then Ui.Colors.Shadow else Ui.Colors.Text
	end
	RENDERERS[currentTab]()
end

function MenuController.Open(tab: string?)
	if tab and RENDERERS[tab] then
		currentTab = tab
	end
	gui.Enabled = true
	Ui.Pop(panel, 0.9)
	render()
	if onOpened then
		onOpened()
	end
end

function MenuController.Close()
	gui.Enabled = false
end

function MenuController.Toggle(tab: string?)
	if gui.Enabled and (tab == nil or tab == currentTab) then
		MenuController.Close()
	else
		MenuController.Open(tab)
	end
end

function MenuController.IsOpen(): boolean
	return gui.Enabled
end

function MenuController.OnOpened(callback: () -> ())
	onOpened = callback
end

function MenuController.CodeResult(text: string)
	codeResult = text
	if currentTab == "Codes" then
		render()
	end
end

-- Pilot cards and invites ----------------------------------------------------------------

function MenuController.ShowCard(card: { [string]: any })
	Ui.ClearChildren(cardGui)
	local frame = Ui.Glass({
		Name = "PilotCard",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(340, 300),
		Parent = cardGui,
	})
	type CardLine = { text: string, font: Enum.Font, size: number, color: Color3 }
	local lines: { CardLine } = {
		{ text = tostring(card.Name or "Pilot"), font = Ui.Font.Title, size = 22, color = Ui.Colors.GoldBright },
		{ text = tostring(card.Title or ""), font = Ui.Font.Bold, size = 14, color = Ui.Colors.Void },
		{
			text = ("%s · Station Tier %s"):format(tostring(card.Citadel or ""), tostring(card.StationTier or 1)),
			font = Ui.Font.Body,
			size = 14,
			color = Ui.Colors.Text,
		},
		{
			text = ("%s × %s"):format(tostring(card.Drone or ""), tostring(card.Drones or 1)),
			font = Ui.Font.Body,
			size = 14,
			color = Ui.Colors.Text,
		},
		{
			text = ("Rebirths %s · Codex %s · Relics %s"):format(
				tostring(card.Rebirths or 0),
				tostring(card.Codex or 0),
				tostring(card.Relics or 0)
			),
			font = Ui.Font.Body,
			size = 14,
			color = Ui.Colors.Muted,
		},
		{
			text = ("Achievements %s · Streak day %s"):format(
				tostring(card.Achievements or 0),
				tostring(card.Streak or 0)
			),
			font = Ui.Font.Body,
			size = 14,
			color = Ui.Colors.Muted,
		},
	}
	local showcase = card.Showcase
	if type(showcase) == "table" and #showcase > 0 then
		table.insert(lines, {
			text = "Showcase: " .. table.concat(showcase, ", "),
			font = Ui.Font.Body,
			size = 13,
			color = Ui.Colors.GoldBright,
		})
	end
	local y = 16
	for _, entry in lines do
		Ui.Label({
			Position = UDim2.fromOffset(18, y),
			Size = UDim2.new(1, -36, 0, entry.size + 10),
			Text = entry.text,
			Font = entry.font,
			TextSize = entry.size,
			TextColor3 = entry.color,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = frame,
		})
		y += entry.size + 14
	end
	Ui.Button({
		Name = "Close",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Size = UDim2.fromOffset(140, Ui.TOUCH),
		Text = "CLOSE",
		Parent = frame,
	}, function()
		Ui.ClearChildren(cardGui)
	end)
	Ui.Pop(frame, 0.85)
end

function MenuController.ShowInvite(fromUserId: number, fromName: string, seconds: number?)
	Ui.ClearChildren(inviteGui)
	local frame = Ui.Glass({
		Name = "Invite",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -96),
		Size = UDim2.fromOffset(360, 104),
		Parent = inviteGui,
	})
	Ui.Label({
		Position = UDim2.fromOffset(14, 8),
		Size = UDim2.new(1, -28, 0, 26),
		Text = ("%s invites you to a squad"):format(fromName),
		Font = Ui.Font.Title,
		TextSize = 16,
		TextColor3 = Ui.Colors.GoldBright,
		Parent = frame,
	})
	local buttons = Ui.Make("Frame", {
		Position = UDim2.fromOffset(14, 44),
		Size = UDim2.new(1, -28, 0, Ui.TOUCH),
		BackgroundTransparency = 1,
		Parent = frame,
	})
	Ui.List(buttons, Enum.FillDirection.Horizontal, 12)
	local function respond(accept: boolean)
		ClientState.Fire("SquadRespond", fromUserId, accept)
		Ui.ClearChildren(inviteGui)
	end
	Ui.Button({ Name = "Accept", Size = UDim2.fromOffset(150, Ui.TOUCH), Text = "ACCEPT", Parent = buttons }, function()
		respond(true)
	end)
	Ui.Button(
		{ Name = "Decline", Size = UDim2.fromOffset(150, Ui.TOUCH), Text = "DECLINE", Parent = buttons },
		function()
			respond(false)
		end
	)
	Ui.Pop(frame, 0.85)
	task.delay(seconds or INVITE_SECONDS, function()
		if frame.Parent then
			frame:Destroy()
		end
	end)
end

function MenuController.Init()
	gui = Ui.Screen("VoidlineMenu", 20)
	gui.Enabled = false
	cardGui = Ui.Screen("VoidlinePilotCard", 25)
	inviteGui = Ui.Screen("VoidlineInvite", 24)
	panel = Ui.Glass({
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.94, 0.86),
		Parent = gui,
	})
	Ui.Make("UISizeConstraint", { MaxSize = Vector2.new(720, 560), Parent = panel })
	Ui.Button({
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 8),
		Size = UDim2.fromOffset(Ui.TOUCH, Ui.TOUCH),
		Text = "✕",
		TextSize = 20,
		Parent = panel,
	}, MenuController.Close)
	local tabs = Ui.Make("ScrollingFrame", {
		Name = "Tabs",
		Position = UDim2.fromOffset(12, 8),
		Size = UDim2.new(1, -80, 0, Ui.TOUCH + 8),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 0,
		ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.X,
		CanvasSize = UDim2.new(),
		Parent = panel,
	})
	Ui.List(tabs, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Left)
	for i, name in TABS do
		tabButtons[name] = Ui.Button({
			Name = name,
			Size = UDim2.fromOffset(96, Ui.TOUCH),
			Text = string.upper(name),
			TextSize = 13,
			LayoutOrder = i,
			Parent = tabs,
		}, function()
			currentTab = name
			render()
		end)
	end
	content = Ui.Make("ScrollingFrame", {
		Name = "Content",
		Position = UDim2.fromOffset(12, Ui.TOUCH + 24),
		Size = UDim2.new(1, -24, 1, -(Ui.TOUCH + 36)),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = panel,
	})
	Ui.List(content, Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Top)

	ClientState.OnChanged(function()
		render()
	end)
	Remotes.Get("InspectResult").OnClientEvent:Connect(function(card: any)
		if type(card) == "table" then
			MenuController.ShowCard(card)
		end
	end)
	Players.PlayerAdded:Connect(function()
		if currentTab == "Squad" then
			render()
		end
	end)
	Players.PlayerRemoving:Connect(function()
		if currentTab == "Squad" then
			task.defer(render)
		end
	end)
end

return MenuController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="103">
            <Properties>
              <string name="Name">MovementController</string>
              <string name="Source"><![CDATA[--!strict
-- Low-G sprint: faster walk while holding Shift (desktop) or the sprint chip
-- (touch). Small gold foot thrusters when sprinting; respects Hide Jetpack.
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local GameConfig = require(Voidline.Config.GameConfig)

local Client = script.Parent.Parent.Client
local Ui = require(Client.Ui)
local ClientState = require(Client.ClientState)

local MovementController = {}

local BASE_WALK = 16
local SPRINT_WALK = 26
local SPRINT_JUMP = 52

local player = Players.LocalPlayer
local sprinting = false
local sprintGui: ScreenGui?
local footL: ParticleEmitter?
local footR: ParticleEmitter?

local function humanoid(): Humanoid?
	local character = player.Character
	return if character then character:FindFirstChildOfClass("Humanoid") else nil
end

local function hideJetpack(): boolean
	return player:GetAttribute("HideJetpack") == true or ClientState.Profile.Settings.HideJetpack == true
end

local function setFootFx(on: boolean)
	local show = on and not hideJetpack()
	if footL then
		footL.Enabled = show
	end
	if footR then
		footR.Enabled = show
	end
end

local function applySpeed()
	local hum = humanoid()
	if not hum then
		return
	end
	if sprinting then
		hum.WalkSpeed = SPRINT_WALK
		hum.JumpPower = SPRINT_JUMP
	else
		hum.WalkSpeed = BASE_WALK
		hum.JumpPower = 50
	end
	setFootFx(sprinting)
end

local function setSprint(on: boolean)
	if sprinting == on then
		return
	end
	sprinting = on
	applySpeed()
end

local function attachFootFx(character: Model)
	footL, footR = nil, nil
	for _, name in { "LeftFoot", "RightFoot", "Left Leg", "Right Leg" } do
		local foot = character:FindFirstChild(name)
		if foot and foot:IsA("BasePart") then
			local existing = foot:FindFirstChild("VoidlineSprintThruster")
			local emitter: ParticleEmitter
			if existing and existing:IsA("ParticleEmitter") then
				emitter = existing
			else
				emitter = Instance.new("ParticleEmitter") :: ParticleEmitter
				emitter.Name = "VoidlineSprintThruster"
				emitter.Texture = ""
				emitter.Rate = 0
				emitter.Lifetime = NumberRange.new(0.15, 0.3)
				emitter.Speed = NumberRange.new(2, 5)
				emitter.SpreadAngle = Vector2.new(25, 25)
				emitter.Color = ColorSequence.new(GameConfig.Colors.GoldBright, GameConfig.Colors.Gold)
				emitter.LightEmission = 0.8
				emitter.Size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.35),
					NumberSequenceKeypoint.new(1, 0),
				})
				emitter.Enabled = false
				emitter.Parent = foot
			end
			if name:find("Left") then
				footL = emitter
			else
				footR = emitter
			end
		end
	end
	applySpeed()
end

local function bindDesktopSprint()
	ContextActionService:BindAction("VoidlineSprint", function(_, state)
		if state == Enum.UserInputState.Begin then
			setSprint(true)
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			setSprint(false)
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift)
end

local function buildTouchSprint()
	if not Ui.IsTouch() then
		return
	end
	sprintGui = Ui.Screen("VoidlineSprintChip", 5)
	local button = Ui.Button({
		Name = "Sprint",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -18, 1, -140),
		Size = UDim2.fromOffset(Ui.TOUCH, Ui.TOUCH),
		Text = "SPRINT",
		Font = Ui.Font.Bold,
		TextSize = 11,
		TextColor3 = Ui.Colors.GoldBright,
		Parent = sprintGui,
	}, function() end)
	Ui.Make("UISizeConstraint", { MinSize = Vector2.new(Ui.TOUCH, Ui.TOUCH), Parent = button })
	button.MouseButton1Down:Connect(function()
		setSprint(true)
	end)
	button.MouseButton1Up:Connect(function()
		setSprint(false)
	end)
	button.MouseLeave:Connect(function()
		setSprint(false)
	end)
	ClientState.OnChanged(function(changed)
		if changed.Settings or changed.Loaded then
			button.Visible = ClientState.Profile.Settings.ClipMode ~= true
		end
	end)
end

function MovementController.SetVisible(on: boolean)
	if sprintGui then
		sprintGui.Enabled = on
	end
end

function MovementController.Init()
	bindDesktopSprint()
	buildTouchSprint()
	local function onCharacter(character: Model)
		task.defer(function()
			local humInst = character:WaitForChild("Humanoid", 10)
			if humInst and humInst:IsA("Humanoid") then
				humInst.WalkSpeed = BASE_WALK
			end
			attachFootFx(character)
		end)
	end
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		onCharacter(player.Character)
	end
	player:GetAttributeChangedSignal("HideJetpack"):Connect(function()
		setFootFx(sprinting)
	end)
	ClientState.OnChanged(function(changed)
		if changed.Settings or changed.Loaded then
			setFootFx(sprinting)
		end
	end)
end

return MovementController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="104">
            <Properties>
              <string name="Name">OnboardingController</string>
              <string name="Source"><![CDATA[--!strict
-- Diegetic onboarding: a golden floor beam from the pilot to the next thing
-- to touch, a pulsing ring on it, the [n/4] ticker and a tiny two-tap Skip.
-- The server owns progress; this only draws what the profile says.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local JuiceConfig = require(Voidline.Config.JuiceConfig)
local GameConfig = require(Voidline.Config.GameConfig)
local TutorialRules = require(Voidline.Rules.TutorialRules)
local PlotLayout = require(Voidline.Modules.PlotLayout)

local Client = script.Parent.Parent.Client
local Ui = require(Client.Ui)
local ClientState = require(Client.ClientState)

local OnboardingController = {}

local FINALE_SECONDS = 6
local SKIP_CONFIRM_SECONDS = 3
local FLOOR_OFFSET = Vector3.new(0, -2.8, 0)

local player = Players.LocalPlayer
local gui: ScreenGui
local card: Frame
local tickerText: TextLabel
local hintText: TextLabel
local pips: { Frame } = {}
local skipButton: TextButton
local skipArmedUntil = 0

local folder: Folder? = nil
local anchor: Part? = nil
local ring: Part? = nil
local beam: Beam? = nil
local rootAttachment: Attachment? = nil
local finaleUntil = 0
local finished = false

local function ensureWorld(): (Part, Part, Beam)
	if folder and anchor and ring and beam then
		return anchor, ring, beam
	end
	local f = Ui.Make("Folder", { Name = "VoidlineOnboarding", Parent = Workspace }) :: Folder
	local a = Ui.Make("Part", {
		Name = "BeamAnchor",
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Transparency = 1,
		Size = Vector3.new(0.2, 0.2, 0.2),
		Parent = f,
	}) :: Part
	local target = Ui.Make("Attachment", { Name = "Target", Parent = a }) :: Attachment
	local r = Ui.Make("Part", {
		Name = "Ring",
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Shape = Enum.PartType.Cylinder,
		Material = Enum.Material.Neon,
		Color = JuiceConfig.TutorialBeamColor,
		Size = Vector3.new(0.15, 9, 9),
		Transparency = 0.35,
		Parent = f,
	}) :: Part
	Ui.Loop(r, 0.8, { Transparency = 0.75 })
	local b = Ui.Make("Beam", {
		Name = "FloorBeam",
		Attachment1 = target,
		Color = ColorSequence.new(JuiceConfig.TutorialBeamColor, GameConfig.Colors.GoldBright),
		Transparency = NumberSequence.new(0.15, 0.4),
		Width0 = 1.4,
		Width1 = 0.8,
		LightEmission = 1,
		LightInfluence = 0,
		FaceCamera = true,
		Segments = 16,
		Enabled = false,
		Parent = a,
	}) :: Beam
	folder, anchor, ring, beam = f, a, r, b
	return a, r, b
end

local function attachToCharacter(character: Model?)
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if rootAttachment then
		rootAttachment:Destroy()
		rootAttachment = nil
	end
	if not root then
		return
	end
	rootAttachment = Ui.Make("Attachment", { Name = "VoidlineGuide", Position = FLOOR_OFFSET, Parent = root })
	if beam then
		beam.Attachment0 = rootAttachment
	end
end

local function plotIndex(): number?
	local index = player:GetAttribute("PlotIndex")
	return if type(index) == "number" then index else nil
end

-- Where to point for the current step: (beam target, ring target).
local function targets(profile: any): (Vector3?, Vector3?)
	local index = plotIndex()
	if not index then
		return nil, nil
	end
	if finaleUntil > os.clock() then
		local hub = PlotLayout.BridgeEnd(index)
		return hub, PlotLayout.World(index, PlotLayout.BridgeStart)
	end
	if profile.TutorialComplete then
		return nil, nil
	end
	local step = profile.TutorialStep
	if step == 1 then
		return nil, PlotLayout.World(index, PlotLayout.Grinder - Vector3.new(0, 4.8, 0))
	elseif step == 2 then
		local pad = PlotLayout.World(index, PlotLayout.Refinery)
		return pad, pad
	elseif step == 3 then
		local id = TutorialRules.NextUpgrade(profile)
		local offset = if id then PlotLayout.Pads[id] else nil
		if offset then
			local pad = PlotLayout.World(index, offset)
			return pad, pad
		end
	end
	return nil, nil
end

local function stepHint(profile: any): string
	local step = profile.TutorialStep
	if step == 3 then
		local flags = profile.TutorialFlags
		local function part(done: boolean, label: string): string
			return if done then "✓ " .. string.split(label, " ")[1] else label
		end
		return ("%s  ·  %s  ·  %s"):format(
			part(flags.Drill, "Drill 20"),
			part(flags.Cargo, "Cargo 35"),
			part(flags.Drone, "Drone 50")
		)
	end
	local info = TutorialRules.Steps[step]
	return if info then info.Hint else ""
end

local function render()
	local profile = ClientState.Profile
	if not ClientState.Loaded then
		gui.Enabled = false
		return
	end
	local inFinale = finaleUntil > os.clock()
	if profile.TutorialComplete and not inFinale then
		gui.Enabled = false
		if folder then
			folder:Destroy()
			folder, anchor, ring, beam = nil, nil, nil, nil
		end
		finished = true
		return
	end
	local clip = profile.Settings.ClipMode == true
	gui.Enabled = not clip
	if clip then
		local _, _, b = ensureWorld()
		b.Enabled = false
		if ring then
			ring.CFrame = CFrame.new(0, -500, 0)
		end
		return
	end
	local step = if inFinale then TutorialRules.DoneStep else profile.TutorialStep
	local info = TutorialRules.Steps[step]
	tickerText.Text = if info then info.Ticker else ""
	if inFinale then
		hintText.Text = if profile.TutorialSkipped
			then ("Skipped · +%d Credits"):format(GameConfig.TutorialCompleteBonusCredits)
			else ("Bridge to the Monolith is open · +%d Credits"):format(GameConfig.TutorialCompleteBonusCredits)
	else
		hintText.Text = stepHint(profile)
	end
	for i, pip in pips do
		pip.BackgroundColor3 = if i <= step then Ui.Colors.Gold else Ui.Colors.Shadow
	end
	skipButton.Visible = not inFinale

	local beamTarget, ringTarget = targets(profile)
	local a, r, b = ensureWorld()
	if beamTarget then
		a.CFrame = CFrame.new(beamTarget + Vector3.new(0, 0.3, 0))
		b.Enabled = true
		if not rootAttachment then
			attachToCharacter(player.Character)
		end
		b.Attachment0 = rootAttachment
	else
		b.Enabled = false
	end
	if ringTarget then
		r.CFrame = CFrame.new(ringTarget + Vector3.new(0, 0.4, 0)) * CFrame.Angles(0, 0, math.rad(90))
	else
		r.CFrame = CFrame.new(0, -500, 0)
	end
end

local function onSkip()
	if os.clock() < skipArmedUntil then
		skipArmedUntil = 0
		ClientState.Fire("TutorialSkip")
		return
	end
	skipArmedUntil = os.clock() + SKIP_CONFIRM_SECONDS
	local label = skipButton:FindFirstChild("Label") :: TextLabel?
	if label then
		label.Text = "Tap again to skip"
		task.delay(SKIP_CONFIRM_SECONDS, function()
			label.Text = "Skip tutorial"
		end)
	end
end

-- Called by the juice dispatcher when the bridge ignites.
function OnboardingController.Finale()
	if finished then
		return
	end
	finaleUntil = os.clock() + FINALE_SECONDS
	render()
	Ui.Pop(card, 0.8)
	task.delay(FINALE_SECONDS + 0.1, render)
end

local function build()
	gui = Ui.Screen("VoidlineOnboarding", 7)
	card = Ui.Glass({
		Name = "Ticker",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 16, 0.34, 0),
		Size = UDim2.fromOffset(300, 86),
		Parent = gui,
	})
	tickerText = Ui.Label({
		Name = "Step",
		Position = UDim2.fromOffset(14, 8),
		Size = UDim2.new(1, -28, 0, 24),
		Font = Ui.Font.Title,
		TextSize = 18,
		TextColor3 = Ui.Colors.GoldBright,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	})
	hintText = Ui.Label({
		Name = "Hint",
		Position = UDim2.fromOffset(14, 34),
		Size = UDim2.new(1, -28, 0, 30),
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = card,
	})
	local pipRow = Ui.Make("Frame", {
		Name = "Pips",
		Position = UDim2.new(0, 14, 1, -14),
		Size = UDim2.new(1, -28, 0, 6),
		BackgroundTransparency = 1,
		Parent = card,
	})
	Ui.List(pipRow, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Left)
	for i = 1, TutorialRules.DoneStep do
		local pip = Ui.Make("Frame", {
			Name = "Pip" .. i,
			Size = UDim2.new(0.25, -5, 1, 0),
			BackgroundColor3 = Ui.Colors.Shadow,
			BorderSizePixel = 0,
			LayoutOrder = i,
			Parent = pipRow,
		}) :: Frame
		Ui.Corner(pip, 3)
		pips[i] = pip
	end
	skipButton = Ui.Make("TextButton", {
		Name = "Skip",
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.new(0, 16, 0.34, 46),
		Size = UDim2.fromOffset(140, Ui.TOUCH),
		BackgroundTransparency = 1,
		Text = "",
		Parent = gui,
	}) :: TextButton
	Ui.Label({
		Name = "Label",
		Size = UDim2.fromScale(1, 1),
		Text = "Skip tutorial",
		TextSize = 12,
		TextColor3 = Ui.Colors.Muted,
		TextTransparency = 0.25,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = skipButton,
	})
	skipButton.Activated:Connect(onSkip)
end

function OnboardingController.Init()
	build()
	gui.Enabled = false
	player.CharacterAdded:Connect(function(character)
		attachToCharacter(character)
		render()
	end)
	player:GetAttributeChangedSignal("PlotIndex"):Connect(render)
	ClientState.OnChanged(function(changed)
		if
			changed.Loaded
			or changed.TutorialStep
			or changed.TutorialFlags
			or changed.TutorialComplete
			or changed.Tutorial
			or changed.Settings
		then
			render()
		end
	end)
	render()
end

return OnboardingController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="105">
            <Properties>
              <string name="Name">SettingsController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local Remotes = require(Voidline.Remotes)
local GameConfig = require(Voidline.Config.GameConfig)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local SettingsController = { _gui = nil, _perf = false, _hideJet = false }

function SettingsController.Toggle()
	if SettingsController._gui then
		SettingsController._gui.Enabled = not SettingsController._gui.Enabled
	end
end

function SettingsController.Init()
	local gui = Instance.new("ScreenGui")
	gui.Name = "VoidlineSettings"
	gui.ResetOnSpawn = false
	gui.Enabled = false
	gui.Parent = playerGui

	local panel = Instance.new("Frame")
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.fromOffset(360, 280)
	panel.BackgroundColor3 = GameConfig.Colors.Obsidian
	panel.Parent = gui
	Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 12)
	local stroke = Instance.new("UIStroke")
	stroke.Color = GameConfig.Colors.Gold
	stroke.Parent = panel

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, -16, 0, 32)
	title.Position = UDim2.fromOffset(12, 8)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBold
	title.TextSize = 20
	title.TextColor3 = GameConfig.Colors.Gold
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Text = "SETTINGS"
	title.Parent = panel

	local function toggleBtn(y, label, callback)
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(1, -24, 0, 40)
		b.Position = UDim2.fromOffset(12, y)
		b.BackgroundColor3 = Color3.fromRGB(24, 24, 32)
		b.TextColor3 = GameConfig.Colors.GoldBright
		b.Font = Enum.Font.GothamMedium
		b.TextSize = 14
		b.Text = label
		b.Parent = panel
		Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
		b.MouseButton1Click:Connect(function()
			callback(b)
		end)
		return b
	end

	toggleBtn(56, "Performance Mode: OFF", function(b)
		SettingsController._perf = not SettingsController._perf
		b.Text = "Performance Mode: " .. (SettingsController._perf and "ON" or "OFF")
		Lighting.Bloom.Enabled = not SettingsController._perf
		Remotes.Get("SettingsUpdate"):FireServer({ PerfMode = SettingsController._perf })
	end)

	toggleBtn(108, "Hide Jetpack: OFF", function(b)
		SettingsController._hideJet = not SettingsController._hideJet
		b.Text = "Hide Jetpack: " .. (SettingsController._hideJet and "ON" or "OFF")
		Remotes.Get("SettingsUpdate"):FireServer({ HideJetpack = SettingsController._hideJet })
		player:SetAttribute("HideJetpack", SettingsController._hideJet)
	end)

	local close = Instance.new("TextButton")
	close.Size = UDim2.new(1, -24, 0, 40)
	close.Position = UDim2.fromOffset(12, 220)
	close.BackgroundColor3 = GameConfig.Colors.Gold
	close.TextColor3 = GameConfig.Colors.Obsidian
	close.Font = Enum.Font.GothamBold
	close.Text = "CLOSE"
	close.Parent = panel
	Instance.new("UICorner", close).CornerRadius = UDim.new(0, 8)
	close.MouseButton1Click:Connect(function()
		gui.Enabled = false
	end)

	-- Ensure bloom exists for perf toggle
	if not Lighting:FindFirstChildOfClass("BloomEffect") then
		local bloom = Instance.new("BloomEffect")
		bloom.Intensity = 0.6
		bloom.Size = 24
		bloom.Threshold = 1.2
		bloom.Parent = Lighting
	end

	SettingsController._gui = gui
end

return SettingsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="106">
            <Properties>
              <string name="Name">StationInteractController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local Remotes = require(Voidline.Remotes)
local DroneConfig = require(Voidline.Config.DroneConfig)

local player = Players.LocalPlayer

local StationInteractController = {}

local function addPrompt(part: BasePart, action: string, objectText: string)
	if part:FindFirstChildOfClass("ProximityPrompt") then
		return
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.ObjectText = objectText
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = part
end

function StationInteractController.Init()
	task.spawn(function()
		local map = Workspace:WaitForChild("VoidlineMap", 30)
		if not map then
			return
		end
		for _, plot in map.Plots:GetChildren() do
			local station = plot:FindFirstChild("Station")
			if station then
				local refinery = station:FindFirstChild("Refinery")
				if refinery then
					addPrompt(refinery, "Sell Ore", "Station Refinery")
				end
				local pads = station:FindFirstChild("UpgradePads")
				if pads then
					for _, pad in pads:GetChildren() do
						if pad:IsA("BasePart") then
							addPrompt(pad, "Upgrade", pad.Name)
						end
					end
				end
				local tuner = station:FindFirstChild("LaserTuner")
				if tuner and tuner:IsA("BasePart") then
					addPrompt(tuner, "Cycle Laser Color", "Laser Tuner")
				end
			end
		end
		local monolith = map.Hub:FindFirstChild("VoidlineMonolith")
		if monolith then
			if monolith:FindFirstChild("RebirthPad") then
				addPrompt(monolith.RebirthPad, "Void Rebirth", "Monolith")
			end
			if monolith:FindFirstChild("ForgeAnchor") then
				addPrompt(monolith.ForgeAnchor, "Forge Artifact", "Artifact Forge")
				local turnIn = Instance.new("ProximityPrompt")
				turnIn.Name = "TurnIn"
				turnIn.ActionText = "Turn In Artifact"
				turnIn.ObjectText = "Token Redemption"
				turnIn.HoldDuration = 0
				turnIn.MaxActivationDistance = 14
				turnIn.RequiresLineOfSight = false
				turnIn.Parent = monolith.ForgeAnchor
			end
			if monolith:FindFirstChild("CodeTerminal") then
				addPrompt(monolith.CodeTerminal, "Enter Code", "Voidline Codes")
			end
			if monolith:FindFirstChild("SummonPads") then
				addPrompt(monolith.SummonPads, "Summon Starfall", "Server Summons")
			end
		end
	end)

	ProximityPromptService.PromptTriggered:Connect(function(prompt, triggerPlayer)
		if triggerPlayer ~= player then
			return
		end
		local part = prompt.Parent
		if not part or not part:IsA("BasePart") then
			return
		end
		local name = part.Name
		if name == "Refinery" then
			Remotes.Get("SellOre"):FireServer()
		elseif part:GetAttribute("UpgradeId") then
			Remotes.Get("RequestUpgrade"):FireServer(part:GetAttribute("UpgradeId"))
		elseif name == "RebirthPad" then
			Remotes.Get("RequestRebirth"):FireServer()
		elseif name == "ForgeAnchor" and prompt.Name == "TurnIn" then
			Remotes.Get("TurnInArtifact"):FireServer()
		elseif name == "ForgeAnchor" then
			Remotes.Get("RequestForge"):FireServer()
		elseif name == "CodeTerminal" then
			-- Simple Studio-friendly cycle of launch codes via attribute index
			local codes = { "VOIDLINE", "KILLSHOT", "LAUNCH" }
			local idx = (part:GetAttribute("CodeIdx") or 0) + 1
			if idx > #codes then
				idx = 1
			end
			part:SetAttribute("CodeIdx", idx)
			Remotes.Get("RedeemCode"):FireServer(codes[idx])
		elseif name == "SummonPads" then
			Remotes.Get("PromptRobuxPurchase"):FireServer("Product", "SummonVoidStarfall")
		elseif name == "LaserTuner" then
			local colors = {}
			for k in DroneConfig.LaserColors do
				table.insert(colors, k)
			end
			table.sort(colors)
			local idx = (part:GetAttribute("ColorIdx") or 0) + 1
			if idx > #colors then
				idx = 1
			end
			part:SetAttribute("ColorIdx", idx)
			Remotes.Get("SetLaserColor"):FireServer(colors[idx])
		elseif name == "VIPLoungePad" then
			Remotes.Get("RedeemDaily"):FireServer()
		end
	end)
end

return StationInteractController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="107">
            <Properties>
              <string name="Name">StoreController</string>
              <string name="Source"><![CDATA[--!strict
-- Dual-currency store. Passes: Robux (Roblox prompt) or Voidline Tokens at a
-- 15-20% discount (two-tap confirm). Server summons: Robux only, with drop
-- odds always shown before the buy button; paid random summons are hidden
-- behind a notice for players whose policy restricts paid random items.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local MonetizationConfig = require(Voidline.Config.MonetizationConfig)

local Client = script.Parent.Parent.Client
local Ui = require(Client.Ui)
local ClientState = require(Client.ClientState)

local StoreController = {}

local CONFIRM_SECONDS = 3

local gui: ScreenGui
local panel: Frame
local list: ScrollingFrame
local tokensLabel: TextLabel
local tabButtons: { [string]: TextButton } = {}
local currentTab = "Passes"
local armed: { Id: string, Until: number }? = nil
local onOpened: (() -> ())? = nil

local function owns(passId: string): boolean
	return ClientState.Store.GamePasses[passId] == true or ClientState.Profile.OwnedPerks[passId] == true
end

local function trialLeft(passId: string): number
	local expires = ClientState.Profile.TrialVouchers[passId]
	return if type(expires) == "number" then expires - os.time() else 0
end

local function row(height: number, order: number): Frame
	local frame = Ui.Make("Frame", {
		Name = "Row" .. order,
		Size = UDim2.new(1, -8, 0, height),
		BackgroundColor3 = Ui.Colors.GlassLight,
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		LayoutOrder = order,
		Parent = list,
	}) :: Frame
	Ui.Corner(frame, 10)
	return frame
end

local function rowText(frame: Frame, title: string, body: string, rightInset: number)
	Ui.Label({
		Name = "Title",
		Position = UDim2.fromOffset(12, 8),
		Size = UDim2.new(1, -(rightInset + 24), 0, 20),
		Text = title,
		Font = Ui.Font.Title,
		TextSize = 16,
		TextColor3 = Ui.Colors.GoldBright,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = frame,
	})
	Ui.Label({
		Name = "Body",
		Position = UDim2.fromOffset(12, 30),
		Size = UDim2.new(1, -(rightInset + 24), 0, 34),
		Text = body,
		TextSize = 13,
		TextColor3 = Ui.Colors.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = frame,
	})
end

local function buyTokens(passId: string, button: TextButton, price: number)
	local now = os.clock()
	local current = armed
	if current and current.Id == passId and now < current.Until then
		armed = nil
		ClientState.Fire("PurchaseWithTokens", passId)
		button.Text = "…"
		return
	end
	armed = { Id = passId, Until = now + CONFIRM_SECONDS }
	button.Text = ("CONFIRM ⬡%d"):format(price)
	task.delay(CONFIRM_SECONDS, function()
		if armed == nil or armed.Id ~= passId or os.clock() >= armed.Until then
			if button.Parent then
				button.Text = ("⬡ %d"):format(price)
			end
		end
	end)
end

local function renderPasses()
	local tokens = ClientState.Profile.VoidlineTokens
	for i, pass in MonetizationConfig.Passes do
		local frame = row(76, i)
		rowText(frame, pass.Name, pass.Blurb, 232)
		local buttons = Ui.Make("Frame", {
			Name = "Buttons",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(222, Ui.TOUCH),
			BackgroundTransparency = 1,
			Parent = frame,
		})
		Ui.List(buttons, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Right)
		if owns(pass.Id) then
			Ui.Label({
				Name = "Owned",
				Size = UDim2.fromOffset(110, Ui.TOUCH),
				Text = "OWNED",
				Font = Ui.Font.Title,
				TextSize = 16,
				TextColor3 = Ui.Colors.Good,
				Parent = buttons,
			})
			continue
		end
		local trial = trialLeft(pass.Id)
		if trial > 0 then
			Ui.Label({
				Name = "Trial",
				Size = UDim2.fromOffset(70, Ui.TOUCH),
				Text = ("TRIAL %dh"):format(math.ceil(trial / 3600)),
				Font = Ui.Font.Bold,
				TextSize = 12,
				TextColor3 = Ui.Colors.Cyan,
				LayoutOrder = 0,
				Parent = buttons,
			})
		end
		if pass.GamePassId ~= 0 then
			Ui.Button({
				Name = "Robux",
				Size = UDim2.fromOffset(100, Ui.TOUCH),
				Text = ("R$ %d"):format(pass.Robux),
				LayoutOrder = 1,
				Parent = buttons,
			}, function()
				ClientState.Fire("PromptRobuxPurchase", "Pass", pass.Id)
			end)
		end
		local tokenButton = Ui.Button({
			Name = "Tokens",
			Size = UDim2.fromOffset(110, Ui.TOUCH),
			Text = ("⬡ %d"):format(pass.Tokens),
			TextColor3 = if tokens >= pass.Tokens then Ui.Colors.Cyan else Ui.Colors.Muted,
			LayoutOrder = 2,
			Parent = buttons,
		})
		tokenButton.Activated:Connect(function()
			buyTokens(pass.Id, tokenButton, pass.Tokens)
		end)
	end
end

local function queueText(productId: string): string
	local attr = if productId == "SummonVoidStarfall" then "StarfallQueue" else "SurgeQueue"
	local queued = Workspace:GetAttribute(attr)
	if type(queued) == "number" and queued > 0 then
		return ("%d queued · each runs after the last"):format(queued)
	end
	return "Starts right away if nothing is queued"
end

local function renderSummons()
	local restricted = ClientState.Store.PaidRandomRestricted
	for i, product in MonetizationConfig.DevProducts do
		local odds: { { Label: string, Chance: number } } = {}
		if product.RandomOutcome then
			odds = MonetizationConfig.StarfallOdds()
		end
		local height = 84 + #odds * 18
		local frame = row(height, i)
		rowText(frame, product.Name, product.Blurb, 132)
		if #odds > 0 then
			local oddsBox = Ui.Make("Frame", {
				Name = "Odds",
				Position = UDim2.fromOffset(12, 62),
				Size = UDim2.new(1, -156, 0, #odds * 18),
				BackgroundTransparency = 1,
				Parent = frame,
			})
			Ui.List(oddsBox, Enum.FillDirection.Vertical, 0, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Top)
			for j, entry in ipairs(odds) do
				Ui.Label({
					Name = "Odd" .. j,
					Size = UDim2.new(1, 0, 0, 18),
					Text = ("%s%% · %s"):format(
						if entry.Chance >= 1 then "100" else ("%.1f"):format(entry.Chance * 100),
						entry.Label
					),
					TextSize = 12,
					TextColor3 = Ui.Colors.Text,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
					LayoutOrder = j,
					Parent = oddsBox,
				})
			end
		end
		Ui.Label({
			Name = "Queue",
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -12, 1, -6),
			Size = UDim2.fromOffset(240, 16),
			Text = queueText(product.Id),
			TextSize = 11,
			TextColor3 = Ui.Colors.Muted,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = frame,
		})
		local blocked = product.RandomOutcome and restricted
		if blocked then
			Ui.Label({
				Name = "Restricted",
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -10, 0, 10),
				Size = UDim2.fromOffset(120, Ui.TOUCH),
				Text = "Not available in your region",
				TextSize = 12,
				TextColor3 = Ui.Colors.Muted,
				Parent = frame,
			})
		elseif product.ProductId == 0 then
			Ui.Label({
				Name = "Soon",
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -10, 0, 10),
				Size = UDim2.fromOffset(120, Ui.TOUCH),
				Text = "Coming soon",
				TextSize = 13,
				TextColor3 = Ui.Colors.Muted,
				Parent = frame,
			})
		else
			Ui.Button({
				Name = "Robux",
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -10, 0, 10),
				Size = UDim2.fromOffset(110, Ui.TOUCH),
				Text = ("R$ %d"):format(product.Robux),
				Parent = frame,
			}, function()
				ClientState.Fire("PromptRobuxPurchase", "Product", product.Id)
			end)
		end
	end
end

local function render()
	if not gui.Enabled then
		return
	end
	Ui.ClearChildren(list)
	tokensLabel.Text = ("⬡ %s Tokens · earned at the Artifact Forge, never sold or traded"):format(
		Ui.Compact(ClientState.Profile.VoidlineTokens)
	)
	for name, button in tabButtons do
		button.BackgroundColor3 = if name == currentTab then Ui.Colors.Gold else Ui.Colors.GlassLight
		button.TextColor3 = if name == currentTab then Ui.Colors.Shadow else Ui.Colors.Text
	end
	if currentTab == "Passes" then
		renderPasses()
	else
		renderSummons()
	end
end

function StoreController.Open(tab: string?)
	if tab then
		currentTab = tab
	end
	gui.Enabled = true
	Ui.Pop(panel, 0.9)
	render()
	if onOpened then
		onOpened()
	end
end

function StoreController.Close()
	gui.Enabled = false
	armed = nil
end

function StoreController.Toggle()
	if gui.Enabled then
		StoreController.Close()
	else
		StoreController.Open(nil)
	end
end

function StoreController.IsOpen(): boolean
	return gui.Enabled
end

function StoreController.OnOpened(callback: () -> ())
	onOpened = callback
end

function StoreController.Init()
	gui = Ui.Screen("VoidlineStore", 20)
	gui.Enabled = false
	panel = Ui.Glass({
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.92, 0.82),
		Parent = gui,
	})
	Ui.Make("UISizeConstraint", { MaxSize = Vector2.new(680, 520), Parent = panel })
	Ui.Label({
		Name = "Title",
		Position = UDim2.fromOffset(18, 10),
		Size = UDim2.new(1, -90, 0, 30),
		Text = "VOIDLINE STORE",
		Font = Ui.Font.Title,
		TextSize = 22,
		TextColor3 = Ui.Colors.GoldBright,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = panel,
	})
	Ui.Button({
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 8),
		Size = UDim2.fromOffset(Ui.TOUCH, Ui.TOUCH),
		Text = "✕",
		TextSize = 20,
		Parent = panel,
	}, StoreController.Close)
	tokensLabel = Ui.Label({
		Name = "Tokens",
		Position = UDim2.fromOffset(18, 42),
		Size = UDim2.new(1, -36, 0, 18),
		TextSize = 12,
		TextColor3 = Ui.Colors.Cyan,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = panel,
	})
	local tabs = Ui.Make("Frame", {
		Name = "Tabs",
		Position = UDim2.fromOffset(14, 64),
		Size = UDim2.new(1, -28, 0, Ui.TOUCH),
		BackgroundTransparency = 1,
		Parent = panel,
	})
	Ui.List(tabs, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Left)
	for i, name in { "Passes", "Summons" } do
		tabButtons[name] = Ui.Button({
			Name = name,
			Size = UDim2.fromOffset(140, Ui.TOUCH),
			Text = string.upper(name),
			LayoutOrder = i,
			Parent = tabs,
		}, function()
			currentTab = name
			render()
		end)
	end
	list = Ui.Make("ScrollingFrame", {
		Name = "List",
		Position = UDim2.fromOffset(14, 120),
		Size = UDim2.new(1, -28, 1, -132),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = panel,
	})
	Ui.List(list, Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Top)

	ClientState.OnChanged(function(changed)
		if changed.Store or changed.VoidlineTokens or changed.OwnedPerks or changed.TrialVouchers then
			render()
		end
	end)
	Workspace:GetAttributeChangedSignal("StarfallQueue"):Connect(render)
	Workspace:GetAttributeChangedSignal("SurgeQueue"):Connect(render)
end

return StoreController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="108">
            <Properties>
              <string name="Name">ThrusterCosmeticController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local ThrusterCosmeticController = {}

local function attachPack(character: Model)
	if character:FindFirstChild("VoidlineThrusterPack") then
		return
	end
	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	if not torso then
		return
	end
	local pack = Instance.new("Part")
	pack.Name = "VoidlineThrusterPack"
	pack.Size = Vector3.new(1.4, 1.8, 0.6)
	pack.Color = Color3.fromRGB(12, 12, 18)
	pack.Material = Enum.Material.Metal
	pack.CanCollide = false
	pack.Massless = true
	pack.Parent = character
	local weld = Instance.new("Weld")
	weld.Part0 = torso
	weld.Part1 = pack
	weld.C0 = CFrame.new(0, 0.2, 0.75)
	weld.Parent = pack
	local glow = Instance.new("Part")
	glow.Name = "GoldTrim"
	glow.Size = Vector3.new(1.5, 0.2, 0.65)
	glow.Color = Color3.fromRGB(232, 186, 74)
	glow.Material = Enum.Material.Neon
	glow.CanCollide = false
	glow.Massless = true
	glow.Parent = character
	local weld2 = Instance.new("Weld")
	weld2.Part0 = pack
	weld2.Part1 = glow
	weld2.Parent = glow
end

function ThrusterCosmeticController.Init()
	local function onChar(char)
		task.wait(0.2)
		attachPack(char)
	end
	if player.Character then
		onChar(player.Character)
	end
	player.CharacterAdded:Connect(onChar)

	RunService.RenderStepped:Connect(function()
		local char = player.Character
		if not char then
			return
		end
		local pack = char:FindFirstChild("VoidlineThrusterPack")
		local trim = char:FindFirstChild("GoldTrim")
		local hide = player:GetAttribute("HideJetpack") == true
		if pack and pack:IsA("BasePart") then
			pack.Transparency = if hide then 1 else 0
		end
		if trim and trim:IsA("BasePart") then
			trim.Transparency = if hide then 1 else 0
		end
	end)
end

return ThrusterCosmeticController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="109">
            <Properties>
              <string name="Name">TowController</string>
              <string name="Source"><![CDATA[--!strict
-- Gravity-Tether tows: the server writes a timeline (start, duration, from,
-- to) on the towed part; every client flies the part along the same arc
-- locally. The server never moves it, so nothing here can affect payouts.
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local TowController = {}

export type Tow = {
	Part: BasePart,
	Owner: number,
	From: Vector3,
	To: Vector3,
	Start: number,
	Duration: number,
	Position: Vector3,
	Alpha: number,
	Spin: number,
}

local TAG = "VoidRock"

local tows: { [BasePart]: Tow } = {}
local byOwner: { [number]: { Tow } } = {}
local arrivalCallbacks: { (Tow) -> () } = {}

local function readTow(part: BasePart): Tow?
	local start = part:GetAttribute("TowStart")
	local duration = part:GetAttribute("TowDuration")
	local from = part:GetAttribute("TowFrom")
	local to = part:GetAttribute("TowTo")
	local owner = part:GetAttribute("TowOwner")
	if
		type(start) ~= "number"
		or type(duration) ~= "number"
		or typeof(from) ~= "Vector3"
		or typeof(to) ~= "Vector3"
		or type(owner) ~= "number"
	then
		return nil
	end
	return {
		Part = part,
		Owner = owner,
		From = from :: Vector3,
		To = to :: Vector3,
		Start = start,
		Duration = math.max(0.1, duration),
		Position = from :: Vector3,
		Alpha = 0,
		Spin = (part:GetAttribute("RockId") or 0) :: number,
	}
end

local function refresh(part: BasePart)
	local tow = readTow(part)
	if tow then
		tows[part] = tow
	else
		tows[part] = nil
	end
end

local function watch(instance: Instance)
	if not instance:IsA("BasePart") then
		return
	end
	local part = instance :: BasePart
	part:GetAttributeChangedSignal("TowStart"):Connect(function()
		refresh(part)
	end)
	refresh(part)
end

-- Quadratic arc lifted above the straight line so tows read as "towed".
function TowController.Curve(from: Vector3, to: Vector3, alpha: number): Vector3
	local lift = math.min(18, (to - from).Magnitude * 0.25 + 4)
	local mid = (from + to) / 2 + Vector3.new(0, lift, 0)
	local a = from:Lerp(mid, alpha)
	local b = mid:Lerp(to, alpha)
	return a:Lerp(b, alpha)
end

function TowController.ForUser(userId: number): { Tow }
	return byOwner[userId] or {}
end

function TowController.OnArrive(callback: (Tow) -> ())
	table.insert(arrivalCallbacks, callback)
end

local function step()
	local now = Workspace:GetServerTimeNow()
	table.clear(byOwner)
	local parts: { BasePart } = {}
	local cframes: { CFrame } = {}
	for part, tow in tows do
		if not part.Parent then
			tows[part] = nil
			continue
		end
		local alpha = math.clamp((now - tow.Start) / tow.Duration, 0, 1)
		if alpha >= 1 and tow.Alpha < 1 then
			for _, callback in arrivalCallbacks do
				task.spawn(callback, tow)
			end
		end
		tow.Alpha = alpha
		local eased = alpha * alpha * (3 - 2 * alpha)
		tow.Position = TowController.Curve(tow.From, tow.To, eased)
		local list = byOwner[tow.Owner]
		if not list then
			list = {}
			byOwner[tow.Owner] = list
		end
		table.insert(list, tow)
		table.insert(parts, part)
		local spin = now * 1.5 + tow.Spin
		table.insert(cframes, CFrame.new(tow.Position) * CFrame.Angles(spin, spin * 0.7, 0))
	end
	if #parts > 0 then
		Workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

function TowController.Init()
	CollectionService:GetInstanceAddedSignal(TAG):Connect(watch)
	for _, part in CollectionService:GetTagged(TAG) do
		watch(part)
	end
	RunService.RenderStepped:Connect(step)
end

return TowController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="110">
            <Properties>
              <string name="Name">VFXController</string>
              <string name="Source"><![CDATA[--!strict
-- Pooled one-shot visuals: floating reward popups (world or screen), the
-- Energy Bridge ignition sweep, pad/grinder flashes and screen flashes.
-- Nothing is created per frame; popups come from a fixed-size pool.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local PlotLayout = require(Voidline.Modules.PlotLayout)

local Client = script.Parent.Parent.Client
local Ui = require(Client.Ui)
local CameraController = require(script.Parent.CameraController)

local VFXController = {}

local WORLD_POOL = 12
local SCREEN_POOL = 6
local POPUP_SECONDS = 1.1
local SWEEP_STEP = 0.07

type WorldPopup = { Anchor: Part, Gui: BillboardGui, Label: TextLabel }
type ScreenPopup = { Label: TextLabel }

local player = Players.LocalPlayer
local folder: Folder
local screenGui: ScreenGui
local flashFrame: Frame
local worldPool: { WorldPopup } = {}
local screenPool: { ScreenPopup } = {}
local worldNext = 1
local screenNext = 1
local clipHidden = false
local perfMode = false
local flashGui: ScreenGui

local function plotFolder(): Instance?
	local index = player:GetAttribute("PlotIndex")
	if type(index) ~= "number" then
		return nil
	end
	local map = Workspace:FindFirstChild("VoidlineMap")
	local plots = map and map:FindFirstChild("Plots")
	return plots and plots:FindFirstChild("Plot_" .. index)
end

function VFXController.OwnPlotWorld(localOffset: Vector3): Vector3?
	local index = player:GetAttribute("PlotIndex")
	if type(index) ~= "number" then
		return nil
	end
	return PlotLayout.World(index, localOffset)
end

local function makeWorldPopup(): WorldPopup
	local anchor = Ui.Make("Part", {
		Name = "PopupAnchor",
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		Transparency = 1,
		Size = Vector3.new(0.2, 0.2, 0.2),
		CFrame = CFrame.new(0, -500, 0),
		Parent = folder,
	}) :: Part
	local gui = Ui.Make("BillboardGui", {
		Name = "Popup",
		Size = UDim2.fromOffset(220, 44),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = 160,
		Enabled = false,
		Parent = anchor,
	}) :: BillboardGui
	local label = Ui.Label({
		Name = "Text",
		Size = UDim2.fromScale(1, 1),
		Font = Ui.Font.Title,
		TextSize = 24,
		TextStrokeTransparency = 0.4,
		Parent = gui,
	})
	return { Anchor = anchor, Gui = gui, Label = label }
end

local function makeScreenPopup(): ScreenPopup
	local label = Ui.Label({
		Name = "Popup",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 54),
		Size = UDim2.fromOffset(260, 30),
		Font = Ui.Font.Title,
		TextSize = 22,
		TextStrokeTransparency = 0.4,
		Visible = false,
		Parent = screenGui,
	})
	return { Label = label }
end

-- Floating text. With a position it rises in the world, otherwise under the
-- top pill.
function VFXController.SetClipHidden(on: boolean)
	clipHidden = on
	if screenGui then
		screenGui.Enabled = not on
	end
	if flashGui then
		flashGui.Enabled = not on
	end
end

function VFXController.SetPerfMode(on: boolean)
	perfMode = on
end

function VFXController.Popup(text: string, color: Color3?, position: Vector3?)
	if clipHidden then
		return
	end
	if position then
		local popup = worldPool[worldNext]
		worldNext = worldNext % WORLD_POOL + 1
		popup.Anchor.CFrame = CFrame.new(position)
		popup.Gui.StudsOffset = Vector3.new(0, 2, 0)
		popup.Gui.Enabled = true
		popup.Label.Text = text
		popup.Label.TextColor3 = color or Ui.Colors.GoldBright
		popup.Label.TextTransparency = 0
		Ui.Tween(popup.Gui, POPUP_SECONDS, { StudsOffset = Vector3.new(0, 6, 0) })
		Ui.Tween(popup.Label, POPUP_SECONDS, { TextTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		return
	end
	local popup = screenPool[screenNext]
	screenNext = screenNext % SCREEN_POOL + 1
	popup.Label.Text = text
	popup.Label.TextColor3 = color or Ui.Colors.GoldBright
	popup.Label.TextTransparency = 0
	popup.Label.Position = UDim2.new(0.5, 0, 0, 92)
	popup.Label.Visible = true
	Ui.Tween(popup.Label, POPUP_SECONDS, { Position = UDim2.new(0.5, 0, 0, 52), TextTransparency = 1 })
end

function VFXController.ScreenFlash(color: Color3?, seconds: number?)
	if clipHidden or perfMode or Ui.ReducedMotion then
		return
	end
	flashFrame.BackgroundColor3 = color or Color3.new(1, 1, 1)
	flashFrame.BackgroundTransparency = 0.35
	flashFrame.Visible = true
	Ui.Tween(flashFrame, seconds or 0.45, { BackgroundTransparency = 1 })
end

-- Segment-by-segment ignition from the plot to the hub.
function VFXController.BridgeSweep()
	local plot = plotFolder()
	local bridge = plot and plot:FindFirstChild("EnergyBridge")
	if not bridge then
		return
	end
	local segments: { BasePart } = {}
	for _, child in bridge:GetChildren() do
		if child:IsA("BasePart") then
			table.insert(segments, child)
		end
	end
	table.sort(segments, function(a, b)
		local ai = tonumber(a:GetAttribute("SegmentIndex")) or 0
		local bi = tonumber(b:GetAttribute("SegmentIndex")) or 0
		return ai < bi
	end)
	for i, segment in segments do
		segment.Transparency = 0.85
		task.delay(Ui.Motion(i * SWEEP_STEP), function()
			segment.Color = Color3.new(1, 1, 1)
			Ui.Tween(segment, 0.35, { Transparency = 0.15, Color = Ui.Colors.Gold })
		end)
	end
	CameraController.Punch(7, 1.4)
	CameraController.Shake(0.45, 0.5)
	VFXController.ScreenFlash(Ui.Colors.GoldBright, 0.6)
end

function VFXController.PadFlash(upgradeId: string)
	local plot = plotFolder()
	local station = plot and plot:FindFirstChild("Station")
	local pads = station and station:FindFirstChild("UpgradePads")
	local pad = pads and pads:FindFirstChild(upgradeId)
	if pad and pad:IsA("BasePart") then
		pad.Color = Color3.new(1, 1, 1)
		Ui.Tween(pad, 0.4, { Color = Ui.Colors.Gold })
	end
end

function VFXController.GrinderPulse()
	local plot = plotFolder()
	local station = plot and plot:FindFirstChild("Station")
	local grinder = station and station:FindFirstChild("GrinderCore")
	local glow = grinder and grinder:FindFirstChild("GrinderGlow")
	if glow and glow:IsA("BasePart") then
		glow.Size = Vector3.new(5.5, 5.5, 5.5)
		Ui.Tween(glow, 0.35, { Size = Vector3.new(4, 4, 4) }, Enum.EasingStyle.Back)
	end
end

function VFXController.Init()
	folder = Ui.Make("Folder", { Name = "VoidlineVFX", Parent = Workspace })
	screenGui = Ui.Screen("VoidlineVFX", 8)
	flashGui = Ui.Screen("VoidlineFlash", 30)
	flashGui.IgnoreGuiInset = true
	flashGui.ScreenInsets = Enum.ScreenInsets.None
	flashFrame = Ui.Make("Frame", {
		Name = "Flash",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Visible = false,
		Parent = flashGui,
	})
	for _ = 1, WORLD_POOL do
		table.insert(worldPool, makeWorldPopup())
	end
	for _ = 1, SCREEN_POOL do
		table.insert(screenPool, makeScreenPopup())
	end
end

return VFXController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="111">
            <Properties>
              <string name="Name">WorldController</string>
              <string name="Source"><![CDATA[--!strict
-- Client-side world presentation driven by replicated Workspace attributes:
-- anomaly sky/lighting profiles, the Monolith split (halves part, the Void
-- Core is exposed), world-event tints, hazard telegraphs and the calm aura
-- at the star overlook. Gravity changes come from the server.
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local BiomeRegistry = require(Voidline.Content.BiomeRegistry)
local WorldEventRegistry = require(Voidline.Content.WorldEventRegistry)

local Client = script.Parent.Parent.Client
local Ui = require(Client.Ui)
local CameraController = require(script.Parent.CameraController)

local WorldController = {}

local SPLIT_DISTANCE = 6
local SPLIT_TILT = math.rad(6)
local SPLIT_SECONDS = 2.4
local GRADE_SECONDS = 3
local HAZARD_POOL = 4
local CALM_TINT = Color3.fromRGB(255, 244, 228)
local HAZARD_IMPULSE = 38

local player = Players.LocalPlayer
local atmosphere: Atmosphere
local grade: ColorCorrectionEffect
local bloom: BloomEffect
local hazardParts: { Part } = {}
local hazardNext = 1
local perfMode = false

local BASE = {
	Ambient = Lighting.Ambient,
	Tint = Color3.new(1, 1, 1),
	AtmosphereColor = Color3.fromRGB(70, 50, 120),
	AtmosphereDecay = Color3.fromRGB(30, 20, 60),
	Density = 0.25,
	Haze = 1,
	Glare = 0,
	Bloom = 0.6,
	Saturation = 0.05,
	Contrast = 0.05,
}

local function ensureEffects()
	atmosphere = Lighting:FindFirstChild("VoidlineAtmosphere") :: Atmosphere?
		or Ui.Make("Atmosphere", { Name = "VoidlineAtmosphere", Parent = Lighting })
	grade = Lighting:FindFirstChild("VoidlineGrade") :: ColorCorrectionEffect?
		or Ui.Make("ColorCorrectionEffect", { Name = "VoidlineGrade", Parent = Lighting })
	bloom = Lighting:FindFirstChild("VoidlineBloom") :: BloomEffect?
		or Ui.Make("BloomEffect", { Name = "VoidlineBloom", Threshold = 0.9, Size = 24, Parent = Lighting })
end

local function currentBiome(): BiomeRegistry.Biome?
	local id = Workspace:GetAttribute("AnomalyId")
	return if type(id) == "string" then BiomeRegistry.ById[id] else nil
end

local function currentEvent(): any
	local id = Workspace:GetAttribute("EventId")
	return if type(id) == "string" and id ~= "" then WorldEventRegistry.ById[id] else nil
end

-- Blends anomaly sky + event colour + calm aura into one lighting target.
local function applyGrade()
	local biome = currentBiome()
	local sky = if biome then biome.Sky else nil
	local tint = if sky then sky.Tint else BASE.Tint
	local event = currentEvent()
	if event then
		tint = tint:Lerp(event.Color, 0.2)
	end
	local calm = player:GetAttribute("CalmAura") == true
	if calm then
		tint = tint:Lerp(CALM_TINT, 0.6)
	end
	Ui.Tween(Lighting, GRADE_SECONDS, { Ambient = if sky then sky.Ambient else BASE.Ambient })
	Ui.Tween(grade, GRADE_SECONDS, {
		TintColor = tint,
		Saturation = if calm then -0.05 elseif sky then sky.Saturation else BASE.Saturation,
		Contrast = if sky then sky.Contrast else BASE.Contrast,
	})
	Ui.Tween(atmosphere, GRADE_SECONDS, {
		Color = if sky then sky.AtmosphereColor else BASE.AtmosphereColor,
		Decay = if sky then sky.AtmosphereDecay else BASE.AtmosphereDecay,
		Density = if sky then sky.Density else BASE.Density,
		Haze = if sky then sky.Haze else BASE.Haze,
		Glare = if sky then sky.Glare else BASE.Glare,
	})
	local bloomIntensity = if sky then sky.Bloom else BASE.Bloom
	Ui.Tween(bloom, GRADE_SECONDS, { Intensity = if perfMode then bloomIntensity * 0.4 else bloomIntensity })
end

-- Monolith -------------------------------------------------------------------------

local function monolith(): Instance?
	local map = Workspace:FindFirstChild("VoidlineMap")
	local hub = map and map:FindFirstChild("Hub")
	return hub and hub:FindFirstChild("VoidlineMonolith")
end

local function applySplit(split: boolean)
	local root = monolith()
	if not root then
		return
	end
	for _, half in root:GetChildren() do
		if not half:IsA("BasePart") then
			continue
		end
		local home = half:GetAttribute("HomeCFrame")
		local side = half:GetAttribute("Side")
		if typeof(home) ~= "CFrame" or type(side) ~= "number" then
			continue
		end
		local homeCFrame = home :: CFrame
		local base = homeCFrame * CFrame.new(0, -half.Size.Y / 2, 0)
		local target = if split
			then base * CFrame.new(side * SPLIT_DISTANCE, 0, 0) * CFrame.Angles(0, 0, -side * SPLIT_TILT) * CFrame.new(
				0,
				half.Size.Y / 2,
				0
			)
			else homeCFrame
		Ui.Tween(half, SPLIT_SECONDS, { CFrame = target }, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
		for _, band in half:GetChildren() do
			local offset = band:GetAttribute("Offset")
			if band:IsA("BasePart") and typeof(offset) == "CFrame" then
				Ui.Tween(
					band,
					SPLIT_SECONDS,
					{ CFrame = target * (offset :: CFrame) },
					Enum.EasingStyle.Quint,
					Enum.EasingDirection.InOut
				)
			end
		end
	end
	local core = root:FindFirstChild("VoidCore")
	if core and core:IsA("BasePart") then
		Ui.Tween(core, SPLIT_SECONDS, { Transparency = if split then 0.05 else 1 })
	end
	if split then
		CameraController.Shake(0.6, 1.2)
		CameraController.Punch(6, 1.6)
	end
end

-- Hazards ----------------------------------------------------------------------------

local function hazardPart(): Part
	local part = hazardParts[hazardNext]
	if not part then
		part = Ui.Make("Part", {
			Name = "HazardZone",
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
			Shape = Enum.PartType.Cylinder,
			Material = Enum.Material.Neon,
			Transparency = 1,
			Parent = Workspace,
		})
		hazardParts[hazardNext] = part
	end
	hazardNext = hazardNext % HAZARD_POOL + 1
	return part
end

local function applyImpulse(effect: string, center: Vector3, radius: number)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local offset = root.Position - center
	local flat = Vector3.new(offset.X, 0, offset.Z)
	if flat.Magnitude > radius or flat.Magnitude < 0.5 then
		return
	end
	local away = flat.Unit
	local direction = if effect == "Pull" then -away else away
	root.AssemblyLinearVelocity += direction * HAZARD_IMPULSE + Vector3.new(0, 12, 0)
end

function WorldController.Hazard(payload: { [string]: any })
	local hazard = if type(payload.Id) == "string" then BiomeRegistry.Hazards.ById[payload.Id] else nil
	local position = payload.Position
	if not hazard or typeof(position) ~= "Vector3" then
		return
	end
	local center = position :: Vector3
	local radius = if type(payload.Radius) == "number" then payload.Radius else hazard.Radius
	local seconds = if type(payload.Seconds) == "number" then payload.Seconds else 3
	local part = hazardPart()
	part.Color = hazard.Color
	part.Size = Vector3.new(0.4, radius * 2, radius * 2)
	part.CFrame = CFrame.new(center.X, 1.2, center.Z) * CFrame.Angles(0, 0, math.rad(90))
	if payload.Phase == "telegraph" then
		part.Transparency = 0.9
		Ui.Tween(part, math.max(0.2, seconds), { Transparency = 0.55 }, Enum.EasingStyle.Sine)
	else
		part.Transparency = 0.2
		Ui.Tween(part, math.max(0.3, seconds), { Transparency = 1 })
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root and (root.Position - center).Magnitude <= radius + 20 then
			CameraController.Shake(0.5, 0.35)
		end
		if payload.Effect == "Pull" or payload.Effect == "Knockback" then
			applyImpulse(payload.Effect, center, radius)
		end
	end
end

function WorldController.SetPerfMode(on: boolean)
	perfMode = on
	applyGrade()
end

function WorldController.Init()
	ensureEffects()
	applyGrade()
	applySplit(Workspace:GetAttribute("MonolithSplit") == true)
	Workspace:GetAttributeChangedSignal("AnomalyId"):Connect(applyGrade)
	Workspace:GetAttributeChangedSignal("EventId"):Connect(applyGrade)
	Workspace:GetAttributeChangedSignal("MonolithSplit"):Connect(function()
		applySplit(Workspace:GetAttribute("MonolithSplit") == true)
	end)
	player:GetAttributeChangedSignal("CalmAura"):Connect(applyGrade)
end

return WorldController
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="112">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">60</float>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>