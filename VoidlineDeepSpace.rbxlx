      <Item class="Folder" referent="33">
        <Properties>
          <string name="Name">Security</string>
        </Properties>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">ValidateRemote</string>
            <string name="Source"><![CDATA[local ValidateRemote = {}

function ValidateRemote.AlivePlayer(player: Player?): boolean
	return player ~= nil and player.Parent ~= nil and player.Character ~= nil
end

function ValidateRemote.OwnsPlot(player: Player, plotIndex: number, plotOwners: { [number]: Player }): boolean
	return plotOwners[plotIndex] == player
end

function ValidateRemote.NearPart(player: Player, part: BasePart, maxDistance: number): boolean
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp or not hrp:IsA("BasePart") then
		return false
	end
	return (hrp.Position - part.Position).Magnitude <= maxDistance
end

return ValidateRemote
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="35">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">AfkService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local GameConfig = require(Voidline.Config.GameConfig)
local Remotes = require(Voidline.Remotes)
local DroneService = require(script.Parent.DroneService)

local AfkService = {
	_lastInput = {} :: { [number]: number },
}

function AfkService.Init()
	Remotes.Get("PlayerInput").OnServerEvent:Connect(function(player)
		AfkService._lastInput[player.UserId] = os.clock()
		DroneService.SetAfk(player, false)
	end)

	Players.PlayerAdded:Connect(function(player)
		AfkService._lastInput[player.UserId] = os.clock()
	end)
	Players.PlayerRemoving:Connect(function(player)
		AfkService._lastInput[player.UserId] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(5)
			local now = os.clock()
			for _, player in Players:GetPlayers() do
				local last = AfkService._lastInput[player.UserId] or now
				if now - last >= GameConfig.AfkIdleSeconds then
					DroneService.SetAfk(player, true)
					Remotes.Get("JuiceEvent"):FireClient(player, { Kind = "AfkIdle" })
				end
			end
		end
	end)
end

return AfkService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">CodeService</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local CodesConfig = require(Voidline.Config.CodesConfig)
local Remotes = require(Voidline.Remotes)
local RateLimiter = require(Voidline.Modules.RateLimiter)
local PlayerDataService = require(script.Parent.PlayerDataService)

local CodeService = {
	_limiter = RateLimiter.new(1),
}

function CodeService.Init()
	Remotes.Get("RedeemCode").OnServerEvent:Connect(function(player, code)
		if not CodeService._limiter:Allow(player.UserId) then
			return
		end
		if typeof(code) ~= "string" then
			return
		end
		code = string.upper(string.gsub(code, "%s+", ""))
		local reward = CodesConfig.Codes[code]
		local data = PlayerDataService.Get(player)
		if not reward or not data then
			Remotes.Get("JuiceEvent"):FireClient(player, { Kind = "CodeFail", Message = "Invalid code" })
			return
		end
		if reward.OneTime and data.RedeemedCodes[code] then
			Remotes.Get("JuiceEvent"):FireClient(player, { Kind = "CodeFail", Message = "Already redeemed" })
			return
		end
		PlayerDataService.Mutate(player, function(d)
			d.RedeemedCodes[code] = true
			d.Credits += reward.Credits or 0
			d.VoidShards += reward.VoidShards or 0
		end)
		PlayerDataService.Save(player)
		Remotes.Get("JuiceEvent"):FireClient(player, {
			Kind = "CodeSuccess",
			Message = reward.Message,
			Credits = reward.Credits,
			VoidShards = reward.VoidShards,
		})
	end)
end

return CodeService
]]></string>
          </Properties>
        </Item>
