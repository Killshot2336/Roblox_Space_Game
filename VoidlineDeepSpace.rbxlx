        <Item class="ModuleScript" referent="4">
          <Properties>
            <string name="Name">AudioConfig</string>
            <string name="Source"><![CDATA[-- Central sound placeholders for the audio pass. Leave AssetId as "" until
-- the owner drops real rbxassetid values in from the Creator Dashboard / library.
-- AudioController skips any entry with an empty AssetId (no errors in Studio).
local AudioConfig = {
	MasterVolume = 1,
	Sounds = {
		Mine = { AssetId = "", Volume = 0.35 },
		Sell = { AssetId = "", Volume = 0.55 },
		Upgrade = { AssetId = "", Volume = 0.5 },
		TowArrive = { AssetId = "", Volume = 0.45 },
		BridgeIgnite = { AssetId = "", Volume = 0.7 },
		Starfall = { AssetId = "", Volume = 0.65 },
		Rebirth = { AssetId = "", Volume = 0.6 },
		StoreSuccess = { AssetId = "", Volume = 0.5 },
	},
}

return AudioConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">CodesConfig</string>
            <string name="Source"><![CDATA[--!strict
-- Code Terminal rewards (spec §11). Codes are case/space-insensitive and each
-- can be redeemed once per profile.
export type CodeReward = {
	Credits: number,
	VoidShards: number,
	Title: string?,
	OneTime: boolean,
	Message: string,
}

local CodesConfig = {
	Codes = {
		VOIDLINE = {
			Credits = 250,
			VoidShards = 5,
			Title = "title.code.voidline",
			OneTime = true,
			Message = "Welcome to Voidline.",
		},
		KILLSHOT = {
			Credits = 500,
			VoidShards = 10,
			Title = "title.code.killshot",
			OneTime = true,
			Message = "Created by Killshot2336.",
		},
		LAUNCH = {
			Credits = 1000,
			VoidShards = 15,
			Title = "title.code.launch",
			OneTime = true,
			Message = "Launch week boost unlocked.",
		},
	} :: { [string]: CodeReward },
	MaxLength = 20,
}

return CodesConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">DailyConfig</string>
            <string name="Source"><![CDATA[--!strict
-- 7-day login streak (spec §12). The cycle restarts after day 7 so the 24 h
-- pass trial voucher stays a weekly treat rather than a permanent free pass.
local DailyConfig = {}

export type DayReward = {
	Credits: number,
	VoidShards: number,
	TrialPerk: string?,
	TrialHours: number?,
}

DailyConfig.CycleLength = 7

DailyConfig.Rewards = {
	[1] = { Credits = 50, VoidShards = 0 },
	[2] = { Credits = 75, VoidShards = 2 },
	[3] = { Credits = 100, VoidShards = 3 },
	[4] = { Credits = 150, VoidShards = 4 },
	[5] = { Credits = 200, VoidShards = 5 },
	[6] = { Credits = 300, VoidShards = 8 },
	[7] = { Credits = 500, VoidShards = 10, TrialPerk = "Credits2x", TrialHours = 24 },
} :: { [number]: DayReward }

return DailyConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">DroneConfig</string>
            <string name="Source"><![CDATA[--!strict
local DroneConfig = {
	StarterSlots = 1,
	MaxBaseSlots = 6,
	Formations = {
		[1] = "Scatter",
		[2] = "OrbitalBeamLink",
		[3] = "SovereignHalo",
	},
	FormationLabels = {
		[1] = "SCATTER",
		[2] = "ORBITAL BEAM-LINK",
		[3] = "SOVEREIGN HALO",
	},
	-- Scatter splits drones over up to 3 rocks; Beam-Link focuses one rock
	-- harder (+10% more per linked squadmate); Halo escorts the pilot and only
	-- chips at rocks close to them, trading income for presence.
	FormationStats = {
		[1] = { DamageMult = 1.0, MaxTargets = 3 },
		[2] = { DamageMult = 1.35, MaxTargets = 1, SquadLinkBonus = 0.10 },
		[3] = { DamageMult = 0.5, MaxTargets = 1, EscortRange = 30 },
	},
	IdleOrbitRadius = 8,
	MineRange = 42,
	TowSpeed = 28,
	-- Hauler branch and Warp Pass shorten tows.
	TowMinSeconds = 0.9,
	TowMaxSeconds = 4.5,
	BaseDamagePerSecond = 8,
	DamagePerDrillLevel = 4,
	-- Each drone evolution stage adds 12% laser damage.
	DamagePerDroneTier = 0.12,
	LaserOverclockMult = 1.35,
	-- Server mining simulation rate (Hz). Clients interpolate visuals.
	SimHz = 5,
	-- Hard cap on rendered drones per pilot (6 base + 3 + 5 passes).
	MaxDrones = 14,
	-- Stage 6 is the branch point of the evolution tree.
	BranchStage = 6,
	Branches = {
		Miner = { Label = "Miner", DamageMult = 1.2, TowMult = 1.0, OreMult = 1.0 },
		Hauler = { Label = "Hauler", DamageMult = 1.0, TowMult = 1.5, OreMult = 1.15 },
		Swarm = { Label = "Swarm", DamageMult = 0.95, TowMult = 1.1, OreMult = 1.0, ExtraDronesPerStages = 3 },
	},
	BranchOrder = { "Miner", "Hauler", "Swarm" },
	LaserColors = {
		Gold = Color3.fromRGB(255, 210, 90),
		Cyan = Color3.fromRGB(90, 220, 255),
		Void = Color3.fromRGB(170, 110, 255),
		Crimson = Color3.fromRGB(255, 90, 110),
		Emerald = Color3.fromRGB(90, 255, 160),
	},
	LaserColorOrder = { "Gold", "Cyan", "Void", "Crimson", "Emerald" },
	DefaultLaserColor = "Gold",
}

return DroneConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">EconomyConfig</string>
            <string name="Source"><![CDATA[--!strict
local EconomyConfig = {}

-- Spec §4: starter cargo 10 ore, first sell 30 credits (10 x 3).
EconomyConfig.StarterCargoCapacity = 10
EconomyConfig.StarterOrePerAsteroid = 10
EconomyConfig.FirstSellCredits = 30
EconomyConfig.CreditsPerOreBase = 3

-- How close (studs, beyond the pad's half-size) a pilot must be to their own
-- Station Refinery to sell by hand. Auto-Sell Warp Link skips this.
EconomyConfig.SellRange = 18

-- Spec §4 first upgrades: +Drill 20, +Cargo 35, +2nd Drone 50.
EconomyConfig.StarterUpgrades = {
	{ Id = "Drill", Label = "+Drill Power", Cost = 20, Stat = "DrillLevel", Amount = 1 },
	{ Id = "Cargo", Label = "+Cargo Capacity", Cost = 35, Stat = "CargoLevel", Amount = 1 },
	{ Id = "Drone2", Label = "+2nd Drone Slot", Cost = 50, Stat = "DroneSlots", Amount = 1 },
}

function EconomyConfig.DrillCost(level: number): number
	return math.floor(20 * (1.55 ^ math.max(0, level - 1)))
end

function EconomyConfig.CargoCost(level: number): number
	return math.floor(35 * (1.55 ^ math.max(0, level - 1)))
end

function EconomyConfig.DroneSlotCost(slots: number): number
	return math.floor(50 * (1.75 ^ math.max(0, slots - 1)))
end

function EconomyConfig.StationTierCost(tier: number): number
	return math.floor(150 * (1.85 ^ math.max(0, tier - 1)))
end

function EconomyConfig.DroneTierCost(tier: number): number
	return math.floor(400 * (2.2 ^ math.max(0, tier - 1)))
end

function EconomyConfig.CargoCapacityForLevel(level: number): number
	return 10 + (level - 1) * 8
end

export type UpgradeDef = {
	Id: string,
	Label: string,
	Stat: string,
	Max: number,
	Cost: (number) -> number,
}

-- Upgrade pads / Quick-Upgrade. `Cost` receives the current stat value.
EconomyConfig.Upgrades = {
	Drill = { Id = "Drill", Label = "+Drill Power", Stat = "DrillLevel", Max = 120, Cost = EconomyConfig.DrillCost },
	Cargo = { Id = "Cargo", Label = "+Cargo Capacity", Stat = "CargoLevel", Max = 120, Cost = EconomyConfig.CargoCost },
	DroneSlot = {
		Id = "DroneSlot",
		Label = "+Drone Slot",
		Stat = "DroneSlots",
		Max = 6,
		Cost = EconomyConfig.DroneSlotCost,
	},
	StationTier = {
		Id = "StationTier",
		Label = "Station Tier",
		Stat = "StationTier",
		Max = 30,
		Cost = EconomyConfig.StationTierCost,
	},
	DroneTier = {
		Id = "DroneTier",
		Label = "Drone Evolution",
		Stat = "DroneTier",
		Max = 12,
		Cost = EconomyConfig.DroneTierCost,
	},
} :: { [string]: UpgradeDef }

-- Order used by Quick-Upgrade (U) and the upgrade pads on each station.
EconomyConfig.UpgradeOrder = { "Drill", "Cargo", "DroneSlot", "StationTier", "DroneTier" }

-- Per-unit ore value by galaxy sector (before ore-variant multipliers).
EconomyConfig.OreValueBySector = {
	Starter = 3,
	Nebula = 8,
	VoidRim = 22,
	Celestial = 55,
}

-- Personal-belt asteroid stats by sector. Starter matches the tutorial pacing:
-- 40 HP at 8 dps = 5 s per rock, 3.3 s after the first Drill upgrade.
EconomyConfig.BeltAsteroid = {
	Starter = { Health = 40, Ore = 10 },
	Nebula = { Health = 140, Ore = 14 },
	VoidRim = { Health = 520, Ore = 20 },
	Celestial = { Health = 1900, Ore = 28 },
}

-- Deep-space shared rocks (soft contest) and how much ore their pool splits.
EconomyConfig.SharedAsteroid = { Health = 5000, OrePool = 80, ShardPool = 6 }

return EconomyConfig
]]></string>
          </Properties>
        </Item>
