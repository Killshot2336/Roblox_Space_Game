end

return CodexService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">DailyStreakService</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local Remotes = require(Voidline.Remotes)
local RateLimiter = require(Voidline.Modules.RateLimiter)
local PlayerDataService = require(script.Parent.PlayerDataService)

-- 7-day streak rewards; day 7 grants 24h trial voucher for Credits2x
local DAY_REWARDS = {
	[1] = { Credits = 50 },
	[2] = { Credits = 75, VoidShards = 2 },
	[3] = { Credits = 100, VoidShards = 3 },
	[4] = { Credits = 150, VoidShards = 4 },
	[5] = { Credits = 200, VoidShards = 5 },
	[6] = { Credits = 300, VoidShards = 8 },
	[7] = { Credits = 500, VoidShards = 10, TrialPerk = "Credits2x", TrialHours = 24 },
}

local DailyStreakService = {
	_limiter = RateLimiter.new(2),
	_claimedToday = {} :: { [number]: boolean },
}

function DailyStreakService.Init()
	Remotes.Get("RedeemDaily").OnServerEvent:Connect(function(player)
		if not DailyStreakService._limiter:Allow(player.UserId) then
			return
		end
		if DailyStreakService._claimedToday[player.UserId] then
			Remotes.Get("JuiceEvent"):FireClient(player, { Kind = "DailyFail", Message = "Already claimed today" })
			return
		end
		local data = PlayerDataService.Get(player)
		if not data then
			return
		end
		local day = math.clamp(data.DailyStreak or 1, 1, 7)
		local reward = DAY_REWARDS[day]
		PlayerDataService.Mutate(player, function(d)
			d.Credits += reward.Credits or 0
			d.VoidShards += reward.VoidShards or 0
			if reward.TrialPerk then
				d.TrialVouchers[reward.TrialPerk] = os.time() + (reward.TrialHours or 24) * 3600
			end
		end)
		DailyStreakService._claimedToday[player.UserId] = true
		PlayerDataService.Save(player)
		Remotes.Get("JuiceEvent"):FireClient(player, {
			Kind = "DailySuccess",
			Day = day,
			Reward = reward,
		})
	end)
end

return DailyStreakService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">DroneService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local DroneConfig = require(Voidline.Config.DroneConfig)
local Remotes = require(Voidline.Remotes)
local PlayerDataService = require(script.Parent.PlayerDataService)
local PlotService = require(script.Parent.PlotService)
local EconomyService = require(script.Parent.EconomyService)

local DroneService = {
	_drones = {} :: { [number]: { Model } },
	_targets = {} :: { [number]: BasePart? },
	_afk = {} :: { [number]: boolean },
	_towing = {} :: { [number]: BasePart? },
}

local function laserColorFor(player: Player): Color3
	local data = PlayerDataService.Get(player)
	local key = (data and data.Settings.LaserColor) or DroneConfig.DefaultLaserColor
	return DroneConfig.LaserColors[key] or DroneConfig.LaserColors.Gold
end

local function makeDrone(player: Player, index: number): Model
	local model = Instance.new("Model")
	model.Name = "VoidlineDrone_" .. index
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Shape = Enum.PartType.Ball
	body.Size = Vector3.new(2.2, 2.2, 2.2)
	body.Material = Enum.Material.Metal
	body.Color = Color3.fromRGB(18, 18, 24)
	body.Anchored = true
	body.CanCollide = false
	body.Parent = model
	local trim = Instance.new("Part")
	trim.Name = "Trim"
	trim.Size = Vector3.new(2.6, 0.3, 2.6)
	trim.Material = Enum.Material.Neon
	trim.Color = Color3.fromRGB(232, 186, 74)
	trim.Anchored = true
	trim.CanCollide = false
	trim.Parent = model
	model.PrimaryPart = body
	model:SetAttribute("OwnerUserId", player.UserId)
	model:SetAttribute("Index", index)
	model.Parent = Workspace:FindFirstChild("VoidlineMap") or Workspace
	return model
end

function DroneService.SyncCount(player: Player)
	local data = PlayerDataService.Get(player)
	if not data then
		return
	end
	local list = DroneService._drones[player.UserId]
	if not list then
		list = {}
		DroneService._drones[player.UserId] = list
	end
	local bonus = 0
	if PlayerDataService.HasPerk(player, "DroneSlots3") then
		bonus += 3
	end
	if PlayerDataService.HasPerk(player, "MegaSwarm5") then
		bonus += 5
	end
	local want = data.DroneSlots + bonus
	while #list < want do
		table.insert(list, makeDrone(player, #list + 1))
	end
	while #list > want do
		local d = table.remove(list)
		if d then
			d:Destroy()
		end
	end
end

local function findNearestAsteroid(player: Player, origin: Vector3): BasePart?
	local plot = PlotService.GetPlayerPlot(player)
	local best: BasePart? = nil
	local bestDist = math.huge
	local function consider(folder: Instance?)
		if not folder then
			return
		end
		for _, child in folder:GetDescendants() do
			if child:IsA("BasePart") and child:GetAttribute("Health") and (child:GetAttribute("Health") :: number) > 0 then
				if child:GetAttribute("Shared") == true then
					-- deep space handled separately preference when formation beam-link
				end
				local dist = (child.Position - origin).Magnitude
				if dist < bestDist and dist <= DroneConfig.MineRange * 3 then
					best = child
					bestDist = dist
				end
			end
		end
	end
	if plot then
		consider(plot:FindFirstChild("PersonalBelt"))
	end
	local map = Workspace:FindFirstChild("VoidlineMap")
	local deep = map and map:FindFirstChild("DeepSpace")
	consider(deep and deep:FindFirstChild("RareAsteroidSpawns"))
	consider(deep and deep:FindFirstChild("EventMeteors"))
	return best
end

function DroneService.SetAfk(player: Player, isAfk: boolean)
	DroneService._afk[player.UserId] = isAfk
end

function DroneService.Init()
	Remotes.Get("SetFormation").OnServerEvent:Connect(function(player, formation)
		if typeof(formation) ~= "number" then
			return
		end
		formation = math.clamp(math.floor(formation), 1, 3)
		PlayerDataService.Mutate(player, function(d)
			d.Formation = formation
		end)
	end)

	Remotes.Get("SetLaserColor").OnServerEvent:Connect(function(player, colorName)
		if typeof(colorName) ~= "string" then
			return
		end
		if not DroneConfig.LaserColors[colorName] then
			return
		end
		PlayerDataService.Mutate(player, function(d)
			d.Settings.LaserColor = colorName
		end)
	end)

	Players.PlayerAdded:Connect(function(player)
		player:GetAttributeChangedSignal("VoidlineDroneSlots"):Connect(function()
			DroneService.SyncCount(player)
		end)
		task.defer(function()
			task.wait(1)
			DroneService.SyncCount(player)
		end)
	end)

	Players.PlayerRemoving:Connect(function(player)
		local list = DroneService._drones[player.UserId]
		if list then
			for _, d in list do
				d:Destroy()
			end
		end
		DroneService._drones[player.UserId] = nil
		DroneService._targets[player.UserId] = nil
		DroneService._afk[player.UserId] = nil
	end)

	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.1 then
			return
		end
		local step = acc
		acc = 0
		for _, player in Players:GetPlayers() do
			if DroneService._afk[player.UserId] then
				local data = PlayerDataService.Get(player)
				local char = player.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				local list = DroneService._drones[player.UserId]
				if data and hrp and list then
					for i, drone in list do
						local angle = os.clock() + i
						local pos = hrp.Position
							+ Vector3.new(math.cos(angle) * DroneConfig.IdleOrbitRadius, 3, math.sin(angle) * DroneConfig.IdleOrbitRadius)
						if drone.PrimaryPart then
							drone:PivotTo(CFrame.new(pos))
						end
					end
				end
			else
				DroneService.SyncCount(player)
				local data = PlayerDataService.Get(player)
				local list = DroneService._drones[player.UserId]
				local char = player.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				if data and list and hrp then
					local formation = data.Formation or 1
					local target = DroneService._targets[player.UserId]
					if not target or not target.Parent or (target:GetAttribute("Health") :: number) <= 0 then
						target = findNearestAsteroid(player, hrp.Position)
						DroneService._targets[player.UserId] = target
						if data.TutorialStep == 1 and target then
							PlayerDataService.Mutate(player, function(d)
								if d.TutorialStep == 1 then
									d.TutorialStep = 2
								end
							end)
							Remotes.Get("TutorialProgress"):FireClient(player, 2)
						end
					end

					local dps = DroneConfig.BaseDamagePerSecond
						+ (data.DrillLevel - 1) * DroneConfig.DamagePerDrillLevel
					if PlayerDataService.HasPerk(player, "LaserOverclock") then
						dps *= 1.35
					end
					if formation == 2 then
						dps *= 1.5
					end
					dps *= #list

					for i, drone in list do
						local body = drone.PrimaryPart
						if body then
							local pos
							if formation == 3 then
								local back = -hrp.CFrame.LookVector
								pos = hrp.Position + back * 4 + Vector3.new((i - (#list + 1) / 2) * 1.6, 3 + i * 0.2, 0)
							elseif target then
								local orbit = (os.clock() * 2 + i) % (math.pi * 2)
								pos = target.Position
									+ Vector3.new(math.cos(orbit) * 6, 4, math.sin(orbit) * 6)
							else
								local angle = os.clock() + i
								pos = hrp.Position
									+ Vector3.new(math.cos(angle) * DroneConfig.IdleOrbitRadius, 3, math.sin(angle) * DroneConfig.IdleOrbitRadius)
							end
							drone:PivotTo(CFrame.new(pos))
							local trim = drone:FindFirstChild("Trim")
							if trim and trim:IsA("BasePart") then
								trim.Color = laserColorFor(player)
								trim.CFrame = body.CFrame
							end
						end
					end

					if target and formation ~= 3 then
						local hp = target:GetAttribute("Health") :: number
						local maxHp = target:GetAttribute("MaxHealth") :: number
						hp = math.max(0, hp - dps * step)
						target:SetAttribute("Health", hp)
						Remotes.Get("JuiceEvent"):FireClient(player, {
							Kind = "Laser",
							Target = target,
							Color = laserColorFor(player),
							Formation = formation,
						})
						if target:GetAttribute("Shared") == true then
							local SoftContestService = require(script.Parent.SoftContestService)
							SoftContestService.AddDamage(target, player, dps * step)
						end
						if hp <= 0 then
							local sector = target:GetAttribute("Sector") or "Starter"
							local oreGain = if sector == "Starter" then 10 else 25
							if target:GetAttribute("Shared") == true then
								local SoftContestService = require(script.Parent.SoftContestService)
								SoftContestService.Resolve(target)
							else
								EconomyService.AddOre(player, oreGain)
								Remotes.Get("JuiceEvent"):FireClient(player, {
									Kind = "Shatter",
									Position = target.Position,
									Ore = oreGain,
								})
								target:SetAttribute("Health", maxHp)
								target.Transparency = 0
								target.CFrame = target.CFrame * CFrame.Angles(0, math.rad(40), 0)
								if PlayerDataService.HasPerk(player, "AutoSellWarpLink") then
									EconomyService.Sell(player)
								end
							end
							DroneService._targets[player.UserId] = nil
						end
					end
				end
			end
		end
	end)
end

return DroneService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local EconomyConfig = require(Voidline.Config.EconomyConfig)
local OreMath = require(Voidline.Modules.OreMath)
local Remotes = require(Voidline.Remotes)
local RateLimiter = require(Voidline.Modules.RateLimiter)
local PlayerDataService = require(script.Parent.PlayerDataService)
local PlotService = require(script.Parent.PlotService)

local EconomyService = {
	_limiter = RateLimiter.new(0.25),
}

local function has2x(player: Player): boolean
	return PlayerDataService.HasPerk(player, "Credits2x")
end

function EconomyService.AddOre(player: Player, amount: number)
	PlayerDataService.Mutate(player, function(data)
		local cap = OreMath.CargoCap(data.CargoLevel)
		data.Ore = math.min(cap, data.Ore + amount)
	end)
end

function EconomyService.Sell(player: Player): boolean
	local data = PlayerDataService.Get(player)
	if not data or data.Ore <= 0 then
		return false
	end
	local sector = "Starter"
	if data.GalaxyFlags.Celestial then
		sector = "Celestial"
	elseif data.GalaxyFlags.VoidRim then
		sector = "VoidRim"
	elseif data.GalaxyFlags.Nebula then
		sector = "Nebula"
	end
	local payout = OreMath.SellValue(data.Ore, sector, data.CreditMult, has2x(player))
	-- First tutorial sell locked to 30 for starter cargo of 10
	if not data.TutorialComplete and data.TutorialStep <= 2 and data.Ore >= 10 then
		payout = EconomyConfig.FirstSellCredits * data.CreditMult
		if has2x(player) then
			payout *= 2
		end
		payout = math.floor(payout)
	end
	PlayerDataService.Mutate(player, function(d)
		d.Credits += payout
		d.Ore = 0
		if d.TutorialStep == 2 then
			d.TutorialStep = 3
		end
	end)
	Remotes.Get("JuiceEvent"):FireClient(player, { Kind = "Sold", Amount = payout })
	Remotes.Get("TutorialProgress"):FireClient(player, PlayerDataService.Get(player).TutorialStep)
	return true
end

function EconomyService.TryUpgrade(player: Player, upgradeId: string): boolean
	local data = PlayerDataService.Get(player)
	if not data then
		return false
	end

	local cost = 0
	local apply: (any) -> () = function() end

	if upgradeId == "Drill" then
		cost = EconomyConfig.DrillCost(data.DrillLevel)
		-- First drill upgrade exact 20
		if data.DrillLevel == 1 then
			cost = 20
		end
		apply = function(d)
			d.DrillLevel += 1
			d.Credits -= cost
			if d.TutorialStep == 3 and d.DrillLevel >= 2 then
				-- stay on step 3 until drone bought; mark drill done via juice only
			end
		end
	elseif upgradeId == "Cargo" then
		cost = EconomyConfig.CargoCost(data.CargoLevel)
		if data.CargoLevel == 1 then
			cost = 35
		end
		apply = function(d)
			d.CargoLevel += 1
			d.Credits -= cost
		end
	elseif upgradeId == "DroneSlot" or upgradeId == "Drone2" then
		cost = EconomyConfig.DroneSlotCost(data.DroneSlots)
		if data.DroneSlots == 1 then
			cost = 50
		end
		apply = function(d)
			d.DroneSlots += 1
			d.Credits -= cost
			if not d.TutorialComplete and d.DroneSlots >= 2 then
				d.TutorialStep = 4
				d.TutorialComplete = true
				d.Credits += 100
			end
		end
	elseif upgradeId == "StationTier" then
		cost = EconomyConfig.StationTierCost(data.StationTier)
		apply = function(d)
			d.StationTier += 1
			d.Credits -= cost
			if d.StationTier >= 3 then
				d.GalaxyFlags.Nebula = true
			end
			if d.StationTier >= 6 and d.DroneTier >= 2 then
				d.GalaxyFlags.VoidRim = true
			end
			if d.StationTier >= 10 then
				d.GalaxyFlags.Celestial = true
			end
			if d.DrillLevel >= 5 then
				d.DroneTier = math.max(d.DroneTier, 2)
			end
		end
	else
		return false
	end

	if data.Credits < cost then
		return false
	end
	PlayerDataService.Mutate(player, apply)
	local after = PlayerDataService.Get(player)
	if after and after.TutorialComplete and after.TutorialStep == 4 then
		PlotService.IgniteBridge(player)
		Remotes.Get("JuiceEvent"):FireClient(player, { Kind = "TutorialComplete", Bonus = 100 })
	end
	Remotes.Get("JuiceEvent"):FireClient(player, { Kind = "Upgrade", Id = upgradeId })
	-- Notify drone service via bindable attribute
	player:SetAttribute("VoidlineDroneSlots", after and after.DroneSlots or 1)
	player:SetAttribute("VoidlineDrillLevel", after and after.DrillLevel or 1)
	return true
end

function EconomyService.Init()
	Remotes.Get("SellOre").OnServerEvent:Connect(function(player)
		if not EconomyService._limiter:Allow(player.UserId) then
			return
		end
		EconomyService.Sell(player)
	end)

	Remotes.Get("RequestUpgrade").OnServerEvent:Connect(function(player, upgradeId)
		if not EconomyService._limiter:Allow(player.UserId) then
			return
		end
		if typeof(upgradeId) ~= "string" then
			return
		end
		EconomyService.TryUpgrade(player, upgradeId)
	end)

	Remotes.Get("QuickUpgrade").OnServerEvent:Connect(function(player)
		if not EconomyService._limiter:Allow(player.UserId) then
			return
		end
		-- Prefer cheapest affordable starter-path upgrade
		local data = PlayerDataService.Get(player)
		if not data then
			return
		end
		local order = { "Drill", "Cargo", "DroneSlot", "StationTier" }
		for _, id in order do
			if EconomyService.TryUpgrade(player, id) then
				return
			end
		end
	end)
end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">ForgeService</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local ForgeConfig = require(Voidline.Config.ForgeConfig)
local Remotes = require(Voidline.Remotes)
local RateLimiter = require(Voidline.Modules.RateLimiter)
local PlayerDataService = require(script.Parent.PlayerDataService)

local ForgeService = {
	_limiter = RateLimiter.new(1),
	_forging = {} :: { [number]: boolean },
}

function ForgeService.Init()
	Remotes.Get("RequestForge").OnServerEvent:Connect(function(player)
		if not ForgeService._limiter:Allow(player.UserId) then
			return
		end
		if ForgeService._forging[player.UserId] then
			return
		end
		local data = PlayerDataService.Get(player)
		if not data or data.VoidShards < ForgeConfig.ShardsPerArtifact then
			return
		end
		local duration = ForgeConfig.ForgeDurationSeconds
		if data.ForgeTokensEarnedToday >= ForgeConfig.DailyTokenSoftCap then
			duration /= ForgeConfig.CoolingMultiplier
			Remotes.Get("JuiceEvent"):FireClient(player, { Kind = "ForgeCooling" })
		end
		ForgeService._forging[player.UserId] = true
		PlayerDataService.Mutate(player, function(d)
			d.VoidShards -= ForgeConfig.ShardsPerArtifact
		end)
		Remotes.Get("JuiceEvent"):FireClient(player, { Kind = "ForgeStart", Duration = duration })
		task.delay(duration, function()
			ForgeService._forging[player.UserId] = false
			PlayerDataService.Mutate(player, function(d)
				d.Artifacts = (d.Artifacts or 0) + 1
			end)
			Remotes.Get("JuiceEvent"):FireClient(player, { Kind = "ForgeComplete" })
			PlayerDataService.Save(player)
		end)
	end)

	Remotes.Get("TurnInArtifact").OnServerEvent:Connect(function(player)
		if not ForgeService._limiter:Allow(player.UserId) then
			return
		end
		local data = PlayerDataService.Get(player)
		if not data or (data.Artifacts or 0) < 1 then
			return
		end
		PlayerDataService.Mutate(player, function(d)
			d.Artifacts -= 1
			d.VoidlineTokens += ForgeConfig.TokensPerArtifact
			d.ForgeTokensEarnedToday += ForgeConfig.TokensPerArtifact
		end)
		PlayerDataService.Save(player)
		Remotes.Get("JuiceEvent"):FireClient(player, {
			Kind = "TokensGranted",
			Amount = ForgeConfig.TokensPerArtifact,
		})
	end)
end

return ForgeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">JuiceService</string>
