        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">ContributionSplit</string>
            <string name="Source"><![CDATA[local SoftContestConfig = require(script.Parent.Parent.Config.SoftContestConfig)

local ContributionSplit = {}

-- damageMap: { [playerUserId]: number }
-- returns { [userId]: shareFraction } that sum to ~1 among qualifiers
function ContributionSplit.Compute(damageMap: { [number]: number }): { [number]: number }
	local total = 0
	for _, dmg in damageMap do
		total += dmg
	end
	if total <= 0 then
		return {}
	end

	local qualifiers: { [number]: number } = {}
	local topId: number? = nil
	local topDmg = -1
	for userId, dmg in damageMap do
		local pct = dmg / total
		if pct >= SoftContestConfig.MinDamagePercent then
			qualifiers[userId] = dmg
			if dmg > topDmg then
				topDmg = dmg
				topId = userId
			end
		end
	end

	local shares: { [number]: number } = {}
	local qualTotal = 0
	for _, dmg in qualifiers do
		qualTotal += dmg
	end
	if qualTotal <= 0 or not topId then
		return {}
	end

	-- Top gets exclusive 40% pool + share of remaining 60%
	for userId, dmg in qualifiers do
		local prop = (dmg / qualTotal) * SoftContestConfig.ProportionalPool
		shares[userId] = prop
	end
	shares[topId] = (shares[topId] or 0) + SoftContestConfig.TopContributorPool
	return shares
end

return ContributionSplit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">FormatNumber</string>
            <string name="Source"><![CDATA[local FormatNumber = {}

function FormatNumber.Compact(n: number): string
	n = math.floor(n)
	if n >= 1_000_000_000 then
		return string.format("%.2fB", n / 1_000_000_000)
	elseif n >= 1_000_000 then
		return string.format("%.2fM", n / 1_000_000)
	elseif n >= 1_000 then
		return string.format("%.1fK", n / 1_000)
	end
	return tostring(n)
end

return FormatNumber
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">OreMath</string>
            <string name="Source"><![CDATA[local EconomyConfig = require(script.Parent.Parent.Config.EconomyConfig)

local OreMath = {}

function OreMath.SellValue(oreAmount: number, sectorId: string, creditMult: number, has2x: boolean): number
	local per = EconomyConfig.OreValueBySector[sectorId] or EconomyConfig.CreditsPerOreBase
	local value = oreAmount * per * creditMult
	if has2x then
		value *= 2
	end
	return math.floor(value)
end

function OreMath.CargoCap(cargoLevel: number): number
	return EconomyConfig.CargoCapacityForLevel(cargoLevel)
end

return OreMath
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[local RateLimiter = {}
RateLimiter.__index = RateLimiter

function RateLimiter.new(minInterval: number)
	return setmetatable({
		_minInterval = minInterval,
		_last = {} :: { [number]: number },
	}, RateLimiter)
end

function RateLimiter:Allow(userId: number): boolean
	local now = os.clock()
	local last = self._last[userId]
	if last and (now - last) < self._minInterval then
		return false
	end
	self._last[userId] = now
	return true
end

function RateLimiter:Clear(userId: number)
	self._last[userId] = nil
end

return RateLimiter
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Types</string>
            <string name="Source"><![CDATA[-- Shared type documentation (Luau). Runtime tables use these shapes.
export type GalaxyFlags = {
	Starter: boolean,
	Nebula: boolean,
	VoidRim: boolean,
	Celestial: boolean,
}

export type PlayerProfile = {
	Credits: number,
	Ore: number,
	VoidShards: number,
	VoidlineTokens: number,
	Rebirths: number,
	CreditMult: number,
	StationTier: number,
	DrillLevel: number,
	CargoLevel: number,
	DroneSlots: number,
	DroneTier: number,
	GalaxyFlags: GalaxyFlags,
	OwnedPerks: { [string]: boolean },
	RedeemedCodes: { [string]: boolean },
	TutorialStep: number,
	TutorialComplete: boolean,
	Settings: {
		PerfMode: boolean,
		HideJetpack: boolean,
		ClipMode: boolean,
		LaserColor: string,
	},
	Cosmetics: { Title: string? },
	ForgeTokensEarnedToday: number,
	ForgeDayKey: string,
	DailyStreak: number,
	LastLoginDay: string,
	TrialVouchers: { [string]: number }, -- perkId -> expiry os.time
	Codex: { [string]: boolean },
	Relics: { [string]: boolean },
	PlotIndex: number?,
	Formation: number,
	Version: number,
}

return {}
]]></string>
          </Properties>
        </Item>
