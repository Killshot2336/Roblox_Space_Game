		Hazards = { "hazard.plasma_geyser", "hazard.ion_squall" },
		Bias = { [3] = 1.6 },
		RelicMult = 1,
		CreditMult = 1.05,
		Tint = Color3.fromRGB(150, 255, 230),
		Atmosphere = Color3.fromRGB(30, 120, 120),
		Flavor = "Living arcs of plasma grow like coral.",
	},
	{
		Id = "crystal_lattice",
		Name = "Crystal Lattice Belt",
		Gravity = 1.0,
		Hazards = { "hazard.radiation_bloom", "hazard.quantum_flicker" },
		Bias = { [2] = 1.6, [5] = 1.3 },
		RelicMult = 1.1,
		CreditMult = 1,
		Tint = Color3.fromRGB(230, 240, 255),
		Atmosphere = Color3.fromRGB(150, 160, 210),
		Flavor = "Asteroids grown in perfect geometric shells.",
	},
	{
		Id = "dark_matter_tide",
		Name = "Dark Matter Tide",
		Gravity = 1.25,
		Hazards = { "hazard.dark_matter_tide", "hazard.gravity_well" },
		Bias = { [4] = 1.8 },
		RelicMult = 1.1,
		CreditMult = 1,
		Tint = Color3.fromRGB(140, 150, 220),
		Atmosphere = Color3.fromRGB(15, 15, 50),
		Flavor = "An unseen mass pulls the whole belt off course.",
	},
	{
		Id = "ion_aurora",
		Name = "Ion Aurora",
		Gravity = 0.9,
		Hazards = { "hazard.ion_squall", "hazard.solar_flare" },
		Bias = { [3] = 1.3, [5] = 1.2 },
		RelicMult = 1,
		CreditMult = 1.05,
		Tint = Color3.fromRGB(170, 255, 200),
		Atmosphere = Color3.fromRGB(30, 110, 80),
		Flavor = "Curtains of green light ripple between the rocks.",
	},
	{
		Id = "quantum_foam",
		Name = "Quantum Foam Shoal",
		Gravity = 0.75,
		Hazards = { "hazard.quantum_flicker", "hazard.tachyon_wake" },
		Bias = { [5] = 1.5, [6] = 1.3 },
		RelicMult = 1.4,
		CreditMult = 1,
		Tint = Color3.fromRGB(235, 245, 255),
		Atmosphere = Color3.fromRGB(120, 140, 200),
		Flavor = "Space bubbles at the smallest scale and nothing sits still.",
	},
	{
		Id = "pulsar_graveyard",
		Name = "Pulsar Graveyard",
		Gravity = 1.1,
		Hazards = { "hazard.radiation_bloom", "hazard.magnetic_reversal" },
		Bias = { [3] = 1.4, [4] = 1.4 },
		RelicMult = 1.2,
		CreditMult = 1,
		Tint = Color3.fromRGB(170, 200, 255),
		Atmosphere = Color3.fromRGB(30, 50, 100),
		Flavor = "Old pulsars tick like clocks over a field of wrecks.",
	},
	{
		Id = "gas_giant_shadow",
		Name = "Gas Giant Shadow",
		Gravity = 1.15,
		Hazards = { "hazard.meteor_hail", "hazard.dark_matter_tide" },
		Bias = { [2] = 1.3, [3] = 1.2 },
		RelicMult = 1,
		CreditMult = 1.05,
		Tint = Color3.fromRGB(255, 220, 170),
		Atmosphere = Color3.fromRGB(120, 80, 40),
		Flavor = "A banded giant blots out half the sky.",
	},
}

local VARIANTS_PER_ARCHETYPE = 4
local INTENSITY_NAMES = { "Calm", "Restless", "Raging", "Cataclysmic" }
local CODE_LETTERS = { "A", "C", "D", "E", "G", "H", "J", "K", "L", "M", "N", "P", "R", "S", "T", "V", "X", "Z" }

local list: { Biome } = {}

for _, archetype in ARCHETYPES do
	for n = 1, VARIANTS_PER_ARCHETYPE do
		local id = ("biome.%s.%d"):format(archetype.Id, n)
		local rng = ContentUtil.Rng("biome", id)
		local code = rng:Pick(CODE_LETTERS) .. rng:Pick(CODE_LETTERS) .. "-" .. tostring(rng:NextInteger(100, 999))
		local intensity = n
		local hazardIds = rng:Sample(archetype.Hazards, math.min(2, #archetype.Hazards))
		table.sort(hazardIds)
		local bias = {}
		for tier, mult in archetype.Bias do
			bias[tier] = ContentUtil.Round(1 + (mult - 1) * (0.7 + 0.15 * intensity), 3)
		end
		local tint = ContentUtil.ShiftColor(archetype.Tint, rng, 0.04)
		local atmosphere = ContentUtil.ShiftColor(archetype.Atmosphere, rng, 0.05)
		table.insert(list, {
			Id = id,
			Name = archetype.Name .. " " .. code,
			Archetype = archetype.Id,
			ArchetypeName = archetype.Name,
			Intensity = intensity,
			IntensityName = INTENSITY_NAMES[intensity],
			GravityMult = ContentUtil.Round(1 + (archetype.Gravity - 1) * (0.6 + 0.2 * intensity), 3),
			HazardIds = hazardIds,
			HazardInterval = math.floor(30 - intensity * 4 + rng:NextInteger(0, 4)),
			TierBias = bias,
			RelicMult = archetype.RelicMult,
			CreditMult = archetype.CreditMult,
			Sky = {
				Tint = tint,
				Ambient = atmosphere:Lerp(Color3.new(0, 0, 0), 0.4),
				AtmosphereColor = atmosphere,
				AtmosphereDecay = atmosphere:Lerp(Color3.new(0, 0, 0), 0.6),
				Density = ContentUtil.Round(0.25 + 0.06 * intensity + rng:NextNumber(0, 0.05), 3),
				Haze = ContentUtil.Round(1 + intensity * 0.4 + rng:NextNumber(0, 0.5), 3),
				Glare = ContentUtil.Round(rng:NextNumber(0, 0.6) + intensity * 0.1, 3),
				Bloom = ContentUtil.Round(0.8 + intensity * 0.15, 3),
				Saturation = ContentUtil.Round(0.05 + 0.04 * intensity, 3),
				Contrast = ContentUtil.Round(0.05 + 0.03 * intensity, 3),
			},
			Flavor = archetype.Flavor,
		})
	end
end

local registry = ContentUtil.Registry("biome", list) :: any
registry.Hazards = ContentUtil.Registry("hazard", HAZARDS)
registry.Archetypes = ARCHETYPES

-- Which anomaly is active for a given rotation slot. Seeded by slot number so
-- every server shows the same anomaly at the same time.
function registry.ForSlot(slot: number): Biome
	local rng = ContentUtil.Rng("biome-slot", tostring(slot))
	return list[rng:NextInteger(1, #list)]
end

return registry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">CitadelRegistry</string>
            <string name="Source"><![CDATA[--!strict
-- Citadel tiers: one per Station Tier (1..30). Each tier adds structures that
-- CitadelBuilder renders on the pilot's plot (turrets, refinery towers, warp
-- docks, trophy halls, ...). Purely cosmetic flex plus relic pedestal slots.
-- FROZEN lists: ERAS, STRUCTURES (append-only).
local ContentUtil = require(script.Parent.ContentUtil)

export type Structure = { Kind: string, Count: number, Scale: number }

export type CitadelTier = {
	Id: string,
	Name: string,
	Tier: number,
	Era: string,
	Adds: { Structure },
	RelicSlots: number,
	Accent: Color3,
	Height: number,
	Flavor: string,
}

local ERAS: { { any } } = {
	{ "Outpost", Color3.fromRGB(200, 170, 110), "A beacon and a landing pad." },
	{ "Station", Color3.fromRGB(232, 186, 74), "Refinery towers rise over the plot." },
	{ "Bastion", Color3.fromRGB(255, 210, 120), "Turrets ring the bastion walls." },
	{ "Citadel", Color3.fromRGB(190, 150, 255), "Warp docks hum with traffic." },
	{ "Bulwark", Color3.fromRGB(120, 200, 255), "Shield rings lock around the spire." },
	{ "Sovereign Spire", Color3.fromRGB(255, 240, 190), "A spire visible from every plot." },
}

-- Structure kinds CitadelBuilder knows how to draw.
local STRUCTURES = {
	"beacon",
	"refinery_tower",
	"turret",
	"warp_dock",
	"trophy_hall",
	"shield_ring",
	"solar_array",
	"hangar",
	"gravity_anchor",
	"relic_vault",
}

-- Fixed signature structure per rank inside an era (rank 1..5).
local SIGNATURE = {
	{ "beacon", "solar_array", "refinery_tower", "hangar", "turret" },
	{ "refinery_tower", "turret", "solar_array", "warp_dock", "trophy_hall" },
	{ "turret", "shield_ring", "refinery_tower", "gravity_anchor", "trophy_hall" },
	{ "warp_dock", "relic_vault", "turret", "shield_ring", "hangar" },
	{ "shield_ring", "gravity_anchor", "warp_dock", "relic_vault", "turret" },
	{ "trophy_hall", "beacon", "shield_ring", "relic_vault", "gravity_anchor" },
}

local TIERS_PER_ERA = 5

local list: { CitadelTier } = {}

for eraIndex, era in ERAS do
	for rank = 1, TIERS_PER_ERA do
		local tier = (eraIndex - 1) * TIERS_PER_ERA + rank
		local id = "citadel.tier." .. tier
		local rng = ContentUtil.Rng("citadel", id)
		local adds: { Structure } = {
			{ Kind = SIGNATURE[eraIndex][rank], Count = 1 + math.floor(eraIndex / 3), Scale = 1 + 0.1 * eraIndex },
		}
		-- From the Bastion era on, each tier also adds a seeded secondary piece.
		if eraIndex >= 3 then
			table.insert(adds, {
				Kind = rng:Pick(STRUCTURES),
				Count = 1,
				Scale = ContentUtil.Round(0.8 + rng:NextNumber(0, 0.4), 3),
			})
		end
		table.insert(list, {
			Id = id,
			Name = era[1] .. " " .. ContentUtil.Roman(rank),
			Tier = tier,
			Era = era[1],
			Adds = adds,
			RelicSlots = 1 + math.floor(tier / 3),
			Accent = ContentUtil.ShiftColor(era[2], rng, 0.03),
			Height = ContentUtil.Round(6 + tier * 1.6, 2),
			Flavor = era[3],
		})
	end
end

local registry = ContentUtil.Registry("citadel", list) :: any
registry.StructureKinds = STRUCTURES

function registry.ForTier(tier: number): CitadelTier
	return list[math.clamp(math.floor(tier), 1, #list)]
end

-- Every structure up to and including `tier`, in build order.
function registry.StructuresUpTo(tier: number): { Structure }
	local out = {}
	for i = 1, math.clamp(math.floor(tier), 0, #list) do
		for _, structure in list[i].Adds do
			table.insert(out, structure)
		end
	end
	return out
end

return registry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">ContentIndex</string>
            <string name="Source"><![CDATA[--!strict
-- One place to look up any content ID, count content and decide what the
-- Codex tracks. Registries live in ReplicatedStorage code, so clients look
-- entries up locally and remotes only ever carry string IDs.
local Content = script.Parent
local OreRegistry = require(Content.OreRegistry)
local BiomeRegistry = require(Content.BiomeRegistry)
local RelicRegistry = require(Content.RelicRegistry)
local DroneRegistry = require(Content.DroneRegistry)
local TitleRegistry = require(Content.TitleRegistry)
local AchievementRegistry = require(Content.AchievementRegistry)
local CitadelRegistry = require(Content.CitadelRegistry)
local QuestRegistry = require(Content.QuestRegistry)
local WorldEventRegistry = require(Content.WorldEventRegistry)

local ContentIndex = {}

ContentIndex.Registries = {
	{ Kind = "ore", Label = "Ore variants", Registry = OreRegistry, Codex = true },
	{ Kind = "biome", Label = "Anomaly biomes", Registry = BiomeRegistry, Codex = true },
	{ Kind = "hazard", Label = "Hazards", Registry = BiomeRegistry.Hazards, Codex = true },
	{ Kind = "relic", Label = "Relics", Registry = RelicRegistry, Codex = true },
	{ Kind = "drone", Label = "Drone evolutions & cosmetics", Registry = DroneRegistry, Codex = true },
	{ Kind = "event", Label = "World events", Registry = WorldEventRegistry, Codex = true },
	{ Kind = "title", Label = "Titles", Registry = TitleRegistry, Codex = false },
	{ Kind = "achievement", Label = "Achievements", Registry = AchievementRegistry, Codex = false },
	{ Kind = "citadel", Label = "Citadel tiers", Registry = CitadelRegistry, Codex = false },
	{ Kind = "quest", Label = "Quests", Registry = QuestRegistry, Codex = false },
}

local lookup: { [string]: { Entry: any, Kind: string, Codex: boolean } } = {}
local codexTotal = 0
for _, info in ContentIndex.Registries do
	for _, entry in info.Registry.List do
		assert(lookup[entry.Id] == nil, "content id used twice: " .. entry.Id)
		lookup[entry.Id] = { Entry = entry, Kind = info.Kind, Codex = info.Codex }
		if info.Codex then
			codexTotal += 1
		end
	end
end
ContentIndex.CodexTotal = codexTotal

function ContentIndex.Get(id: string): (any, string?)
	local hit = lookup[id]
	if hit then
		return hit.Entry, hit.Kind
	end
	return nil, nil
end

function ContentIndex.IsCodexId(id: string): boolean
	local hit = lookup[id]
	return hit ~= nil and hit.Codex
end

function ContentIndex.Totals(): ({ { Kind: string, Label: string, Count: number } }, number)
	local rows = {}
	local total = 0
	for _, info in ContentIndex.Registries do
		table.insert(rows, { Kind = info.Kind, Label = info.Label, Count = info.Registry.Count })
		total += info.Registry.Count
	end
	return rows, total
end

-- Codex milestones: permanent credit multiplier steps (spec §10).
ContentIndex.CodexMilestones = {
	{ Count = 10, Bonus = 0.02 },
	{ Count = 25, Bonus = 0.03 },
	{ Count = 50, Bonus = 0.05 },
	{ Count = 100, Bonus = 0.05 },
	{ Count = 175, Bonus = 0.05 },
	{ Count = 250, Bonus = 0.05 },
	{ Count = 350, Bonus = 0.05 },
	{ Count = 450, Bonus = 0.05 },
	{ Count = 550, Bonus = 0.05 },
	{ Count = 650, Bonus = 0.10 },
}

function ContentIndex.CodexMultiplier(count: number): number
	local mult = 1
	for _, milestone in ContentIndex.CodexMilestones do
		if count >= milestone.Count then
			mult += milestone.Bonus
		end
	end
	return mult
end

return ContentIndex
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">ContentUtil</string>
            <string name="Source"><![CDATA[--!strict
-- Helpers shared by the content registries.
--
-- Stability contract (read before editing any registry):
--   * IDs are lowercase dotted slugs and are saved in player profiles. Never
--     rename or remove one; add new entries instead.
--   * Every entry's stats come from Prng.new(<kind> .. ":" .. id), so an
--     entry's values never depend on list order.
--   * Word lists feeding generated *names* are frozen once shipped. Append new
--     sets/archetypes rather than editing existing lists. The registry
--     snapshot test (tests/snapshots/content_ids.txt) fails on any rename.
local Prng = require(script.Parent.Prng)

local ContentUtil = {}

function ContentUtil.Slug(text: string): string
	local slug = string.lower(text)
	slug = string.gsub(slug, "[^%w]+", "_")
	slug = string.gsub(slug, "^_+", "")
	slug = string.gsub(slug, "_+$", "")
	return slug
end

local ROMAN: { { any } } = {
	{ 1000, "M" },
	{ 900, "CM" },
	{ 500, "D" },
	{ 400, "CD" },
	{ 100, "C" },
	{ 90, "XC" },
	{ 50, "L" },
	{ 40, "XL" },
	{ 10, "X" },
	{ 9, "IX" },
	{ 5, "V" },
	{ 4, "IV" },
	{ 1, "I" },
}

function ContentUtil.Roman(n: number): string
	local out = {}
	local rest = math.floor(n)
	for _, pair in ROMAN do
		while rest >= pair[1] do
			table.insert(out, pair[2])
			rest -= pair[1]
		end
	end
	return table.concat(out)
end

function ContentUtil.Rng(kind: string, id: string): Prng.Prng
	return Prng.new(kind .. ":" .. id)
end

-- Deterministic yes/no for an (a, b) pair, independent of list positions.
function ContentUtil.Include(salt: string, probability: number): boolean
	return (Prng.Hash(salt) % 10000) / 10000 < probability
end

function ContentUtil.Jitter(rng: Prng.Prng, value: number, spread: number): number
	return value * (1 + rng:NextNumber(-spread, spread))
end

function ContentUtil.Round(value: number, places: number): number
	local scale = 10 ^ places
	return math.floor(value * scale + 0.5) / scale
end

function ContentUtil.ShiftColor(color: Color3, rng: Prng.Prng, amount: number): Color3
	local h, s, v = color:ToHSV()
	h = (h + rng:NextNumber(-amount, amount)) % 1
	s = math.clamp(s + rng:NextNumber(-amount, amount), 0, 1)
	v = math.clamp(v + rng:NextNumber(-amount, amount), 0.15, 1)
	return Color3.fromHSV(h, s, v)
end

function ContentUtil.FormatCount(n: number): string
	if n >= 1e9 then
		return (string.gsub(string.format("%.1fB", n / 1e9), "%.0B", "B"))
	elseif n >= 1e6 then
		return (string.gsub(string.format("%.1fM", n / 1e6), "%.0M", "M"))
	elseif n >= 1e3 then
		return (string.gsub(string.format("%.1fK", n / 1e3), "%.0K", "K"))
	end
	return tostring(n)
end

export type Registry<T> = {
	Kind: string,
	List: { T },
	ById: { [string]: T },
	Count: number,
}

-- Builds the standard registry shape and rejects duplicate IDs.
function ContentUtil.Registry<T>(kind: string, list: { T }): Registry<T>
	local byId = {}
	for _, entry in list do
		local id = (entry :: any).Id
		assert(type(id) == "string", kind .. " entry without Id")
		assert(byId[id] == nil, kind .. " duplicate id " .. id)
		byId[id] = entry
	end
	return { Kind = kind, List = list, ById = byId, Count = #list }
end

return ContentUtil
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">DroneRegistry</string>
            <string name="Source"><![CDATA[--!strict
-- Drone content: the evolution tree (Mk.I -> three branches -> Omega
-- Antimatter), cosmetic mutations, laser shaders, hit effects and thrusters.
-- FROZEN lists: everything below is append-only (see ContentUtil).
local ContentUtil = require(script.Parent.ContentUtil)

export type Evolution = {
	Id: string,
	Name: string,
	Stage: number,
	Branch: string,
	BodyScale: number,
	RingCount: number,
	FinCount: number,
	Color: Color3,
	Glow: Color3,
	Flavor: string,
}

export type Cosmetic = {
	Id: string,
	Name: string,
	Category: string, -- "Mutation" | "Laser" | "HitEffect" | "Thruster"
	Style: string,
	Color: Color3,
	Accent: Color3,
	Rarity: string,
	Source: string,
}

local SHARED_STAGES = {
	{ "Mk.I Prospector", "A tough little cutter. Every fleet starts here." },
	{ "Mk.II Cutter", "Twin emitters and a better tow winch." },
	{ "Mk.III Borer", "Bores through rock that used to bounce lasers." },
	{ "Mk.IV Lancer", "Long-lance emitter, longer reach." },
	{ "Mk.V Vanguard", "The last common frame before the branches." },
}

local BRANCHES = {
	{
		Id = "Miner",
		Color = Color3.fromRGB(255, 190, 80),
		Names = { "Core Breaker", "Magma Lancer", "Quasar Drill", "Pulsar Ram", "Nova Bore", "Singularity Bore" },
		Flavor = "Miner line: every upgrade goes into the laser.",
	},
	{
		Id = "Hauler",
		Color = Color3.fromRGB(90, 220, 255),
		Names = {
			"Tug Hauler",
			"Gravity Mule",
			"Tether Titan",
			"Orbit Freighter",
			"Warp Barge",
			"Event Horizon Hauler",
		},
		Flavor = "Hauler line: faster tows, heavier rocks, more ore per rock.",
	},
	{
		Id = "Swarm",
		Color = Color3.fromRGB(180, 120, 255),
		Names = { "Hive Spark", "Swarm Wisp", "Locust Array", "Murmuration", "Star Choir", "Legion Prime" },
		Flavor = "Swarm line: extra drones join as the line grows.",
	},
}

local MUTATIONS: { { any } } = {
	{ "Shiny", Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 240, 255), "Rare" },
	{ "Golden", Color3.fromRGB(255, 205, 70), Color3.fromRGB(255, 240, 170), "Epic" },
	{ "Void-Corrupted", Color3.fromRGB(80, 30, 120), Color3.fromRGB(190, 110, 255), "Epic" },
	{ "Starforged", Color3.fromRGB(255, 150, 80), Color3.fromRGB(255, 230, 160), "Legendary" },
	{ "Prismatic", Color3.fromRGB(255, 150, 230), Color3.fromRGB(150, 230, 255), "Legendary" },
	{ "Spectral", Color3.fromRGB(200, 230, 255), Color3.fromRGB(255, 255, 255), "Epic" },
	{ "Crystalline", Color3.fromRGB(170, 230, 255), Color3.fromRGB(240, 250, 255), "Rare" },
	{ "Solar-Kissed", Color3.fromRGB(255, 180, 90), Color3.fromRGB(255, 230, 120), "Rare" },
	{ "Frostbitten", Color3.fromRGB(150, 200, 255), Color3.fromRGB(220, 245, 255), "Rare" },
	{ "Nebula-Born", Color3.fromRGB(150, 80, 200), Color3.fromRGB(255, 150, 220), "Epic" },
	{ "Quantum", Color3.fromRGB(120, 255, 220), Color3.fromRGB(255, 255, 255), "Legendary" },
	{ "Obsidian", Color3.fromRGB(25, 25, 35), Color3.fromRGB(232, 186, 74), "Mythic" },
}

local PALETTES: { { any } } = {
	{ "Gold", Color3.fromRGB(255, 210, 90), Color3.fromRGB(255, 245, 200) },
	{ "Cyan", Color3.fromRGB(90, 220, 255), Color3.fromRGB(220, 250, 255) },
	{ "Void", Color3.fromRGB(170, 110, 255), Color3.fromRGB(240, 220, 255) },
	{ "Crimson", Color3.fromRGB(255, 90, 110), Color3.fromRGB(255, 210, 210) },
	{ "Emerald", Color3.fromRGB(90, 255, 160), Color3.fromRGB(220, 255, 235) },
	{ "Solar", Color3.fromRGB(255, 150, 60), Color3.fromRGB(255, 230, 170) },
	{ "Aurora", Color3.fromRGB(120, 255, 200), Color3.fromRGB(190, 160, 255) },
	{ "Plasma", Color3.fromRGB(255, 80, 220), Color3.fromRGB(120, 200, 255) },
}

local LASER_STYLES = { "Pulse", "Helix", "Ribbon", "Lattice", "Flare", "Needle" }
local HIT_STYLES = { "Sparks", "Shatter", "Ripple", "Bloom" }
local THRUSTER_STYLES = { "Comet", "Ion", "Plasma", "Ember" }
local PALETTES_PER_SMALL_STYLE = 6

local RARITY_BY_PALETTE = { "Common", "Common", "Rare", "Rare", "Rare", "Epic", "Epic", "Legendary" }

local evolutions: { Evolution } = {}
local cosmetics: { Cosmetic } = {}

for stage, entry in SHARED_STAGES do
	local id = "drone.evo.mk" .. stage
	local rng = ContentUtil.Rng("drone", id)
	table.insert(evolutions, {
		Id = id,
		Name = entry[1],
		Stage = stage,
		Branch = "",
		BodyScale = ContentUtil.Round(1 + 0.06 * (stage - 1), 3),
		RingCount = 0,
		FinCount = 2 + math.floor(stage / 2),
		Color = ContentUtil.ShiftColor(Color3.fromRGB(232, 186, 74), rng, 0.03),
		Glow = Color3.fromRGB(255, 230, 150),
		Flavor = entry[2],
	})
end

for _, branch in BRANCHES do
	for offset, name in branch.Names do
		local stage = 5 + offset
		local id = ("drone.evo.%s.%d"):format(string.lower(branch.Id), stage)
		local rng = ContentUtil.Rng("drone", id)
		table.insert(evolutions, {
			Id = id,
			Name = name,
			Stage = stage,
			Branch = branch.Id,
			BodyScale = ContentUtil.Round(1.3 + 0.08 * offset, 3),
			RingCount = 1 + math.floor(offset / 2),
			FinCount = 4 + offset,
			Color = ContentUtil.ShiftColor(branch.Color, rng, 0.04),
			Glow = branch.Color:Lerp(Color3.new(1, 1, 1), 0.4),
			Flavor = branch.Flavor,
		})
	end
end

table.insert(evolutions, {
	Id = "drone.evo.omega",
	Name = "Omega Antimatter",
	Stage = 12,
	Branch = "Omega",
	BodyScale = 2.0,
	RingCount = 4,
	FinCount = 12,
	Color = Color3.fromRGB(20, 10, 30),
	Glow = Color3.fromRGB(255, 80, 200),
	Flavor = "Every branch ends here. The laser cuts reality a little.",
})

for _, mutation in MUTATIONS do
	table.insert(cosmetics, {
		Id = "drone.mut." .. ContentUtil.Slug(mutation[1]),
		Name = mutation[1],
		Category = "Mutation",
		Style = "Mutation",
		Color = mutation[2],
		Accent = mutation[3],
		Rarity = mutation[4],
		Source = "Evolution roll, boss meteors and Starfalls",
	})
end

for _, style in LASER_STYLES do
	for paletteIndex, palette in PALETTES do
		table.insert(cosmetics, {
			Id = ("laser.%s.%s"):format(string.lower(style), string.lower(palette[1])),
			Name = style .. " · " .. palette[1],
			Category = "Laser",
			Style = style,
			Color = palette[2],
			Accent = palette[3],
			Rarity = RARITY_BY_PALETTE[paletteIndex],
			Source = "Achievements and quests",
		})
	end
end

table.insert(cosmetics, {
	Id = "laser.overclock",
	Name = "Overclock",
	Category = "Laser",
	Style = "Overclock",
	Color = Color3.fromRGB(255, 255, 255),
	Accent = Color3.fromRGB(255, 120, 60),
	Rarity = "Legendary",
	Source = "Laser Overclock pass",
})

for _, style in HIT_STYLES do
	for paletteIndex = 1, PALETTES_PER_SMALL_STYLE do
		local palette = PALETTES[paletteIndex]
		table.insert(cosmetics, {
			Id = ("hit.%s.%s"):format(string.lower(style), string.lower(palette[1])),
			Name = style .. " · " .. palette[1],
			Category = "HitEffect",
			Style = style,
			Color = palette[2],
			Accent = palette[3],
			Rarity = RARITY_BY_PALETTE[paletteIndex],
			Source = "Achievements and quests",
		})
	end
end

for _, style in THRUSTER_STYLES do
	for paletteIndex = 1, PALETTES_PER_SMALL_STYLE do
		local palette = PALETTES[paletteIndex]
		table.insert(cosmetics, {
			Id = ("thruster.%s.%s"):format(string.lower(style), string.lower(palette[1])),
			Name = style .. " · " .. palette[1],
			Category = "Thruster",
			Style = style,
			Color = palette[2],
			Accent = palette[3],
			Rarity = RARITY_BY_PALETTE[paletteIndex],
			Source = "Achievements and quests",
		})
	end
end

table.insert(cosmetics, {
	Id = "thruster.gold_comet",
	Name = "Gold Comet",
	Category = "Thruster",
	Style = "Comet",
	Color = Color3.fromRGB(255, 205, 90),
	Accent = Color3.fromRGB(255, 245, 200),
	Rarity = "Epic",
	Source = "Starter Bundle",
})

local all: { any } = {}
for _, evo in evolutions do
	table.insert(all, evo)
end
for _, cosmetic in cosmetics do
	table.insert(all, cosmetic)
end

local registry = ContentUtil.Registry("drone", all) :: any
registry.Evolutions = evolutions
registry.Cosmetics = cosmetics

-- Evolution for a stage/branch pair (stage 1..12).
function registry.EvolutionFor(stage: number, branch: string): Evolution
	if stage <= 5 then
		return evolutions[math.max(1, stage)]
	elseif stage >= 12 then
		return registry.ById["drone.evo.omega"]
	end
	local branchId = if branch ~= "" then string.lower(branch) else "miner"
	return registry.ById[("drone.evo.%s.%d"):format(branchId, stage)]
end

function registry.ByCategory(category: string): { Cosmetic }
	local out = {}
	for _, cosmetic in cosmetics do
		if cosmetic.Category == category then
			table.insert(out, cosmetic)
		end
	end
	return out
end

return registry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">OreRegistry</string>
            <string name="Source"><![CDATA[--!strict
-- Ore variants: 6 rarity tiers x tier-specific mineral roots x quality
-- modifiers. Base variants ("ore.<tier>.<root>") have exact tier values so the
-- tutorial stays deterministic; modifier variants get seeded stats.
-- FROZEN lists: TIERS, ROOTS, MODIFIERS (append-only; see ContentUtil).
local ContentUtil = require(script.Parent.ContentUtil)

export type Ore = {
	Id: string,
	Name: string,
	Tier: string,
	TierIndex: number,
	Root: string,
	Modifier: string,
	ValueMult: number,
	ShardChance: number,
	RelicChance: number,
	Weight: number,
	Color: Color3,
	Glow: Color3,
	Material: Enum.Material,
	MinSector: number,
	Flavor: string,
}

type TierDef = {
	Id: string,
	Label: string,
	Index: number,
	ValueMult: number,
	ShardChance: number,
	RelicChance: number,
	Weight: number,
	MinSector: number,
	Color: Color3,
	Glow: Color3,
	Material: Enum.Material,
}

local TIERS: { TierDef } = {
	{
		Id = "common",
		Label = "Common",
		Index = 1,
		ValueMult = 1.0,
		ShardChance = 0.006,
		RelicChance = 0.0002,
		Weight = 1000,
		MinSector = 1,
		Color = Color3.fromRGB(120, 112, 104),
		Glow = Color3.fromRGB(200, 180, 150),
		Material = Enum.Material.Rock,
	},
	{
		Id = "refined",
		Label = "Refined",
		Index = 2,
		ValueMult = 1.6,
		ShardChance = 0.014,
		RelicChance = 0.0005,
		Weight = 280,
		MinSector = 1,
		Color = Color3.fromRGB(150, 160, 175),
		Glow = Color3.fromRGB(190, 220, 255),
		Material = Enum.Material.Slate,
	},
	{
		Id = "isotope",
		Label = "Isotope",
		Index = 3,
		ValueMult = 2.6,
		ShardChance = 0.03,
		RelicChance = 0.001,
		Weight = 80,
		MinSector = 2,
		Color = Color3.fromRGB(90, 150, 80),
		Glow = Color3.fromRGB(150, 255, 120),
		Material = Enum.Material.Basalt,
	},
	{
		Id = "void_touched",
		Label = "Void-Touched",
		Index = 4,
		ValueMult = 4.2,
		ShardChance = 0.06,
		RelicChance = 0.002,
		Weight = 22,
		MinSector = 3,
		Color = Color3.fromRGB(60, 30, 90),
		Glow = Color3.fromRGB(170, 110, 255),
		Material = Enum.Material.Basalt,
	},
	{
		Id = "celestial",
		Label = "Celestial",
		Index = 5,
		ValueMult = 7.0,
		ShardChance = 0.1,
		RelicChance = 0.004,
		Weight = 6,
		MinSector = 4,
		Color = Color3.fromRGB(230, 220, 190),
		Glow = Color3.fromRGB(255, 230, 140),
		Material = Enum.Material.Glass,
	},
	{
		Id = "antimatter",
		Label = "Antimatter",
		Index = 6,
		ValueMult = 12.0,
		ShardChance = 0.18,
		RelicChance = 0.008,
		Weight = 1.5,
		MinSector = 4,
		Color = Color3.fromRGB(20, 10, 30),
		Glow = Color3.fromRGB(255, 80, 200),
		Material = Enum.Material.Glass,
	},
}

local ROOTS: { [string]: { string } } = {
	common = {
		"Ferrite",
		"Cobalt",
		"Nickel",
		"Silicate",
		"Basalt",
		"Olivine",
		"Pyroxene",
		"Magnetite",
		"Hematite",
		"Quartzite",
		"Bauxite",
		"Graphite",
	},
	refined = {
		"Titanium",
		"Iridium",
		"Palladium",
		"Osmium",
		"Rhodium",
		"Tungsten",
		"Chromium",
		"Vanadium",
		"Platinum",
		"Beryllium",
	},
	isotope = {
		"Uranium",
		"Thorium",
		"Plutonium",
		"Tritium",
		"Deuterium",
		"Helium-3",
		"Cesium",
		"Strontium",
		"Radium",
		"Polonium",
	},
	void_touched = { "Umbral", "Nullstone", "Shadeglass", "Eclipsite", "Duskium", "Gloomite", "Vantaite", "Abyssite" },
	celestial = { "Starfire", "Nebulite", "Aurorium", "Quasarite", "Pulsarine", "Cometite", "Lumenite", "Solarium" },
	antimatter = { "Antiferrite", "Positronium", "Antiproton", "Mirrorium", "Annihilite", "Exotic Matter" },
}

type ModifierDef = { Id: string, Label: string, ValueMult: number, Material: Enum.Material?, Tint: Color3? }

local MODIFIERS: { ModifierDef } = {
	{
		Id = "molten",
		Label = "Molten",
		ValueMult = 1.10,
		Material = Enum.Material.CrackedLava,
		Tint = Color3.fromRGB(255, 120, 40),
	},
	{
		Id = "glacial",
		Label = "Glacial",
		ValueMult = 1.05,
		Material = Enum.Material.Ice,
		Tint = Color3.fromRGB(150, 210, 255),
	},
	{
		Id = "prismatic",
		Label = "Prismatic",
		ValueMult = 1.25,
		Material = Enum.Material.Glass,
		Tint = Color3.fromRGB(255, 160, 255),
	},
	{ Id = "fractured", Label = "Fractured", ValueMult = 0.95, Material = Enum.Material.Slate },
	{ Id = "charged", Label = "Charged", ValueMult = 1.15, Tint = Color3.fromRGB(90, 230, 255) },
	{ Id = "radiant", Label = "Radiant", ValueMult = 1.2, Tint = Color3.fromRGB(255, 230, 120) },
	{ Id = "ancient", Label = "Ancient", ValueMult = 1.3, Material = Enum.Material.Granite },
	{
		Id = "gilded",
		Label = "Gilded",
		ValueMult = 1.35,
		Material = Enum.Material.Foil,
		Tint = Color3.fromRGB(240, 190, 70),
	},
	{ Id = "porous", Label = "Porous", ValueMult = 1.02, Material = Enum.Material.Sandstone },
	{ Id = "shimmering", Label = "Shimmering", ValueMult = 1.18, Tint = Color3.fromRGB(200, 255, 230) },
	{ Id = "ionized", Label = "Ionized", ValueMult = 1.22, Tint = Color3.fromRGB(120, 140, 255) },
	{ Id = "dense", Label = "Dense", ValueMult = 1.08, Material = Enum.Material.Basalt },
}

local INCLUDE_CHANCE = 0.42

local FLAVOR = {
	common = "Belt staple. Every citadel was built on it.",
	refined = "Purified in the tail of passing comets.",
	isotope = "Warm to the touch. Handle with drones only.",
	void_touched = "Pulled back from the edge of the Void.",
	celestial = "Fell from somewhere no map has reached.",
	antimatter = "Contained by nothing but your tow beam.",
}

local list: { Ore } = {}

for _, tier in TIERS do
	for _, rootLabel in ROOTS[tier.Id] do
		local root = ContentUtil.Slug(rootLabel)
		local baseId = ("ore.%s.%s"):format(tier.Id, root)
		local baseRng = ContentUtil.Rng("ore", baseId)
		local baseColor = ContentUtil.ShiftColor(tier.Color, baseRng, 0.06)
		table.insert(list, {
			Id = baseId,
			Name = rootLabel,
			Tier = tier.Label,
			TierIndex = tier.Index,
			Root = root,
			Modifier = "",
			ValueMult = tier.ValueMult,
			ShardChance = tier.ShardChance,
			RelicChance = tier.RelicChance,
			Weight = tier.Weight,
			Color = baseColor,
			Glow = tier.Glow,
			Material = tier.Material,
			MinSector = tier.MinSector,
			Flavor = FLAVOR[tier.Id],
		})
		for _, modifier in MODIFIERS do
			if ContentUtil.Include(baseId .. "+" .. modifier.Id, INCLUDE_CHANCE) then
				local id = baseId .. "." .. modifier.Id
				local rng = ContentUtil.Rng("ore", id)
				local color = if modifier.Tint then baseColor:Lerp(modifier.Tint, 0.35) else baseColor
				table.insert(list, {
					Id = id,
					Name = modifier.Label .. " " .. rootLabel,
					Tier = tier.Label,
					TierIndex = tier.Index,
					Root = root,
					Modifier = modifier.Id,
					ValueMult = ContentUtil.Round(
						ContentUtil.Jitter(rng, tier.ValueMult * modifier.ValueMult, 0.05),
						3
					),
					ShardChance = ContentUtil.Round(ContentUtil.Jitter(rng, tier.ShardChance * 1.15, 0.1), 5),
					RelicChance = ContentUtil.Round(tier.RelicChance * 1.2, 5),
					Weight = ContentUtil.Round(tier.Weight * rng:NextNumber(0.25, 0.6), 3),
					Color = ContentUtil.ShiftColor(color, rng, 0.03),
					Glow = if modifier.Tint then tier.Glow:Lerp(modifier.Tint, 0.5) else tier.Glow,
					Material = modifier.Material or tier.Material,
					MinSector = tier.MinSector,
					Flavor = FLAVOR[tier.Id],
				})
			end
		end
	end
end

local registry = ContentUtil.Registry("ore", list) :: any
registry.Tiers = TIERS
registry.TutorialOreId = "ore.common.ferrite"

local byTier: { [number]: { Ore } } = {}
for _, ore in list do
	byTier[ore.TierIndex] = byTier[ore.TierIndex] or {}
	table.insert(byTier[ore.TierIndex], ore)
end
registry.ByTier = byTier

-- Server-side roll. `rng` is any object with NextNumber() in [0, 1);
-- `sectorIndex` 1..4; `luck` scales the rare-tier weights.
function registry.Roll(rng: any, sectorIndex: number, luck: number, tierBias: { [number]: number }?): Ore
	local weights = {}
	local total = 0
	for _, tier in TIERS do
		local weight = 0
		if sectorIndex >= tier.MinSector then
			weight = tier.Weight
			if tier.Index >= 3 then
				weight *= luck
			end
			if tierBias and tierBias[tier.Index] then
				weight *= tierBias[tier.Index]
			end
		end
		weights[tier.Index] = weight
		total += weight
	end
	local roll = rng:NextNumber() * total
	local chosen = 1
	for index = 1, #TIERS do
		roll -= weights[index]
		if roll < 0 then
			chosen = index
			break
		end
	end
	local pool = byTier[chosen]
	local poolTotal = 0
	for _, ore in pool do
		poolTotal += ore.Weight
	end
	local pick = rng:NextNumber() * poolTotal
	for _, ore in pool do
		pick -= ore.Weight
		if pick < 0 then
			return ore
		end
	end
	return pool[#pool]
end

return registry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Prng</string>
            <string name="Source"><![CDATA[--!strict
-- Deterministic PRNG for content generation (mulberry32 + FNV-1a seeding).
-- Pure 32-bit integer math through bit32, so generated registries are
-- identical in Studio, live servers and the headless test harness. Do not
-- use Random.new here: its sequence is not guaranteed across engine versions.
local Prng = {}
Prng.__index = Prng

local TWO_32 = 4294967296

-- (a * b) mod 2^32 without losing precision in doubles.
local function imul(a: number, b: number): number
	local ah = bit32.rshift(a, 16)
	local al = bit32.band(a, 0xFFFF)
	return ((ah * b) % 65536 * 65536 + al * b) % TWO_32
end

-- FNV-1a 32-bit. FNV prime 16777619 = 2^24 + 403.
function Prng.Hash(text: string): number
	local h = 2166136261
	for i = 1, #text do
		h = bit32.bxor(h, string.byte(text, i))
		h = (bit32.lshift(h, 24) + h * 403) % TWO_32
	end
	return h
end

export type Prng = typeof(setmetatable({} :: { _state: number }, Prng))

function Prng.new(seed: number | string): Prng
	local state = if type(seed) == "string" then Prng.Hash(seed) else math.floor(seed) % TWO_32
	return setmetatable({ _state = state }, Prng)
end

-- Next unsigned 32-bit integer.
function Prng.NextUInt(self: Prng): number
	self._state = (self._state + 0x6D2B79F5) % TWO_32
	local t = self._state
	t = imul(bit32.bxor(t, bit32.rshift(t, 15)), bit32.bor(t, 1))
	t = bit32.bxor(t, (t + imul(bit32.bxor(t, bit32.rshift(t, 7)), bit32.bor(t, 61))) % TWO_32)
	return bit32.bxor(t, bit32.rshift(t, 14))
end

-- Uniform in [0, 1), or [min, max) when bounds are given.
function Prng.NextNumber(self: Prng, min: number?, max: number?): number
	local unit = self:NextUInt() / TWO_32
	if min and max then
		return min + (max - min) * unit
	end
	return unit
end

-- Uniform integer in [min, max] inclusive.
function Prng.NextInteger(self: Prng, min: number, max: number): number
	return min + (self:NextUInt() % (max - min + 1))
end

function Prng.Chance(self: Prng, probability: number): boolean
	return self:NextNumber() < probability
end

function Prng.Pick<T>(self: Prng, list: { T }): T
	return list[self:NextInteger(1, #list)]
end

function Prng.Shuffle<T>(self: Prng, list: { T }): { T }
	for i = #list, 2, -1 do
		local j = self:NextInteger(1, i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

-- Picks `count` distinct items (order preserved from a shuffled copy).
function Prng.Sample<T>(self: Prng, list: { T }, count: number): { T }
	local copy = table.clone(list)
	self:Shuffle(copy)
	local out = {}
	for i = 1, math.min(count, #copy) do
		out[i] = copy[i]
	end
	return out
end

return Prng
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">QuestRegistry</string>
            <string name="Source"><![CDATA[--!strict
-- Daily (3 per UTC day) and weekly (3 per week) quest templates. Assignment
-- is seeded by (day or week, UserId) so it is stable across servers.
-- FROZEN lists: DAILY, WEEKLY (append-only).
local ContentUtil = require(script.Parent.ContentUtil)

export type Quest = {
	Id: string,
	Name: string,
	Cadence: string, -- "Daily" | "Weekly"
	Stat: string,
	Target: number,
	ScalesWithTier: boolean,
	RewardCredits: number,
	RewardShards: number,
	RewardCosmetic: boolean,
}

-- { stat key, name when target is 1, name pattern, targets, scales with station tier }
local DAILY: { { any } } = {
	{ "RocksMined", "Break a rock", "Break %s rocks", { 25, 50, 100 }, false },
	{ "Sells", "Refine cargo once", "Refine cargo %s times", { 5, 10, 20 }, false },
	{ "CreditsEarned", "Earn a Credit", "Earn %s Credits", { 200, 600, 1500 }, true },
	{ "ShardsFound", "Find a Void Shard", "Find %s Void Shards", { 1, 3, 5 }, false },
	{ "UpgradesBought", "Buy an upgrade", "Buy %s upgrades", { 3, 5, 10 }, false },
	{ "MeteorsContested", "Qualify on a boss meteor", "Qualify on %s boss meteors", { 1, 3 }, false },
	{ "EventsJoined", "Join a world event", "Join %s world events", { 1, 2 }, false },
	{ "ArtifactsForged", "Forge an artifact", "Forge %s artifacts", { 1, 2 }, false },
	{ "HazardsSurvived", "Fly through a hazard", "Fly through %s hazards", { 1, 3 }, false },
	{ "AnomaliesSeen", "Witness an anomaly", "Witness %s anomalies", { 1 }, false },
	{ "RiftClears", "Clear the Void Rift", "Clear the Void Rift %s times", { 1 }, false },
	{ "SquadMinutes", "Fly a minute in a squad", "Fly %s minutes in a squad", { 5, 15 }, false },
	{ "PlaytimeMinutes", "Fly for a minute", "Fly for %s minutes", { 10, 20, 30 }, false },
	{ "OreStored", "Store an ore", "Store %s ore", { 100, 250, 500 }, true },
	{ "Warps", "Warp once", "Warp %s times", { 1, 3 }, false },
}

local WEEKLY: { { any } } = {
	{ "RocksMined", "Break a rock", "Break %s rocks", { 500, 1000, 2500 }, false },
	{ "Sells", "Refine cargo once", "Refine cargo %s times", { 100, 250 }, false },
	{ "CreditsEarned", "Earn a Credit", "Earn %s Credits", { 5000, 15000, 40000 }, true },
	{ "ShardsFound", "Find a Void Shard", "Find %s Void Shards", { 20, 50 }, false },
	{ "MeteorsContested", "Qualify on a boss meteor", "Qualify on %s boss meteors", { 10, 25 }, false },
	{ "EventsJoined", "Join a world event", "Join %s world events", { 10 }, false },
	{ "ArtifactsForged", "Forge an artifact", "Forge %s artifacts", { 10 }, false },
	{ "RiftClears", "Clear the Void Rift", "Clear the Void Rift %s times", { 5 }, false },
	{ "SquadMinutes", "Fly a minute in a squad", "Fly %s minutes in a squad", { 120 }, false },
	{ "PlaytimeMinutes", "Fly for a minute", "Fly for %s minutes", { 180 }, false },
	{ "UpgradesBought", "Buy an upgrade", "Buy %s upgrades", { 50 }, false },
	{ "HazardsSurvived", "Fly through a hazard", "Fly through %s hazards", { 25 }, false },
}

local list: { Quest } = {}

local function build(cadence: string, templates: { any })
	for _, template in templates do
		local stat, one, pattern, targets, scales = template[1], template[2], template[3], template[4], template[5]
		for step, target in targets do
			local id = ("quest.%s.%s.%d"):format(string.lower(cadence), ContentUtil.Slug(stat), target)
			local weekly = cadence == "Weekly"
			table.insert(list, {
				Id = id,
				Name = if target == 1 then one else pattern:format(ContentUtil.FormatCount(target)),
				Cadence = cadence,
				Stat = stat,
				Target = target,
				ScalesWithTier = scales,
				RewardCredits = (if weekly then 400 else 60) * step,
				RewardShards = if weekly then 8 + 4 * step else 1 + step,
				RewardCosmetic = weekly and step == #targets,
			})
		end
	end
end

build("Daily", DAILY)
build("Weekly", WEEKLY)

local registry = ContentUtil.Registry("quest", list) :: any

local daily, weekly = {}, {}
for _, quest in list do
	table.insert(if quest.Cadence == "Daily" then daily else weekly, quest)
end
registry.Daily = daily
registry.Weekly = weekly
registry.PerCadence = 3

-- Display name for a pilot whose target was scaled by station tier.
function registry.NameFor(quest: Quest, target: number): string
	if not quest.ScalesWithTier then
		return quest.Name
	end
	local templates: { { any } } = if quest.Cadence == "Daily" then DAILY else WEEKLY
	for _, template in templates do
		if template[1] == quest.Stat then
			return template[3]:format(ContentUtil.FormatCount(target))
		end
	end
	return quest.Name
end

-- Target for a pilot at `stationTier` (credit/ore quests grow with tier).
function registry.TargetFor(quest: Quest, stationTier: number): number
	if not quest.ScalesWithTier then
		return quest.Target
	end
	return math.floor(quest.Target * 1.6 ^ math.max(0, stationTier - 1))
end

-- Three distinct quests for this pilot and period.
function registry.Assign(cadence: string, periodKey: string, userId: number): { Quest }
	local pool = if cadence == "Daily" then daily else weekly
	local rng = ContentUtil.Rng("quest-" .. cadence, periodKey .. ":" .. tostring(userId))
	local picked, usedStats = {}, {}
	for _, quest in rng:Shuffle(table.clone(pool)) do
		if not usedStats[quest.Stat] then
			usedStats[quest.Stat] = true
			table.insert(picked, quest)
			if #picked >= registry.PerCadence then
				break
			end
		end
	end
	return picked
end

return registry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">RelicRegistry</string>
            <string name="Source"><![CDATA[--!strict
-- Relics: 16 themed sets of 10 plus hand-made mythic uniques. Relics are found
-- rarely while mining, from boss meteors and Starfalls, fill the Codex and can
-- be shown on citadel pedestals. Completing a set unlocks a curator title.
-- FROZEN lists: SETS (append-only), NOUNS, RARITY_BY_SLOT, UNIQUES.
local ContentUtil = require(script.Parent.ContentUtil)

export type Relic = {
	Id: string,
	Name: string,
	Set: string,
	SetName: string,
	Rarity: string,
	RarityIndex: number,
	Shape: string,
	Color: Color3,
	Glow: Color3,
	DropWeight: number,
	Flavor: string,
}

type SetDef = { Id: string, Name: string, Owner: string, Color: Color3, Flavor: string }

local SETS: { SetDef } = {
	{
		Id = "titan_wreck",
		Name = "Titan Wreck",
		Owner = "Titan Navigator's",
		Color = Color3.fromRGB(150, 180, 160),
		Flavor = "Salvaged from the hull of a ship the size of a moon.",
	},
	{
		Id = "solar_forge",
		Name = "Solar Forge",
		Owner = "Forgemaster's",
		Color = Color3.fromRGB(255, 160, 60),
		Flavor = "Tempered in starlight by smiths who never slept.",
	},
	{
		Id = "magnetar_choir",
		Name = "Magnetar Choir",
		Owner = "Choirwarden's",
		Color = Color3.fromRGB(120, 140, 255),
		Flavor = "Still hums with the song of a dead star.",
	},
	{
		Id = "singularity_monks",
		Name = "Singularity Monks",
		Owner = "Horizon Monk's",
		Color = Color3.fromRGB(150, 90, 220),
		Flavor = "Kept by an order that meditated at the edge of a black hole.",
	},
	{
		Id = "diamond_nebula",
		Name = "Diamond Nebula",
		Owner = "Gemcutter's",
		Color = Color3.fromRGB(240, 220, 255),
		Flavor = "Cut from the glittering fog of the Diamond Nebula.",
	},
	{
		Id = "antimatter_cult",
		Name = "Antimatter Cult",
		Owner = "Mirror Priest's",
		Color = Color3.fromRGB(255, 80, 200),
		Flavor = "Its reflection is always a little late.",
	},
	{
		Id = "first_expedition",
		Name = "First Voidline Expedition",
		Owner = "Pathfinder's",
		Color = Color3.fromRGB(232, 186, 74),
		Flavor = "Carried by the first crews to cross the Void.",
	},
	{
		Id = "eclipse_navy",
		Name = "Eclipse Navy",
		Owner = "Eclipse Admiral's",
		Color = Color3.fromRGB(70, 70, 110),
		Flavor = "Issued to a fleet that only sailed in shadow.",
	},
	{
		Id = "starfall_pilgrims",
		Name = "Starfall Pilgrims",
		Owner = "Pilgrim's",
		Color = Color3.fromRGB(255, 220, 150),
		Flavor = "Pilgrims followed falling stars to find these.",
	},
	{
		Id = "quasar_archive",
		Name = "Quasar Archive",
		Owner = "Archivist's",
		Color = Color3.fromRGB(150, 230, 255),
		Flavor = "Indexed in a library lit by a quasar.",
	},
	{
		Id = "comet_nomads",
		Name = "Comet Nomads",
		Owner = "Nomad's",
		Color = Color3.fromRGB(180, 240, 255),
		Flavor = "Traded from tail to tail across a thousand comets.",
	},
	{
		Id = "aurora_court",
		Name = "Aurora Court",
		Owner = "Aurora Regent's",
		Color = Color3.fromRGB(120, 255, 190),
		Flavor = "Worn at a court that met beneath the aurora.",
	},
	{
		Id = "pulsar_clockmakers",
		Name = "Pulsar Clockmakers",
		Owner = "Clockmaker's",
		Color = Color3.fromRGB(200, 210, 255),
		Flavor = "Calibrated to the tick of a pulsar.",
	},
	{
		Id = "obsidian_guild",
		Name = "Obsidian Guild",
		Owner = "Guildmaster's",
		Color = Color3.fromRGB(40, 40, 55),
		Flavor = "Struck in obsidian and gold, the guild's colours.",
	},
	{
		Id = "gilded_armada",
		Name = "Gilded Armada",
		Owner = "Armada Captain's",
		Color = Color3.fromRGB(255, 200, 80),
		Flavor = "The armada never lost a battle, or a single bolt.",
	},
	{
		Id = "deep_cartographers",
		Name = "Deep Cartographers",
		Owner = "Cartographer's",
		Color = Color3.fromRGB(110, 200, 210),
		Flavor = "Maps of places that have since moved.",
	},
}

-- { noun, pedestal shape }
local NOUNS: { { string } } = {
	{ "Astrolabe", "Device" },
	{ "Compass", "Device" },
	{ "Crown", "Crown" },
	{ "Engine Core", "Orb" },
	{ "Lens", "Ring" },
	{ "Codex Page", "Tablet" },
	{ "Idol", "Idol" },
	{ "Key", "Shard" },
	{ "Bell", "Idol" },
	{ "Chalice", "Idol" },
	{ "Map Fragment", "Tablet" },
	{ "Medal", "Ring" },
	{ "Helm", "Crown" },
	{ "Lantern", "Orb" },
	{ "Sextant", "Device" },
	{ "Signet Ring", "Ring" },
	{ "Hourglass", "Device" },
	{ "Prism", "Shard" },
	{ "Tuning Fork", "Shard" },
	{ "Gauntlet", "Idol" },
	{ "Beacon", "Orb" },
	{ "Orrery", "Device" },
	{ "Seal", "Tablet" },
	{ "Reliquary", "Idol" },
	{ "Mask", "Idol" },
	{ "Circlet", "Crown" },
	{ "Spindle", "Shard" },
	{ "Censer", "Orb" },
	{ "Scepter", "Shard" },
	{ "Locket", "Ring" },
	{ "Horn", "Idol" },
	{ "Mirror", "Tablet" },
	{ "Anchor", "Idol" },
	{ "Quill", "Shard" },
	{ "Fossil", "Tablet" },
	{ "Dial", "Ring" },
	{ "Totem", "Idol" },
	{ "Star Chart", "Tablet" },
	{ "Gyroscope", "Device" },
	{ "Heartstone", "Orb" },
}

local RARITIES = {
	{ Name = "Rare", Weight = 60 },
	{ Name = "Epic", Weight = 28 },
	{ Name = "Legendary", Weight = 10 },
	{ Name = "Mythic", Weight = 2 },
}

-- Rarity of set slot 1..10.
local RARITY_BY_SLOT = { 1, 1, 1, 1, 2, 2, 2, 3, 3, 4 }
local ITEMS_PER_SET = 10

local UNIQUES: { { any } } = {
	{ "First Voidline Beacon", "Orb", Color3.fromRGB(255, 220, 120), "The light that guided the first crossing." },
	{ "Heart of the Monolith", "Orb", Color3.fromRGB(200, 160, 255), "It beats once every time the Monolith splits." },
	{
		"Creator's Golden Blueprint",
		"Tablet",
		Color3.fromRGB(232, 186, 74),
		"Signed by the architect of the Voidline.",
	},
	{
		"Event Horizon Compass",
		"Device",
		Color3.fromRGB(120, 90, 255),
		"Points at the one place you cannot return from.",
	},
	{ "Sovereign Halo Fragment", "Ring", Color3.fromRGB(255, 240, 180), "A piece of the first drone halo ever flown." },
	{ "Starforged Crown", "Crown", Color3.fromRGB(255, 200, 140), "Forged in a star and cooled in the Void." },
	{ "Antimatter Teardrop", "Shard", Color3.fromRGB(255, 90, 210), "Weighs less than nothing." },
	{ "Silent Choir Bell", "Idol", Color3.fromRGB(150, 170, 255), "Rings only when no one is listening." },
	{ "Obsidian Gate Key", "Shard", Color3.fromRGB(40, 40, 60), "Opens a gate no one has found." },
	{ "Comet Rider's Spur", "Shard", Color3.fromRGB(170, 240, 255), "Worn by the first pilot to ride a comet tail." },
}

local list: { Relic } = {}
local sets: { [string]: { string } } = {}

for _, set in SETS do
	local setRng = ContentUtil.Rng("relic-set", set.Id)
	local nouns = setRng:Sample(NOUNS, ITEMS_PER_SET)
	sets[set.Id] = {}
	for slot = 1, ITEMS_PER_SET do
		local id = ("relic.%s.%02d"):format(set.Id, slot)
		local rng = ContentUtil.Rng("relic", id)
		local noun = nouns[slot]
		local rarityIndex = RARITY_BY_SLOT[slot]
		local color = ContentUtil.ShiftColor(set.Color, rng, 0.05)
		table.insert(list, {
			Id = id,
			Name = set.Owner .. " " .. noun[1],
			Set = set.Id,
			SetName = set.Name,
			Rarity = RARITIES[rarityIndex].Name,
			RarityIndex = rarityIndex,
			Shape = noun[2],
			Color = color,
			Glow = color:Lerp(Color3.new(1, 1, 1), 0.35),
			DropWeight = RARITIES[rarityIndex].Weight,
			Flavor = set.Flavor,
		})
		table.insert(sets[set.Id], id)
	end
end

for _, unique in UNIQUES do
	local id = "relic.mythic." .. ContentUtil.Slug(unique[1])
	table.insert(list, {
		Id = id,
		Name = unique[1],
		Set = "mythic",
		SetName = "Mythic Uniques",
		Rarity = "Mythic",
		RarityIndex = 4,
		Shape = unique[2],
		Color = unique[3],
		Glow = unique[3]:Lerp(Color3.new(1, 1, 1), 0.4),
		DropWeight = 0.5,
		Flavor = unique[4],
	})
end

local registry = ContentUtil.Registry("relic", list) :: any
registry.Sets = SETS
registry.SetMembers = sets
registry.Rarities = RARITIES

local totalWeight = 0
for _, relic in list do
	totalWeight += relic.DropWeight
end

-- Weighted roll over every relic. `rng` exposes NextNumber() in [0, 1).
function registry.Roll(rng: any): Relic
	local pick = rng:NextNumber() * totalWeight
	for _, relic in list do
		pick -= relic.DropWeight
		if pick < 0 then
			return relic
		end
	end
	return list[#list]
end

-- Probability that a single relic roll yields `relicId`.
function registry.Odds(relicId: string): number
	local relic = registry.ById[relicId]
	return if relic then relic.DropWeight / totalWeight else 0
end

function registry.SetComplete(owned: { [string]: any }, setId: string): boolean
	local members = sets[setId]
	if not members then
		return false
	end
	for _, id in members do
		if not owned[id] then
			return false
		end
	end
	return true
end

return registry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">TitleRegistry</string>
            <string name="Source"><![CDATA[--!strict
-- Nameplate titles. Rebirth titles VOID I..L, owner-named titles, pass/code
-- titles, achievement ladder titles, relic-set curators and anomaly witnesses.
-- FROZEN lists: append-only (see ContentUtil).
local ContentUtil = require(script.Parent.ContentUtil)
local RelicRegistry = require(script.Parent.RelicRegistry)
local BiomeRegistry = require(script.Parent.BiomeRegistry)

export type Title = {
	Id: string,
	Name: string,
	Source: string,
	Rarity: string,
	Color: Color3,
}

local GOLD = Color3.fromRGB(255, 215, 110)
local VOID = Color3.fromRGB(170, 110, 255)
local CYAN = Color3.fromRGB(110, 220, 255)
local WHITE = Color3.fromRGB(235, 235, 245)

local VOID_TITLES = 50

local HANDMADE: { { string } } = {
	-- id, name, source, rarity
	{ "title.star_breaker", "STAR BREAKER", "Top contributor on 10 boss meteors", "Legendary" },
	{ "title.monolith_architect", "MONOLITH ARCHITECT", "Reach Station Tier 25", "Legendary" },
	{ "title.event_horizon", "EVENT HORIZON", "Evolve to Omega Antimatter", "Mythic" },
	{ "title.pass.pioneer", "PIONEER", "Starter Bundle", "Rare" },
	{ "title.pass.void_sovereign", "VOID SOVEREIGN", "Void Sovereign VIP", "Legendary" },
	{ "title.pass.eternal_architect", "ETERNAL ARCHITECT", "Eternal Architect", "Legendary" },
	{ "title.code.voidline", "VOIDLINER", "Code VOIDLINE", "Common" },
	{ "title.code.killshot", "KILLSHOT'S CREW", "Code KILLSHOT", "Rare" },
	{ "title.code.launch", "LAUNCH CREW", "Code LAUNCH", "Rare" },
	{ "title.sector.nebula", "NEBULA DRIFTER", "Discover the Nebula Ring", "Common" },
	{ "title.sector.voidrim", "RIM WALKER", "Discover the Void Rim", "Rare" },
	{ "title.sector.celestial", "CELESTIAL", "Discover Celestial Orbit", "Epic" },
	{ "title.formation.scatter", "SCATTERSHOT", "Fly the Scatter formation", "Common" },
	{ "title.formation.beam_link", "BEAM-LINKED", "Fly the Orbital Beam-Link", "Common" },
	{ "title.formation.halo", "HALO BEARER", "Fly the Sovereign Halo", "Common" },
	{ "title.event.starfall", "STARFALL CHASER", "Join a Void Starfall", "Rare" },
	{ "title.event.rift", "RIFT RUNNER", "Clear the Void Rift 5 times", "Epic" },
	{ "title.squad.captain", "SQUAD CAPTAIN", "Fly 300 minutes in a squad", "Epic" },
	{ "title.streak.seven", "SEVEN SUNS", "Claim 7 daily rewards", "Rare" },
	{ "title.forge.smith", "VOIDSMITH", "Forge 10 artifacts", "Rare" },
	{ "title.codex.scholar", "CODEX SCHOLAR", "Log 100 Codex entries", "Epic" },
	{ "title.codex.archivist", "GRAND ARCHIVIST", "Log 650 Codex entries", "Mythic" },
	{ "title.branch.miner", "DEEP DRILLER", "Choose the Miner drone line", "Rare" },
	{ "title.branch.hauler", "GRAVITY HAULER", "Choose the Hauler drone line", "Rare" },
	{ "title.branch.swarm", "SWARM MIND", "Choose the Swarm drone line", "Rare" },
	{ "title.ladder.credits.1", "CREDIT BARON", "Earn 1M lifetime Credits", "Rare" },
	{ "title.ladder.credits.2", "TYCOON", "Earn 1B lifetime Credits", "Epic" },
	{ "title.ladder.credits.3", "STAR MAGNATE", "Earn 100B lifetime Credits", "Legendary" },
	{ "title.ladder.rocks.1", "ROCK BREAKER", "Break 100 rocks", "Common" },
	{ "title.ladder.rocks.2", "BELT BANE", "Break 5K rocks", "Rare" },
	{ "title.ladder.rocks.3", "ASTEROID REAPER", "Break 100K rocks", "Legendary" },
	{ "title.ladder.shards.1", "SHARD SEEKER", "Find 100 Void Shards", "Rare" },
	{ "title.ladder.shards.2", "SHARD HOARDER", "Find 5K Void Shards", "Epic" },
	{ "title.ladder.relics.1", "RELIC HUNTER", "Collect 25 relics", "Rare" },
	{ "title.ladder.relics.2", "RELIC LORD", "Collect 150 relics", "Legendary" },
	{ "title.ladder.meteors.1", "METEOR BRAWLER", "Qualify on 50 boss meteors", "Rare" },
}

local RARITY_COLORS = {
	Common = WHITE,
	Rare = CYAN,
	Epic = VOID,
	Legendary = GOLD,
	Mythic = Color3.fromRGB(255, 120, 200),
}

local list: { Title } = {}

for n = 1, VOID_TITLES do
	table.insert(list, {
		Id = "title.void." .. n,
		Name = "VOID " .. ContentUtil.Roman(n),
		Source = "Rebirth " .. n,
		Rarity = if n >= 25 then "Mythic" elseif n >= 10 then "Legendary" elseif n >= 5 then "Epic" else "Rare",
		Color = VOID:Lerp(GOLD, math.min(1, (n - 1) / 24)),
	})
end

for _, entry in HANDMADE do
	table.insert(list, {
		Id = entry[1],
		Name = entry[2],
		Source = entry[3],
		Rarity = entry[4],
		Color = RARITY_COLORS[entry[4]],
	})
end

for _, set in RelicRegistry.Sets do
	table.insert(list, {
		Id = "title.curator." .. set.Id,
		Name = string.upper(set.Name) .. " CURATOR",
		Source = "Complete the " .. set.Name .. " relic set",
		Rarity = "Epic",
		Color = set.Color:Lerp(WHITE, 0.3),
	})
end

for _, archetype in BiomeRegistry.Archetypes do
	table.insert(list, {
		Id = "title.witness." .. archetype.Id,
		Name = string.upper(archetype.Name) .. " WITNESS",
		Source = "Witness a " .. archetype.Name,
		Rarity = "Rare",
		Color = archetype.Tint,
	})
end

local registry = ContentUtil.Registry("title", list) :: any
registry.RarityColors = RARITY_COLORS

function registry.VoidTitleId(rebirths: number): string?
	if rebirths < 1 then
		return nil
	end
	return "title.void." .. math.min(rebirths, VOID_TITLES)
end

return registry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">WorldEventRegistry</string>
            <string name="Source"><![CDATA[--!strict
-- Server-wide world events (every 6 min, 90 s; spec §7). Event kinds map to
-- WorldEventService handlers:
--   Monolith  - the Monolith splits, gravity/lighting shift, Void Core contest
--   Shower    - boss meteors fall around the Monolith (soft contest each)
--   Contest   - a single big core to contest (e.g. a Titan wreck)
--   Modifier  - server-wide multipliers for the duration
--   Rift      - the Void Rift parkour gate opens
-- FROZEN list: append-only.
local ContentUtil = require(script.Parent.ContentUtil)

export type WorldEvent = {
	Id: string,
	Name: string,
	Kind: string,
	Duration: number,
	Weight: number,
	Banner: string,
	Color: Color3,
	CoreHealth: number,
	Meteors: number,
	MeteorHealth: number,
	CreditMult: number,
	LuckMult: number,
	GravityMult: number,
	CelestialBias: number,
	RelicGuaranteed: boolean,
	Flavor: string,
}

local function event(fields: { [string]: any }): WorldEvent
	return {
		Id = fields.Id,
		Name = fields.Name,
		Kind = fields.Kind,
		Duration = fields.Duration or 90,
		Weight = fields.Weight or 1,
		Banner = fields.Banner,
		Color = fields.Color,
		CoreHealth = fields.CoreHealth or 0,
		Meteors = fields.Meteors or 0,
		MeteorHealth = fields.MeteorHealth or 0,
		CreditMult = fields.CreditMult or 1,
		LuckMult = fields.LuckMult or 1,
		GravityMult = fields.GravityMult or 1,
		CelestialBias = fields.CelestialBias or 1,
		RelicGuaranteed = fields.RelicGuaranteed or false,
		Flavor = fields.Flavor,
	}
end

local list: { WorldEvent } = {
	event({
		Id = "event.monolith_split",
		Name = "Monolith Split",
		Kind = "Monolith",
		Weight = 3,
		Banner = "THE MONOLITH SPLITS · VOID CORE EXPOSED",
		Color = Color3.fromRGB(170, 110, 255),
		CoreHealth = 12000,
		GravityMult = 0.6,
		Flavor = "The Monolith opens and gravity loosens its grip.",
	}),
	event({
		Id = "event.meteor_shower",
		Name = "Boss Meteor Shower",
		Kind = "Shower",
		Weight = 3,
		Banner = "BOSS METEORS INBOUND",
		Color = Color3.fromRGB(255, 150, 80),
		Meteors = 3,
		MeteorHealth = 5000,
		Flavor = "Three giants fall. Everyone who helps gets paid.",
	}),
	event({
		Id = "event.ion_storm",
		Name = "Ion Storm",
		Kind = "Modifier",
		Weight = 2,
		Banner = "ION STORM · SHARD LUCK x1.5",
		Color = Color3.fromRGB(90, 220, 255),
		LuckMult = 1.5,
		Flavor = "Charged dust shakes Void Shards loose.",
	}),
	event({
		Id = "event.solar_tide",
		Name = "Solar Tide",
		Kind = "Modifier",
		Weight = 2,
		Banner = "SOLAR TIDE · CREDITS x1.25",
		Color = Color3.fromRGB(255, 200, 90),
		CreditMult = 1.25,
		Flavor = "Refineries run hot and pay out more.",
	}),
	event({
		Id = "event.gravity_inversion",
		Name = "Gravity Inversion",
		Kind = "Modifier",
		Weight = 1,
		Banner = "GRAVITY INVERSION · MOON JUMPS",
		Color = Color3.fromRGB(140, 120, 255),
		GravityMult = 0.35,
		Flavor = "Every jump becomes a launch.",
	}),
	event({
		Id = "event.void_rift",
		Name = "Void Rift Opens",
		Kind = "Rift",
		Weight = 2,
		Banner = "THE VOID RIFT IS OPEN",
		Color = Color3.fromRGB(190, 120, 255),
		Flavor = "A path of floating shards leads to a reward cache.",
	}),
	event({
		Id = "event.comet_pass",
		Name = "Comet Pass",
		Kind = "Shower",
		Weight = 2,
		Banner = "COMET PASS · CELESTIAL FRAGMENTS",
		Color = Color3.fromRGB(180, 240, 255),
		Meteors = 5,
		MeteorHealth = 2500,
		CelestialBias = 4,
		Flavor = "A comet sheds glittering fragments as it passes.",
	}),
	event({
		Id = "event.derelict_titan",
		Name = "Derelict Titan Drift",
		Kind = "Contest",
		Weight = 1,
		Banner = "A DERELICT TITAN DRIFTS IN · RELIC GUARANTEED",
		Color = Color3.fromRGB(150, 200, 170),
		CoreHealth = 15000,
		RelicGuaranteed = true,
		Flavor = "Salvage the wreck; the top salvager keeps a relic.",
	}),
}

local registry = ContentUtil.Registry("event", list) :: any

-- Event for a rotation slot (same on every server at the same time).
function registry.ForSlot(slot: number): WorldEvent
	local total = 0
	for _, e in list do
		total += e.Weight
	end
	local rng = ContentUtil.Rng("event-slot", tostring(slot))
	local pick = rng:NextNumber() * total
	for _, e in list do
		pick -= e.Weight
		if pick < 0 then
			return e
		end
	end
	return list[#list]
end

return registry
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="31">
        <Properties>
          <string name="Name">Modules</string>
        </Properties>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">ContributionSplit</string>
            <string name="Source"><![CDATA[--!strict
-- Soft-contest reward split (GAME_DESIGN.md §6).
-- Qualify at >= MinDamagePercent of total damage. The #1 contributor takes the
-- TopContributorPool bonus plus their proportional share of ProportionalPool;
-- every other qualifier gets their proportional share. Shares sum to exactly 1
-- across qualifiers (or the result is empty when nobody dealt damage).
local SoftContestConfig = require(script.Parent.Parent.Config.SoftContestConfig)

local ContributionSplit = {}

local function sanitize(damage: any): number
	if type(damage) ~= "number" or damage ~= damage or damage <= 0 or damage == math.huge then
		return 0
	end
	return damage
end

-- Highest damage wins; exact ties resolve to the lowest UserId so the
-- "#1 TOP MINER" callout never depends on table iteration order.
function ContributionSplit.TopContributor(damageMap: { [number]: number }): number?
	local topId: number? = nil
	local topDamage = 0
	for userId, raw in damageMap do
		local damage = sanitize(raw)
		if damage > 0 then
			if damage > topDamage or (damage == topDamage and topId ~= nil and userId < topId) then
				topId = userId
				topDamage = damage
			end
		end
	end
	return topId
end

function ContributionSplit.Compute(damageMap: { [number]: number }): { [number]: number }
	-- Normalise by the largest hit first so huge values cannot overflow to inf.
	local maxDamage = 0
	for _, raw in damageMap do
		local damage = sanitize(raw)
		if damage > maxDamage then
			maxDamage = damage
		end
	end
	if maxDamage <= 0 then
		return {}
	end

	local normalised: { [number]: number } = {}
	local total = 0
	for userId, raw in damageMap do
		local damage = sanitize(raw)
		if damage > 0 then
			local n = damage / maxDamage
			normalised[userId] = n
			total += n
		end
	end

	local qualifiers: { [number]: number } = {}
	local qualifierTotal = 0
	for userId, n in normalised do
		if n / total >= SoftContestConfig.MinDamagePercent then
			qualifiers[userId] = n
			qualifierTotal += n
		end
	end

	local topId = ContributionSplit.TopContributor(qualifiers)
	if topId == nil or qualifierTotal <= 0 then
		return {}
	end

	local shares: { [number]: number } = {}
	for userId, n in qualifiers do
		shares[userId] = (n / qualifierTotal) * SoftContestConfig.ProportionalPool
	end
	shares[topId] += SoftContestConfig.TopContributorPool
	return shares
end

-- Convert fractional shares into whole-number payouts (largest remainder).
-- The sum of payouts never exceeds `pool`.
function ContributionSplit.Allocate(shares: { [number]: number }, pool: number): { [number]: number }
	local payouts: { [number]: number } = {}
	local whole = math.max(0, math.floor(sanitize(pool)))
	local remainders: { { userId: number, remainder: number } } = {}
	local assigned = 0
	for userId, share in shares do
		local exact = math.max(0, sanitize(share)) * whole
		local base = math.floor(exact)
		payouts[userId] = base
		assigned += base
		table.insert(remainders, { userId = userId, remainder = exact - base })
	end
	table.sort(remainders, function(a, b)
		if a.remainder ~= b.remainder then
			return a.remainder > b.remainder
		end
		return a.userId < b.userId
	end)
	local leftover = whole - assigned
	local i = 1
	while leftover > 0 and i <= #remainders do
		local userId = remainders[i].userId
		payouts[userId] += 1
		leftover -= 1
		i += 1
	end
	return payouts
end

return ContributionSplit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">FormatNumber</string>
            <string name="Source"><![CDATA[local FormatNumber = {}

function FormatNumber.Compact(n: number): string
	n = math.floor(n)
	if n >= 1_000_000_000 then
		return string.format("%.2fB", n / 1_000_000_000)
	elseif n >= 1_000_000 then
		return string.format("%.2fM", n / 1_000_000)
	elseif n >= 1_000 then
		return string.format("%.1fK", n / 1_000)
	end
	return tostring(n)
end

return FormatNumber
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">HubLayout</string>
            <string name="Source"><![CDATA[--!strict
-- Shared hub / deep-space geometry (world space, Monolith at the origin).
local HubLayout = {}

HubLayout.HubSize = Vector3.new(96, 2, 96)
HubLayout.MonolithSize = Vector3.new(18, 72, 18)
HubLayout.MonolithCenter = Vector3.new(0, 37, 0)
HubLayout.VoidCore = Vector3.new(0, 40, 0)
HubLayout.RebirthPad = Vector3.new(21, 1.5, 0)
HubLayout.ForgePad = Vector3.new(-21, 1.5, 0)
HubLayout.CodeTerminal = Vector3.new(0, 6, 25)
HubLayout.SummonPad = Vector3.new(0, 1.5, -25)
HubLayout.VipLounge = Vector3.new(34, 1.5, 34)
HubLayout.Monument = Vector3.new(-34, 1, 34)
HubLayout.OverlookGate = Vector3.new(-34, 1.5, -34)
HubLayout.RiftGate = Vector3.new(34, 1.5, -34)
HubLayout.Spawn = Vector3.new(0, 1.5, 38)

-- Leaderboards sit between bridge landings (bridges arrive every 30 deg).
HubLayout.BoardRadius = 36
HubLayout.Boards = {
	{ Id = "TopCredits", Title = "TOP CREDITS", Angle = 15 },
	{ Id = "TopRebirths", Title = "TOP REBIRTHS", Angle = 105 },
	{ Id = "CodexDiscoveries", Title = "CODEX DISCOVERIES", Angle = 195 },
	{ Id = "TopSummoners", Title = "TOP SUMMONERS", Angle = 285 },
}

function HubLayout.BoardCFrame(angleDegrees: number): CFrame
	local a = math.rad(angleDegrees)
	local pos = Vector3.new(math.cos(a) * HubLayout.BoardRadius, 10, math.sin(a) * HubLayout.BoardRadius)
	return CFrame.lookAt(pos, Vector3.new(0, 10, 0))
end

-- Shared deep-space rocks float in a ring just beyond the hub edge, in drone
-- range (42 studs) of a pilot standing at the hub rim.
HubLayout.SharedRockRadius = 64
HubLayout.SharedRockHeight = 16

function HubLayout.SharedRockSlot(slot: number, slots: number): Vector3
	local a = (slot - 0.5) / slots * math.pi * 2 + math.rad(15)
	return Vector3.new(
		math.cos(a) * HubLayout.SharedRockRadius,
		HubLayout.SharedRockHeight,
		math.sin(a) * HubLayout.SharedRockRadius
	)
end

-- Boss meteors hover above the hub so everyone on it can reach them.
function HubLayout.MeteorSlot(slot: number, slots: number): Vector3
	local a = (slot - 1) / math.max(1, slots) * math.pi * 2
	return Vector3.new(math.cos(a) * 30, 28, math.sin(a) * 30)
end

-- Deep-space zone: where anomaly hazards land and witnesses are counted.
HubLayout.ZoneRadius = 100

-- Void Rift parkour: a spiral of floating shards up the Monolith.
HubLayout.RiftPlatforms = 18
function HubLayout.RiftPlatform(i: number): Vector3
	local t = (i - 1) / (HubLayout.RiftPlatforms - 1)
	local a = math.rad(45) + t * math.pi * 3.5
	local radius = 22 - t * 6
	return Vector3.new(math.cos(a) * radius, 6 + t * 64, math.sin(a) * radius)
end
HubLayout.RiftCache = Vector3.new(0, 74.5, 0)

-- The quiet star overlook (cosmetic aura only).
HubLayout.Overlook = Vector3.new(180, 60, -180)

return HubLayout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">OreMath</string>
            <string name="Source"><![CDATA[local EconomyConfig = require(script.Parent.Parent.Config.EconomyConfig)

local OreMath = {}

function OreMath.SellValue(oreAmount: number, sectorId: string, creditMult: number, has2x: boolean): number
	local per = EconomyConfig.OreValueBySector[sectorId] or EconomyConfig.CreditsPerOreBase
	local value = oreAmount * per * creditMult
	if has2x then
		value *= 2
	end
	return math.floor(value)
end

function OreMath.CargoCap(cargoLevel: number): number
	return EconomyConfig.CargoCapacityForLevel(cargoLevel)
end

return OreMath
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">PlotLayout</string>
            <string name="Source"><![CDATA[--!strict
-- Shared plot geometry: 12 plots on a ring facing the hub. Local plot space:
-- +Y up, -Z toward the hub (Monolith). MapBuilder builds from these offsets,
-- server services validate distances with them and clients aim beams at them.
local GameConfig = require(script.Parent.Parent.Config.GameConfig)

local PlotLayout = {}

PlotLayout.BaseSize = Vector3.new(60, 2, 60)
PlotLayout.SurfaceY = 2
PlotLayout.Spawn = Vector3.new(0, 2.6, 8)
PlotLayout.Refinery = Vector3.new(-12, 2.2, -1)
PlotLayout.RefinerySize = Vector3.new(10, 1, 10)
PlotLayout.RefineryTower = Vector3.new(-12, 8, 9)
PlotLayout.Grinder = Vector3.new(13, 7, 6)
PlotLayout.LaserTuner = Vector3.new(-23, 2.2, 15)
PlotLayout.BridgeStart = Vector3.new(0, 1.6, -30)
PlotLayout.BridgeSegments = 12
PlotLayout.PadSize = Vector3.new(8, 1, 8)

-- Upgrade pads in a row toward the hub, in Quick-Upgrade order.
PlotLayout.Pads = {
	Drill = Vector3.new(-20, 2.2, -15),
	Cargo = Vector3.new(-10, 2.2, -15),
	DroneSlot = Vector3.new(0, 2.2, -15),
	StationTier = Vector3.new(10, 2.2, -15),
	DroneTier = Vector3.new(20, 2.2, -15),
} :: { [string]: Vector3 }

-- Relic pedestals along the back edge, centre outwards.
PlotLayout.PedestalCount = 11
function PlotLayout.Pedestal(slot: number): Vector3
	local offset = math.ceil((slot - 1) / 2) * (if slot % 2 == 0 then 4 else -4)
	return Vector3.new(offset, 3, 25)
end

-- Citadel structure anchors around the plot edge (back and sides).
PlotLayout.CitadelAnchors = {
	Vector3.new(-26, 2, 26),
	Vector3.new(26, 2, 26),
	Vector3.new(-26, 2, 10),
	Vector3.new(26, 2, 10),
	Vector3.new(-26, 2, -4),
	Vector3.new(26, 2, -4),
	Vector3.new(-14, 2, 20),
	Vector3.new(14, 2, 20),
	Vector3.new(-26, 2, -24),
	Vector3.new(26, 2, -24),
}

-- Belt rocks: a ring behind and beside the plot, never over the bridge.
PlotLayout.BeltRadius = 38
PlotLayout.BeltHeight = 12

function PlotLayout.PlotCFrame(index: number): CFrame
	local angle = ((index - 1) / GameConfig.PlotCount) * math.pi * 2
	local center =
		Vector3.new(math.cos(angle) * GameConfig.PlotRingRadius, 0, math.sin(angle) * GameConfig.PlotRingRadius)
	return CFrame.lookAt(center, Vector3.new(0, 0, 0))
end

function PlotLayout.World(index: number, localOffset: Vector3): Vector3
	return PlotLayout.PlotCFrame(index):PointToWorldSpace(localOffset)
end

-- Belt slot position. Slots spread over 240 degrees behind the plot.
function PlotLayout.BeltSlot(index: number, slot: number, slots: number, wobble: number?): Vector3
	local t = if slots > 1 then (slot - 1) / (slots - 1) else 0.5
	local angle = math.rad(60 + 240 * t)
	local radius = PlotLayout.BeltRadius + (wobble or 0)
	-- Local angle 0 points at the hub (-Z); sweep around the back.
	local localPos =
		Vector3.new(math.sin(angle) * radius, PlotLayout.BeltHeight + (wobble or 0) * 0.5, -math.cos(angle) * radius)
	return PlotLayout.World(index, localPos)
end

-- Where the bridge meets the hub ring.
function PlotLayout.BridgeEnd(index: number): Vector3
	local cf = PlotLayout.PlotCFrame(index)
	local outward = Vector3.new(cf.Position.X, 0, cf.Position.Z).Unit
	return outward * (GameConfig.HubRadius - 1) + Vector3.new(0, 1.6, 0)
end

return PlotLayout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">ProfileSchema</string>
            <string name="Source"><![CDATA[--!strict
-- Saved profile shape, defaults and migration. Shared so the client can start
-- from the same defaults before its first snapshot arrives.
-- Rules: never drop unknown fields, never rename keys, registry IDs are stable
-- strings. Bump VERSION and add a step to Migrate for every shape change.
local ProfileSchema = {}

ProfileSchema.VERSION = 2
ProfileSchema.MAX_RECEIPTS = 64
-- Diff replication marks a removed sub-key with this value (never a real value).
ProfileSchema.REMOVED = "\0nil"

local function defaults()
	return {
		Version = ProfileSchema.VERSION,
		Credits = 0,
		LifetimeCredits = 0,
		Ore = 0,
		CargoValue = 0,
		LifetimeOre = 0,
		VoidShards = 0,
		LifetimeShards = 0,
		Artifacts = 0,
		VoidlineTokens = 0,
		LifetimeTokens = 0,
		Rebirths = 0,
		CreditMult = 1,
		StationTier = 1,
		DrillLevel = 1,
		CargoLevel = 1,
		DroneSlots = 1,
		DroneTier = 1,
		DroneBranch = "",
		Formation = 1,
		GalaxyFlags = { Starter = true, Nebula = false, VoidRim = false, Celestial = false },
		OwnedPerks = {},
		PassGrants = {},
		TrialVouchers = {},
		RedeemedCodes = {},
		TutorialStep = 1,
		TutorialComplete = false,
		TutorialSkipped = false,
		TutorialFlags = { Drill = false, Cargo = false, Drone = false },
		Settings = {
			PerfMode = false,
			HideJetpack = false,
			ClipMode = false,
			ReducedMotion = false,
			LaserColor = "Gold",
			MusicVolume = 0.5,
			SfxVolume = 0.8,
		},
		Cosmetics = { Title = "", LaserShader = "", Thruster = "", HitEffect = "", DroneMutation = "" },
		Titles = {},
		Unlocks = {},
		ForgeTokensEarnedToday = 0,
		ForgeDayKey = "",
		ForgeJobEndsAt = 0,
		DailyStreak = 0,
		LastLoginDay = "",
		LastDailyClaimDay = "",
		Codex = {},
		Relics = {},
		RelicDisplay = {},
		Stats = {},
		Achievements = {},
		Quests = { DayKey = "", Daily = {}, WeekKey = "", Weekly = {} },
		ProcessedReceipts = {},
		FirstJoin = 0,
		LastSeen = 0,
		PlaytimeSeconds = 0,
	}
end

local function deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = deepCopy(v)
	end
	return copy
end
ProfileSchema.DeepCopy = deepCopy

function ProfileSchema.Default(): any
	return defaults()
end

local function isFinite(n: number): boolean
	return n == n and n ~= math.huge and n ~= -math.huge
end

-- Fills missing keys and repairs wrong types/non-finite numbers in place.
-- Unknown keys are preserved untouched.
local function reconcile(target: any, template: any)
	for key, defaultValue in template do
		local current = target[key]
		if current == nil then
			target[key] = deepCopy(defaultValue)
		elseif type(defaultValue) == "table" then
			if type(current) ~= "table" then
				target[key] = deepCopy(defaultValue)
			else
				reconcile(current, defaultValue)
			end
		elseif type(current) ~= type(defaultValue) or (type(current) == "number" and not isFinite(current)) then
			target[key] = defaultValue
		end
	end
end

-- Integer counters that must never go negative.
local NON_NEGATIVE = {
	"Credits",
	"LifetimeCredits",
	"Ore",
	"CargoValue",
	"LifetimeOre",
	"VoidShards",
	"LifetimeShards",
	"Artifacts",
	"VoidlineTokens",
	"LifetimeTokens",
	"Rebirths",
	"ForgeTokensEarnedToday",
	"ForgeJobEndsAt",
	"DailyStreak",
	"PlaytimeSeconds",
}

local AT_LEAST_ONE = { "StationTier", "DrillLevel", "CargoLevel", "DroneSlots", "DroneTier", "Formation" }

-- Accepts anything read from a DataStore (nil, v1 flat profile, v2 profile)
-- and returns a valid current-version profile.
function ProfileSchema.Migrate(saved: any): any
	if type(saved) ~= "table" then
		return defaults()
	end
	local profile = saved
	local version = if type(profile.Version) == "number" then profile.Version else 1

	if version < 2 then
		-- v1 had no cargo value; value existing ore at the starter rate.
		if type(profile.Ore) == "number" and profile.CargoValue == nil then
			profile.CargoValue = math.max(0, math.floor(profile.Ore)) * 3
		end
		-- v1 stored Cosmetics.Title = nil; v2 uses "" for none.
		-- v1 had no lifetime counters; seed them from current balances.
		if profile.LifetimeCredits == nil and type(profile.Credits) == "number" then
			profile.LifetimeCredits = profile.Credits
		end
		if profile.LifetimeShards == nil and type(profile.VoidShards) == "number" then
			profile.LifetimeShards = profile.VoidShards
		end
		if profile.LifetimeTokens == nil and type(profile.VoidlineTokens) == "number" then
			profile.LifetimeTokens = profile.VoidlineTokens
		end
		-- v1 kept the session plot index in the profile; plots are per server.
		profile.PlotIndex = nil
	end

	reconcile(profile, defaults())

	for _, key in NON_NEGATIVE do
		profile[key] = math.max(0, math.floor(profile[key]))
	end
	for _, key in AT_LEAST_ONE do
		profile[key] = math.max(1, math.floor(profile[key]))
	end
	profile.Formation = math.clamp(profile.Formation, 1, 3)
	profile.TutorialStep = math.clamp(math.floor(profile.TutorialStep), 1, 4)
	profile.Version = ProfileSchema.VERSION
	return profile
end

-- Records a processed purchase id and trims the oldest beyond MAX_RECEIPTS.
function ProfileSchema.RecordReceipt(profile: any, purchaseId: string, unixTime: number)
	local receipts = profile.ProcessedReceipts
	receipts[purchaseId] = unixTime
	local count = 0
	for _ in receipts do
		count += 1
	end
	while count > ProfileSchema.MAX_RECEIPTS do
		local oldestId, oldestTime = nil, math.huge
		for id, t in receipts do
			if t < oldestTime then
				oldestId, oldestTime = id, t
			end
		end
		if oldestId == nil then
			break
		end
		receipts[oldestId] = nil
		count -= 1
	end
end

function ProfileSchema.Bump(profile: any, statId: string, amount: number?)
	local stats = profile.Stats
	stats[statId] = (stats[statId] or 0) + (amount or 1)
end

return ProfileSchema
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[--!strict
-- Per-key token bucket. `minInterval` is the steady-state spacing between
-- allowed calls; `burst` (default 1) is how many calls may arrive at once.
-- RateLimiter.new(0.5) keeps the original "once per 0.5s" behaviour.
local RateLimiter = {}
RateLimiter.__index = RateLimiter

type Bucket = { tokens: number, stamp: number }

export type RateLimiter = typeof(setmetatable(
	{} :: {
		_interval: number,
		_burst: number,
		_buckets: { [any]: Bucket },
	},
	RateLimiter
))

function RateLimiter.new(minInterval: number, burst: number?): RateLimiter
	assert(type(minInterval) == "number" and minInterval > 0, "RateLimiter.new: minInterval must be > 0")
	return setmetatable({
		_interval = minInterval,
		_burst = math.max(1, burst or 1),
		_buckets = {},
	}, RateLimiter)
end

function RateLimiter.Allow(self: RateLimiter, key: any): boolean
	local now = os.clock()
	local bucket = self._buckets[key]
	if bucket == nil then
		bucket = { tokens = self._burst, stamp = now }
		self._buckets[key] = bucket
	else
		local refill = (now - bucket.stamp) / self._interval
		bucket.tokens = math.min(self._burst, bucket.tokens + math.max(0, refill))
		bucket.stamp = now
	end
	if bucket.tokens >= 1 then
		bucket.tokens -= 1
		return true
	end
	return false
end

function RateLimiter.Clear(self: RateLimiter, key: any)
	self._buckets[key] = nil
end

return RateLimiter
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--!strict
-- Remote registry. Only the server creates remotes (ReplicatedStorage.Voidline.Net);
-- clients wait for the server's instances. A client must never create its own
-- copy: a client-created RemoteEvent does not replicate and silently drops traffic.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "Net"
local CLIENT_WAIT_SECONDS = 60

-- "Event" = RemoteEvent (reliable). "Unreliable" = UnreliableRemoteEvent for
-- high-frequency cosmetic state where a dropped packet is harmless.
local REMOTES: { [string]: "Event" | "Unreliable" } = {
	-- client -> server (every one is bound through ValidateRemote.Bind)
	RequestUpgrade = "Event",
	QuickUpgrade = "Event",
	SetFormation = "Event",
	SellOre = "Event",
	RequestRebirth = "Event",
	RequestForge = "Event",
	TurnInArtifact = "Event",
	PurchaseWithTokens = "Event",
	PromptRobuxPurchase = "Event",
	SquadInvite = "Event",
	SquadRespond = "Event",
	SquadLeave = "Event",
	SquadKick = "Event",
	SettingsUpdate = "Event",
	RedeemCode = "Event",
	RedeemDaily = "Event",
	EquipCosmetic = "Event",
	TutorialSkip = "Event",
	PlayerInput = "Event",
	WarpRequest = "Event",
	SetRelicDisplay = "Event",
	InspectPilot = "Event",
	-- server -> client
	DataSnapshot = "Event",
	TutorialProgress = "Event",
	JuiceEvent = "Event",
	StoreState = "Event",
	SquadUpdate = "Event",
	InspectResult = "Event",
	SoftContestUpdate = "Unreliable",
}

local Remotes = {}
Remotes.Names = REMOTES

local function serverFolder(): Folder
	local voidline = ReplicatedStorage:WaitForChild("Voidline")
	local existing = voidline:FindFirstChild(FOLDER_NAME)
	if existing and existing:IsA("Folder") then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = FOLDER_NAME
	folder.Parent = voidline
	return folder
end

-- Server only. Idempotent.
function Remotes.Ensure(): Folder
	assert(RunService:IsServer(), "Remotes.Ensure is server-only; clients use Remotes.Get")
	local folder = serverFolder()
	for name, kind in REMOTES do
		if not folder:FindFirstChild(name) then
			local className = if kind == "Unreliable" then "UnreliableRemoteEvent" else "RemoteEvent"
			local remote = Instance.new(className)
			remote.Name = name
			remote.Parent = folder
		end
	end
	return folder
end

local cache: { [string]: Instance } = {}

local function resolve(name: string): Instance
	local hit = cache[name]
	if hit and hit.Parent then
		return hit
	end
	assert(REMOTES[name] ~= nil, "Unknown remote " .. name)
	local folder: Instance
	if RunService:IsServer() then
		folder = Remotes.Ensure()
	else
		local voidline = ReplicatedStorage:WaitForChild("Voidline")
		local found = voidline:WaitForChild(FOLDER_NAME, CLIENT_WAIT_SECONDS)
		assert(found, "Voidline remotes folder never replicated (is the server running Boot?)")
		folder = found
	end
	local remote = folder:WaitForChild(name, CLIENT_WAIT_SECONDS)
	assert(remote, "Missing remote " .. name)
	cache[name] = remote
	return remote
end

function Remotes.Get(name: string): RemoteEvent
	local remote = resolve(name)
	assert(remote:IsA("RemoteEvent"), name .. " is not a reliable RemoteEvent")
	return remote
end

function Remotes.GetUnreliable(name: string): UnreliableRemoteEvent
	local remote = resolve(name)
	assert(remote:IsA("UnreliableRemoteEvent"), name .. " is not an UnreliableRemoteEvent")
	return remote
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="40">
        <Properties>
          <string name="Name">Rules</string>
        </Properties>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">AchievementRules</string>
            <string name="Source"><![CDATA[--!strict
-- Achievement evaluation and grants (pure). Stat keys come from
-- AchievementRegistry; derived keys are resolved here.
local Content = script.Parent.Parent.Content
local AchievementRegistry = require(Content.AchievementRegistry)
local RelicRegistry = require(Content.RelicRegistry)

local AchievementRules = {}

local function count(map: { [string]: any }): number
	local n = 0
	for _ in map do
		n += 1
	end
	return n
end
AchievementRules.Count = count

function AchievementRules.StatValue(profile: any, stat: string): number
	local direct = profile[stat]
	if type(direct) == "number" then
		return direct
	end
	if stat == "CodexCount" then
		return count(profile.Codex)
	elseif stat == "RelicCount" then
		return count(profile.Relics)
	end
	local prefix, arg = string.match(stat, "^(%a+):(.+)$")
	if prefix == "Flag" then
		local node = profile
		for part in string.gmatch(arg :: string, "[^%.]+") do
			node = if type(node) == "table" then node[part] else nil
		end
		return if node == true then 1 else 0
	elseif prefix == "RelicSet" then
		return if RelicRegistry.SetComplete(profile.Relics, arg :: string) then 1 else 0
	elseif prefix == "Branch" then
		return if profile.DroneBranch == arg then 1 else 0
	elseif prefix ~= nil then
		-- Formation:<n>, OreTier:<n>, Archetype:<id> are plain counters.
		return profile.Stats[stat] or 0
	end
	return profile.Stats[stat] or 0
end

export type Grant = {
	Id: string,
	Name: string,
	Credits: number,
	Shards: number,
	Title: string,
	Unlock: string,
}

function AchievementRules.Grant(profile: any, achievement: any, unixTime: number): Grant?
	if profile.Achievements[achievement.Id] then
		return nil
	end
	profile.Achievements[achievement.Id] = unixTime
	profile.Credits += achievement.RewardCredits
	profile.LifetimeCredits += achievement.RewardCredits
	profile.VoidShards += achievement.RewardShards
	profile.LifetimeShards += achievement.RewardShards
	if achievement.RewardTitle ~= "" then
		profile.Titles[achievement.RewardTitle] = true
	end
	if achievement.RewardUnlock ~= "" then
		profile.Unlocks[achievement.RewardUnlock] = true
	end
	return {
		Id = achievement.Id,
		Name = achievement.Name,
		Credits = achievement.RewardCredits,
		Shards = achievement.RewardShards,
		Title = achievement.RewardTitle,
		Unlock = achievement.RewardUnlock,
	}
end

-- Grants every newly reached achievement for `stat`. Rewards that move other
-- stats (credits, shards) are re-checked until nothing new unlocks.
function AchievementRules.Check(profile: any, stat: string, unixTime: number): { Grant }
	local granted = {}
	local queue = { stat }
	local queued = { [stat] = true }
	local guard = 0
	while #queue > 0 and guard < 64 do
		guard += 1
		local current = table.remove(queue, 1) :: string
		queued[current] = nil
		local group = AchievementRegistry.ByStat[current]
		if group then
			local value = AchievementRules.StatValue(profile, current)
			for _, achievement in group do
				if achievement.Threshold > value then
					break
				end
				local grant = AchievementRules.Grant(profile, achievement, unixTime)
				if grant then
					table.insert(granted, grant)
					for _, follow in { "LifetimeCredits", "LifetimeShards" } do
						if not queued[follow] then
							queued[follow] = true
							table.insert(queue, follow)
						end
					end
				end
			end
		end
	end
	return granted
end

-- Every stat key the registry uses (for a full re-check on load).
function AchievementRules.AllStats(): { string }
	local stats = {}
	for stat in AchievementRegistry.ByStat do
		table.insert(stats, stat)
	end
	table.sort(stats)
	return stats
end

return AchievementRules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">EconomyRules</string>
            <string name="Source"><![CDATA[--!strict
-- Pure economy rules shared by server services, the client HUD and tests.
-- Functions that mutate take the profile table explicitly; nothing here
-- touches Instances, remotes or DataStores.
local Config = script.Parent.Parent.Config
local EconomyConfig = require(Config.EconomyConfig)
local GalaxyConfig = require(Config.GalaxyConfig)
local RebirthConfig = require(Config.RebirthConfig)
local DroneConfig = require(Config.DroneConfig)

export type Ctx = {
	Perks: { [string]: boolean }?,
	CreditBoost: number?,
	CodexMult: number?,
}

local EconomyRules = {}

function EconomyRules.HasPerk(ctx: Ctx?, perkId: string): boolean
	return ctx ~= nil and ctx.Perks ~= nil and ctx.Perks[perkId] == true
end

function EconomyRules.CargoCap(profile: any): number
	return EconomyConfig.CargoCapacityForLevel(profile.CargoLevel)
end

function EconomyRules.CargoSpace(profile: any): number
	return math.max(0, EconomyRules.CargoCap(profile) - profile.Ore)
end

function EconomyRules.ActiveSector(profile: any): string
	return GalaxyConfig.ActiveSector(profile)
end

function EconomyRules.UnitValue(sectorId: string, variantMult: number?): number
	local base = EconomyConfig.OreValueBySector[sectorId] or EconomyConfig.CreditsPerOreBase
	return base * (variantMult or 1)
end

-- Adds ore up to the cargo cap. Returns how many units were stored.
function EconomyRules.AddOre(profile: any, amount: number, unitValue: number): number
	if amount ~= amount or amount <= 0 or unitValue ~= unitValue or unitValue < 0 then
		return 0
	end
	local added = math.min(math.floor(amount), EconomyRules.CargoSpace(profile))
	if added <= 0 then
		return 0
	end
	profile.Ore += added
	profile.CargoValue += added * unitValue
	profile.LifetimeOre += added
	return added
end

function EconomyRules.CreditMultiplier(profile: any, ctx: Ctx?): number
	local mult = RebirthConfig.CreditMultiplier(profile.Rebirths)
	if EconomyRules.HasPerk(ctx, "Credits2x") then
		mult *= 2
	end
	if EconomyRules.HasPerk(ctx, "VoidSovereignVIP") then
		mult *= 1.1
	end
	if ctx then
		mult *= (ctx.CreditBoost or 1) * (ctx.CodexMult or 1)
	end
	return mult
end

function EconomyRules.SellPayout(profile: any, ctx: Ctx?): number
	if profile.Ore <= 0 or profile.CargoValue <= 0 then
		return 0
	end
	return math.floor(profile.CargoValue * EconomyRules.CreditMultiplier(profile, ctx) + 1e-9)
end

-- Sells the whole cargo hold. Returns credits paid and ore sold.
function EconomyRules.Sell(profile: any, ctx: Ctx?): (number, number)
	local ore = profile.Ore
	local payout = EconomyRules.SellPayout(profile, ctx)
	if ore <= 0 then
		return 0, 0
	end
	profile.Ore = 0
	profile.CargoValue = 0
	EconomyRules.AddCredits(profile, payout)
	return payout, ore
end

function EconomyRules.AddCredits(profile: any, amount: number)
	if amount ~= amount or amount <= 0 or amount == math.huge then
		return
	end
	profile.Credits += amount
	profile.LifetimeCredits += amount
end

function EconomyRules.NormalizeUpgradeId(upgradeId: string): string
	if upgradeId == "Drone2" then
		return "DroneSlot"
	end
	return upgradeId
end

function EconomyRules.UpgradeCost(profile: any, upgradeId: string, ctx: Ctx?): number?
	local def = EconomyConfig.Upgrades[EconomyRules.NormalizeUpgradeId(upgradeId)]
	if not def then
		return nil
	end
	local cost = def.Cost(profile[def.Stat])
	if def.Id == "StationTier" and EconomyRules.HasPerk(ctx, "EternalArchitect") then
		cost = math.floor(cost * 0.9)
	end
	return cost
end

-- Returns ok plus a short reason code: "unknown" | "max" | "locked" | "funds".
function EconomyRules.CanUpgrade(profile: any, upgradeId: string, ctx: Ctx?): (boolean, string?)
	local id = EconomyRules.NormalizeUpgradeId(upgradeId)
	local def = EconomyConfig.Upgrades[id]
	if not def then
		return false, "unknown"
	end
	if profile[def.Stat] >= def.Max then
		return false, "max"
	end
	if id == "DroneTier" and profile.StationTier < 2 * profile.DroneTier then
		return false, "locked"
	end
	local cost = EconomyRules.UpgradeCost(profile, id, ctx) :: number
	if profile.Credits < cost then
		return false, "funds"
	end
	return true, nil
end

-- Applies an upgrade. `branch` picks the drone evolution line at the branch stage.
function EconomyRules.ApplyUpgrade(
	profile: any,
	upgradeId: string,
	ctx: Ctx?,
	branch: string?
): (boolean, number, string?)
	local id = EconomyRules.NormalizeUpgradeId(upgradeId)
	local ok, reason = EconomyRules.CanUpgrade(profile, id, ctx)
	if not ok then
		return false, 0, reason
	end
	local def = EconomyConfig.Upgrades[id]
	local cost = EconomyRules.UpgradeCost(profile, id, ctx) :: number
	profile.Credits -= cost
	profile[def.Stat] += 1
	if id == "DroneTier" and profile.DroneTier >= DroneConfig.BranchStage and profile.DroneBranch == "" then
		profile.DroneBranch = if branch and DroneConfig.Branches[branch] then branch else "Miner"
	end
	EconomyRules.RefreshGalaxyFlags(profile)
	return true, cost, nil
end

-- Sectors stay discovered forever (no reset), spec §5.
function EconomyRules.RefreshGalaxyFlags(profile: any): { string }
	local newly = {}
	for _, sector in GalaxyConfig.Sectors do
		if not profile.GalaxyFlags[sector.Id] and GalaxyConfig.IsUnlocked(sector.Id, profile) then
			profile.GalaxyFlags[sector.Id] = true
			table.insert(newly, sector.Id)
		end
	end
	return newly
end

-- Quick-Upgrade (U): during onboarding follow the tutorial order, afterwards
-- buy the cheapest affordable upgrade.
function EconomyRules.QuickUpgradeChoice(profile: any, ctx: Ctx?): string?
	if not profile.TutorialComplete then
		local flags = profile.TutorialFlags
		for _, entry in { { "Drill", "Drill" }, { "Cargo", "Cargo" }, { "Drone", "DroneSlot" } } do
			if not flags[entry[1]] then
				local ok = EconomyRules.CanUpgrade(profile, entry[2], ctx)
				return if ok then entry[2] else nil
			end
		end
	end
	local best, bestCost = nil, math.huge
	for _, id in EconomyConfig.UpgradeOrder do
		if EconomyRules.CanUpgrade(profile, id, ctx) then
			local cost = EconomyRules.UpgradeCost(profile, id, ctx) :: number
			if cost < bestCost then
				best, bestCost = id, cost
			end
		end
	end
	return best
end

return EconomyRules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">MiningRules</string>
            <string name="Source"><![CDATA[--!strict
-- Drone swarm math (spec §6). Server-authoritative: the server simulates
-- damage with these numbers; clients only render.
local Config = script.Parent.Parent.Config
local DroneConfig = require(Config.DroneConfig)
local SquadConfig = require(Config.SquadConfig)

local MiningRules = {}

local function hasPerk(perks: { [string]: boolean }?, perkId: string): boolean
	return perks ~= nil and perks[perkId] == true
end

function MiningRules.BranchStats(profile: any)
	return DroneConfig.Branches[profile.DroneBranch]
end

function MiningRules.DroneCount(profile: any, perks: { [string]: boolean }?): number
	local count = profile.DroneSlots
	if hasPerk(perks, "DroneSlots3") then
		count += 3
	end
	if hasPerk(perks, "MegaSwarm5") then
		count += 5
	end
	local branch = MiningRules.BranchStats(profile)
	if branch and branch.ExtraDronesPerStages then
		local stagesInBranch = profile.DroneTier - DroneConfig.BranchStage + 1
		count += math.floor(math.max(0, stagesInBranch) / branch.ExtraDronesPerStages)
	end
	return math.clamp(count, 1, DroneConfig.MaxDrones)
end

function MiningRules.DamagePerDrone(profile: any, perks: { [string]: boolean }?): number
	local dps = DroneConfig.BaseDamagePerSecond + DroneConfig.DamagePerDrillLevel * (profile.DrillLevel - 1)
	dps *= 1 + DroneConfig.DamagePerDroneTier * (profile.DroneTier - 1)
	if hasPerk(perks, "LaserOverclock") then
		dps *= DroneConfig.LaserOverclockMult
	end
	local branch = MiningRules.BranchStats(profile)
	if branch then
		dps *= branch.DamageMult
	end
	return dps
end

-- Total swarm damage per second for a formation. `linkedSquadmates` counts
-- squad members also in Beam-Link formation.
function MiningRules.SwarmDps(
	profile: any,
	perks: { [string]: boolean }?,
	formation: number,
	linkedSquadmates: number?
): number
	local stats = DroneConfig.FormationStats[formation] or DroneConfig.FormationStats[1]
	local mult = stats.DamageMult
	if stats.SquadLinkBonus and linkedSquadmates then
		mult += stats.SquadLinkBonus * math.clamp(linkedSquadmates, 0, 3)
	end
	return MiningRules.DamagePerDrone(profile, perks) * MiningRules.DroneCount(profile, perks) * mult
end

function MiningRules.OrePerRock(profile: any, baseOre: number): number
	local branch = MiningRules.BranchStats(profile)
	local mult = if branch then branch.OreMult else 1
	return math.floor(baseOre * mult + 1e-9)
end

-- Seconds for a drone to tow a rock `distance` studs home.
function MiningRules.TowSeconds(profile: any, perks: { [string]: boolean }?, distance: number): number
	local speed = DroneConfig.TowSpeed
	local branch = MiningRules.BranchStats(profile)
	if branch then
		speed *= branch.TowMult
	end
	if hasPerk(perks, "DeepSpaceWarpPass") then
		speed *= 1.25
	end
	return math.clamp(distance / speed, DroneConfig.TowMinSeconds, DroneConfig.TowMaxSeconds)
end

-- Probability multiplier for shard/relic finds.
function MiningRules.LuckMultiplier(perks: { [string]: boolean }?, squadLinked: boolean, serverSurge: boolean): number
	local luck = 1
	if hasPerk(perks, "ShardRelicLuck2x") then
		luck *= 2
	end
	if serverSurge then
		luck *= 2
	end
	if squadLinked then
		luck *= 1 + SquadConfig.LinkedShardLuckBonus
	end
	return luck
end

return MiningRules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">ProgressionRules</string>
            <string name="Source"><![CDATA[--!strict
-- Forge, rebirth, daily streak and code rules (spec §5, §8, §11, §12).
local Config = script.Parent.Parent.Config
local ForgeConfig = require(Config.ForgeConfig)
local RebirthConfig = require(Config.RebirthConfig)
local DailyConfig = require(Config.DailyConfig)
local CodesConfig = require(Config.CodesConfig)

local ProgressionRules = {}

local SECONDS_PER_DAY = 86400

function ProgressionRules.DayKey(unixTime: number): string
	local d = os.date("!*t", math.floor(unixTime)) :: any
	return string.format("%04d-%02d-%02d", d.year, d.month, d.day)
end

-- Weeks start Monday 00:00 UTC (1970-01-05 was a Monday).
function ProgressionRules.WeekKey(unixTime: number): string
	local week = math.floor((unixTime - 4 * SECONDS_PER_DAY) / (7 * SECONDS_PER_DAY))
	return "W" .. tostring(week)
end

-- Forge ---------------------------------------------------------------------

function ProgressionRules.RefreshForgeDay(profile: any, unixTime: number)
	local key = ProgressionRules.DayKey(unixTime)
	if profile.ForgeDayKey ~= key then
		profile.ForgeDayKey = key
		profile.ForgeTokensEarnedToday = 0
	end
end

function ProgressionRules.ForgeCooling(profile: any): boolean
	return profile.ForgeTokensEarnedToday >= ForgeConfig.DailyTokenSoftCap
end

function ProgressionRules.ForgeDuration(profile: any): number
	local duration = ForgeConfig.ForgeDurationSeconds
	if ProgressionRules.ForgeCooling(profile) then
		duration /= ForgeConfig.CoolingMultiplier
	end
	return duration
end

-- Returns ok, reason ("busy" | "shards"), duration.
function ProgressionRules.StartForge(profile: any, unixTime: number): (boolean, string?, number)
	ProgressionRules.RefreshForgeDay(profile, unixTime)
	if profile.ForgeJobEndsAt > 0 then
		return false, "busy", 0
	end
	if profile.VoidShards < ForgeConfig.ShardsPerArtifact then
		return false, "shards", 0
	end
	local duration = ProgressionRules.ForgeDuration(profile)
	profile.VoidShards -= ForgeConfig.ShardsPerArtifact
	profile.ForgeJobEndsAt = unixTime + duration
	return true, nil, duration
end

-- Completes a finished job (also on rejoin: the job end time is saved).
function ProgressionRules.CollectForge(profile: any, unixTime: number): boolean
	if profile.ForgeJobEndsAt > 0 and unixTime >= profile.ForgeJobEndsAt then
		profile.ForgeJobEndsAt = 0
		profile.Artifacts += 1
		return true
	end
	return false
end

function ProgressionRules.TurnInArtifact(profile: any, unixTime: number): (boolean, number)
	ProgressionRules.RefreshForgeDay(profile, unixTime)
	if profile.Artifacts < 1 then
		return false, 0
	end
	local tokens = ForgeConfig.TokensPerArtifact
	profile.Artifacts -= 1
	profile.VoidlineTokens += tokens
	profile.LifetimeTokens += tokens
	profile.ForgeTokensEarnedToday += tokens
	return true, tokens
end

-- Rebirth -------------------------------------------------------------------

function ProgressionRules.CanRebirth(profile: any): boolean
	return profile.StationTier >= RebirthConfig.RequiredStationTier
end

-- Resets credits, station tier, drill/cargo and cargo hold. Keeps passes,
-- tokens, shards, artifacts, relics, codex, squads, cosmetics, drone slots/tier
-- and discovered sectors.
function ProgressionRules.Rebirth(profile: any): (number, number)
	local n = profile.Rebirths + 1
	local shards = RebirthConfig.ShardPayout(n)
	profile.Rebirths = n
	profile.CreditMult = RebirthConfig.CreditMultiplier(n)
	profile.Credits = 0
	profile.Ore = 0
	profile.CargoValue = 0
	profile.StationTier = 1
	profile.DrillLevel = 1
	profile.CargoLevel = 1
	profile.VoidShards += shards
	profile.LifetimeShards += shards
	return n, shards
end

-- Daily streak ----------------------------------------------------------------

-- Updates the streak position (1..7) on the first login of a UTC day.
function ProgressionRules.OnLogin(profile: any, unixTime: number): boolean
	local today = ProgressionRules.DayKey(unixTime)
	if profile.LastLoginDay == today then
		return false
	end
	local yesterday = ProgressionRules.DayKey(unixTime - SECONDS_PER_DAY)
	if profile.LastLoginDay == yesterday and profile.DailyStreak >= 1 then
		profile.DailyStreak = (profile.DailyStreak % DailyConfig.CycleLength) + 1
	else
		profile.DailyStreak = 1
	end
	profile.LastLoginDay = today
	return true
end

function ProgressionRules.CanClaimDaily(profile: any, unixTime: number): boolean
	return profile.LastDailyClaimDay ~= ProgressionRules.DayKey(unixTime)
end

function ProgressionRules.ClaimDaily(profile: any, unixTime: number): (boolean, DailyConfig.DayReward?, number)
	ProgressionRules.OnLogin(profile, unixTime)
	if not ProgressionRules.CanClaimDaily(profile, unixTime) then
		return false, nil, profile.DailyStreak
	end
	local day = math.clamp(profile.DailyStreak, 1, DailyConfig.CycleLength)
	local reward = DailyConfig.Rewards[day]
	profile.LastDailyClaimDay = ProgressionRules.DayKey(unixTime)
	profile.Credits += reward.Credits
	profile.LifetimeCredits += reward.Credits
	profile.VoidShards += reward.VoidShards
	profile.LifetimeShards += reward.VoidShards
	if reward.TrialPerk then
		local expires = unixTime + (reward.TrialHours or 24) * 3600
		profile.TrialVouchers[reward.TrialPerk] = math.max(profile.TrialVouchers[reward.TrialPerk] or 0, expires)
	end
	return true, reward, day
end

-- Codes -----------------------------------------------------------------------

function ProgressionRules.NormalizeCode(raw: any): string?
	if type(raw) ~= "string" or #raw > 64 then
		return nil
	end
	local code = string.upper((string.gsub(raw, "%s+", "")))
	if #code == 0 or #code > CodesConfig.MaxLength or string.find(code, "[^A-Z0-9]") then
		return nil
	end
	return code
end

-- Returns ok, reason ("invalid" | "unknown" | "used"), normalized code.
function ProgressionRules.RedeemCode(profile: any, raw: any): (boolean, string?, string?)
	local code = ProgressionRules.NormalizeCode(raw)
	if not code then
		return false, "invalid", nil
	end
	local reward = CodesConfig.Codes[code]
	if not reward then
		return false, "unknown", code
	end
	if profile.RedeemedCodes[code] then
		return false, "used", code
	end
	profile.RedeemedCodes[code] = true
	profile.Credits += reward.Credits
	profile.LifetimeCredits += reward.Credits
	profile.VoidShards += reward.VoidShards
	profile.LifetimeShards += reward.VoidShards
	if reward.Title then
		profile.Titles[reward.Title] = true
	end
	return true, nil, code
end

return ProgressionRules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">QuestRules</string>
            <string name="Source"><![CDATA[--!strict
-- Daily/weekly quest state (pure). Quests auto-complete and pay out the
-- moment their target is reached: no extra claim step to forget.
local Rules = script.Parent
local Content = Rules.Parent.Content
local QuestRegistry = require(Content.QuestRegistry)
local DroneRegistry = require(Content.DroneRegistry)
local ProgressionRules = require(Rules.ProgressionRules)

local QuestRules = {}

export type Completion = {
	Id: string,
	Name: string,
	Credits: number,
	Shards: number,
	Unlock: string,
}

local function assign(cadence: string, periodKey: string, userId: number, stationTier: number): { any }
	local out = {}
	for _, quest in QuestRegistry.Assign(cadence, periodKey, userId) do
		local target = QuestRegistry.TargetFor(quest, stationTier)
		table.insert(out, {
			Id = quest.Id,
			Name = QuestRegistry.NameFor(quest, target),
			Stat = quest.Stat,
			Target = target,
			Progress = 0,
			Done = false,
		})
	end
	return out
end

-- Rolls new quests when the UTC day/week changed. Returns true if refreshed.
function QuestRules.Refresh(profile: any, unixTime: number, userId: number): boolean
	local quests = profile.Quests
	local changed = false
	local day = ProgressionRules.DayKey(unixTime)
	if quests.DayKey ~= day then
		quests.DayKey = day
		quests.Daily = assign("Daily", day, userId, profile.StationTier)
		changed = true
	end
	local week = ProgressionRules.WeekKey(unixTime)
	if quests.WeekKey ~= week then
		quests.WeekKey = week
		quests.Weekly = assign("Weekly", week, userId, profile.StationTier)
		changed = true
	end
	return changed
end

local function lockedCosmetics(profile: any): { string }
	local out = {}
	for _, cosmetic in DroneRegistry.Cosmetics do
		if cosmetic.Source == "Achievements and quests" and not profile.Unlocks[cosmetic.Id] then
			table.insert(out, cosmetic.Id)
		end
	end
	return out
end

-- Adds progress for `stat`. `rng` (NextInteger) picks cosmetic rewards.
function QuestRules.Progress(profile: any, stat: string, amount: number, rng: any): { Completion }
	local completions = {}
	if amount <= 0 or amount ~= amount then
		return completions
	end
	for _, list in { profile.Quests.Daily, profile.Quests.Weekly } do
		for _, entry in list do
			if not entry.Done and entry.Stat == stat then
				entry.Progress = math.min(entry.Target, entry.Progress + amount)
				if entry.Progress >= entry.Target then
					entry.Done = true
					local quest = QuestRegistry.ById[entry.Id]
					local unlock = ""
					if quest then
						profile.Credits += quest.RewardCredits
						profile.LifetimeCredits += quest.RewardCredits
						profile.VoidShards += quest.RewardShards
						profile.LifetimeShards += quest.RewardShards
						if quest.RewardCosmetic then
							local pool = lockedCosmetics(profile)
							if #pool > 0 then
								unlock = pool[rng:NextInteger(1, #pool)]
								profile.Unlocks[unlock] = true
							end
						end
					end
					table.insert(completions, {
						Id = entry.Id,
						Name = entry.Name,
						Credits = if quest then quest.RewardCredits else 0,
						Shards = if quest then quest.RewardShards else 0,
						Unlock = unlock,
					})
				end
			end
		end
	end
	return completions
end

return QuestRules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">StoreRules</string>
            <string name="Source"><![CDATA[--!strict
-- Dual-currency store rules (spec §9). Tokens buy the same passes as Robux at
-- a 15-20% discount; tokens are earn-only and never tradeable.
local Config = script.Parent.Parent.Config
local MonetizationConfig = require(Config.MonetizationConfig)

local StoreRules = {}

-- Perks from purchases plus unexpired trial vouchers.
function StoreRules.EffectivePerks(
	profile: any,
	unixTime: number,
	ownedGamePasses: { [string]: boolean }?
): { [string]: boolean }
	local perks = {}
	for perkId, owned in profile.OwnedPerks do
		if owned then
			perks[perkId] = true
		end
	end
	if ownedGamePasses then
		for perkId, owned in ownedGamePasses do
			if owned then
				perks[perkId] = true
			end
		end
	end
	for perkId, expires in profile.TrialVouchers do
		if type(expires) == "number" and expires > unixTime then
			perks[perkId] = true
		end
	end
	return perks
end

-- Returns ok, reason ("unknown" | "owned" | "tokens"), price.
function StoreRules.BuyWithTokens(profile: any, passId: string): (boolean, string?, number)
	local pass = MonetizationConfig.GetPass(passId)
	if not pass then
		return false, "unknown", 0
	end
	if profile.OwnedPerks[passId] then
		return false, "owned", pass.Tokens
	end
	if profile.VoidlineTokens < pass.Tokens then
		return false, "tokens", pass.Tokens
	end
	profile.VoidlineTokens -= pass.Tokens
	profile.OwnedPerks[passId] = true
	return true, nil, pass.Tokens
end

-- One-time grants that come with owning a pass (however it was obtained).
-- Returns true when something new was granted.
function StoreRules.ApplyPassGrants(profile: any, passId: string): boolean
	if profile.PassGrants[passId] then
		return false
	end
	profile.PassGrants[passId] = true
	if passId == "StarterBundle" then
		local credits = MonetizationConfig.StarterBundleCredits
		profile.Credits += credits
		profile.LifetimeCredits += credits
		profile.Titles["title.pass.pioneer"] = true
		profile.Unlocks["thruster.gold_comet"] = true
	elseif passId == "VoidSovereignVIP" then
		profile.Titles["title.pass.void_sovereign"] = true
	elseif passId == "EternalArchitect" then
		profile.Titles["title.pass.eternal_architect"] = true
	elseif passId == "LaserOverclock" then
		profile.Unlocks["laser.overclock"] = true
	end
	return true
end

return StoreRules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">TutorialRules</string>
            <string name="Source"><![CDATA[--!strict
-- Diegetic 4-step onboarding (spec §4, owner brief ~45 s):
--   1 HARVESTING ORE -> 2 REFINE AT PAD -> 3 DEPLOY 2ND DRONE (+Drill, +Cargo,
--   +Drone) -> 4 ENERGY BRIDGE ONLINE (+100 Credits, bridge ignites).
-- Rewards are deterministic; the completion bonus is granted exactly once.
local Config = script.Parent.Parent.Config
local EconomyConfig = require(Config.EconomyConfig)
local GameConfig = require(Config.GameConfig)

local TutorialRules = {}

TutorialRules.Steps = {
	[1] = { Ticker = "[1/4] HARVESTING ORE", Hint = "Your drone is towing a rock home" },
	[2] = { Ticker = "[2/4] REFINE AT PAD", Hint = "Walk onto the gold Refinery pad" },
	[3] = { Ticker = "[3/4] DEPLOY 2ND DRONE", Hint = "Drill 20 · Cargo 35 · Drone 50" },
	[4] = { Ticker = "[4/4] ENERGY BRIDGE ONLINE", Hint = "+100 Credits" },
}
TutorialRules.DoneStep = 4

-- Upgrade id -> tutorial flag.
local FLAG_FOR_UPGRADE = {
	Drill = "Drill",
	Cargo = "Cargo",
	DroneSlot = "Drone",
	Drone2 = "Drone",
}

export type Change = { Step: number, Completed: boolean, Bonus: number }

local function complete(profile: any, skipped: boolean): Change
	profile.TutorialStep = TutorialRules.DoneStep
	profile.TutorialComplete = true
	profile.TutorialSkipped = skipped
	local bonus = GameConfig.TutorialCompleteBonusCredits
	profile.Credits += bonus
	profile.LifetimeCredits += bonus
	return { Step = TutorialRules.DoneStep, Completed = true, Bonus = bonus }
end

local function allFlags(profile: any): boolean
	local flags = profile.TutorialFlags
	return flags.Drill and flags.Cargo and flags.Drone
end

function TutorialRules.OnOreStored(profile: any): Change?
	if profile.TutorialComplete or profile.TutorialStep ~= 1 then
		return nil
	end
	if profile.Ore >= EconomyConfig.StarterCargoCapacity then
		profile.TutorialStep = 2
		return { Step = 2, Completed = false, Bonus = 0 }
	end
	return nil
end

function TutorialRules.OnSold(profile: any): Change?
	if profile.TutorialComplete or profile.TutorialStep > 2 then
		return nil
	end
	if allFlags(profile) then
		return complete(profile, false)
	end
	profile.TutorialStep = 3
	return { Step = 3, Completed = false, Bonus = 0 }
end

function TutorialRules.OnUpgrade(profile: any, upgradeId: string): Change?
	if profile.TutorialComplete then
		return nil
	end
	local flag = FLAG_FOR_UPGRADE[upgradeId]
	if not flag then
		return nil
	end
	profile.TutorialFlags[flag] = true
	if profile.TutorialStep == 3 and allFlags(profile) then
		return complete(profile, false)
	end
	return nil
end

-- The tiny Skip button: same end state and bonus as finishing normally.
function TutorialRules.Skip(profile: any): Change?
	if profile.TutorialComplete then
		return nil
	end
	return complete(profile, true)
end

-- Next upgrade the golden floor beam should point at during step 3.
function TutorialRules.NextUpgrade(profile: any): string?
	if profile.TutorialComplete or profile.TutorialStep ~= 3 then
		return nil
	end
	local flags = profile.TutorialFlags
	if not flags.Drill then
		return "Drill"
	elseif not flags.Cargo then
		return "Cargo"
	elseif not flags.Drone then
		return "DroneSlot"
	end
	return nil
end

return TutorialRules
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="48">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="49">
      <Properties>
        <string name="Name">Voidline</string>
      </Properties>
      <Item class="Script" referent="50">
        <Properties>
          <string name="Name">Boot</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Voidline: Deep Space — server boot.
	Order: remotes -> map -> services (callbacks registered) -> start loading
	profiles. A service whose Init throws is logged and skipped so one broken
	feature cannot take the whole server down.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local Remotes = require(Voidline.Remotes)
Remotes.Ensure()

local Services = script.Parent.Services

require(Services.MapBuilder).Build()

local ORDER = {
	"PlayerDataService",
	"WorldState",
	"JuiceService",
	"StatService",
	"CodexService",
	"PlotService",
	"RockService",
	"TowService",
	"TutorialService",
	"EconomyService",
	"RelicService",
	"BeltService",
	"DroneService",
	"SoftContestService",
	"RiftService",
	"WorldEventService",
	"ForgeService",
	"RebirthService",
	"CodeService",
	"DailyStreakService",
	"SummonService",
	"MonetizationService",
	"LeaderboardService",
	"AfkService",
	"SquadService",
	"WarpService",
	"CosmeticService",
	"CitadelService",
	"InspectService",
}

local failed = {}
for _, name in ORDER do
	local service = require(Services[name])
	local ok, err = xpcall(service.Init, debug.traceback)
	if not ok then
		table.insert(failed, name)
		warn(("[Voidline] %s.Init failed: %s"):format(name, tostring(err)))
	end
end

require(Services.PlayerDataService).Start()

if #failed == 0 then
	print("[Voidline] Boot complete — Voidline: Deep Space online")
else
	warn("[Voidline] Boot finished with failures: " .. table.concat(failed, ", "))
end
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="51">
        <Properties>
          <string name="Name">Security</string>
        </Properties>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">ValidateRemote</string>
            <string name="Source"><![CDATA[--!strict
-- Central remote validation: every client -> server remote is bound through
-- ValidateRemote.Bind so type checks, NaN/inf rejection, string limits,
-- numeric ranges, per-player token-bucket rate limits and the "profile is
-- loaded" gate are enforced in one place. Handlers only ever see clean args.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local Remotes = require(Voidline.Remotes)
local RateLimiter = require(Voidline.Modules.RateLimiter)

export type Spec = {
	Rate: number?, -- steady-state seconds between calls (default 0.25)
	Burst: number?, -- calls allowed back-to-back (default 3)
	Args: { string }?, -- "number" | "integer" | "string" | "boolean" | "table" | "any", "?" suffix = optional
	MaxString: number?, -- max bytes for string args (default 64)
	Range: { [number]: { number } }?, -- per-arg inclusive numeric range
	RequireCharacter: boolean?,
	SkipProfileGate: boolean?,
}

local ValidateRemote = {
	Rejections = {} :: { [number]: number },
	ProfileGate = nil :: ((Player) -> boolean)?,
	_limiters = {} :: { RateLimiter.RateLimiter },
}

local function isFiniteNumber(value: any): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end
ValidateRemote.IsFiniteNumber = isFiniteNumber

function ValidateRemote.CheckArg(value: any, kind: string, maxString: number?): boolean
	if string.sub(kind, -1) == "?" then
		if value == nil then
			return true
		end
		kind = string.sub(kind, 1, -2)
	end
	if kind == "number" then
		return isFiniteNumber(value)
	elseif kind == "integer" then
		return isFiniteNumber(value) and math.floor(value) == value
	elseif kind == "string" then
		return type(value) == "string" and #value <= (maxString or 64) and utf8.len(value) ~= nil
	elseif kind == "boolean" then
		return type(value) == "boolean"
	elseif kind == "table" then
		return type(value) == "table"
	elseif kind == "any" then
		return true
	end
	return false
end

local function reject(player: Player, remoteName: string, reason: string)
	local count = (ValidateRemote.Rejections[player.UserId] or 0) + 1
	ValidateRemote.Rejections[player.UserId] = count
	-- Log the first few and then every 100th so spammers cannot flood output.
	if count <= 3 or count % 100 == 0 then
		warn(("[Voidline] rejected %s from %s (%s) x%d"):format(remoteName, player.Name, reason, count))
	end
end

function ValidateRemote.RootPart(player: Player): BasePart?
	local character = player.Character
	if not character then
		return nil
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

function ValidateRemote.NearPosition(player: Player, position: Vector3, maxDistance: number): boolean
	local root = ValidateRemote.RootPart(player)
	if not root then
		return false
	end
	return (root.Position - position).Magnitude <= maxDistance
end

function ValidateRemote.NearPart(player: Player, part: BasePart?, maxDistance: number): boolean
	if not part then
		return false
	end
	-- Measure to the part's surface-ish envelope so large pads are fair.
	local slack = math.max(part.Size.X, part.Size.Z) * 0.5
	return ValidateRemote.NearPosition(player, part.Position, maxDistance + slack)
end

function ValidateRemote.AlivePlayer(player: Player?): boolean
	return player ~= nil and player.Parent ~= nil and player.Character ~= nil
end

function ValidateRemote.Bind(remoteName: string, spec: Spec, handler: (Player, ...any) -> ...any)
	local remote = Remotes.Get(remoteName)
	local limiter = RateLimiter.new(spec.Rate or 0.25, spec.Burst or 3)
	table.insert(ValidateRemote._limiters, limiter)
	local argKinds: { string } = spec.Args or {}
	local argCount = #argKinds
	remote.OnServerEvent:Connect(function(player: Player, ...: any)
		if not limiter:Allow(player.UserId) then
			reject(player, remoteName, "rate")
			return
		end
		if select("#", ...) > argCount then
			reject(player, remoteName, "extra args")
			return
		end
		local gate = ValidateRemote.ProfileGate
		if not spec.SkipProfileGate and gate and not gate(player) then
			return
		end
		if spec.RequireCharacter and not ValidateRemote.RootPart(player) then
			return
		end
		local args = table.pack(...)
		for i = 1, argCount do
			local kind = argKinds[i]
			local value = args[i]
			if not ValidateRemote.CheckArg(value, kind, spec.MaxString) then
				reject(player, remoteName, ("arg %d not %s"):format(i, kind))
				return
			end
			local range = spec.Range and spec.Range[i]
			if range and value ~= nil and (value < range[1] or value > range[2]) then
				reject(player, remoteName, ("arg %d out of range"):format(i))
				return
			end
		end
		local ok, err = pcall(handler, player, table.unpack(args, 1, argCount))
		if not ok then
			warn(("[Voidline] %s handler error for %s: %s"):format(remoteName, player.Name, tostring(err)))
		end
	end)
end

Players.PlayerRemoving:Connect(function(player)
	for _, limiter in ValidateRemote._limiters do
		limiter:Clear(player.UserId)
	end
	ValidateRemote.Rejections[player.UserId] = nil
end)

return ValidateRemote
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="53">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">AfkService</string>
            <string name="Source"><![CDATA[--!strict
-- AFK idle orbit: after AfkIdleSeconds without input or movement a pilot's
-- drones settle into a calm orbit and stop mining. Nobody is ever kicked;
-- any input or movement wakes the fleet again.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local GameConfig = require(Voidline.Config.GameConfig)

local ValidateRemote = require(script.Parent.Parent.Security.ValidateRemote)
local JuiceService = require(script.Parent.JuiceService)

local AfkService = {}

local CHECK_INTERVAL = 5
local MOVE_EPSILON = 2

AfkService._lastActive = {} :: { [number]: number }
AfkService._lastPos = {} :: { [number]: Vector3 }

local function setAfk(player: Player, afk: boolean)
	if (player:GetAttribute("Afk") == true) == afk then
		return
	end
	player:SetAttribute("Afk", afk)
	JuiceService.Send(player, if afk then "AfkIdle" else "AfkResume", {})
end

function AfkService.MarkActive(player: Player)
	AfkService._lastActive[player.UserId] = os.clock()
	setAfk(player, false)
end

function AfkService.Check(now: number)
	for _, player in Players:GetPlayers() do
		local userId = player.UserId
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			local last = AfkService._lastPos[userId]
			if last and (root.Position - last).Magnitude > MOVE_EPSILON then
				AfkService.MarkActive(player)
			end
			AfkService._lastPos[userId] = root.Position
		end
		local lastActive = AfkService._lastActive[userId] or now
		AfkService._lastActive[userId] = lastActive
		if now - lastActive >= GameConfig.AfkIdleSeconds then
			setAfk(player, true)
		end
	end
end

function AfkService.Init()
	ValidateRemote.Bind("PlayerInput", { Rate = 1, Burst = 3, Args = {} }, function(player)
		AfkService.MarkActive(player)
	end)
	Players.PlayerAdded:Connect(function(player)
		AfkService._lastActive[player.UserId] = os.clock()
		player:SetAttribute("Afk", false)
	end)
	Players.PlayerRemoving:Connect(function(player)
		AfkService._lastActive[player.UserId] = nil
		AfkService._lastPos[player.UserId] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(CHECK_INTERVAL)
			AfkService.Check(os.clock())
		end
	end)
end

return AfkService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">BeltService</string>
            <string name="Source"><![CDATA[--!strict
-- Personal asteroid belt around each claimed plot. Only the owner's drones
-- mine it; broken rocks are tethered home to the Grinder Core and pay out
-- on arrival. During onboarding every rock is the same starter ore so the
-- tutorial is exactly 10 ore -> 30 Credits.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local GameConfig = require(Voidline.Config.GameConfig)
local EconomyConfig = require(Voidline.Config.EconomyConfig)
local GalaxyConfig = require(Voidline.Config.GalaxyConfig)
local PlotLayout = require(Voidline.Modules.PlotLayout)
local EconomyRules = require(Voidline.Rules.EconomyRules)
local MiningRules = require(Voidline.Rules.MiningRules)
local OreRegistry = require(Voidline.Content.OreRegistry)

local PlayerDataService = require(script.Parent.PlayerDataService)
local PlotService = require(script.Parent.PlotService)
local RockService = require(script.Parent.RockService)
local TowService = require(script.Parent.TowService)
local EconomyService = require(script.Parent.EconomyService)
local StatService = require(script.Parent.StatService)
local RelicService = require(script.Parent.RelicService)
local WorldState = require(script.Parent.WorldState)

local BeltService = {}

type Belt = {
	Owner: Player,
	Index: number,
	Slots: { [number]: RockService.Rock | false },
	Generation: number,
	Sector: string,
}

local belts: { [number]: Belt } = {}
local rng = Random.new()

local function sectorIndex(sectorId: string): number
	for i, sector in GalaxyConfig.Sectors do
		if sector.Id == sectorId then
			return i
		end
	end
	return 1
end

local function rollOre(player: Player, profile: any): OreRegistry.Ore
	if not profile.TutorialComplete then
		return OreRegistry.ById[OreRegistry.TutorialOreId]
	end
	local index = sectorIndex(EconomyRules.ActiveSector(profile))
	return OreRegistry.Roll(rng, index, WorldState.Luck(player), nil)
end

local spawnSlot: (belt: Belt, slot: number) -> ()

local function onBreak(belt: Belt, slot: number, generation: number)
	return function(rock: RockService.Rock, _killer: Player?)
		if belts[belt.Index] ~= belt or belt.Generation ~= generation then
			RockService.ReleasePart(rock.Part)
			return
		end
		belt.Slots[slot] = false
		task.delay(GameConfig.BeltRespawnSeconds, function()
			if belts[belt.Index] == belt and belt.Generation == generation and belt.Slots[slot] == false then
				spawnSlot(belt, slot)
			end
		end)

		local owner = belt.Owner
		local profile = PlayerDataService.Get(owner)
		local grinder = PlotService.GrinderPosition(owner)
		if not profile or not grinder then
			RockService.ReleasePart(rock.Part)
			return
		end
		local perks = PlayerDataService.Perks(owner)
		local amount = MiningRules.OrePerRock(profile, rock.Ore)
		local duration = MiningRules.TowSeconds(profile, perks, (grinder - rock.Position).Magnitude)
		local oreId = rock.OreId
		local tutorial = not profile.TutorialComplete
		TowService.Start({
			Player = owner,
			Part = rock.Part,
			From = rock.Position,
			To = grinder,
			Duration = duration,
			Ore = amount,
			OnArrive = function()
				EconomyService.GrantOre(owner, oreId, amount, { Position = grinder, Source = "belt" })
				StatService.Bump(owner, "RocksMined", 1)
				local current = PlayerDataService.Get(owner)
				if current then
					StatService.Bump(owner, "Formation:" .. tostring(current.Formation), 1)
				end
				if tutorial then
					return
				end
				local ore = OreRegistry.ById[oreId]
				local luck = WorldState.Luck(owner)
				if ore and rng:NextNumber() < ore.ShardChance * luck then
					EconomyService.AddShards(owner, 1, "belt")
				end
				if ore then
					RelicService.TryFind(owner, ore.RelicChance * luck, "belt")
				end
			end,
		})
	end
end

function spawnSlot(belt: Belt, slot: number)
	local profile = PlayerDataService.Get(belt.Owner)
	if not profile then
		return
	end
	local sectorId = EconomyRules.ActiveSector(profile)
	local stats = EconomyConfig.BeltAsteroid[sectorId] or EconomyConfig.BeltAsteroid.Starter
	local ore = rollOre(belt.Owner, profile)
	local count = GameConfig.BeltAsteroidsPerPlot
	local wobble = rng:NextNumber(-3, 3)
	local generation = belt.Generation
	local rock = RockService.Create({
		Kind = "Belt",
		Position = PlotLayout.BeltSlot(belt.Index, slot, count, wobble),
		Size = 3.4 + ore.TierIndex * 0.35 + rng:NextNumber(0, 0.8),
		OreId = ore.Id,
		Health = stats.Health,
		Ore = stats.Ore,
		OwnerUserId = belt.Owner.UserId,
		Priority = 1,
		OnBreak = onBreak(belt, slot, generation),
		Data = { PlotIndex = belt.Index, Slot = slot },
		Name = "BeltRock",
	})
	belt.Slots[slot] = rock
end

local function clear(index: number)
	local belt = belts[index]
	if not belt then
		return
	end
	belt.Generation += 1
	for slot, rock in belt.Slots do
		if rock then
			RockService.Remove(rock :: RockService.Rock)
		end
		belt.Slots[slot] = false
	end
	belts[index] = nil
end

-- Respawns the whole belt (after a rebirth resets the sector, for example).
function BeltService.Reset(player: Player)
	local index = PlotService.IndexOf(player)
	if not index then
		return
	end
	clear(index)
	local profile = PlayerDataService.Get(player)
	local belt: Belt = {
		Owner = player,
		Index = index,
		Slots = {},
		Generation = 0,
		Sector = if profile then EconomyRules.ActiveSector(profile) else "Starter",
	}
	belts[index] = belt
	for slot = 1, GameConfig.BeltAsteroidsPerPlot do
		spawnSlot(belt, slot)
	end
end

function BeltService.Rocks(player: Player): { RockService.Rock }
	local out: { RockService.Rock } = {}
	local index = PlotService.IndexOf(player)
	local belt = index and belts[index]
	if belt then
		for _, rock in belt.Slots do
			if rock then
				table.insert(out, rock :: RockService.Rock)
			end
		end
	end
	return out
end

function BeltService.Init()
	PlotService.OnClaimed(function(player)
		BeltService.Reset(player)
	end)
	PlotService.OnReleased(function(_player, index)
		clear(index)
	end)
	-- Reaching a new sector rerolls the belt so richer rocks appear at once.
	EconomyService.OnUpgraded(function(player, upgradeId)
		if upgradeId ~= "StationTier" and upgradeId ~= "DroneTier" then
			return
		end
		local index = PlotService.IndexOf(player)
		local belt = index and belts[index]
		local profile = PlayerDataService.Get(player)
		if belt and profile and belt.Sector ~= EconomyRules.ActiveSector(profile) then
			BeltService.Reset(player)
		end
	end)
end

return BeltService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">CitadelService</string>
            <string name="Source"><![CDATA[--!strict
-- Citadel: every Station Tier adds structures to the pilot's plot (turrets,
-- refinery towers, warp docks, trophy halls...). The ten newest structures
-- stand on the ten plot-edge anchors, so a max-tier plot stays cheap
-- (decorative, anchored, non-colliding parts only).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local PlotLayout = require(Voidline.Modules.PlotLayout)
local CitadelRegistry = require(Voidline.Content.CitadelRegistry)

local PlayerDataService = require(script.Parent.PlayerDataService)
local PlotService = require(script.Parent.PlotService)
local EconomyService = require(script.Parent.EconomyService)
local RebirthService = require(script.Parent.RebirthService)
local MapBuilder = require(script.Parent.MapBuilder)

local CitadelService = {}

local METAL = Color3.fromRGB(30, 28, 40)
local GOLD = Color3.fromRGB(232, 186, 74)

type Piece = {
	Size: Vector3,
	Offset: CFrame,
	Material: Enum.Material,
	Color: Color3?,
	Shape: Enum.PartType?,
	Transparency: number?,
}

-- Each structure kind is a handful of primitive parts, in local space
-- (origin at the anchor, +Y up). nil Color = tier accent.
local SHAPES: { [string]: { Piece } } = {
	beacon = {
		{
			Size = Vector3.new(1.2, 12, 1.2),
			Offset = CFrame.new(0, 6, 0),
			Material = Enum.Material.Metal,
			Color = METAL,
			Shape = Enum.PartType.Cylinder,
		},
		{
			Size = Vector3.new(2.4, 2.4, 2.4),
			Offset = CFrame.new(0, 12.5, 0),
			Material = Enum.Material.Neon,
			Shape = Enum.PartType.Ball,
		},
	},
	refinery_tower = {
		{ Size = Vector3.new(4, 14, 4), Offset = CFrame.new(0, 7, 0), Material = Enum.Material.Metal, Color = METAL },
		{ Size = Vector3.new(4.4, 0.8, 4.4), Offset = CFrame.new(0, 10, 0), Material = Enum.Material.Neon },
		{ Size = Vector3.new(4.4, 0.8, 4.4), Offset = CFrame.new(0, 5, 0), Material = Enum.Material.Neon },
	},
	turret = {
		{
			Size = Vector3.new(3, 4, 4),
			Offset = CFrame.new(0, 2, 0) * CFrame.Angles(0, 0, math.rad(90)),
			Material = Enum.Material.Metal,
			Color = METAL,
			Shape = Enum.PartType.Cylinder,
		},
		{
			Size = Vector3.new(1, 1, 6),
			Offset = CFrame.new(0, 4.6, -2) * CFrame.Angles(math.rad(25), 0, 0),
			Material = Enum.Material.Metal,
			Color = METAL,
		},
		{
			Size = Vector3.new(1.2, 1.2, 1.2),
			Offset = CFrame.new(0, 6, -4.6),
			Material = Enum.Material.Neon,
			Shape = Enum.PartType.Ball,
		},
	},
	warp_dock = {
		{ Size = Vector3.new(1, 9, 1), Offset = CFrame.new(-3, 4.5, 0), Material = Enum.Material.Metal, Color = METAL },
		{ Size = Vector3.new(1, 9, 1), Offset = CFrame.new(3, 4.5, 0), Material = Enum.Material.Metal, Color = METAL },
		{ Size = Vector3.new(7, 1, 1), Offset = CFrame.new(0, 9, 0), Material = Enum.Material.Neon },
		{
			Size = Vector3.new(5, 7, 0.2),
			Offset = CFrame.new(0, 4.5, 0),
			Material = Enum.Material.Glass,
			Transparency = 0.6,
		},
	},
	trophy_hall = {
		{
			Size = Vector3.new(8, 5, 6),
			Offset = CFrame.new(0, 2.5, 0),
			Material = Enum.Material.Marble,
			Color = Color3.fromRGB(40, 36, 52),
		},
		{
			Size = Vector3.new(8.4, 0.6, 6.4),
			Offset = CFrame.new(0, 5.3, 0),
			Material = Enum.Material.Neon,
			Color = GOLD,
		},
		{
			Size = Vector3.new(6, 2.5, 4),
			Offset = CFrame.new(0, 6.8, 0),
			Material = Enum.Material.Glass,
			Transparency = 0.4,
		},
	},
	shield_ring = {
		{
			Size = Vector3.new(0.6, 10, 10),
			Offset = CFrame.new(0, 8, 0) * CFrame.Angles(0, 0, math.rad(90)),
			Material = Enum.Material.ForceField,
			Shape = Enum.PartType.Cylinder,
			Transparency = 0.2,
		},
		{ Size = Vector3.new(1, 6, 1), Offset = CFrame.new(0, 3, 0), Material = Enum.Material.Metal, Color = METAL },
	},
	solar_array = {
		{
			Size = Vector3.new(0.8, 6, 0.8),
			Offset = CFrame.new(0, 3, 0),
			Material = Enum.Material.Metal,
			Color = METAL,
		},
		{
			Size = Vector3.new(7, 0.3, 4),
			Offset = CFrame.new(0, 6.4, 0) * CFrame.Angles(math.rad(-30), 0, 0),
			Material = Enum.Material.Glass,
			Color = Color3.fromRGB(80, 140, 255),
			Transparency = 0.2,
		},
	},
	hangar = {
		{ Size = Vector3.new(8, 4, 8), Offset = CFrame.new(0, 2, 0), Material = Enum.Material.Metal, Color = METAL },
		{
			Size = Vector3.new(8, 3, 8),
			Offset = CFrame.new(0, 5.5, 0),
			Material = Enum.Material.Metal,
			Color = Color3.fromRGB(44, 40, 58),
			Shape = Enum.PartType.Wedge,
		},
		{ Size = Vector3.new(5, 3, 0.3), Offset = CFrame.new(0, 1.6, -4.1), Material = Enum.Material.Neon },
	},
	gravity_anchor = {
		{
			Size = Vector3.new(4, 4, 4),
			Offset = CFrame.new(0, 5, 0),
			Material = Enum.Material.Slate,
			Color = Color3.fromRGB(16, 14, 22),
			Shape = Enum.PartType.Ball,
		},
		{
			Size = Vector3.new(0.4, 7, 7),
			Offset = CFrame.new(0, 5, 0) * CFrame.Angles(math.rad(20), 0, math.rad(90)),
			Material = Enum.Material.Neon,
			Shape = Enum.PartType.Cylinder,
			Transparency = 0.3,
		},
	},
	relic_vault = {
		{
			Size = Vector3.new(5, 5, 5),
			Offset = CFrame.new(0, 2.5, 0),
			Material = Enum.Material.DiamondPlate,
			Color = METAL,
		},
		{ Size = Vector3.new(2, 3.4, 0.3), Offset = CFrame.new(0, 1.9, -2.6), Material = Enum.Material.Neon },
	},
}

local function clear(index: number)
	local plot = PlotService.Folder(index)
	local folder = plot and plot:FindFirstChild("Citadel")
	if folder then
		folder:ClearAllChildren()
	end
end

local function buildStructure(parent: Instance, kind: string, origin: CFrame, scale: number, accent: Color3)
	local pieces = SHAPES[kind] or SHAPES.beacon
	local model = Instance.new("Model")
	model.Name = kind
	for i, piece in pieces do
		local offset = piece.Offset
		MapBuilder.Part({
			Name = kind .. "_" .. i,
			Parent = model,
			Size = piece.Size * scale,
			CFrame = origin * CFrame.new(offset.Position * scale) * offset.Rotation,
			Color = piece.Color or accent,
			Material = piece.Material,
			Shape = piece.Shape,
			Transparency = piece.Transparency or 0,
			CanCollide = false,
			CanQuery = false,
		})
	end
	model.Parent = parent
end

function CitadelService.Rebuild(player: Player)
	local index = PlotService.IndexOf(player)
	local profile = PlayerDataService.Get(player)
	if not index or not profile then
		return
	end
	clear(index)
	local plot = PlotService.Folder(index)
	local folder = plot and plot:FindFirstChild("Citadel")
	if not plot or not folder then
		return
	end
	local tier = CitadelRegistry.ForTier(profile.StationTier)
	local structures = CitadelRegistry.StructuresUpTo(profile.StationTier)
	local anchors = PlotLayout.CitadelAnchors
	local first = math.max(1, #structures - #anchors + 1)
	local plotCFrame = PlotLayout.PlotCFrame(index)
	for i = first, #structures do
		local structure = structures[i]
		local anchor = anchors[i - first + 1]
		for copy = 1, math.min(structure.Count, 3) do
			local spread = (copy - (math.min(structure.Count, 3) + 1) / 2) * 5
			local localPos = anchor + Vector3.new(0, 0, spread)
			local origin = plotCFrame * CFrame.new(localPos) * CFrame.Angles(0, math.rad(180), 0)
			buildStructure(folder, structure.Kind, origin, structure.Scale, tier.Accent)
		end
	end
	plot:SetAttribute("CitadelTier", tier.Tier)
	plot:SetAttribute("CitadelName", tier.Name)
end

function CitadelService.Init()
	PlotService.OnClaimed(function(player)
		CitadelService.Rebuild(player)
	end)
	PlotService.OnReleased(function(_player, index)
		clear(index)
	end)
	EconomyService.OnUpgraded(function(player, upgradeId)
		if upgradeId == "StationTier" then
			CitadelService.Rebuild(player)
		end
	end)
	RebirthService.OnRebirth(function(player)
		CitadelService.Rebuild(player)
	end)
end

return CitadelService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">CodeService</string>
            <string name="Source"><![CDATA[--!strict
-- Code Terminal (VOIDLINE, KILLSHOT, LAUNCH). Codes are fixed strings from
-- CodesConfig; nothing a pilot types is ever shown to anyone else.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local CodesConfig = require(Voidline.Config.CodesConfig)
local ProgressionRules = require(Voidline.Rules.ProgressionRules)

local ValidateRemote = require(script.Parent.Parent.Security.ValidateRemote)
local PlayerDataService = require(script.Parent.PlayerDataService)
local JuiceService = require(script.Parent.JuiceService)
local StatService = require(script.Parent.StatService)

local CodeService = {}

function CodeService.Redeem(player: Player, raw: any): (boolean, string?)
	local ok, reason, code = false, nil :: string?, nil :: string?
	PlayerDataService.Mutate(player, function(p)
		ok, reason, code = ProgressionRules.RedeemCode(p, raw)
	end)
	if not ok then
		JuiceService.Send(player, "Code", { Ok = false, Reason = reason })
		return false, reason
	end
	local reward = CodesConfig.Codes[code :: string]
	JuiceService.Send(player, "Code", {
		Ok = true,
		Message = reward.Message,
		Credits = reward.Credits,
		Shards = reward.VoidShards,
		Title = reward.Title,
	})
	StatService.Bump(player, "CodesRedeemed", 1)
	StatService.Check(player, "LifetimeCredits", "LifetimeShards")
	task.spawn(PlayerDataService.Save, player)
	return true, nil
end

function CodeService.Init()
	ValidateRemote.Bind(
		"RedeemCode",
		{ Rate = 1.5, Burst = 3, Args = { "string" }, MaxString = 64 },
		function(player, raw)
			CodeService.Redeem(player, raw)
		end
	)
end

return CodeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">CodexService</string>
            <string name="Source"><![CDATA[--!strict
-- Voidline Codex: every ore, anomaly, hazard, relic, drone evolution,
-- cosmetic and world event a pilot has witnessed. Discoveries are permanent
-- and feed the Codex milestone credit multiplier.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local ContentIndex = require(Voidline.Content.ContentIndex)
local DroneRegistry = require(Voidline.Content.DroneRegistry)

local PlayerDataService = require(script.Parent.PlayerDataService)
local JuiceService = require(script.Parent.JuiceService)
local StatService = require(script.Parent.StatService)

local CodexService = {}

local function milestoneFor(count: number): number?
	for _, milestone in ContentIndex.CodexMilestones do
		if milestone.Count == count then
			return milestone.Bonus
		end
	end
	return nil
end

-- Records a discovery. Returns true the first time. `quiet` skips the toast
-- (used for back-filling things a pilot already owns).
function CodexService.Discover(player: Player, id: string, quiet: boolean?): boolean
	if not ContentIndex.IsCodexId(id) then
		return false
	end
	local session = PlayerDataService.Session(player)
	if not session or session.Profile.Codex[id] ~= nil then
		return false
	end
	session.Profile.Codex[id] = os.time()
	session.Dirty = true
	session.CodexCount += 1
	local entry, kind = ContentIndex.Get(id)
	if kind == "ore" then
		StatService.Bump(player, "OreTier:" .. tostring(entry.TierIndex), 1)
	end
	if not quiet then
		JuiceService.Send(player, "Codex", { Id = id, Count = session.CodexCount, Total = ContentIndex.CodexTotal })
	end
	local bonus = milestoneFor(session.CodexCount)
	if bonus then
		JuiceService.Send(player, "CodexMilestone", {
			Count = session.CodexCount,
			Multiplier = ContentIndex.CodexMultiplier(session.CodexCount),
		})
	end
	StatService.Check(player, "CodexCount")
	return true
end

function CodexService.Count(player: Player): number
	local session = PlayerDataService.Session(player)
	return if session then session.CodexCount else 0
end

-- Back-fills entries for things the pilot already has (evolutions reached,
-- unlocked cosmetics, owned relics) so old saves start with a fair Codex.
function CodexService.SyncOwned(player: Player)
	local profile = PlayerDataService.Get(player)
	if not profile then
		return
	end
	for stage = 1, profile.DroneTier do
		CodexService.Discover(player, DroneRegistry.EvolutionFor(stage, profile.DroneBranch).Id, true)
	end
	for id in profile.Unlocks do
		CodexService.Discover(player, id, true)
	end
	for id in profile.Relics do
		CodexService.Discover(player, id, true)
	end
end

function CodexService.Init()
	PlayerDataService.OnLoaded(function(player)
		task.defer(CodexService.SyncOwned, player)
	end)
end

return CodexService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">CosmeticService</string>
            <string name="Source"><![CDATA[--!strict
-- Equipping earned cosmetics (titles, laser shaders, hit effects, thrusters,
-- drone mutations), the overhead title tag, and the Star Overlook's calm
-- aura (purely cosmetic: a soft glow and quieter audio on the client).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local HubLayout = require(Voidline.Modules.HubLayout)
local TitleRegistry = require(Voidline.Content.TitleRegistry)
local DroneRegistry = require(Voidline.Content.DroneRegistry)

local ValidateRemote = require(script.Parent.Parent.Security.ValidateRemote)
local PlayerDataService = require(script.Parent.PlayerDataService)
local DroneService = require(script.Parent.DroneService)
local JuiceService = require(script.Parent.JuiceService)

local CosmeticService = {}

local AURA_RADIUS = 12
local AURA_HEIGHT = 14

-- Equip slot -> DroneRegistry category.
local SLOT_CATEGORY: { [string]: string } = {
	LaserShader = "Laser",
	HitEffect = "HitEffect",
	Thruster = "Thruster",
	DroneMutation = "Mutation",
}

local function titleTag(character: Model): BillboardGui?
	local head = character:FindFirstChild("Head")
	if not head then
		return nil
	end
	local tag = head:FindFirstChild("VoidlineTitle") :: BillboardGui?
	if tag then
		return tag
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "VoidlineTitle"
	gui.Size = UDim2.fromOffset(220, 26)
	gui.StudsOffset = Vector3.new(0, 2.6, 0)
	gui.MaxDistance = 80
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Name = "Title"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextStrokeTransparency = 0.6
	label.Parent = gui
	gui.Parent = head
	return gui
end

function CosmeticService.RefreshTitle(player: Player)
	local profile = PlayerDataService.Get(player)
	local character = player.Character
	if not profile or not character then
		return
	end
	local title = TitleRegistry.ById[profile.Cosmetics.Title]
	player:SetAttribute("Title", if title then title.Name else "")
	local tag = titleTag(character)
	if not tag then
		return
	end
	local label = tag:FindFirstChild("Title") :: TextLabel
	label.Text = if title then title.Name else ""
	label.TextColor3 = if title then title.Color else Color3.new(1, 1, 1)
	tag.Enabled = title ~= nil
end

function CosmeticService.Equip(player: Player, slot: string, id: string): (boolean, string?)
	local profile = PlayerDataService.Get(player)
	if not profile then
		return false, "loading"
	end
	if slot == "Title" then
		if id ~= "" and (not TitleRegistry.ById[id] or profile.Titles[id] ~= true) then
			return false, "locked"
		end
	elseif SLOT_CATEGORY[slot] then
		if id ~= "" then
			local cosmetic = DroneRegistry.ById[id]
			if not cosmetic or cosmetic.Category ~= SLOT_CATEGORY[slot] or profile.Unlocks[id] ~= true then
				return false, "locked"
			end
		end
	else
		return false, "slot"
	end
	PlayerDataService.Mutate(player, function(p)
		p.Cosmetics[slot] = id
	end)
	if slot == "Title" then
		CosmeticService.RefreshTitle(player)
	else
		DroneService.RefreshLook(player)
	end
	return true, nil
end

local function auraStep()
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local inside = false
		if root then
			local offset = root.Position - HubLayout.Overlook
			inside = Vector3.new(offset.X, 0, offset.Z).Magnitude <= AURA_RADIUS
				and offset.Y > -2
				and offset.Y < AURA_HEIGHT
		end
		if (player:GetAttribute("CalmAura") == true) ~= inside then
			player:SetAttribute("CalmAura", inside)
		end
	end
end

function CosmeticService.Init()
	ValidateRemote.Bind(
		"EquipCosmetic",
		{ Rate = 0.3, Burst = 5, Args = { "string", "string" }, MaxString = 64 },
		function(player, slot, id)
			local ok, reason = CosmeticService.Equip(player, slot, id)
			JuiceService.Send(player, "Equip", { Ok = ok, Slot = slot, Id = id, Reason = reason })
		end
	)
	PlayerDataService.OnSettingsChanged(function(player)
		DroneService.RefreshLook(player)
	end)
	PlayerDataService.OnLoaded(function(player)
		CosmeticService.RefreshTitle(player)
		player.CharacterAdded:Connect(function()
			task.defer(CosmeticService.RefreshTitle, player)
		end)
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			auraStep()
		end
	end)
end

return CosmeticService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">DailyStreakService</string>
            <string name="Source"><![CDATA[--!strict
-- 7-day login streak. Day 7 adds a 24 h pass trial voucher; the cycle then
-- restarts so the voucher stays a weekly treat.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local ProgressionRules = require(Voidline.Rules.ProgressionRules)

local ValidateRemote = require(script.Parent.Parent.Security.ValidateRemote)
local PlayerDataService = require(script.Parent.PlayerDataService)
local JuiceService = require(script.Parent.JuiceService)
local StatService = require(script.Parent.StatService)

local DailyStreakService = {}

function DailyStreakService.Claim(player: Player): boolean
	local ok, reward, day = false, nil, 0
	PlayerDataService.Mutate(player, function(p)
		ok, reward, day = ProgressionRules.ClaimDaily(p, os.time())
	end)
	if not ok or not reward then
		JuiceService.Send(player, "Daily", { Ok = false })
		return false
	end
	JuiceService.Send(player, "Daily", {
		Ok = true,
		Day = day,
		Credits = reward.Credits,
		Shards = reward.VoidShards,
		Trial = reward.TrialPerk,
	})
	StatService.Bump(player, "DailyClaims", 1)
	StatService.Check(player, "LifetimeCredits", "LifetimeShards")
	task.spawn(PlayerDataService.Save, player)
	return true
end

function DailyStreakService.Init()
	PlayerDataService.OnLoaded(function(player, profile)
		ProgressionRules.OnLogin(profile, os.time())
		PlayerDataService.MarkDirty(player)
		if ProgressionRules.CanClaimDaily(profile, os.time()) then
			JuiceService.Send(player, "DailyReady", { Day = profile.DailyStreak })
		end
	end)
	ValidateRemote.Bind("RedeemDaily", { Rate = 1, Burst = 2 }, function(player)
		DailyStreakService.Claim(player)
	end)
end

return DailyStreakService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">DroneService</string>
            <string name="Source"><![CDATA[--!strict
-- Server-authoritative drone swarms. The server only simulates *what* each
-- swarm is mining (5 Hz) and how much damage it deals; it never creates
-- drone parts. Compact state goes out as Player attributes (count,
-- formation, target rock ids, look) and every client renders and
-- interpolates the drones, beams and tethers locally.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local DroneConfig = require(Voidline.Config.DroneConfig)
local MiningRules = require(Voidline.Rules.MiningRules)
local EconomyRules = require(Voidline.Rules.EconomyRules)
local DroneRegistry = require(Voidline.Content.DroneRegistry)

local ValidateRemote = require(script.Parent.Parent.Security.ValidateRemote)
local PlayerDataService = require(script.Parent.PlayerDataService)
local PlotService = require(script.Parent.PlotService)
local RockService = require(script.Parent.RockService)
local TowService = require(script.Parent.TowService)
local EconomyService = require(script.Parent.EconomyService)
local CodexService = require(script.Parent.CodexService)
local JuiceService = require(script.Parent.JuiceService)
local StatService = require(script.Parent.StatService)

local DroneService = {}

type SwarmState = {
	Targets: { RockService.Rock },
	NextRetarget: number,
	TargetsAttr: string,
	PausedUntil: number,
	CargoWarned: boolean,
}

local SIM_DT = 1 / DroneConfig.SimHz
local RETARGET_SECONDS = 1
local MUTATION_CHANCE_PER_EVOLUTION = 0.12
-- Beam-Link squad bonus counts linked squadmates within this range.
local LINK_RANGE = 60

local states: { [number]: SwarmState } = {}
local pausedZones: { { Center: Vector3, Radius: number, Until: number } } = {}
local rng = Random.new()

-- Set by SquadService: squadmates flying Beam-Link near `player`.
DroneService.LinkedSquadmates = function(_player: Player, _range: number): number
	return 0
end

local function stateFor(player: Player): SwarmState
	local state = states[player.UserId]
	if not state then
		state = { Targets = {}, NextRetarget = 0, TargetsAttr = "", PausedUntil = 0, CargoWarned = false }
		states[player.UserId] = state
	end
	return state
end

-- Hazards (Solar Flare, Radiation Bloom) pause every drone inside a sphere.
function DroneService.PauseZone(center: Vector3, radius: number, seconds: number)
	table.insert(pausedZones, { Center = center, Radius = radius, Until = os.clock() + seconds })
end

local function inPausedZone(position: Vector3, now: number): boolean
	for i = #pausedZones, 1, -1 do
		local zone = pausedZones[i]
		if now >= zone.Until then
			table.remove(pausedZones, i)
		elseif (position - zone.Center).Magnitude <= zone.Radius then
			return true
		end
	end
	return false
end

local function setTargets(player: Player, state: SwarmState, targets: { RockService.Rock })
	state.Targets = targets
	local ids = table.create(#targets)
	for i, rock in targets do
		ids[i] = tostring(rock.Id)
	end
	local attr = table.concat(ids, ",")
	if attr ~= state.TargetsAttr then
		state.TargetsAttr = attr
		player:SetAttribute("DroneTargets", attr)
	end
end

-- Appearance + count replicated for client rendering.
function DroneService.RefreshLook(player: Player)
	local profile = PlayerDataService.Get(player)
	if not profile then
		return
	end
	local perks = PlayerDataService.Perks(player)
	local evolution = DroneRegistry.EvolutionFor(profile.DroneTier, profile.DroneBranch)
	player:SetAttribute("DroneCount", MiningRules.DroneCount(profile, perks))
	player:SetAttribute("Formation", profile.Formation)
	player:SetAttribute("DroneEvo", evolution.Id)
	player:SetAttribute("DroneMutation", profile.Cosmetics.DroneMutation)
	player:SetAttribute("LaserColor", profile.Settings.LaserColor)
	local laser = profile.Cosmetics.LaserShader
	if laser == "" and perks.LaserOverclock then
		laser = "laser.overclock"
	end
	player:SetAttribute("LaserShader", laser)
	player:SetAttribute("HitEffect", profile.Cosmetics.HitEffect)
	player:SetAttribute("Thruster", profile.Cosmetics.Thruster)
end

local function chooseTargets(player: Player, profile: any, root: BasePart, state: SwarmState): { RockService.Rock }
	local candidates = RockService.Candidates(root.Position, player.UserId, PlotService.IsOnPlot(player))
	local space = EconomyRules.CargoSpace(profile) - TowService.PendingOre(player.UserId)
	local formation = profile.Formation
	local stats = DroneConfig.FormationStats[formation] or DroneConfig.FormationStats[1]
	local picked: { RockService.Rock } = {}
	local skippedBelt = false
	for _, rock in candidates do
		if #picked >= stats.MaxTargets then
			break
		end
		if rock.Kind == "Belt" and space <= 0 then
			skippedBelt = true
			continue
		end
		if stats.EscortRange and (rock.Position - root.Position).Magnitude > stats.EscortRange then
			continue
		end
		if rock.Kind == "Belt" then
			-- Do not split the swarm over rocks whose ore cannot fit.
			space -= MiningRules.OrePerRock(profile, rock.Ore)
		end
		table.insert(picked, rock)
	end
	if skippedBelt and #picked == 0 then
		if not state.CargoWarned then
			state.CargoWarned = true
			JuiceService.Send(player, "CargoFull", {})
		end
	else
		state.CargoWarned = false
	end
	return picked
end

local function stepPlayer(player: Player, now: number)
	local session = PlayerDataService.Session(player)
	local state = stateFor(player)
	local root = PlotService.RootPart(player)
	if not session or not root or player:GetAttribute("Afk") == true or inPausedZone(root.Position, now) then
		if #state.Targets > 0 then
			setTargets(player, state, {})
		end
		return
	end
	local profile = session.Profile
	local needRetarget = now >= state.NextRetarget or #state.Targets == 0
	for _, rock in state.Targets do
		if not rock.Alive then
			needRetarget = true
		end
	end
	if needRetarget then
		state.NextRetarget = now + RETARGET_SECONDS
		setTargets(player, state, chooseTargets(player, profile, root, state))
	end
	local targets = state.Targets
	if #targets == 0 then
		return
	end
	local linked = if profile.Formation == 2 then DroneService.LinkedSquadmates(player, LINK_RANGE) else 0
	local dps = MiningRules.SwarmDps(profile, PlayerDataService.Perks(player), profile.Formation, linked)
	local share = dps * SIM_DT / #targets
	for _, rock in targets do
		RockService.Damage(rock, player, share)
	end
end

function DroneService.Step(now: number)
	for _, player in Players:GetPlayers() do
		stepPlayer(player, now)
	end
	RockService.FlushHealth()
end

local function onUpgraded(player: Player, upgradeId: string)
	if upgradeId == "DroneTier" then
		local profile = PlayerDataService.Get(player)
		if profile then
			local evolution = DroneRegistry.EvolutionFor(profile.DroneTier, profile.DroneBranch)
			CodexService.Discover(player, evolution.Id)
			JuiceService.Send(player, "Evolution", { Id = evolution.Id })
			StatService.Check(player, "Branch:" .. profile.DroneBranch)
			if rng:NextNumber() < MUTATION_CHANCE_PER_EVOLUTION then
				local mutations = DroneRegistry.ByCategory("Mutation")
				local mutation = mutations[rng:NextInteger(1, #mutations)]
				PlayerDataService.Mutate(player, function(p)
					p.Unlocks[mutation.Id] = true
				end)
				CodexService.Discover(player, mutation.Id)
				JuiceService.Send(player, "Mutation", { Id = mutation.Id })
			end
		end
	end
	if upgradeId == "DroneTier" or upgradeId == "DroneSlot" then
		DroneService.RefreshLook(player)
	end
end

function DroneService.Init()
	ValidateRemote.Bind(
		"SetFormation",
		{ Rate = 0.3, Burst = 3, Args = { "integer" }, Range = { { 1, 3 } } },
		function(player, formation)
			PlayerDataService.Mutate(player, function(p)
				p.Formation = formation
			end)
			DroneService.RefreshLook(player)
			local state = states[player.UserId]
			if state then
				state.NextRetarget = 0
			end
		end
	)

	PlayerDataService.OnLoaded(function(player)
		DroneService.RefreshLook(player)
	end)
	EconomyService.OnUpgraded(onUpgraded)

	Players.PlayerRemoving:Connect(function(player)
		states[player.UserId] = nil
	end)

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < SIM_DT then
			return
		end
		accumulator -= SIM_DT
		-- Never try to catch up more than one step after a hitch.
		accumulator = math.min(accumulator, SIM_DT)
		DroneService.Step(os.clock())
	end)
end

return DroneService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--!strict
-- Cargo, refining and station upgrades. All amounts are computed here from
-- the profile and shared rules; clients only ask ("sell", "upgrade Drill").
-- Diegetic controls: ProximityPrompts on each plot's pads, plus standing on
-- the gold Refinery pad auto-refines.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local GameConfig = require(Voidline.Config.GameConfig)
local EconomyConfig = require(Voidline.Config.EconomyConfig)
local DroneConfig = require(Voidline.Config.DroneConfig)
local GalaxyConfig = require(Voidline.Config.GalaxyConfig)
local PlotLayout = require(Voidline.Modules.PlotLayout)
local FormatNumber = require(Voidline.Modules.FormatNumber)
local EconomyRules = require(Voidline.Rules.EconomyRules)
local OreRegistry = require(Voidline.Content.OreRegistry)

local ValidateRemote = require(script.Parent.Parent.Security.ValidateRemote)
local PlayerDataService = require(script.Parent.PlayerDataService)
local PlotService = require(script.Parent.PlotService)
local JuiceService = require(script.Parent.JuiceService)
local StatService = require(script.Parent.StatService)
local CodexService = require(script.Parent.CodexService)
local TutorialService = require(script.Parent.TutorialService)

local EconomyService = {}

local upgradedCallbacks: { (Player, string) -> () } = {}
local lastPadSell: { [number]: number } = {}
local prompts: { [number]: { [string]: ProximityPrompt } } = {}

local PAD_SELL_COOLDOWN = 0.75
local PAD_ZONE_HALF = 5.5

function EconomyService.OnUpgraded(callback: (Player, string) -> ())
	table.insert(upgradedCallbacks, callback)
end

local function promptText(profile: any, upgradeId: string, ctx: EconomyRules.Ctx): string
	local def = EconomyConfig.Upgrades[upgradeId]
	local level = profile[def.Stat]
	if level >= def.Max then
		return ("%s · MAX"):format(def.Label)
	end
	local cost = EconomyRules.UpgradeCost(profile, upgradeId, ctx) or 0
	local _, reason = EconomyRules.CanUpgrade(profile, upgradeId, ctx)
	if reason == "locked" then
		return ("%s · needs Station Tier %d"):format(def.Label, 2 * profile.DroneTier)
	end
	return ("%s Lv%d · %s Cr"):format(def.Label, level + 1, FormatNumber.Compact(cost))
end

-- Refreshes the owner's pad prompts (costs change after every purchase).
function EconomyService.RefreshPrompts(player: Player)
	local index = PlotService.IndexOf(player)
	local profile = PlayerDataService.Get(player)
	if not index or not profile then
		return
	end
	local set = prompts[index]
	if not set then
		return
	end
	local ctx = PlayerDataService.Ctx(player)
	for upgradeId, prompt in set do
		if EconomyConfig.Upgrades[upgradeId] then
			prompt.ObjectText = promptText(profile, upgradeId, ctx)
		end
	end
end

local function cargoFull(profile: any): boolean
	return EconomyRules.CargoSpace(profile) <= 0
end

function EconomyService.UnitValue(profile: any, oreId: string): number
	local ore = OreRegistry.ById[oreId]
	return EconomyRules.UnitValue(EconomyRules.ActiveSector(profile), if ore then ore.ValueMult else 1)
end

-- Sells the whole hold. `source`: "pad" | "prompt" | "remote" | "warp".
function EconomyService.Sell(player: Player, source: string): (number, number)
	local profile = PlayerDataService.Get(player)
	if not profile or profile.Ore <= 0 then
		return 0, 0
	end
	local ctx = PlayerDataService.Ctx(player)
	local credits, ore = 0, 0
	PlayerDataService.Mutate(player, function(p)
		credits, ore = EconomyRules.Sell(p, ctx)
	end)
	if ore <= 0 then
		return 0, 0
	end
	JuiceService.Send(player, "Sell", { Credits = credits, Ore = ore, Source = source })
	StatService.Bump(player, "Sells", 1)
	StatService.Bump(player, "CreditsEarned", credits)
	StatService.Check(player, "LifetimeCredits", "Credits")
	TutorialService.OnSold(player)
	EconomyService.RefreshPrompts(player)
	return credits, ore
end

export type GrantOptions = {
	Overflow: string?, -- "refine": contest payouts never go to waste
	Position: Vector3?,
	Source: string?,
}

-- Adds mined ore to the cargo hold. Returns (stored, creditsFromOverflow).
function EconomyService.GrantOre(
	player: Player,
	oreId: string,
	amount: number,
	options: GrantOptions?
): (number, number)
	local profile = PlayerDataService.Get(player)
	if not profile or amount <= 0 then
		return 0, 0
	end
	local opts: GrantOptions = options or {}
	local unit = EconomyService.UnitValue(profile, oreId)
	local ctx = PlayerDataService.Ctx(player)
	local stored, refined = 0, 0
	PlayerDataService.Mutate(player, function(p)
		stored = EconomyRules.AddOre(p, amount, unit)
		local overflow = math.floor(amount) - stored
		if opts.Overflow == "refine" and overflow > 0 then
			refined = math.floor(overflow * unit * EconomyRules.CreditMultiplier(p, ctx) + 1e-9)
			EconomyRules.AddCredits(p, refined)
		end
	end)
	JuiceService.Send(player, "Ore", {
		Amount = stored,
		OreId = oreId,
		Refined = refined,
		Full = cargoFull(profile),
		Position = opts.Position,
		Source = opts.Source,
	})
	CodexService.Discover(player, oreId)
	if stored > 0 then
		StatService.Bump(player, "OreStored", stored)
		StatService.Check(player, "LifetimeOre")
		TutorialService.OnOreStored(player)
	end
	if refined > 0 then
		StatService.Check(player, "LifetimeCredits", "Credits")
	end
	-- Auto-Sell Warp Link: a full hold warps itself to the refinery.
	if cargoFull(profile) and profile.TutorialComplete and PlayerDataService.HasPerk(player, "AutoSellWarpLink") then
		EconomyService.Sell(player, "warp")
	end
	return stored, refined
end

function EconomyService.AddCredits(player: Player, amount: number, source: string)
	if amount <= 0 then
		return
	end
	PlayerDataService.Mutate(player, function(p)
		EconomyRules.AddCredits(p, math.floor(amount))
	end)
	JuiceService.Send(player, "Credits", { Amount = math.floor(amount), Source = source })
	StatService.Check(player, "LifetimeCredits", "Credits")
	EconomyService.RefreshPrompts(player)
end

function EconomyService.AddShards(player: Player, amount: number, source: string)
	if amount <= 0 then
		return
	end
	PlayerDataService.Mutate(player, function(p)
		p.VoidShards += math.floor(amount)
		p.LifetimeShards += math.floor(amount)
	end)
	JuiceService.Send(player, "Shards", { Amount = math.floor(amount), Source = source })
	StatService.Bump(player, "ShardsFound", math.floor(amount))
	StatService.Check(player, "LifetimeShards")
end

function EconomyService.Upgrade(player: Player, upgradeId: string, branch: string?): (boolean, string?)
	local id = EconomyRules.NormalizeUpgradeId(upgradeId)
	if not EconomyConfig.Upgrades[id] then
		return false, "unknown"
	end
	local ctx = PlayerDataService.Ctx(player)
	local ok, cost, reason = false, 0, nil :: string?
	local newSectors: { string } = {}
	PlayerDataService.Mutate(player, function(p)
		local before = table.clone(p.GalaxyFlags)
		ok, cost, reason = EconomyRules.ApplyUpgrade(p, id, ctx, branch)
		if ok then
			for sectorId, flag in p.GalaxyFlags do
				if flag and not before[sectorId] then
					table.insert(newSectors, sectorId)
				end
			end
		end
	end)
	if not ok then
		JuiceService.Send(player, "UpgradeFail", { Id = id, Reason = reason })
		return false, reason
	end
	local profile = PlayerDataService.Get(player) :: any
	local def = EconomyConfig.Upgrades[id]
	JuiceService.Send(player, "Upgrade", { Id = id, Level = profile[def.Stat], Cost = cost })
	StatService.Bump(player, "UpgradesBought", 1)
	StatService.Check(player, def.Stat)
	for _, sectorId in newSectors do
		JuiceService.Banner(player, "SECTOR DISCOVERED · " .. GalaxyConfig.Label(sectorId), "gold")
		StatService.Check(player, "Flag:GalaxyFlags." .. sectorId)
	end
	TutorialService.OnUpgrade(player, id)
	for _, callback in upgradedCallbacks do
		task.spawn(callback, player, id)
	end
	EconomyService.RefreshPrompts(player)
	return true, nil
end

function EconomyService.QuickUpgrade(player: Player): boolean
	local profile = PlayerDataService.Get(player)
	if not profile then
		return false
	end
	local choice = EconomyRules.QuickUpgradeChoice(profile, PlayerDataService.Ctx(player))
	if not choice then
		JuiceService.Send(player, "UpgradeFail", { Id = "", Reason = "funds" })
		return false
	end
	return (EconomyService.Upgrade(player, choice))
end

local function ownerOf(index: number): Player?
	return PlotService.Owners[index]
end

local function makePrompt(parent: Instance, action: string, object: string, key: Enum.KeyCode): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.ObjectText = object
	prompt.KeyboardKeyCode = key
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = parent
	return prompt
end

local function buildPrompts(index: number)
	local plot = PlotService.Folder(index)
	local station = plot and plot:FindFirstChild("Station")
	if not station then
		return
	end
	local set: { [string]: ProximityPrompt } = {}
	prompts[index] = set
	local pads = station:FindFirstChild("UpgradePads")
	if pads then
		for _, pad in pads:GetChildren() do
			local upgradeId = pad:GetAttribute("UpgradeId")
			if type(upgradeId) == "string" and EconomyConfig.Upgrades[upgradeId] then
				local prompt = makePrompt(pad, "Upgrade", EconomyConfig.Upgrades[upgradeId].Label, Enum.KeyCode.E)
				set[upgradeId] = prompt
				prompt.Triggered:Connect(function(player)
					if ownerOf(index) ~= player then
						JuiceService.Banner(player, "This is another pilot's station", "warn")
						return
					end
					local branch = if upgradeId == "DroneTier" then player:GetAttribute("PreferredBranch") else nil
					EconomyService.Upgrade(player, upgradeId, if type(branch) == "string" then branch else nil)
				end)
			end
		end
	end
	local refinery = station:FindFirstChild("Refinery")
	if refinery then
		local prompt = makePrompt(refinery, "Refine", "Refinery", Enum.KeyCode.E)
		set.Refinery = prompt
		prompt.Triggered:Connect(function(player)
			if ownerOf(index) == player then
				EconomyService.Sell(player, "prompt")
			end
		end)
	end
	local tuner = station:FindFirstChild("LaserTuner")
	if tuner then
		local prompt = makePrompt(tuner, "Tune Laser", "Laser Tuner", Enum.KeyCode.E)
		set.LaserTuner = prompt
		prompt.Triggered:Connect(function(player)
			if ownerOf(index) ~= player then
				return
			end
			PlayerDataService.Mutate(player, function(p)
				local order = DroneConfig.LaserColorOrder
				local current = table.find(order, p.Settings.LaserColor) or 0
				p.Settings.LaserColor = order[current % #order + 1]
				player:SetAttribute("LaserColor", p.Settings.LaserColor)
			end)
			JuiceService.Send(player, "LaserTuned", {})
		end)
	end
end

local function nearOwnRefinery(player: Player, extra: number): boolean
	local position = PlotService.World(player, PlotLayout.Refinery)
	return position ~= nil and ValidateRemote.NearPosition(player, position, extra)
end

local function padSellTick()
	local now = os.clock()
	for index, player in PlotService.Owners do
		local profile = PlayerDataService.Get(player)
		local root = PlotService.RootPart(player)
		if not profile or not root or profile.Ore <= 0 then
			continue
		end
		if now - (lastPadSell[player.UserId] or 0) < PAD_SELL_COOLDOWN then
			continue
		end
		local localPos = PlotLayout.PlotCFrame(index):PointToObjectSpace(root.Position) - PlotLayout.Refinery
		if
			math.abs(localPos.X) <= PAD_ZONE_HALF
			and math.abs(localPos.Z) <= PAD_ZONE_HALF
			and math.abs(localPos.Y) < 7
		then
			lastPadSell[player.UserId] = now
			EconomyService.Sell(player, "pad")
		end
	end
end

function EconomyService.Init()
	for index = 1, GameConfig.PlotCount do
		buildPrompts(index)
	end
	PlotService.OnClaimed(function(player)
		EconomyService.RefreshPrompts(player)
	end)

	ValidateRemote.Bind("SellOre", { Rate = 0.4, Burst = 3 }, function(player)
		local profile = PlayerDataService.Get(player)
		if not profile then
			return
		end
		local remote = PlayerDataService.HasPerk(player, "AutoSellWarpLink")
		if remote or nearOwnRefinery(player, EconomyConfig.SellRange) then
			EconomyService.Sell(player, if remote then "warp" else "remote")
		else
			JuiceService.Banner(player, "Fly back to your Refinery to sell", "warn")
		end
	end)

	ValidateRemote.Bind(
		"RequestUpgrade",
		{ Rate = 0.15, Burst = 6, Args = { "string", "string?" }, MaxString = 24 },
		function(player, upgradeId, branch)
			if branch ~= nil and not DroneConfig.Branches[branch] then
				return
			end
			if branch then
				player:SetAttribute("PreferredBranch", branch)
			end
			EconomyService.Upgrade(player, upgradeId, branch)
		end
	)

	ValidateRemote.Bind("QuickUpgrade", { Rate = 0.15, Burst = 6 }, function(player)
		EconomyService.QuickUpgrade(player)
	end)

	task.spawn(function()
		while true do
			task.wait(0.25)
			padSellTick()
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastPadSell[player.UserId] = nil
	end)
end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">ForgeService</string>
            <string name="Source"><![CDATA[--!strict
-- Artifact Forge: 25 Void Shards -> 1 artifact (timed job that survives a
-- rejoin) -> 40 Voidline Tokens. After 500 tokens in a UTC day the forge
-- "cools" (slower jobs) instead of hard-capping.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local ProgressionRules = require(Voidline.Rules.ProgressionRules)

local ValidateRemote = require(script.Parent.Parent.Security.ValidateRemote)
local PlayerDataService = require(script.Parent.PlayerDataService)
local JuiceService = require(script.Parent.JuiceService)
local StatService = require(script.Parent.StatService)

local ForgeService = {}

function ForgeService.Start(player: Player): (boolean, string?)
	local ok, reason, duration = false, nil :: string?, 0
	PlayerDataService.Mutate(player, function(p)
		ok, reason, duration = ProgressionRules.StartForge(p, os.time())
	end)
	if ok then
		local profile = PlayerDataService.Get(player) :: any
		JuiceService.Send(player, "Forge", {
			Phase = "start",
			Seconds = duration,
			Cooling = ProgressionRules.ForgeCooling(profile),
		})
		task.delay(duration + 0.05, function()
			ForgeService.Collect(player)
		end)
	else
		JuiceService.Send(player, "Forge", { Phase = "fail", Reason = reason })
	end
	return ok, reason
end

function ForgeService.Collect(player: Player): boolean
	local collected = false
	PlayerDataService.Mutate(player, function(p)
		collected = ProgressionRules.CollectForge(p, os.time())
	end)
	if collected then
		JuiceService.Send(player, "Forge", { Phase = "done" })
		StatService.Bump(player, "ArtifactsForged", 1)
	end
	return collected
end

function ForgeService.TurnIn(player: Player): boolean
	local ok, tokens = false, 0
	PlayerDataService.Mutate(player, function(p)
		ok, tokens = ProgressionRules.TurnInArtifact(p, os.time())
	end)
	if ok then
		JuiceService.Send(player, "Tokens", { Amount = tokens })
		StatService.Check(player, "LifetimeTokens")
		task.spawn(PlayerDataService.Save, player)
	else
		JuiceService.Send(player, "Forge", { Phase = "fail", Reason = "artifacts" })
	end
	return ok
end

function ForgeService.Init()
	ValidateRemote.Bind("RequestForge", { Rate = 0.5, Burst = 3 }, function(player)
		local profile = PlayerDataService.Get(player)
		if not profile then
			return
		end
		if profile.ForgeJobEndsAt > 0 then
			if not ForgeService.Collect(player) then
				JuiceService.Send(player, "Forge", { Phase = "busy", EndsAt = profile.ForgeJobEndsAt })
			end
		else
			ForgeService.Start(player)
		end
	end)
	ValidateRemote.Bind("TurnInArtifact", { Rate = 0.3, Burst = 3 }, function(player)
		ForgeService.TurnIn(player)
	end)

	local map = Workspace:FindFirstChild("VoidlineMap")
	local hub = map and map:FindFirstChild("Hub")
	local pad = hub and hub:FindFirstChild("ForgePad")
	if pad then
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Forge"
		prompt.ObjectText = "Artifact Forge · 25 Shards"
		prompt.HoldDuration = 0.5
		prompt.MaxActivationDistance = 12
		prompt.RequiresLineOfSight = false
		prompt.Parent = pad
		prompt.Triggered:Connect(function(player)
			local profile = PlayerDataService.Get(player)
			if not profile then
				return
			end
			if profile.Artifacts > 0 then
				ForgeService.TurnIn(player)
			elseif profile.ForgeJobEndsAt > 0 then
				ForgeService.Collect(player)
			else
				ForgeService.Start(player)
			end
		end)
	end

	-- Finish jobs that completed while the pilot was offline.
	PlayerDataService.OnLoaded(function(player, profile)
		if profile.ForgeJobEndsAt > 0 then
			local remaining = profile.ForgeJobEndsAt - os.time()
			task.delay(math.max(0, remaining) + 0.05, function()
				ForgeService.Collect(player)
			end)
		end
	end)
end

return ForgeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">InspectService</string>
            <string name="Source"><![CDATA[--!strict
-- Pilot Cards: a compact, read-only summary of another pilot in the server.
-- Only registry names and numbers are sent (no free text from players).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local Remotes = require(Voidline.Remotes)
local TitleRegistry = require(Voidline.Content.TitleRegistry)
local DroneRegistry = require(Voidline.Content.DroneRegistry)
local RelicRegistry = require(Voidline.Content.RelicRegistry)
local CitadelRegistry = require(Voidline.Content.CitadelRegistry)

local ValidateRemote = require(script.Parent.Parent.Security.ValidateRemote)
local PlayerDataService = require(script.Parent.PlayerDataService)

local InspectService = {}

local function count(map: { [any]: any }): number
	local n = 0
	for _ in map do
		n += 1
	end
	return n
end

function InspectService.Card(target: Player): { [string]: any }?
	local session = PlayerDataService.Session(target)
	if not session then
		return nil
	end
	local profile = session.Profile
	local title = TitleRegistry.ById[profile.Cosmetics.Title]
	local evolution = DroneRegistry.EvolutionFor(profile.DroneTier, profile.DroneBranch)
	local relics = {}
	for _, relicId in profile.RelicDisplay do
		local relic = RelicRegistry.ById[relicId]
		if relic and #relics < 3 then
			table.insert(relics, relic.Name)
		end
	end
	return {
		UserId = target.UserId,
		Name = target.DisplayName,
		Title = if title then title.Name else "",
		StationTier = profile.StationTier,
		Citadel = CitadelRegistry.ForTier(profile.StationTier).Name,
		Rebirths = profile.Rebirths,
		Codex = session.CodexCount,
		Relics = count(profile.Relics),
		Achievements = count(profile.Achievements),
		Drone = evolution.Name,
		Drones = target:GetAttribute("DroneCount") or 1,
		Formation = profile.Formation,
		Streak = profile.DailyStreak,
		Showcase = relics,
	}
end

function InspectService.Init()
	ValidateRemote.Bind("InspectPilot", { Rate = 1, Burst = 3, Args = { "integer" } }, function(player, targetUserId)
		local target = Players:GetPlayerByUserId(targetUserId)
		if not target then
			return
		end
		local card = InspectService.Card(target)
		if card then
			Remotes.Get("InspectResult"):FireClient(player, card)
		end
	end)
end

return InspectService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">JuiceService</string>
            <string name="Source"><![CDATA[--!strict
-- Server -> client feedback. Every message is a small table with a `Kind`;
-- the client turns kinds into banners, popups, sounds and camera nudges.
-- Gameplay never depends on these arriving.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Voidline").Remotes)

local JuiceService = {}

function JuiceService.Send(player: Player, kind: string, payload: { [string]: any }?)
	local message: { [string]: any } = payload or {}
	message.Kind = kind
	Remotes.Get("JuiceEvent"):FireClient(player, message)
end

function JuiceService.All(kind: string, payload: { [string]: any }?)
	local message: { [string]: any } = payload or {}
	message.Kind = kind
	Remotes.Get("JuiceEvent"):FireAllClients(message)
end

-- Style: "info" | "good" | "gold" | "void" | "warn"
function JuiceService.Banner(player: Player, text: string, style: string?)
	JuiceService.Send(player, "Banner", { Text = text, Style = style or "info" })
end

function JuiceService.BannerAll(text: string, style: string?)
	JuiceService.All("Banner", { Text = text, Style = style or "info" })
end

function JuiceService.Init() end

return JuiceService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--!strict
-- Four holographic OrderedDataStore boards on the hub, refreshed every
-- ~90 s (never per change). Writes are budget-checked; if DataStores are
-- unavailable (Studio without API access) the boards show this server only.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local GameConfig = require(Voidline.Config.GameConfig)
local HubLayout = require(Voidline.Modules.HubLayout)
local FormatNumber = require(Voidline.Modules.FormatNumber)

local PlayerDataService = require(script.Parent.PlayerDataService)

local LeaderboardService = {}

local ROWS = 10
local STORE_PREFIX = "VoidlineBoard_"

type Row = { UserId: number, Value: number }

local VALUE_OF: { [string]: (any, any) -> number } = {
	TopCredits = function(profile)
		return profile.LifetimeCredits
	end,
	TopRebirths = function(profile)
		return profile.Rebirths
	end,
	CodexDiscoveries = function(_profile, session)
		return session.CodexCount
	end,
	TopSummoners = function(profile)
		return profile.Stats.Summons or 0
	end,
}

local stores: { [string]: any } = {}
local names: { [number]: string } = {}
local storesAvailable = true

local function getStore(boardId: string): any
	if not storesAvailable then
		return nil
	end
	if stores[boardId] then
		return stores[boardId]
	end
	local ok, store = pcall(function()
		return DataStoreService:GetOrderedDataStore(STORE_PREFIX .. boardId)
	end)
	if ok and store then
		stores[boardId] = store
		return store
	end
	storesAvailable = false
	return nil
end

local function nameFor(userId: number): string
	local cached = names[userId]
	if cached then
		return cached
	end
	local online = Players:GetPlayerByUserId(userId)
	if online then
		names[userId] = online.DisplayName
		return online.DisplayName
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local resolved = if ok and type(name) == "string" then name else "Pilot"
	names[userId] = resolved
	return resolved
end

local function budget(): number
	local ok, value = pcall(function()
		return DataStoreService:GetRequestBudgetForRequestType(Enum.DataStoreRequestType.SetIncrementSortedAsync)
	end)
	return if ok then value else 0
end

local function writeOnline(boardId: string)
	local store = getStore(boardId)
	if not store then
		return
	end
	for _, session in PlayerDataService._sessions do
		if budget() < 4 then
			return
		end
		local value = math.floor(VALUE_OF[boardId](session.Profile, session))
		if value > 0 then
			pcall(function()
				store:SetAsync(tostring(session.UserId), value)
			end)
		end
	end
end

local function readTop(boardId: string): { Row }
	local rows: { Row } = {}
	local store = getStore(boardId)
	if store then
		local ok, pages = pcall(function()
			return store:GetSortedAsync(false, ROWS)
		end)
		if ok and pages then
			local okPage, page = pcall(function()
				return pages:GetCurrentPage()
			end)
			if okPage and page then
				for _, entry in page do
					local userId = tonumber(entry.key)
					if userId then
						table.insert(rows, { UserId = userId, Value = entry.value })
					end
				end
			end
		end
	end
	if #rows == 0 then
		-- Fallback: this server's pilots.
		for _, session in PlayerDataService._sessions do
			table.insert(
				rows,
				{ UserId = session.UserId, Value = math.floor(VALUE_OF[boardId](session.Profile, session)) }
			)
		end
		table.sort(rows, function(a, b)
			if a.Value ~= b.Value then
				return a.Value > b.Value
			end
			return a.UserId < b.UserId
		end)
		while #rows > ROWS do
			table.remove(rows)
		end
	end
	return rows
end

local function boardGui(board: BasePart, title: string): Frame
	local existing = board:FindFirstChild("BoardGui")
	if existing then
		return (existing :: any).List
	end
	local gui = Instance.new("SurfaceGui")
	gui.Name = "BoardGui"
	gui.Face = Enum.NormalId.Front
	gui.LightInfluence = 0
	gui.PixelsPerStud = 30
	gui.Parent = board
	local header = Instance.new("TextLabel")
	header.Name = "Header"
	header.BackgroundTransparency = 1
	header.Size = UDim2.fromScale(1, 0.12)
	header.Font = Enum.Font.GothamBlack
	header.TextScaled = true
	header.TextColor3 = GameConfig.Colors.GoldBright
	header.Text = title
	header.Parent = gui
	local list = Instance.new("Frame")
	list.Name = "List"
	list.BackgroundTransparency = 1
	list.Position = UDim2.fromScale(0.05, 0.14)
	list.Size = UDim2.fromScale(0.9, 0.84)
	list.Parent = gui
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 2)
	layout.Parent = list
	return list
end

local function render(boardId: string, rows: { Row })
	local map = Workspace:FindFirstChild("VoidlineMap")
	local hub = map and map:FindFirstChild("Hub")
	local boards = hub and hub:FindFirstChild("Leaderboards")
	local board = boards and boards:FindFirstChild(boardId)
	if not board or not board:IsA("BasePart") then
		return
	end
	local title = board:GetAttribute("Title")
	local list = boardGui(board, if type(title) == "string" then title else boardId)
	for i = 1, ROWS do
		local label = list:FindFirstChild("Row" .. i) :: TextLabel?
		if not label then
			local newLabel = Instance.new("TextLabel")
			newLabel.Name = "Row" .. i
			newLabel.LayoutOrder = i
			newLabel.BackgroundTransparency = 1
			newLabel.Size = UDim2.fromScale(1, 0.095)
			newLabel.Font = Enum.Font.GothamMedium
			newLabel.TextScaled = true
			newLabel.TextXAlignment = Enum.TextXAlignment.Left
			newLabel.TextColor3 = if i <= 3 then GameConfig.Colors.Gold else Color3.fromRGB(220, 220, 235)
			newLabel.Parent = list
			label = newLabel
		end
		local row = rows[i]
		local target = label :: TextLabel
		target.Text = if row
			then ("%d. %s  ·  %s"):format(i, nameFor(row.UserId), FormatNumber.Compact(row.Value))
			else ""
	end
end

function LeaderboardService.Refresh()
	for _, def in HubLayout.Boards do
		writeOnline(def.Id)
		render(def.Id, readTop(def.Id))
	end
end

function LeaderboardService.Init()
	task.spawn(function()
		task.wait(10)
		while true do
			local ok, err = pcall(function(): ...any
				return LeaderboardService.Refresh()
			end)
			if not ok then
				warn("[Voidline] leaderboard refresh failed: " .. tostring(err))
			end
			task.wait(GameConfig.LeaderboardRefreshSeconds)
		end
	end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">MapBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- Builds the static world from PlotLayout / HubLayout: hub with the Voidline
-- Monolith (two halves so it can split), pads, monument, leaderboard boards,
-- the Void Rift spiral, the quiet star overlook and 12 obsidian-gold plots
-- with segmented Energy Bridges. Dynamic pieces (belt rocks, citadel,
-- pedestals, prompts) are added by their services.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local GameConfig = require(Voidline.Config.GameConfig)
local PlotLayout = require(Voidline.Modules.PlotLayout)
local HubLayout = require(Voidline.Modules.HubLayout)

local MapBuilder = {}

local COLORS = GameConfig.Colors

type PartProps = {
	Name: string?,
	Parent: Instance?,
	Size: Vector3?,
	CFrame: CFrame?,
	Color: Color3?,
	Material: Enum.Material?,
	Transparency: number?,
	CanCollide: boolean?,
	CanQuery: boolean?,
	Shape: Enum.PartType?,
	CastShadow: boolean?,
}

local function part(props: PartProps): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = props.CanCollide ~= false
	p.CanQuery = props.CanQuery ~= false
	p.CanTouch = false
	p.CastShadow = props.CastShadow == true
	p.Material = props.Material or Enum.Material.SmoothPlastic
	p.Color = props.Color or COLORS.Obsidian
	p.Size = props.Size or Vector3.new(4, 1, 4)
	p.CFrame = props.CFrame or CFrame.new()
	p.Name = props.Name or "Part"
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Transparency = props.Transparency or 0
	if props.Shape then
		p.Shape = props.Shape
	end
	p.Parent = props.Parent
	return p
end
MapBuilder.Part = part

local function folder(name: string, parent: Instance): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function label(parent: Instance, text: string, height: number, maxDistance: number, color: Color3?): BillboardGui
	local bb = Instance.new("BillboardGui")
	bb.Name = "Label"
	bb.Size = UDim2.fromOffset(200, 34)
	bb.StudsOffset = Vector3.new(0, height, 0)
	bb.AlwaysOnTop = false
	bb.MaxDistance = maxDistance
	bb.LightInfluence = 0
	bb.Parent = parent
	local text_ = Instance.new("TextLabel")
	text_.Name = "Text"
	text_.BackgroundTransparency = 0.3
	text_.BackgroundColor3 = COLORS.Obsidian
	text_.Size = UDim2.fromScale(1, 1)
	text_.Font = Enum.Font.GothamBold
	text_.TextScaled = true
	text_.TextColor3 = color or COLORS.Gold
	text_.Text = text
	text_.Parent = bb
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = text_
	local stroke = Instance.new("UIStroke")
	stroke.Color = COLORS.Gold
	stroke.Transparency = 0.5
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = text_
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 8)
	padding.PaddingRight = UDim.new(0, 8)
	padding.Parent = text_
	return bb
end
MapBuilder.Label = label

local function goldTrim(parent: Instance, base: CFrame, size: Vector3)
	local half = size / 2
	local edges = {
		{ Vector3.new(0, half.Y, -half.Z), Vector3.new(size.X, 0.4, 0.6) },
		{ Vector3.new(0, half.Y, half.Z), Vector3.new(size.X, 0.4, 0.6) },
		{ Vector3.new(-half.X, half.Y, 0), Vector3.new(0.6, 0.4, size.Z) },
		{ Vector3.new(half.X, half.Y, 0), Vector3.new(0.6, 0.4, size.Z) },
	}
	for i, edge in edges do
		part({
			Name = "GoldTrim" .. i,
			Parent = parent,
			Size = edge[2],
			CFrame = base * CFrame.new(edge[1]),
			Color = COLORS.Gold,
			Material = Enum.Material.Neon,
			CanCollide = false,
			CanQuery = false,
		})
	end
end

local function buildHub(root: Instance)
	local hub = folder("Hub", root)
	local hubCFrame = CFrame.new(0, 0, 0)
	part({
		Name = "HubPad",
		Parent = hub,
		Size = HubLayout.HubSize,
		CFrame = hubCFrame,
		Material = Enum.Material.Basalt,
	})
	goldTrim(hub, hubCFrame, HubLayout.HubSize)

	-- Monolith: two halves (split along X) plus gold bands and the Void Core.
	local monolith = folder("VoidlineMonolith", hub)
	local size = HubLayout.MonolithSize
	local sides: { [string]: number } = { Left = -1, Right = 1 }
	for side, sign in sides do
		local halfSize = Vector3.new(size.X / 2, size.Y, size.Z)
		local half = part({
			Name = "Monolith" .. side,
			Parent = monolith,
			Size = halfSize,
			CFrame = CFrame.new(HubLayout.MonolithCenter + Vector3.new(sign * size.X / 4, 0, 0)),
			Material = Enum.Material.Slate,
			Color = Color3.fromRGB(14, 12, 20),
			CastShadow = true,
		})
		half:SetAttribute("Side", sign)
		half:SetAttribute("HomeCFrame", half.CFrame)
		for i = 1, 4 do
			local band = part({
				Name = "GoldBand" .. i,
				Parent = half,
				Size = Vector3.new(halfSize.X + 0.6, 1.2, halfSize.Z + 0.6),
				CFrame = half.CFrame * CFrame.new(0, -size.Y / 2 + 10 + i * 13, 0),
				Color = COLORS.Gold,
				Material = Enum.Material.Neon,
				CanCollide = false,
				CanQuery = false,
			})
			band:SetAttribute("Offset", half.CFrame:ToObjectSpace(band.CFrame))
		end
	end
	local core = part({
		Name = "VoidCore",
		Parent = monolith,
		Size = Vector3.new(7, 7, 7),
		CFrame = CFrame.new(HubLayout.VoidCore),
		Color = COLORS.VoidAccent,
		Material = Enum.Material.Neon,
		Shape = Enum.PartType.Ball,
		CanCollide = false,
		Transparency = 1,
	})
	core:SetAttribute("Exposed", false)
	label(monolith:FindFirstChild("MonolithLeft") :: Instance, "THE VOIDLINE MONOLITH", 42, 160)
	local monolithHalfSize = Vector3.new(size.X / 2, size.Y, size.Z)
	for side, sign in sides do
		local half = monolith:FindFirstChild("Monolith" .. side)
		if half and half:IsA("BasePart") then
			part({
				Name = "SpireCrown",
				Parent = half,
				Size = Vector3.new(monolithHalfSize.X * 0.35, 5, monolithHalfSize.Z * 0.35),
				CFrame = half.CFrame * CFrame.new(0, size.Y / 2 + 2.5, 0),
				Color = COLORS.GoldBright,
				Material = Enum.Material.Neon,
				CanCollide = false,
				CanQuery = false,
			})
			part({
				Name = "SpireFin",
				Parent = half,
				Size = Vector3.new(1.2, 14, 1.2),
				CFrame = half.CFrame
					* CFrame.new(sign * (monolithHalfSize.X * 0.28), size.Y / 2 + 9, 0)
					* CFrame.Angles(0, 0, sign * math.rad(8)),
				Color = COLORS.VoidAccent,
				Material = Enum.Material.Glass,
				Transparency = 0.15,
				CanCollide = false,
				CanQuery = false,
			})
		end
	end
	part({
		Name = "HubSilhouetteRing",
		Parent = hub,
		Size = Vector3.new(2, HubLayout.HubSize.X * 1.45, HubLayout.HubSize.Z * 1.45),
		CFrame = hubCFrame * CFrame.Angles(0, 0, math.rad(90)),
		Shape = Enum.PartType.Cylinder,
		Color = COLORS.Gold,
		Material = Enum.Material.Neon,
		Transparency = 0.82,
		CanCollide = false,
		CanQuery = false,
	})

	local function pad(name: string, position: Vector3, padSize: Vector3, color: Color3, text: string)
		local p = part({
			Name = name,
			Parent = hub,
			Size = padSize,
			CFrame = CFrame.new(position),
			Color = color,
			Material = Enum.Material.Neon,
		})
		label(p, text, 4, 70)
		return p
	end
	pad("RebirthPad", HubLayout.RebirthPad, Vector3.new(12, 1, 12), COLORS.Gold, "VOID REBIRTH")
	pad("ForgePad", HubLayout.ForgePad, Vector3.new(12, 1, 12), COLORS.VoidAccent, "ARTIFACT FORGE")
	pad("SummonPad", HubLayout.SummonPad, Vector3.new(12, 1, 12), COLORS.GoldBright, "SERVER SUMMONS")
	pad("VipLounge", HubLayout.VipLounge, Vector3.new(18, 1, 18), COLORS.Gold, "VOID SOVEREIGN LOUNGE")
	pad("OverlookGate", HubLayout.OverlookGate, Vector3.new(10, 1, 10), Color3.fromRGB(255, 236, 190), "STAR OVERLOOK")
	pad("RiftGate", HubLayout.RiftGate, Vector3.new(10, 1, 10), Color3.fromRGB(190, 120, 255), "VOID RIFT")

	local terminal = part({
		Name = "CodeTerminal",
		Parent = hub,
		Size = Vector3.new(8, 10, 2),
		CFrame = CFrame.lookAt(HubLayout.CodeTerminal, Vector3.new(0, HubLayout.CodeTerminal.Y, 0)),
		Material = Enum.Material.Metal,
	})
	label(terminal, "CODE TERMINAL", 7, 60)

	-- "Created by Killshot2336" monument: obsidian plinth, gold obelisk, plaque.
	local monument = folder("CreatorMonument", hub)
	local plinth = part({
		Name = "Plinth",
		Parent = monument,
		Size = Vector3.new(10, 2, 10),
		CFrame = CFrame.new(HubLayout.Monument + Vector3.new(0, 1, 0)),
		Material = Enum.Material.Marble,
		Color = Color3.fromRGB(20, 18, 26),
	})
	part({
		Name = "Obelisk",
		Parent = monument,
		Size = Vector3.new(3, 18, 3),
		CFrame = plinth.CFrame * CFrame.new(0, 10, 0),
		Material = Enum.Material.Foil,
		Color = COLORS.Gold,
	})
	part({
		Name = "Crown",
		Parent = monument,
		Size = Vector3.new(4, 4, 4),
		CFrame = plinth.CFrame * CFrame.new(0, 21, 0) * CFrame.Angles(math.rad(45), 0, math.rad(45)),
		Material = Enum.Material.Neon,
		Color = COLORS.GoldBright,
		CanCollide = false,
	})
	local plaque = part({
		Name = "Plaque",
		Parent = monument,
		Size = Vector3.new(8, 3, 0.4),
		CFrame = CFrame.lookAt(plinth.Position + Vector3.new(0, 2.5, 5.2), Vector3.new(0, 3.5, 0)),
		Material = Enum.Material.Metal,
	})
	local surface = Instance.new("SurfaceGui")
	surface.Name = "PlaqueGui"
	surface.Face = Enum.NormalId.Front
	surface.LightInfluence = 0
	surface.PixelsPerStud = 40
	surface.Parent = plaque
	local plaqueText = Instance.new("TextLabel")
	plaqueText.BackgroundTransparency = 1
	plaqueText.Size = UDim2.fromScale(1, 1)
	plaqueText.Font = Enum.Font.GothamBlack
	plaqueText.TextScaled = true
	plaqueText.TextColor3 = COLORS.Gold
	plaqueText.Text = "Created by " .. GameConfig.BrandCreator
	plaqueText.Parent = surface
	label(plinth, "Created by " .. GameConfig.BrandCreator, 26, 120)

	-- Leaderboard frames; LeaderboardService draws the holographic lists.
	local boards = folder("Leaderboards", hub)
	for _, def in HubLayout.Boards do
		local board = part({
			Name = def.Id,
			Parent = boards,
			Size = Vector3.new(12, 15, 0.6),
			CFrame = HubLayout.BoardCFrame(def.Angle),
			Color = Color3.fromRGB(20, 16, 34),
			Material = Enum.Material.Glass,
			Transparency = 0.35,
		})
		board:SetAttribute("Title", def.Title)
	end

	local spawnLocation = Instance.new("SpawnLocation")
	spawnLocation.Name = "VoidlineSpawn"
	spawnLocation.Anchored = true
	spawnLocation.Size = Vector3.new(10, 1, 10)
	spawnLocation.CFrame = CFrame.new(HubLayout.Spawn)
	spawnLocation.Color = COLORS.Gold
	spawnLocation.Material = Enum.Material.Neon
	spawnLocation.Duration = 0
	spawnLocation.Transparency = 0.6
	spawnLocation.Parent = hub

	-- Void Rift spiral: faint and solid only while the Rift event is open.
	local rift = folder("VoidRift", hub)
	for i = 1, HubLayout.RiftPlatforms do
		local p = part({
			Name = "RiftShard" .. i,
			Parent = rift,
			Size = Vector3.new(6, 1, 6),
			CFrame = CFrame.new(HubLayout.RiftPlatform(i)) * CFrame.Angles(0, i * 0.7, 0),
			Color = Color3.fromRGB(190, 120, 255),
			Material = Enum.Material.Neon,
			Transparency = 0.85,
			CanCollide = false,
		})
		p:SetAttribute("RiftIndex", i)
	end
	local cache = part({
		Name = "RiftCache",
		Parent = rift,
		Size = Vector3.new(8, 1, 8),
		CFrame = CFrame.new(HubLayout.RiftCache),
		Color = COLORS.GoldBright,
		Material = Enum.Material.Neon,
		Transparency = 0.85,
		CanCollide = false,
	})
	cache:SetAttribute("RiftIndex", HubLayout.RiftPlatforms + 1)
	return hub
end

local function buildDeepSpace(root: Instance)
	local deep = folder("DeepSpace", root)
	part({
		Name = "ZoneRing",
		Parent = deep,
		Size = Vector3.new(1, HubLayout.ZoneRadius * 2, HubLayout.ZoneRadius * 2),
		CFrame = CFrame.new(0, -6, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Shape = Enum.PartType.Cylinder,
		Color = Color3.fromRGB(30, 14, 60),
		Material = Enum.Material.Neon,
		Transparency = 0.9,
		CanCollide = false,
		CanQuery = false,
	})
	-- Thumbnail-readable Deep Space rim: tall neon pylons between hub and plot ring.
	for i = 1, 12 do
		local angle = (i - 0.5) / 12 * math.pi * 2
		local rim = (HubLayout.ZoneRadius + GameConfig.PlotRingRadius) * 0.52
		local pos = Vector3.new(math.cos(angle) * rim, 6, math.sin(angle) * rim)
		part({
			Name = "DeepSpacePylon" .. i,
			Parent = deep,
			Size = Vector3.new(1.4, 22, 1.4),
			CFrame = CFrame.new(pos),
			Color = if i % 2 == 0 then COLORS.VoidAccent else COLORS.GoldBright,
			Material = Enum.Material.Neon,
			Transparency = 0.2,
			CanCollide = false,
			CanQuery = false,
		})
	end
	part({
		Name = "DeepSpaceFloor",
		Parent = deep,
		Size = Vector3.new(HubLayout.ZoneRadius * 1.85, 0.6, HubLayout.ZoneRadius * 1.85),
		CFrame = CFrame.new(0, -8, 0),
		Color = Color3.fromRGB(8, 6, 14),
		Material = Enum.Material.Slate,
		CanCollide = false,
		CanQuery = false,
	})
	folder("SharedRocks", deep)
	folder("EventTargets", deep)
	folder("Hazards", deep)
end

local function buildOverlook(root: Instance)
	local overlook = folder("StarOverlook", root)
	local platform = part({
		Name = "OverlookPlatform",
		Parent = overlook,
		Size = Vector3.new(22, 1.5, 22),
		CFrame = CFrame.new(HubLayout.Overlook),
		Color = Color3.fromRGB(28, 24, 36),
		Material = Enum.Material.Marble,
	})
	goldTrim(overlook, platform.CFrame, platform.Size)
	local aura = part({
		Name = "AuraZone",
		Parent = overlook,
		Size = Vector3.new(22, 10, 22),
		CFrame = platform.CFrame * CFrame.new(0, 5.5, 0),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
	})
	aura:SetAttribute("CalmAura", true)
	local star = part({
		Name = "QuietStar",
		Parent = overlook,
		Size = Vector3.new(36, 36, 36),
		CFrame = CFrame.new(HubLayout.Overlook + Vector3.new(60, 70, -60)),
		Color = Color3.fromRGB(255, 236, 190),
		Material = Enum.Material.Neon,
		Shape = Enum.PartType.Ball,
		CanCollide = false,
		CanQuery = false,
	})
	star.Transparency = 0.1
	local spawnPad = part({
		Name = "ArrivalPad",
		Parent = overlook,
		Size = Vector3.new(6, 0.2, 6),
		CFrame = platform.CFrame * CFrame.new(0, 0.85, 6),
		Color = Color3.fromRGB(255, 236, 190),
		Material = Enum.Material.Neon,
		CanCollide = false,
		Transparency = 0.5,
	})
	spawnPad:SetAttribute("Arrival", true)
end

local function buildPlot(plots: Instance, index: number)
	local plotCFrame = PlotLayout.PlotCFrame(index)
	local plot = folder("Plot_" .. index, plots)
	plot:SetAttribute("PlotIndex", index)
	plot:SetAttribute("OwnerUserId", 0)
	plot:SetAttribute("OwnerName", "")
	plot:SetAttribute("BridgeIgnited", false)

	local baseCFrame = plotCFrame * CFrame.new(0, PlotLayout.SurfaceY - 1, 0)
	part({
		Name = "StationBase",
		Parent = plot,
		Size = PlotLayout.BaseSize,
		CFrame = baseCFrame,
		Material = Enum.Material.Basalt,
		Color = COLORS.Obsidian,
	})
	goldTrim(plot, baseCFrame, PlotLayout.BaseSize)
	local half = PlotLayout.BaseSize / 2
	local pylonOffsets = {
		Vector3.new(-half.X + 2, 2, -half.Z + 2),
		Vector3.new(half.X - 2, 2, -half.Z + 2),
		Vector3.new(-half.X + 2, 2, half.Z - 2),
		Vector3.new(half.X - 2, 2, half.Z - 2),
	}
	for i, offset in pylonOffsets do
		part({
			Name = "PlotPylon" .. i,
			Parent = plot,
			Size = Vector3.new(1.4, 7, 1.4),
			CFrame = plotCFrame * CFrame.new(offset),
			Color = COLORS.GoldBright,
			Material = Enum.Material.Neon,
			CanCollide = false,
			CanQuery = false,
		})
	end

	local spawnMarker = part({
		Name = "PlayerSpawn",
		Parent = plot,
		Size = Vector3.new(6, 0.2, 6),
		CFrame = plotCFrame * CFrame.new(PlotLayout.Spawn),
		Color = COLORS.GoldBright,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Transparency = 0.6,
	})
	spawnMarker:SetAttribute("Spawn", true)

	local station = folder("Station", plot)
	local refinery = part({
		Name = "Refinery",
		Parent = station,
		Size = PlotLayout.RefinerySize,
		CFrame = plotCFrame * CFrame.new(PlotLayout.Refinery),
		Color = COLORS.Gold,
		Material = Enum.Material.Neon,
	})
	label(refinery, "REFINERY", 4, 60)
	part({
		Name = "RefineryTower",
		Parent = station,
		Size = Vector3.new(8, 12, 6),
		CFrame = plotCFrame * CFrame.new(PlotLayout.RefineryTower),
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(26, 24, 34),
	})
	local grinder = part({
		Name = "GrinderCore",
		Parent = station,
		Size = Vector3.new(9, 9, 9),
		CFrame = plotCFrame * CFrame.new(PlotLayout.Grinder) * CFrame.Angles(math.rad(45), math.rad(45), 0),
		Color = Color3.fromRGB(30, 28, 44),
		Material = Enum.Material.DiamondPlate,
	})
	part({
		Name = "GrinderGlow",
		Parent = grinder,
		Size = Vector3.new(4, 4, 4),
		CFrame = grinder.CFrame,
		Color = COLORS.GoldBright,
		Material = Enum.Material.Neon,
		Shape = Enum.PartType.Ball,
		CanCollide = false,
		CanQuery = false,
	})
	label(grinder, "GRINDER CORE", 7, 60)

	local pads = folder("UpgradePads", station)
	for upgradeId, offset in PlotLayout.Pads do
		local pad = part({
			Name = upgradeId,
			Parent = pads,
			Size = PlotLayout.PadSize,
			CFrame = plotCFrame * CFrame.new(offset),
			Color = COLORS.Gold,
			Material = Enum.Material.Neon,
			Transparency = 0.1,
		})
		pad:SetAttribute("UpgradeId", upgradeId)
	end

	local tuner = part({
		Name = "LaserTuner",
		Parent = station,
		Size = Vector3.new(6, 1, 6),
		CFrame = plotCFrame * CFrame.new(PlotLayout.LaserTuner),
		Color = Color3.fromRGB(90, 220, 255),
		Material = Enum.Material.Neon,
	})
	label(tuner, "LASER TUNER", 3, 40)

	folder("Pedestals", plot)
	folder("Citadel", plot)
	folder("Belt", plot)

	-- Energy Bridge: segments from the plot's front edge to the hub ring.
	local bridge = folder("EnergyBridge", plot)
	local startPos = plotCFrame:PointToWorldSpace(PlotLayout.BridgeStart)
	local endPos = PlotLayout.BridgeEnd(index)
	local span = endPos - startPos
	local count = PlotLayout.BridgeSegments
	local segmentLength = span.Magnitude / count
	for i = 1, count do
		local center = startPos + span * ((i - 0.5) / count)
		local segment = part({
			Name = "Segment" .. i,
			Parent = bridge,
			Size = Vector3.new(7, 0.8, segmentLength + 0.05),
			CFrame = CFrame.lookAt(center, center + span),
			Color = COLORS.Gold,
			Material = Enum.Material.Neon,
			Transparency = 0.85,
			CanCollide = false,
		})
		segment:SetAttribute("SegmentIndex", i)
		part({
			Name = "Rail" .. i,
			Parent = bridge,
			Size = Vector3.new(0.35, 2.2, segmentLength * 0.92),
			CFrame = segment.CFrame * CFrame.new(3.4, 1.2, 0),
			Color = Color3.fromRGB(120, 200, 255),
			Material = Enum.Material.Glass,
			Transparency = 0.35,
			CanCollide = false,
			CanQuery = false,
		})
		part({
			Name = "RailL" .. i,
			Parent = bridge,
			Size = Vector3.new(0.35, 2.2, segmentLength * 0.92),
			CFrame = segment.CFrame * CFrame.new(-3.4, 1.2, 0),
			Color = Color3.fromRGB(120, 200, 255),
			Material = Enum.Material.Glass,
			Transparency = 0.35,
			CanCollide = false,
			CanQuery = false,
		})
	end
	return plot
end

function MapBuilder.Build(): Instance
	local existing = Workspace:FindFirstChild("VoidlineMap")
	if existing then
		return existing
	end
	local root = Instance.new("Folder")
	root.Name = "VoidlineMap"
	buildHub(root)
	buildDeepSpace(root)
	buildOverlook(root)
	local plots = folder("Plots", root)
	for i = 1, GameConfig.PlotCount do
		buildPlot(plots, i)
	end
	root.Parent = Workspace
	print(("[Voidline] MapBuilder: VoidlineMap ready (%d plots)"):format(GameConfig.PlotCount))
	return root
end

return MapBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[--!strict
-- Dual-currency store. Every Marketplace/Policy call is pcall-wrapped.
--   * Game passes: ownership checked on join and after a purchase prompt.
--     An ID of 0 is a placeholder: never prompted, never granted.
--   * Tokens: the same passes 15-20% cheaper, earn-only currency.
--   * Developer products (Robux-only summons): ProcessReceipt is idempotent.
--     The PurchaseId is recorded in the profile with the grant and
--     PurchaseGranted is returned only after that profile was saved.
--   * Paid random outcomes (Void Starfall) are disabled for players whose
--     policy restricts them (and when the policy lookup fails).
local MarketplaceService = game:GetService("MarketplaceService")
local PolicyService = game:GetService("PolicyService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local MonetizationConfig = require(Voidline.Config.MonetizationConfig)
local ProfileSchema = require(Voidline.Modules.ProfileSchema)
local StoreRules = require(Voidline.Rules.StoreRules)
local Remotes = require(Voidline.Remotes)

local ValidateRemote = require(script.Parent.Parent.Security.ValidateRemote)
local PlayerDataService = require(script.Parent.PlayerDataService)
local JuiceService = require(script.Parent.JuiceService)
local DroneService = require(script.Parent.DroneService)
local SummonService = require(script.Parent.SummonService)
local EconomyService = require(script.Parent.EconomyService)

local MonetizationService = {}

local restricted: { [number]: boolean } = {}

local function sendStoreState(player: Player)
	local session = PlayerDataService.Session(player)
	if not session then
		return
	end
	Remotes.Get("StoreState"):FireClient(player, {
		GamePasses = session.GamePasses,
		PaidRandomRestricted = restricted[player.UserId] ~= false,
	})
end

function MonetizationService.IsRandomRestricted(player: Player): boolean
	return restricted[player.UserId] ~= false
end

local function refreshPolicy(player: Player)
	local ok, info = pcall(function()
		return PolicyService:GetPolicyInfoForPlayerAsync(player)
	end)
	-- Fail closed: if we cannot read the policy, treat random items as restricted.
	local value = true
	if ok and type(info) == "table" then
		value = info.ArePaidRandomItemsRestricted == true
	end
	restricted[player.UserId] = value
	player:SetAttribute("PaidRandomRestricted", value)
end

local function applyPassGrants(player: Player, passId: string)
	local granted = false
	PlayerDataService.Mutate(player, function(p)
		granted = StoreRules.ApplyPassGrants(p, passId)
	end)
	if granted then
		local pass = MonetizationConfig.GetPass(passId)
		JuiceService.Send(player, "PassGranted", { Id = passId, Name = if pass then pass.Name else passId })
		if passId == "StarterBundle" then
			EconomyService.RefreshPrompts(player)
		end
	end
end

local function refreshGamePasses(player: Player)
	for _, pass in MonetizationConfig.Passes do
		if pass.GamePassId == 0 then
			continue
		end
		local ok, owned = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.GamePassId)
		end)
		if ok then
			PlayerDataService.SetGamePass(player, pass.Id, owned == true)
			if owned then
				applyPassGrants(player, pass.Id)
			end
		end
	end
	DroneService.RefreshLook(player)
	sendStoreState(player)
end

function MonetizationService.BuyWithTokens(player: Player, passId: string): (boolean, string?)
	local ok, reason = false, nil :: string?
	PlayerDataService.Mutate(player, function(p)
		ok, reason = StoreRules.BuyWithTokens(p, passId)
	end)
	if not ok then
		JuiceService.Send(player, "Store", { Ok = false, Reason = reason, Id = passId })
		return false, reason
	end
	applyPassGrants(player, passId)
	JuiceService.Send(player, "Store", { Ok = true, Id = passId, Currency = "Tokens" })
	DroneService.RefreshLook(player)
	sendStoreState(player)
	task.spawn(PlayerDataService.Save, player)
	return true, nil
end

function MonetizationService.PromptRobux(player: Player, kind: string, id: string): boolean
	if kind == "Pass" then
		local pass = MonetizationConfig.GetPass(id)
		if not pass or pass.GamePassId == 0 then
			JuiceService.Send(player, "Store", { Ok = false, Reason = "unavailable", Id = id })
			return false
		end
		local ok = pcall(function()
			MarketplaceService:PromptGamePassPurchase(player, pass.GamePassId)
		end)
		return ok
	elseif kind == "Product" then
		local product = MonetizationConfig.GetProduct(id)
		if not product or product.ProductId == 0 then
			JuiceService.Send(player, "Store", { Ok = false, Reason = "unavailable", Id = id })
			return false
		end
		if product.RandomOutcome and MonetizationService.IsRandomRestricted(player) then
			JuiceService.Send(player, "Store", { Ok = false, Reason = "restricted", Id = id })
			return false
		end
		local ok = pcall(function()
			MarketplaceService:PromptProductPurchase(player, product.ProductId)
		end)
		return ok
	end
	return false
end

function MonetizationService.ProcessReceipt(receiptInfo: any): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	local session = if player then PlayerDataService.Session(player) else nil
	if not player or not session then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local purchaseId = tostring(receiptInfo.PurchaseId)
	if session.Profile.ProcessedReceipts[purchaseId] then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local product = MonetizationConfig.ProductByProductId(receiptInfo.ProductId)
	if not product then
		warn(("[Voidline] receipt for unknown product %s"):format(tostring(receiptInfo.ProductId)))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	PlayerDataService.Mutate(player, function(p)
		ProfileSchema.RecordReceipt(p, purchaseId, os.time())
		ProfileSchema.Bump(p, "Summons", 1)
	end)
	SummonService.Enqueue(product.Id, player)
	JuiceService.Send(player, "Store", { Ok = true, Id = product.Id, Currency = "Robux" })
	if not PlayerDataService.SaveNow(player) then
		-- Recorded in memory, so a retry on this server will not double-grant.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function MonetizationService.Init()
	MarketplaceService.ProcessReceipt = MonetizationService.ProcessReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId, purchased)
		if not purchased then
			return
		end
		local pass = MonetizationConfig.PassByGamePassId(gamePassId)
		if pass then
			PlayerDataService.SetGamePass(player, pass.Id, true)
			applyPassGrants(player, pass.Id)
			DroneService.RefreshLook(player)
			sendStoreState(player)
		end
	end)

	ValidateRemote.Bind(
		"PurchaseWithTokens",
		{ Rate = 0.5, Burst = 2, Args = { "string" }, MaxString = 32 },
		function(player, passId)
			MonetizationService.BuyWithTokens(player, passId)
		end
	)
	ValidateRemote.Bind(
		"PromptRobuxPurchase",
		{ Rate = 0.5, Burst = 2, Args = { "string", "string" }, MaxString = 32 },
		function(player, kind, id)
			MonetizationService.PromptRobux(player, kind, id)
		end
	)

	PlayerDataService.OnLoaded(function(player)
		refreshPolicy(player)
		refreshGamePasses(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		restricted[player.UserId] = nil
	end)
end

return MonetizationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">PlayerDataService</string>
            <string name="Source"><![CDATA[--!strict
-- Session-locked player profiles.
--   * Load: UpdateAsync takes a lock {JobId, Time}. A live lock held by
--     another server is retried with backoff; the final attempt (or a lock
--     older than LOCK_STALE_SECONDS) takes the session over.
--   * Save: UpdateAsync only writes while this server still owns the lock, so
--     a server whose session was taken over can never overwrite newer data.
--   * Leave/BindToClose: final save releases the lock. A rejoin on the same
--     server waits for the in-flight release before loading.
--   * Replication: only changed keys are sent (DataSnapshot patches), at most
--     every FLUSH_INTERVAL seconds per player.
-- Studio without API access (or any DataStore outage at startup) degrades to
-- in-memory profiles that are never written.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local GameConfig = require(Voidline.Config.GameConfig)
local DroneConfig = require(Voidline.Config.DroneConfig)
local ProfileSchema = require(Voidline.Modules.ProfileSchema)
local StoreRules = require(Voidline.Rules.StoreRules)
local EconomyRules = require(Voidline.Rules.EconomyRules)
local ContentIndex = require(Voidline.Content.ContentIndex)
local Remotes = require(Voidline.Remotes)

local ValidateRemote = require(script.Parent.Parent.Security.ValidateRemote)

local STORE_NAME = "VoidlinePlayer_v1"
local KEY_PREFIX = "p_"
local RECORD_SCHEMA = 2
local LOCK_STALE_SECONDS = 30 * 60
local LOAD_ATTEMPTS = 5
local SAVE_ATTEMPTS = 3
local FLUSH_INTERVAL = 0.15
local RELEASE_WAIT_SECONDS = 30
local REMOVED = ProfileSchema.REMOVED

-- Never replicated to the client.
local SERVER_ONLY = { ProcessedReceipts = true, PassGrants = true, RedeemedCodes = true }

local SERVER_ID = if game.JobId ~= "" then game.JobId else "studio-" .. HttpService:GenerateGUID(false)

export type Session = {
	Player: Player,
	UserId: number,
	Profile: any,
	LastSent: any,
	Dirty: boolean,
	Saving: boolean,
	SaveQueued: boolean,
	Persist: boolean,
	Stolen: boolean,
	GamePasses: { [string]: boolean },
	CodexCount: number,
	JoinedAt: number,
}

local PlayerDataService = {
	ServerId = SERVER_ID,
	InMemory = false,
	_sessions = {} :: { [number]: Session },
	_loading = {} :: { [number]: boolean },
	_releasing = {} :: { [number]: boolean },
	_onLoaded = {} :: { (Player, any) -> () },
	_onRelease = {} :: { (Player, any) -> () },
	_onSettings = {} :: { (Player, any) -> () },
	_store = nil :: any,
	-- Set by WorldEventService: server-wide credit boost (events, anomalies).
	CreditBoostProvider = function(): number
		return 1
	end,
}

local function getStore(): any
	if PlayerDataService._store or PlayerDataService.InMemory then
		return PlayerDataService._store
	end
	local ok, store = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok and store then
		PlayerDataService._store = store
		return store
	end
	PlayerDataService.InMemory = true
	warn("[Voidline] DataStore unavailable; profiles are in-memory this session: " .. tostring(store))
	return nil
end

local function toRecord(raw: any): any
	if type(raw) ~= "table" then
		return { Schema = RECORD_SCHEMA }
	end
	if raw.Schema == nil and raw.Data == nil then
		-- v1 stored the flat profile directly under the key.
		return { Schema = RECORD_SCHEMA, Data = raw }
	end
	return raw
end

local function lockHeldElsewhere(record: any, now: number): boolean
	local lock = record.Lock
	return type(lock) == "table"
		and lock.JobId ~= SERVER_ID
		and type(lock.Time) == "number"
		and now - lock.Time < LOCK_STALE_SECONDS
end

-- Returns "ok" | "locked" | "error" plus the stored profile data.
local function acquire(store: any, userId: number, force: boolean): (string, any)
	local status, data = "error", nil
	local ok, err = pcall(function()
		store:UpdateAsync(KEY_PREFIX .. userId, function(raw)
			local record = toRecord(raw)
			local now = os.time()
			if lockHeldElsewhere(record, now) and not force then
				status = "locked"
				return nil
			end
			if force and lockHeldElsewhere(record, now) then
				warn(("[Voidline] taking over session lock for %d from %s"):format(userId, tostring(record.Lock.JobId)))
			end
			record.Lock = { JobId = SERVER_ID, Time = now }
			record.Schema = RECORD_SCHEMA
			status = "ok"
			data = record.Data
			return record
		end)
	end)
	if not ok then
		warn("[Voidline] profile load error for " .. userId .. ": " .. tostring(err))
		return "error", nil
	end
	return status, data
end

local function writeRecord(store: any, userId: number, snapshot: any, release: boolean): (boolean, boolean)
	local stolen = false
	local ok, err = pcall(function()
		store:UpdateAsync(KEY_PREFIX .. userId, function(raw)
			local record = toRecord(raw)
			if type(record.Lock) == "table" and record.Lock.JobId ~= SERVER_ID then
				stolen = true
				return nil
			end
			local now = os.time()
			record.Schema = RECORD_SCHEMA
			record.Data = snapshot
			record.SavedAt = now
			record.Lock = if release then nil else { JobId = SERVER_ID, Time = now }
			return record
		end)
	end)
	if not ok then
		warn("[Voidline] profile save error for " .. userId .. ": " .. tostring(err))
	end
	return ok, stolen
end

-- Replication ---------------------------------------------------------------

local function isFlat(t: { [any]: any }): boolean
	if #t > 0 then
		return false
	end
	for _, v in t do
		if type(v) == "table" then
			return false
		end
	end
	return true
end

local function deepEqual(a: any, b: any): boolean
	if a == b then
		return true
	end
	if type(a) ~= "table" or type(b) ~= "table" then
		return false
	end
	for k, v in a do
		if not deepEqual(v, b[k]) then
			return false
		end
	end
	for k in b do
		if a[k] == nil then
			return false
		end
	end
	return true
end

local function clientCopy(profile: any): any
	local out = {}
	for key, value in profile do
		if not SERVER_ONLY[key] then
			out[key] = ProfileSchema.DeepCopy(value)
		end
	end
	return out
end

-- Builds a patch of changed keys and advances `lastSent` to match.
function PlayerDataService.Diff(profile: any, lastSent: any): (any?, any?)
	local set, sub = nil, nil
	for key, value in profile do
		if SERVER_ONLY[key] then
			continue
		end
		local old = lastSent[key]
		if type(value) == "table" and type(old) == "table" and isFlat(value) and isFlat(old) then
			local changes = nil
			for k, v in value do
				if old[k] ~= v then
					changes = changes or {}
					changes[k] = v
				end
			end
			for k in old do
				if value[k] == nil then
					changes = changes or {}
					changes[k] = REMOVED
				end
			end
			if changes then
				sub = sub or {}
				sub[key] = changes
				for k, v in changes do
					old[k] = if v == REMOVED then nil else v
				end
			end
		elseif not deepEqual(value, old) then
			set = set or {}
			set[key] = ProfileSchema.DeepCopy(value)
			lastSent[key] = ProfileSchema.DeepCopy(value)
		end
	end
	return set, sub
end
PlayerDataService.REMOVED = REMOVED

local function flush(session: Session)
	session.Dirty = false
	local set, sub = PlayerDataService.Diff(session.Profile, session.LastSent)
	if set or sub then
		Remotes.Get("DataSnapshot"):FireClient(session.Player, { Set = set, Sub = sub })
	end
end

-- Public API ------------------------------------------------------------------

function PlayerDataService.Session(player: Player): Session?
	return PlayerDataService._sessions[player.UserId]
end

function PlayerDataService.Get(player: Player): any?
	local session = PlayerDataService._sessions[player.UserId]
	return if session then session.Profile else nil
end

function PlayerDataService.IsLoaded(player: Player): boolean
	return PlayerDataService._sessions[player.UserId] ~= nil
end

function PlayerDataService.MarkDirty(player: Player)
	local session = PlayerDataService._sessions[player.UserId]
	if session then
		session.Dirty = true
	end
end

function PlayerDataService.Mutate(player: Player, mutator: (any) -> ()): boolean
	local session = PlayerDataService._sessions[player.UserId]
	if not session then
		return false
	end
	mutator(session.Profile)
	session.Dirty = true
	return true
end

function PlayerDataService.FlushNow(player: Player)
	local session = PlayerDataService._sessions[player.UserId]
	if session then
		flush(session)
	end
end

function PlayerDataService.OnLoaded(callback: (Player, any) -> ())
	table.insert(PlayerDataService._onLoaded, callback)
end

function PlayerDataService.OnRelease(callback: (Player, any) -> ())
	table.insert(PlayerDataService._onRelease, callback)
end

function PlayerDataService.OnSettingsChanged(callback: (Player, any) -> ())
	table.insert(PlayerDataService._onSettings, callback)
end

function PlayerDataService.SetGamePass(player: Player, passId: string, owned: boolean)
	local session = PlayerDataService._sessions[player.UserId]
	if session then
		session.GamePasses[passId] = owned
	end
end

function PlayerDataService.Perks(player: Player): { [string]: boolean }
	local session = PlayerDataService._sessions[player.UserId]
	if not session then
		return {}
	end
	return StoreRules.EffectivePerks(session.Profile, os.time(), session.GamePasses)
end

function PlayerDataService.HasPerk(player: Player, perkId: string): boolean
	return PlayerDataService.Perks(player)[perkId] == true
end

function PlayerDataService.SetCodexCount(player: Player, count: number)
	local session = PlayerDataService._sessions[player.UserId]
	if session then
		session.CodexCount = count
	end
end

-- Rules context. During onboarding world/codex boosts are ignored so the
-- tutorial rewards stay exactly 10 ore -> 30 Credits.
function PlayerDataService.Ctx(player: Player): EconomyRules.Ctx
	local session = PlayerDataService._sessions[player.UserId]
	if not session then
		return { Perks = {} }
	end
	local perks = StoreRules.EffectivePerks(session.Profile, os.time(), session.GamePasses)
	if not session.Profile.TutorialComplete then
		return { Perks = perks, CreditBoost = 1, CodexMult = 1 }
	end
	return {
		Perks = perks,
		CreditBoost = PlayerDataService.CreditBoostProvider(),
		CodexMult = ContentIndex.CodexMultiplier(session.CodexCount),
	}
end

local function saveSession(session: Session, release: boolean?, waitForInFlight: boolean?): boolean
	if session.Stolen then
		return false
	end
	if not session.Persist then
		return true
	end
	if session.Saving then
		if not release and not waitForInFlight then
			session.SaveQueued = true
			return false
		end
		local waited = 0
		while session.Saving and waited < RELEASE_WAIT_SECONDS do
			task.wait(0.1)
			waited += 0.1
		end
	end
	session.Saving = true
	session.SaveQueued = false
	local snapshot = ProfileSchema.DeepCopy(session.Profile)
	snapshot.LastSeen = os.time()
	local saved = false
	for attempt = 1, SAVE_ATTEMPTS do
		local ok, stolen = writeRecord(PlayerDataService._store, session.UserId, snapshot, release == true)
		if ok then
			if stolen then
				session.Stolen = true
				warn(("[Voidline] session for %d is owned by another server; not saving here"):format(session.UserId))
			end
			saved = not stolen
			break
		end
		if attempt < SAVE_ATTEMPTS then
			task.wait(2 ^ (attempt - 1))
		end
	end
	session.Saving = false
	if session.SaveQueued and not release and not session.Stolen then
		task.spawn(saveSession, session)
	end
	return saved
end

-- Saves the profile. `release` drops the session lock (leave/shutdown).
function PlayerDataService.Save(player: Player, release: boolean?): boolean
	local session = PlayerDataService._sessions[player.UserId]
	if not session then
		return false
	end
	return saveSession(session, release)
end

-- Saves and reports whether *this* state reached the DataStore, waiting
-- for an in-flight autosave first (purchases need a definite answer).
function PlayerDataService.SaveNow(player: Player): boolean
	local session = PlayerDataService._sessions[player.UserId]
	if not session then
		return false
	end
	return saveSession(session, false, true)
end

local function runCallbacks(list: { (Player, any) -> () }, player: Player, profile: any)
	for _, callback in list do
		local ok, err = xpcall(callback :: (Player, any) -> ...any, debug.traceback, player, profile)
		if not ok then
			warn("[Voidline] profile callback error: " .. tostring(err))
		end
	end
end

local loadInto: (Player) -> ()

function PlayerDataService.Load(player: Player)
	local userId = player.UserId
	if PlayerDataService._sessions[userId] or PlayerDataService._loading[userId] then
		return
	end
	PlayerDataService._loading[userId] = true
	local ok, err = xpcall(loadInto :: (Player) -> ...any, debug.traceback, player)
	PlayerDataService._loading[userId] = nil
	if not ok then
		warn("[Voidline] profile load crashed for " .. userId .. ": " .. tostring(err))
	end
end

function loadInto(player: Player)
	local userId = player.UserId
	local waited = 0
	while PlayerDataService._releasing[userId] and waited < RELEASE_WAIT_SECONDS do
		task.wait(0.25)
		waited += 0.25
	end

	local store = getStore()
	local data, persist = nil, false
	if store then
		local status = "error"
		for attempt = 1, LOAD_ATTEMPTS do
			local value
			status, value = acquire(store, userId, attempt == LOAD_ATTEMPTS)
			if status == "ok" then
				data, persist = value, true
				break
			end
			if player.Parent == nil then
				return
			end
			task.wait(math.min(2 ^ (attempt - 1), 8))
		end
		if not persist then
			if RunService:IsStudio() then
				warn("[Voidline] profile load failed in Studio; using an unsaved profile")
			else
				player:Kick("Voidline could not load your save right now. Please rejoin in a minute.")
				return
			end
		end
	end

	if player.Parent == nil then
		-- Left while loading: hand the lock straight back.
		if persist then
			writeRecord(store, userId, data, true)
		end
		return
	end

	local profile = ProfileSchema.Migrate(data)
	local now = os.time()
	if profile.FirstJoin == 0 then
		profile.FirstJoin = now
	end
	local codexCount = 0
	for _ in profile.Codex do
		codexCount += 1
	end
	local session: Session = {
		Player = player,
		UserId = userId,
		Profile = profile,
		LastSent = clientCopy(profile),
		Dirty = false,
		Saving = false,
		SaveQueued = false,
		Persist = persist,
		Stolen = false,
		GamePasses = {},
		CodexCount = codexCount,
		JoinedAt = now,
	}
	PlayerDataService._sessions[userId] = session
	Remotes.Get("DataSnapshot"):FireClient(player, { Full = true, Data = session.LastSent })
	player:SetAttribute("ProfileLoaded", true)
	runCallbacks(PlayerDataService._onLoaded, player, profile)
end

-- Final save + lock release. Safe to call from both PlayerRemoving and
-- BindToClose: the second caller waits for the first to finish.
function PlayerDataService.Release(player: Player)
	local userId = player.UserId
	if PlayerDataService._releasing[userId] then
		local waited = 0
		while PlayerDataService._releasing[userId] and waited < RELEASE_WAIT_SECONDS do
			task.wait(0.1)
			waited += 0.1
		end
		return
	end
	local session = PlayerDataService._sessions[userId]
	if not session then
		return
	end
	PlayerDataService._releasing[userId] = true
	runCallbacks(PlayerDataService._onRelease, player, session.Profile)
	-- Drop the session first so no gameplay or receipt touches it mid-save.
	PlayerDataService._sessions[userId] = nil
	saveSession(session, true)
	PlayerDataService._releasing[userId] = nil
end

local function applySettings(profile: any, patch: { [string]: any })
	local settings = profile.Settings
	for _, key in { "PerfMode", "HideJetpack", "ClipMode", "ReducedMotion" } do
		if type(patch[key]) == "boolean" then
			settings[key] = patch[key]
		end
	end
	for _, key in { "MusicVolume", "SfxVolume" } do
		local value = patch[key]
		if ValidateRemote.IsFiniteNumber(value) then
			settings[key] = math.clamp(value, 0, 1)
		end
	end
	if type(patch.LaserColor) == "string" and DroneConfig.LaserColors[patch.LaserColor] then
		settings.LaserColor = patch.LaserColor
	end
end

function PlayerDataService.Init()
	ValidateRemote.ProfileGate = PlayerDataService.IsLoaded

	ValidateRemote.Bind("SettingsUpdate", { Rate = 0.2, Burst = 6, Args = { "table" } }, function(player, patch)
		local applied = PlayerDataService.Mutate(player, function(profile)
			applySettings(profile, patch)
		end)
		if applied then
			runCallbacks(PlayerDataService._onSettings, player, PlayerDataService.Get(player))
		end
	end)

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < FLUSH_INTERVAL then
			return
		end
		accumulator = 0
		for _, session in PlayerDataService._sessions do
			if session.Dirty then
				flush(session)
			end
		end
	end)

	task.spawn(function()
		while true do
			task.wait(GameConfig.AutosaveSeconds)
			local sessions = {}
			for _, session in PlayerDataService._sessions do
				table.insert(sessions, session)
			end
			-- Spread saves across the interval instead of bursting the budget.
			local gap = math.min(2, GameConfig.AutosaveSeconds / math.max(1, #sessions) * 0.5)
			for _, session in sessions do
				if session.Player.Parent and PlayerDataService._sessions[session.UserId] == session then
					local okBudget, budget = pcall(function()
						return DataStoreService:GetRequestBudgetForRequestType(Enum.DataStoreRequestType.UpdateAsync)
					end)
					if not okBudget or budget > 2 then
						task.spawn(saveSession, session)
					end
					task.wait(gap)
				end
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for _, player in Players:GetPlayers() do
			if PlayerDataService._sessions[player.UserId] then
				pending += 1
				task.spawn(function()
					PlayerDataService.Release(player)
					pending -= 1
				end)
			end
		end
		local waited = 0
		while (pending > 0 or next(PlayerDataService._releasing) ~= nil) and waited < 28 do
			waited += task.wait(0.1)
		end
	end)
end

-- Starts loading profiles. Boot calls this after every service has
-- registered its OnLoaded callbacks (in-memory loads finish instantly).
function PlayerDataService.Start()
	Players.PlayerAdded:Connect(PlayerDataService.Load)
	Players.PlayerRemoving:Connect(PlayerDataService.Release)
	for _, player in Players:GetPlayers() do
		task.spawn(PlayerDataService.Load, player)
	end
end

return PlayerDataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">PlotService</string>
            <string name="Source"><![CDATA[--!strict
-- Plot ownership. Every pilot gets the lowest free plot as soon as their
-- profile loads, spawns there, and keeps it until they leave. The Energy
-- Bridge to the hub is lit once onboarding is done (returning pilots join
-- with it already lit).
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local GameConfig = require(Voidline.Config.GameConfig)
local PlotLayout = require(Voidline.Modules.PlotLayout)

local PlayerDataService = require(script.Parent.PlayerDataService)

local PlotService = {
	Owners = {} :: { [number]: Player },
	ByUserId = {} :: { [number]: number },
}

local claimedCallbacks: { (Player, number) -> () } = {}
local releasedCallbacks: { (Player, number) -> () } = {}

-- Horizontal radius that counts as "on your plot" (drones mine the belt).
local ON_PLOT_RADIUS = 46

local function plotFolder(index: number): Instance?
	local map = Workspace:FindFirstChild("VoidlineMap")
	local plots = map and map:FindFirstChild("Plots")
	return plots and plots:FindFirstChild("Plot_" .. index)
end
PlotService.Folder = plotFolder

function PlotService.IndexOf(player: Player): number?
	return PlotService.ByUserId[player.UserId]
end

function PlotService.PlotOf(player: Player): Instance?
	local index = PlotService.ByUserId[player.UserId]
	return if index then plotFolder(index) else nil
end

function PlotService.OnClaimed(callback: (Player, number) -> ())
	table.insert(claimedCallbacks, callback)
end

function PlotService.OnReleased(callback: (Player, number) -> ())
	table.insert(releasedCallbacks, callback)
end

function PlotService.World(player: Player, localOffset: Vector3): Vector3?
	local index = PlotService.ByUserId[player.UserId]
	return if index then PlotLayout.World(index, localOffset) else nil
end

function PlotService.GrinderPosition(player: Player): Vector3?
	return PlotService.World(player, PlotLayout.Grinder)
end

function PlotService.SpawnCFrame(index: number): CFrame
	local plotCFrame = PlotLayout.PlotCFrame(index)
	local position = plotCFrame:PointToWorldSpace(PlotLayout.Spawn + Vector3.new(0, 3, 0))
	-- Face the hub so the bridge and Monolith are in view on spawn.
	return CFrame.lookAt(position, Vector3.new(0, position.Y, 0))
end

function PlotService.RootPart(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

function PlotService.IsOnPlot(player: Player): boolean
	local index = PlotService.ByUserId[player.UserId]
	local root = PlotService.RootPart(player)
	if not index or not root then
		return false
	end
	local center = PlotLayout.PlotCFrame(index).Position
	local offset = root.Position - center
	return Vector3.new(offset.X, 0, offset.Z).Magnitude <= ON_PLOT_RADIUS and math.abs(offset.Y) < 40
end

local function moveToPlot(player: Player)
	local index = PlotService.ByUserId[player.UserId]
	local character = player.Character
	if not index or not character then
		return
	end
	character:PivotTo(PlotService.SpawnCFrame(index))
end

local function setBridge(index: number, lit: boolean)
	local plot = plotFolder(index)
	if not plot then
		return
	end
	plot:SetAttribute("BridgeIgnited", lit)
	plot:SetAttribute("BridgeIgnitedAt", if lit then Workspace:GetServerTimeNow() else 0)
	local bridge = plot:FindFirstChild("EnergyBridge")
	if not bridge then
		return
	end
	for _, segment in bridge:GetChildren() do
		if segment:IsA("BasePart") then
			segment.CanCollide = lit
			segment.Transparency = if lit then 0.15 else 0.85
		end
	end
end

function PlotService.IgniteBridge(player: Player)
	local index = PlotService.ByUserId[player.UserId]
	if index then
		local plot = plotFolder(index)
		if plot and plot:GetAttribute("BridgeIgnited") ~= true then
			setBridge(index, true)
		end
	end
end

local function claim(player: Player, profile: any)
	if PlotService.ByUserId[player.UserId] or player.Parent ~= Players then
		return
	end
	local index: number? = nil
	for i = 1, GameConfig.PlotCount do
		if not PlotService.Owners[i] then
			index = i
			break
		end
	end
	if not index then
		warn("[Voidline] no free plot for " .. player.Name)
		return
	end
	PlotService.Owners[index] = player
	PlotService.ByUserId[player.UserId] = index
	player:SetAttribute("PlotIndex", index)
	local plot = plotFolder(index)
	if plot then
		plot:SetAttribute("OwnerUserId", player.UserId)
		plot:SetAttribute("OwnerName", player.DisplayName)
	end
	setBridge(index, profile.TutorialComplete == true)
	moveToPlot(player)
	for _, callback in claimedCallbacks do
		task.spawn(callback, player, index)
	end
end

local function release(player: Player)
	local index = PlotService.ByUserId[player.UserId]
	if not index then
		return
	end
	for _, callback in releasedCallbacks do
		local ok, err = pcall(callback :: (Player, number) -> ...any, player, index)
		if not ok then
			warn("[Voidline] plot release callback failed: " .. tostring(err))
		end
	end
	PlotService.Owners[index] = nil
	PlotService.ByUserId[player.UserId] = nil
	local plot = plotFolder(index)
	if plot then
		plot:SetAttribute("OwnerUserId", 0)
		plot:SetAttribute("OwnerName", "")
	end
	setBridge(index, false)
end

function PlotService.Init()
	PlayerDataService.OnLoaded(claim)
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			-- Wait a frame so the character is fully parented before moving it.
			task.defer(moveToPlot, player)
		end)
	end)
	for _, player in Players:GetPlayers() do
		player.CharacterAdded:Connect(function()
			task.defer(moveToPlot, player)
		end)
	end
	Players.PlayerRemoving:Connect(release)
end

return PlotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">RebirthService</string>
            <string name="Source"><![CDATA[--!strict
-- Void Rebirth: at Station Tier 10, reset credits/tiers/drill/cargo for a
-- permanent credit multiplier and a shard payout. Passes, tokens, relics,
-- Codex, cosmetics, drone slots/evolution and discovered sectors are kept.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local RebirthConfig = require(Voidline.Config.RebirthConfig)
local ProgressionRules = require(Voidline.Rules.ProgressionRules)

local ValidateRemote = require(script.Parent.Parent.Security.ValidateRemote)
local PlayerDataService = require(script.Parent.PlayerDataService)
local JuiceService = require(script.Parent.JuiceService)
local StatService = require(script.Parent.StatService)

local RebirthService = {}

local rebirthCallbacks: { (Player) -> () } = {}

function RebirthService.OnRebirth(callback: (Player) -> ())
	table.insert(rebirthCallbacks, callback)
end

function RebirthService.Rebirth(player: Player): boolean
	local profile = PlayerDataService.Get(player)
	if not profile or not ProgressionRules.CanRebirth(profile) then
		JuiceService.Send(player, "Rebirth", {
			Ok = false,
			Required = RebirthConfig.RequiredStationTier,
		})
		return false
	end
	local n, shards = 0, 0
	PlayerDataService.Mutate(player, function(p)
		n, shards = ProgressionRules.Rebirth(p)
	end)
	JuiceService.Send(player, "Rebirth", {
		Ok = true,
		Count = n,
		Shards = shards,
		Multiplier = RebirthConfig.CreditMultiplier(n),
	})
	StatService.Check(player, "Rebirths", "LifetimeShards")
	for _, callback in rebirthCallbacks do
		task.spawn(callback, player)
	end
	task.spawn(PlayerDataService.Save, player)
	return true
end

function RebirthService.Init()
	ValidateRemote.Bind("RequestRebirth", { Rate = 2, Burst = 1 }, function(player)
		RebirthService.Rebirth(player)
	end)
	local map = Workspace:FindFirstChild("VoidlineMap")
	local hub = map and map:FindFirstChild("Hub")
	local pad = hub and hub:FindFirstChild("RebirthPad")
	if pad then
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Rebirth"
		prompt.ObjectText = ("Void Rebirth · Station Tier %d"):format(RebirthConfig.RequiredStationTier)
		prompt.HoldDuration = 1.5
		prompt.MaxActivationDistance = 12
		prompt.RequiresLineOfSight = false
		prompt.Parent = pad
		prompt.Triggered:Connect(function(player)
			RebirthService.Rebirth(player)
		end)
	end
end

return RebirthService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">RelicService</string>
            <string name="Source"><![CDATA[--!strict
-- Relic finds, duplicates and the pedestal row on each pilot's station.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local PlotLayout = require(Voidline.Modules.PlotLayout)
local RelicRegistry = require(Voidline.Content.RelicRegistry)
local GameConfig = require(Voidline.Config.GameConfig)

local ValidateRemote = require(script.Parent.Parent.Security.ValidateRemote)
local PlayerDataService = require(script.Parent.PlayerDataService)
local PlotService = require(script.Parent.PlotService)
local JuiceService = require(script.Parent.JuiceService)
local StatService = require(script.Parent.StatService)
local CodexService = require(script.Parent.CodexService)

local RelicService = {}

local DUPLICATE_SHARDS = 2
local SHAPES: { [string]: Enum.PartType } = {
	Orb = Enum.PartType.Ball,
	Crown = Enum.PartType.Ball,
	Ring = Enum.PartType.Cylinder,
	Device = Enum.PartType.Cylinder,
	Shard = Enum.PartType.Wedge,
	Idol = Enum.PartType.Block,
	Tablet = Enum.PartType.Block,
}

local rng = Random.new()

local function ownedCount(value: any): number
	if type(value) == "number" then
		return value
	end
	return if value then 1 else 0
end

local function pedestalPart(folder: Instance, slot: number, plotCFrame: CFrame, name: string): Part
	local existing = folder:FindFirstChild(name .. slot)
	if existing and existing:IsA("Part") then
		return existing
	end
	local part = Instance.new("Part")
	part.Name = name .. slot
	part.Anchored = true
	part.CanTouch = false
	part.CastShadow = false
	if name == "Pedestal" then
		part.Size = Vector3.new(2.4, 3, 2.4)
		part.Material = Enum.Material.Marble
		part.Color = GameConfig.Colors.Obsidian
		part.CFrame = plotCFrame * CFrame.new(PlotLayout.Pedestal(slot) - Vector3.new(0, 0.5, 0))
	else
		part.Size = Vector3.new(1.4, 1.4, 1.4)
		part.Material = Enum.Material.Neon
		part.CanCollide = false
		part.CFrame = plotCFrame * CFrame.new(PlotLayout.Pedestal(slot) + Vector3.new(0, 2, 0))
	end
	part.Parent = folder
	return part
end

-- Rebuilds the pedestal row for the pilot's current display list.
function RelicService.RefreshPedestals(player: Player)
	local index = PlotService.IndexOf(player)
	local profile = PlayerDataService.Get(player)
	local plot = index and PlotService.Folder(index)
	local folder = plot and plot:FindFirstChild("Pedestals")
	if not index or not profile or not folder then
		return
	end
	local plotCFrame = PlotLayout.PlotCFrame(index)
	for slot = 1, PlotLayout.PedestalCount do
		local relicId = profile.RelicDisplay[slot]
		local relic = if type(relicId) == "string" then RelicRegistry.ById[relicId] else nil
		local gemName = "Gem" .. slot
		if relic then
			pedestalPart(folder, slot, plotCFrame, "Pedestal")
			local gem = pedestalPart(folder, slot, plotCFrame, "Gem")
			gem.Shape = SHAPES[relic.Shape] or Enum.PartType.Ball
			gem.Color = relic.Color
			gem:SetAttribute("RelicId", relic.Id)
		else
			local pedestal = folder:FindFirstChild("Pedestal" .. slot)
			local gem = folder:FindFirstChild(gemName)
			if pedestal then
				pedestal:Destroy()
			end
			if gem then
				gem:Destroy()
			end
		end
	end
end

local function clearPedestals(_player: Player, index: number)
	local plot = PlotService.Folder(index)
	local folder = plot and plot:FindFirstChild("Pedestals")
	if folder then
		folder:ClearAllChildren()
	end
end

-- Grants a relic (rolled unless `relicId` is given). Returns the relic.
function RelicService.Grant(player: Player, source: string, relicId: string?): RelicRegistry.Relic?
	local relic: RelicRegistry.Relic = if relicId and RelicRegistry.ById[relicId]
		then RelicRegistry.ById[relicId]
		else RelicRegistry.Roll(rng)
	local isNew = false
	local applied = PlayerDataService.Mutate(player, function(p)
		local count = ownedCount(p.Relics[relic.Id])
		isNew = count == 0
		p.Relics[relic.Id] = count + 1
		if isNew and #p.RelicDisplay < PlotLayout.PedestalCount then
			table.insert(p.RelicDisplay, relic.Id)
		end
		if not isNew then
			p.VoidShards += DUPLICATE_SHARDS
			p.LifetimeShards += DUPLICATE_SHARDS
		end
	end)
	if not applied then
		return nil
	end
	JuiceService.Send(player, "Relic", {
		Id = relic.Id,
		New = isNew,
		Source = source,
		DuplicateShards = if isNew then 0 else DUPLICATE_SHARDS,
	})
	if isNew then
		CodexService.Discover(player, relic.Id, true)
		StatService.Check(player, "RelicCount", "RelicSet:" .. relic.Set)
		RelicService.RefreshPedestals(player)
	else
		StatService.Check(player, "LifetimeShards")
	end
	return relic
end

-- Rolls a find with the given probability. Returns the relic or nil.
function RelicService.TryFind(player: Player, chance: number, source: string): RelicRegistry.Relic?
	if chance > 0 and rng:NextNumber() < chance then
		return RelicService.Grant(player, source)
	end
	return nil
end

function RelicService.Init()
	PlotService.OnClaimed(function(player)
		RelicService.RefreshPedestals(player)
	end)
	PlotService.OnReleased(clearPedestals)

	ValidateRemote.Bind("SetRelicDisplay", { Rate = 0.5, Burst = 3, Args = { "table" } }, function(player, list)
		local profile = PlayerDataService.Get(player)
		if not profile or #list > PlotLayout.PedestalCount then
			return
		end
		local clean: { string } = {}
		local seen: { [string]: boolean } = {}
		for i = 1, #list do
			local id = list[i]
			if type(id) ~= "string" or seen[id] or ownedCount(profile.Relics[id]) == 0 then
				return
			end
			seen[id] = true
			table.insert(clean, id)
		end
		PlayerDataService.Mutate(player, function(p)
			p.RelicDisplay = clean
		end)
		RelicService.RefreshPedestals(player)
	end)
end

return RelicService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">RiftService</string>
            <string name="Source"><![CDATA[--!strict
-- Void Rift parkour: while the Rift event is open the shard spiral around
-- the Monolith turns solid and a cache waits on top. Each pilot can claim it
-- once per opening; falling off just drops you back onto the hub.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local HubLayout = require(Voidline.Modules.HubLayout)

local ValidateRemote = require(script.Parent.Parent.Security.ValidateRemote)
local PlayerDataService = require(script.Parent.PlayerDataService)
local EconomyService = require(script.Parent.EconomyService)
local StatService = require(script.Parent.StatService)
local JuiceService = require(script.Parent.JuiceService)

local RiftService = {}

local CLAIM_RANGE = 12
local REWARD_SHARDS = 6
local REWARD_CREDITS_PER_TIER = 120

local claimed: { [number]: boolean } = {}
local open = false

local function riftFolder(): Instance?
	local map = Workspace:FindFirstChild("VoidlineMap")
	local hub = map and map:FindFirstChild("Hub")
	return hub and hub:FindFirstChild("VoidRift")
end

local function setSolid(solid: boolean)
	local folder = riftFolder()
	if not folder then
		return
	end
	for _, part in folder:GetChildren() do
		if part:IsA("BasePart") then
			part.CanCollide = solid
			part.Transparency = if solid then 0.2 else 0.85
		end
	end
end

function RiftService.IsOpen(): boolean
	return open
end

function RiftService.Open()
	open = true
	table.clear(claimed)
	setSolid(true)
	Workspace:SetAttribute("RiftOpen", true)
end

function RiftService.Close()
	open = false
	setSolid(false)
	Workspace:SetAttribute("RiftOpen", false)
end

function RiftService.Claim(player: Player): boolean
	if not open or claimed[player.UserId] then
		return false
	end
	if not ValidateRemote.NearPosition(player, HubLayout.RiftCache, CLAIM_RANGE) then
		return false
	end
	local profile = PlayerDataService.Get(player)
	if not profile then
		return false
	end
	claimed[player.UserId] = true
	EconomyService.AddCredits(player, REWARD_CREDITS_PER_TIER * profile.StationTier, "rift")
	EconomyService.AddShards(player, REWARD_SHARDS, "rift")
	StatService.Bump(player, "RiftClears", 1)
	JuiceService.Send(player, "RiftCleared", {})
	return true
end

function RiftService.Init()
	local folder = riftFolder()
	local cache = folder and folder:FindFirstChild("RiftCache")
	if cache then
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Claim"
		prompt.ObjectText = "Rift Cache"
		prompt.HoldDuration = 0.4
		prompt.MaxActivationDistance = 10
		prompt.RequiresLineOfSight = false
		prompt.Parent = cache
		prompt.Triggered:Connect(function(player)
			RiftService.Claim(player)
		end)
	end
	RiftService.Close()
end

return RiftService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">RockService</string>
            <string name="Source"><![CDATA[--!strict
-- Every mineable target: personal belt rocks, shared deep-space rocks, boss
-- meteors and event cores. Rocks are anchored server parts (never
-- client-owned physics). Health and contributions live here; DroneService
-- deals damage, the owning service decides what a break pays.
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local OreRegistry = require(Voidline.Content.OreRegistry)

local RockService = {}

export type Rock = {
	Id: number,
	Kind: string, -- "Belt" | "Shared" | "Meteor" | "Core"
	Part: BasePart,
	Position: Vector3,
	Health: number,
	MaxHealth: number,
	OreId: string,
	Ore: number,
	Shards: number,
	OwnerUserId: number, -- 0 = anyone may mine it
	Reach: number,
	Priority: number,
	Damage: { [number]: number },
	Alive: boolean,
	SentHealth: number,
	OnBreak: ((Rock, Player?) -> ())?,
	Data: { [string]: any },
}

export type Spec = {
	Kind: string,
	Position: Vector3,
	Size: number,
	OreId: string,
	Health: number,
	Ore: number?,
	Shards: number?,
	OwnerUserId: number?,
	Reach: number?,
	Priority: number?,
	OnBreak: ((Rock, Player?) -> ())?,
	Data: { [string]: any }?,
	Name: string?,
}

local TAG = "VoidRock"
local HIDDEN_CFRAME = CFrame.new(0, 4000, 0)

local rocks: { [number]: Rock } = {}
local nextId = 0
local pool: { BasePart } = {}
local folder: Folder? = nil

local function getFolder(): Folder
	if folder and folder.Parent then
		return folder
	end
	local f = Instance.new("Folder")
	f.Name = "Rocks"
	f.Parent = Workspace
	folder = f
	return f
end

local function acquirePart(): BasePart
	local part = table.remove(pool)
	if part and part.Parent then
		return part
	end
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanTouch = false
	p.CastShadow = false
	p.Shape = Enum.PartType.Ball
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CFrame = HIDDEN_CFRAME
	p.Parent = getFolder()
	CollectionService:AddTag(p, TAG)
	return p
end

function RockService.ReleasePart(part: BasePart)
	for _, name in { "RockId", "Kind", "OreId", "Health", "MaxHealth", "Owner", "Hidden" } do
		part:SetAttribute(name, nil)
	end
	for _, name in { "TowStart", "TowDuration", "TowFrom", "TowTo", "TowOwner" } do
		part:SetAttribute(name, nil)
	end
	part:SetAttribute("Hidden", true)
	part.Transparency = 1
	part.CanCollide = false
	part.CanQuery = false
	part.CFrame = HIDDEN_CFRAME
	table.insert(pool, part)
end

-- Paints a part as an ore variant (also used for towed chunks).
function RockService.Paint(part: BasePart, oreId: string, size: number)
	local ore = OreRegistry.ById[oreId] or OreRegistry.ById[OreRegistry.TutorialOreId]
	part.Size = Vector3.new(size, size, size)
	part.Color = ore.Color
	part.Material = ore.Material
	part.Transparency = 0
	part.CanQuery = true
	part:SetAttribute("OreId", ore.Id)
	part:SetAttribute("Hidden", nil)
end

function RockService.Create(spec: Spec): Rock
	nextId += 1
	local part = acquirePart()
	RockService.Paint(part, spec.OreId, spec.Size)
	part.Name = spec.Name or (spec.Kind .. "Rock")
	part.CanCollide = spec.Kind ~= "Belt"
	part.CFrame = CFrame.new(spec.Position) * CFrame.Angles(math.rad(nextId * 37 % 360), math.rad(nextId * 53 % 360), 0)
	part:SetAttribute("RockId", nextId)
	part:SetAttribute("Kind", spec.Kind)
	part:SetAttribute("Health", spec.Health)
	part:SetAttribute("MaxHealth", spec.Health)
	part:SetAttribute("Owner", spec.OwnerUserId or 0)
	local rock: Rock = {
		Id = nextId,
		Kind = spec.Kind,
		Part = part,
		Position = spec.Position,
		Health = spec.Health,
		MaxHealth = spec.Health,
		OreId = spec.OreId,
		Ore = spec.Ore or 0,
		Shards = spec.Shards or 0,
		OwnerUserId = spec.OwnerUserId or 0,
		Reach = spec.Reach or 42,
		Priority = spec.Priority or 0,
		Damage = {},
		Alive = true,
		SentHealth = spec.Health,
		OnBreak = spec.OnBreak,
		Data = spec.Data or {},
	}
	rocks[rock.Id] = rock
	return rock
end

function RockService.Get(id: number): Rock?
	return rocks[id]
end

function RockService.All(): { [number]: Rock }
	return rocks
end

-- Removes a rock without breaking it (despawn, plot released, event ended).
-- `keepPart` hands the part to the caller (e.g. to tow it home first).
function RockService.Remove(rock: Rock, keepPart: boolean?)
	if rocks[rock.Id] == rock then
		rocks[rock.Id] = nil
	end
	rock.Alive = false
	if not keepPart then
		RockService.ReleasePart(rock.Part)
	end
end

-- Applies server-computed damage. Returns true if this hit broke the rock.
function RockService.Damage(rock: Rock, player: Player?, amount: number): boolean
	if not rock.Alive or amount ~= amount or amount <= 0 then
		return false
	end
	local dealt = math.min(amount, rock.Health)
	rock.Health -= dealt
	if player then
		rock.Damage[player.UserId] = (rock.Damage[player.UserId] or 0) + dealt
	end
	if rock.Health <= 1e-6 then
		rock.Health = 0
		rock.Alive = false
		rocks[rock.Id] = nil
		rock.Part:SetAttribute("Health", 0)
		rock.Part.CanQuery = false
		if rock.OnBreak then
			rock.OnBreak(rock, player)
		else
			RockService.ReleasePart(rock.Part)
		end
		return true
	end
	return false
end

-- Pushes changed health to the part attribute (called at the sim rate, not
-- per hit, to keep replication small).
function RockService.FlushHealth()
	for _, rock in rocks do
		if rock.Alive and rock.SentHealth ~= rock.Health then
			rock.SentHealth = rock.Health
			rock.Part:SetAttribute("Health", math.ceil(rock.Health))
		end
	end
end

-- Rocks `player` may target from `position`, nearest first.
function RockService.Candidates(position: Vector3, userId: number, onOwnPlot: boolean): { Rock }
	local out = {}
	local distances: { [Rock]: number } = {}
	for _, rock in rocks do
		if not rock.Alive then
			continue
		end
		if rock.Kind == "Belt" then
			if rock.OwnerUserId == userId and onOwnPlot then
				table.insert(out, rock)
				distances[rock] = (rock.Position - position).Magnitude
			end
		elseif rock.OwnerUserId == 0 or rock.OwnerUserId == userId then
			local distance = (rock.Position - position).Magnitude
			if distance <= rock.Reach then
				table.insert(out, rock)
				distances[rock] = distance
			end
		end
	end
	table.sort(out, function(a, b)
		if a.Priority ~= b.Priority then
			return a.Priority > b.Priority
		end
		local da, db = distances[a], distances[b]
		if da ~= db then
			return da < db
		end
		return a.Id < b.Id
	end)
	return out
end

-- Fraction of a contest each user dealt, sorted high to low (for HUD bars).
function RockService.TopContributors(rock: Rock, limit: number): { { UserId: number, Share: number } }
	local total = 0
	for _, dealt in rock.Damage do
		total += dealt
	end
	local list = {}
	if total <= 0 then
		return list
	end
	for userId, dealt in rock.Damage do
		table.insert(list, { UserId = userId, Share = dealt / total })
	end
	table.sort(list, function(a, b)
		if a.Share ~= b.Share then
			return a.Share > b.Share
		end
		return a.UserId < b.UserId
	end)
	while #list > limit do
		table.remove(list)
	end
	return list
end

-- Damages every live rock inside a sphere (hazard strikes). Unattributed.
function RockService.DamageInRadius(center: Vector3, radius: number, fraction: number)
	local hits = {}
	for _, rock in rocks do
		if rock.Alive and (rock.Position - center).Magnitude <= radius then
			table.insert(hits, rock)
		end
	end
	for _, rock in hits do
		-- Strikes never finish a rock off; someone still has to mine it.
		local amount = math.min(rock.MaxHealth * fraction, rock.Health - 1)
		if amount > 0 then
			RockService.Damage(rock, nil, amount)
		end
	end
end

function RockService.Init()
	getFolder()
end

return RockService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">SoftContestService</string>
            <string name="Source"><![CDATA[--!strict
-- Soft contests: shared deep-space rocks, boss meteors and event cores.
-- Anyone in range can mine them; nobody can "steal" them. On break (or when
-- an event ends) the ore and shard pools are split by damage dealt:
-- qualify at >= 5%, 40% bonus to the top contributor + 60% proportional.
-- Every qualifier's share is towed home as a chunk to their Grinder Core.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local GameConfig = require(Voidline.Config.GameConfig)
local EconomyConfig = require(Voidline.Config.EconomyConfig)
local HubLayout = require(Voidline.Modules.HubLayout)
local ContributionSplit = require(Voidline.Modules.ContributionSplit)
local MiningRules = require(Voidline.Rules.MiningRules)
local OreRegistry = require(Voidline.Content.OreRegistry)
local Remotes = require(Voidline.Remotes)

local PlayerDataService = require(script.Parent.PlayerDataService)
local PlotService = require(script.Parent.PlotService)
local RockService = require(script.Parent.RockService)
local TowService = require(script.Parent.TowService)
local EconomyService = require(script.Parent.EconomyService)
local StatService = require(script.Parent.StatService)
local RelicService = require(script.Parent.RelicService)
local JuiceService = require(script.Parent.JuiceService)
local WorldState = require(script.Parent.WorldState)

local SoftContestService = {}

export type ContestSpec = {
	Kind: string, -- "Shared" | "Meteor" | "Core"
	Position: Vector3,
	Size: number,
	Health: number,
	OrePool: number,
	ShardPool: number,
	OreId: string?,
	Bias: { [number]: number }?,
	RelicChance: number?,
	Reach: number?,
	Priority: number?,
	Label: string?,
	Stat: string?, -- extra stat bumped for qualifiers (e.g. "StarfallsJoined")
	OnResolved: ((RockService.Rock) -> ())?,
}

local UPDATE_INTERVAL = 0.5
local DEEP_SPACE_SECTOR = 3

local rng = Random.new()
local contests: { [number]: { Rock: RockService.Rock, Spec: ContestSpec, LastSent: number } } = {}
local sharedSlots: { [number]: RockService.Rock | false } = {}

local function rollOre(bias: { [number]: number }?): string
	local ore = OreRegistry.Roll(rng, DEEP_SPACE_SECTOR, 1, bias)
	return ore.Id
end

-- Splits a contest and tows each qualifier's share home. `fraction` scales
-- the pools (1 = destroyed; less when an event ended before the break).
function SoftContestService.Resolve(rock: RockService.Rock, spec: ContestSpec, fraction: number)
	local shares = ContributionSplit.Compute(rock.Damage)
	local orePayouts = ContributionSplit.Allocate(shares, spec.OrePool * fraction)
	local shardPayouts = ContributionSplit.Allocate(shares, spec.ShardPool * fraction)
	local topId = ContributionSplit.TopContributor(shares)
	for userId, share in shares do
		local player = Players:GetPlayerByUserId(userId)
		if not player or not PlayerDataService.IsLoaded(player) then
			continue
		end
		local profile = PlayerDataService.Get(player) :: any
		local surge = WorldState.ZoneMult("OreSurge", rock.Position, 1.5)
		local ore = MiningRules.OrePerRock(profile, (orePayouts[userId] or 0) * surge)
		local shards = shardPayouts[userId] or 0
		local isTop = userId == topId
		local luck = WorldState.Luck(player, rock.Position)
		local baseChance = spec.RelicChance or 0
		local guaranteed = isTop and baseChance >= 1
		local relicChance = if isTop
			then baseChance * luck * WorldState.RelicMult()
			else math.min(0.25, baseChance * 0.1 * luck)
		local function payout()
			if ore > 0 then
				EconomyService.GrantOre(player, rock.OreId, ore, { Overflow = "refine", Source = spec.Kind })
			end
			if shards > 0 then
				EconomyService.AddShards(player, shards, spec.Kind)
			end
			if guaranteed then
				RelicService.Grant(player, spec.Kind)
			else
				RelicService.TryFind(player, relicChance, spec.Kind)
			end
		end
		JuiceService.Send(player, "ContestShare", {
			Kind = spec.Kind,
			Label = spec.Label,
			Share = share,
			Ore = ore,
			Shards = shards,
			Top = isTop,
		})
		if spec.Kind ~= "Shared" then
			StatService.Bump(player, "MeteorsContested", 1)
			if isTop then
				StatService.Bump(player, "MeteorTops", 1)
			end
		end
		if spec.Stat then
			StatService.Bump(player, spec.Stat, 1)
		end
		local grinder = PlotService.GrinderPosition(player)
		if grinder then
			local perks = PlayerDataService.Perks(player)
			local duration = MiningRules.TowSeconds(profile, perks, (grinder - rock.Position).Magnitude)
			TowService.StartChunk(player, rock.OreId, rock.Position, grinder, duration, payout)
		else
			payout()
		end
	end
	if spec.OnResolved then
		spec.OnResolved(rock)
	end
end

local function sendUpdate(entry: { Rock: RockService.Rock, Spec: ContestSpec, LastSent: number }, final: boolean)
	local rock = entry.Rock
	local top = {}
	for _, row in RockService.TopContributors(rock, 3) do
		local player = Players:GetPlayerByUserId(row.UserId)
		table.insert(top, { Name = if player then player.DisplayName else "Pilot", Share = row.Share })
	end
	Remotes.GetUnreliable("SoftContestUpdate"):FireAllClients({
		Id = rock.Id,
		Label = entry.Spec.Label or entry.Spec.Kind,
		Health = math.ceil(rock.Health),
		Max = rock.MaxHealth,
		Top = top,
		Done = final,
	})
end

function SoftContestService.Spawn(spec: ContestSpec): RockService.Rock
	local entry: { Rock: RockService.Rock, Spec: ContestSpec, LastSent: number }
	local rock = RockService.Create({
		Kind = spec.Kind,
		Position = spec.Position,
		Size = spec.Size,
		OreId = spec.OreId or rollOre(spec.Bias or (if WorldState.Biome then WorldState.Biome.TierBias else nil)),
		Health = spec.Health,
		Reach = spec.Reach or 42,
		Priority = spec.Priority or 2,
		Name = spec.Kind,
		OnBreak = function(broken, _killer)
			contests[broken.Id] = nil
			sendUpdate(entry, true)
			RockService.ReleasePart(broken.Part)
			SoftContestService.Resolve(broken, spec, 1)
		end,
	})
	entry = { Rock = rock, Spec = spec, LastSent = 0 }
	contests[rock.Id] = entry
	return rock
end

-- Ends a contest early (event over): pays out the share of health removed.
function SoftContestService.Expire(rock: RockService.Rock)
	local entry = contests[rock.Id]
	if not entry or not rock.Alive then
		return
	end
	contests[rock.Id] = nil
	local fraction = 1 - rock.Health / rock.MaxHealth
	sendUpdate(entry, true)
	RockService.Remove(rock)
	if fraction > 0 then
		SoftContestService.Resolve(rock, entry.Spec, fraction)
	elseif entry.Spec.OnResolved then
		entry.Spec.OnResolved(rock)
	end
end

local function spawnShared(slot: number)
	local pool = EconomyConfig.SharedAsteroid
	local rock = SoftContestService.Spawn({
		Kind = "Shared",
		Position = HubLayout.SharedRockSlot(slot, GameConfig.SharedAsteroidCount),
		Size = 9,
		Health = pool.Health,
		OrePool = pool.OrePool,
		ShardPool = pool.ShardPool,
		RelicChance = 0.02,
		Reach = 48,
		Priority = 2,
		Label = "Deep-Space Rock",
		OnResolved = function()
			sharedSlots[slot] = false
			task.delay(GameConfig.SharedRespawnSeconds, function()
				if sharedSlots[slot] == false then
					spawnShared(slot)
				end
			end)
		end,
	})
	sharedSlots[slot] = rock
end

function SoftContestService.Init()
	for slot = 1, GameConfig.SharedAsteroidCount do
		spawnShared(slot)
	end
	task.spawn(function()
		while true do
			task.wait(UPDATE_INTERVAL)
			for _, entry in contests do
				if entry.Rock.Alive and entry.Rock.Health ~= entry.LastSent and next(entry.Rock.Damage) then
					entry.LastSent = entry.Rock.Health
					sendUpdate(entry, false)
				end
			end
		end
	end)
end

return SoftContestService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">SquadService</string>
            <string name="Source"><![CDATA[--!strict
-- Squads of 2-4 pilots: invites by UserId (validated server-side), a shared
-- Squad Challenge, +10% shard luck while a squadmate flies nearby, and the
-- Beam-Link damage bonus for linked squadmates.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local SquadConfig = require(Voidline.Config.SquadConfig)
local Remotes = require(Voidline.Remotes)

local ValidateRemote = require(script.Parent.Parent.Security.ValidateRemote)
local PlayerDataService = require(script.Parent.PlayerDataService)
local JuiceService = require(script.Parent.JuiceService)
local StatService = require(script.Parent.StatService)
local EconomyService = require(script.Parent.EconomyService)
local WorldState = require(script.Parent.WorldState)
local DroneService = require(script.Parent.DroneService)

local SquadService = {}

local INVITE_SECONDS = 30
local LINK_RANGE = 60
local CHALLENGE_SECONDS = 600
local CHALLENGE_ROCKS_PER_MEMBER = 40
local CHALLENGE_COOLDOWN = 120

type Challenge = { Goal: number, Progress: number, EndsAt: number }
type Squad = { Id: number, Leader: number, Members: { number }, Challenge: Challenge?, NextChallengeAt: number }
type Invite = { From: number, Expires: number }

SquadService._squads = {} :: { [number]: Squad }
SquadService._byPlayer = {} :: { [number]: number }
SquadService._invites = {} :: { [number]: { Invite } }
local nextId = 0

local function squadOf(player: Player): Squad?
	local id = SquadService._byPlayer[player.UserId]
	return if id then SquadService._squads[id] else nil
end
SquadService.SquadOf = squadOf

local function memberPlayers(squad: Squad): { Player }
	local list = {}
	for _, userId in squad.Members do
		local p = Players:GetPlayerByUserId(userId)
		if p then
			table.insert(list, p)
		end
	end
	return list
end

local function broadcast(squad: Squad)
	local members = {}
	for _, p in memberPlayers(squad) do
		table.insert(members, { UserId = p.UserId, Name = p.DisplayName, Leader = p.UserId == squad.Leader })
	end
	local challenge = squad.Challenge
	for _, p in memberPlayers(squad) do
		Remotes.Get("SquadUpdate"):FireClient(p, {
			SquadId = squad.Id,
			Members = members,
			LuckBonus = SquadConfig.LinkedShardLuckBonus,
			Challenge = if challenge
				then { Goal = challenge.Goal, Progress = challenge.Progress, EndsAt = challenge.EndsAt }
				else nil,
		})
	end
end

local function clearClient(player: Player)
	Remotes.Get("SquadUpdate"):FireClient(player, { SquadId = nil, Members = {} })
end

local function startChallenge(squad: Squad, now: number)
	if #squad.Members < SquadConfig.MinSize or squad.Challenge or now < squad.NextChallengeAt then
		return
	end
	local goal = CHALLENGE_ROCKS_PER_MEMBER * #squad.Members
	squad.Challenge = { Goal = goal, Progress = 0, EndsAt = now + CHALLENGE_SECONDS }
	for _, p in memberPlayers(squad) do
		JuiceService.Banner(p, ("SQUAD CHALLENGE · mine %d rocks together"):format(goal), "gold")
	end
	broadcast(squad)
end

local function removeMember(squad: Squad, userId: number)
	local index = table.find(squad.Members, userId)
	if index then
		table.remove(squad.Members, index)
	end
	SquadService._byPlayer[userId] = nil
	if #squad.Members < SquadConfig.MinSize then
		for _, other in squad.Members do
			SquadService._byPlayer[other] = nil
			local p = Players:GetPlayerByUserId(other)
			if p then
				clearClient(p)
				JuiceService.Banner(p, "Squad disbanded", "info")
			end
		end
		SquadService._squads[squad.Id] = nil
		return
	end
	if squad.Leader == userId then
		squad.Leader = squad.Members[1]
	end
	broadcast(squad)
end

function SquadService.Invite(player: Player, targetUserId: number): (boolean, string?)
	local target = Players:GetPlayerByUserId(targetUserId)
	if not target or target == player then
		return false, "target"
	end
	if SquadService._byPlayer[target.UserId] then
		return false, "busy"
	end
	local squad = squadOf(player)
	if squad and #squad.Members >= SquadConfig.MaxSize then
		return false, "full"
	end
	if squad and squad.Leader ~= player.UserId then
		return false, "leader"
	end
	local now = os.clock()
	local pending = SquadService._invites[target.UserId] or {}
	for i = #pending, 1, -1 do
		if pending[i].Expires < now or pending[i].From == player.UserId then
			table.remove(pending, i)
		end
	end
	if #pending >= 3 then
		return false, "busy"
	end
	table.insert(pending, { From = player.UserId, Expires = now + INVITE_SECONDS })
	SquadService._invites[target.UserId] = pending
	JuiceService.Send(
		target,
		"SquadInvite",
		{ FromUserId = player.UserId, FromName = player.DisplayName, Seconds = INVITE_SECONDS }
	)
	JuiceService.Banner(player, ("Invite sent to %s"):format(target.DisplayName), "info")
	return true, nil
end

function SquadService.Respond(player: Player, fromUserId: number, accept: boolean): boolean
	local pending = SquadService._invites[player.UserId]
	if not pending then
		return false
	end
	local now = os.clock()
	local invite: Invite? = nil
	for i = #pending, 1, -1 do
		if pending[i].From == fromUserId then
			invite = table.remove(pending, i)
		elseif pending[i].Expires < now then
			table.remove(pending, i)
		end
	end
	if not invite or invite.Expires < now or not accept then
		return false
	end
	local inviter = Players:GetPlayerByUserId(fromUserId)
	if not inviter or SquadService._byPlayer[player.UserId] then
		return false
	end
	local squad = squadOf(inviter)
	if not squad then
		nextId += 1
		local created: Squad =
			{ Id = nextId, Leader = inviter.UserId, Members = { inviter.UserId }, Challenge = nil, NextChallengeAt = 0 }
		SquadService._squads[nextId] = created
		SquadService._byPlayer[inviter.UserId] = nextId
		squad = created
	end
	local current = squad :: Squad
	if #current.Members >= SquadConfig.MaxSize then
		JuiceService.Banner(player, "That squad is full", "warn")
		return false
	end
	table.insert(current.Members, player.UserId)
	SquadService._byPlayer[player.UserId] = current.Id
	SquadService._invites[player.UserId] = nil
	for _, p in memberPlayers(current) do
		JuiceService.Banner(p, ("%s joined the squad"):format(player.DisplayName), "good")
	end
	broadcast(current)
	startChallenge(current, now)
	return true
end

function SquadService.Leave(player: Player)
	local squad = squadOf(player)
	if squad then
		removeMember(squad, player.UserId)
		clearClient(player)
	end
end

function SquadService.Kick(player: Player, targetUserId: number)
	local squad = squadOf(player)
	if not squad or squad.Leader ~= player.UserId or targetUserId == player.UserId then
		return
	end
	if not table.find(squad.Members, targetUserId) then
		return
	end
	removeMember(squad, targetUserId)
	local target = Players:GetPlayerByUserId(targetUserId)
	if target then
		clearClient(target)
		JuiceService.Banner(target, "You left the squad", "info")
	end
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

-- Squadmates within `range` of `player` (server positions), optionally only
-- those flying Beam-Link.
function SquadService.NearbyMates(player: Player, range: number, beamLinkOnly: boolean?): number
	local squad = squadOf(player)
	local root = rootOf(player)
	if not squad or not root then
		return 0
	end
	local count = 0
	for _, mate in memberPlayers(squad) do
		if mate ~= player then
			local mateRoot = rootOf(mate)
			local profile = PlayerDataService.Get(mate)
			if mateRoot and profile and (mateRoot.Position - root.Position).Magnitude <= range then
				if not beamLinkOnly or profile.Formation == 2 then
					count += 1
				end
			end
		end
	end
	return count
end

local function onStat(player: Player, stat: string, amount: number)
	if stat ~= "RocksMined" then
		return
	end
	local squad = squadOf(player)
	local challenge = squad and squad.Challenge
	if not squad or not challenge then
		return
	end
	challenge.Progress += amount
	if challenge.Progress >= challenge.Goal then
		squad.Challenge = nil
		squad.NextChallengeAt = os.clock() + CHALLENGE_COOLDOWN
		for _, p in memberPlayers(squad) do
			local profile = PlayerDataService.Get(p)
			local reward = 150 * math.max(1, if profile then profile.StationTier else 1)
			EconomyService.AddCredits(p, reward, "SquadChallenge")
			EconomyService.AddShards(p, 5, "SquadChallenge")
			StatService.Bump(p, "SquadChallenges", 1)
			JuiceService.Send(p, "SquadChallenge", { Credits = reward, Shards = 5 })
		end
	end
	broadcast(squad)
end

function SquadService.TickMinute(now: number)
	for _, squad in SquadService._squads do
		local challenge = squad.Challenge
		if challenge and now >= challenge.EndsAt then
			squad.Challenge = nil
			squad.NextChallengeAt = now + CHALLENGE_COOLDOWN
			for _, p in memberPlayers(squad) do
				JuiceService.Banner(p, "Squad challenge expired · a new one starts soon", "info")
			end
			broadcast(squad)
		end
		startChallenge(squad, now)
		if #squad.Members >= SquadConfig.MinSize then
			for _, p in memberPlayers(squad) do
				StatService.Bump(p, "SquadMinutes", 1)
			end
		end
	end
end

function SquadService.Init()
	WorldState.SquadLinked = function(player: Player): boolean
		return SquadService.NearbyMates(player, LINK_RANGE) > 0
	end
	DroneService.LinkedSquadmates = function(player: Player, range: number): number
		return SquadService.NearbyMates(player, range, true)
	end
	StatService.Listen(onStat)

	ValidateRemote.Bind("SquadInvite", { Rate = 2, Burst = 3, Args = { "integer" } }, function(player, targetUserId)
		local ok, reason = SquadService.Invite(player, targetUserId)
		if not ok then
			JuiceService.Send(player, "SquadError", { Reason = reason })
		end
	end)
	ValidateRemote.Bind(
		"SquadRespond",
		{ Rate = 0.5, Burst = 3, Args = { "integer", "boolean" } },
		function(player, fromUserId, accept)
			SquadService.Respond(player, fromUserId, accept)
		end
	)
	ValidateRemote.Bind("SquadLeave", { Rate = 1, Burst = 2 }, function(player)
		SquadService.Leave(player)
	end)
	ValidateRemote.Bind("SquadKick", { Rate = 1, Burst = 2, Args = { "integer" } }, function(player, targetUserId)
		SquadService.Kick(player, targetUserId)
	end)

	Players.PlayerRemoving:Connect(function(player)
		local squad = squadOf(player)
		if squad then
			removeMember(squad, player.UserId)
		end
		SquadService._invites[player.UserId] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(60)
			SquadService.TickMinute(os.clock())
		end
	end)
end

return SquadService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">StatService</string>
            <string name="Source"><![CDATA[--!strict
-- Single entry point for "something happened" counters: bumps the stat,
-- advances daily/weekly quests and grants achievements, then tells the pilot.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local ProfileSchema = require(Voidline.Modules.ProfileSchema)
local AchievementRules = require(Voidline.Rules.AchievementRules)
local QuestRules = require(Voidline.Rules.QuestRules)

local PlayerDataService = require(script.Parent.PlayerDataService)
local JuiceService = require(script.Parent.JuiceService)

local StatService = {}

local rng = Random.new()
local listeners: { (Player, string, number) -> () } = {}

-- Server-side observers of counter bumps (squad challenges, etc.).
function StatService.Listen(fn: (Player, string, number) -> ())
	table.insert(listeners, fn)
end

local function announce(player: Player, grants: { AchievementRules.Grant }, completions: { QuestRules.Completion })
	for _, grant in grants do
		JuiceService.Send(player, "Achievement", {
			Name = grant.Name,
			Credits = grant.Credits,
			Shards = grant.Shards,
			Title = grant.Title,
			Unlock = grant.Unlock,
		})
	end
	for _, completion in completions do
		JuiceService.Send(player, "Quest", {
			Name = completion.Name,
			Credits = completion.Credits,
			Shards = completion.Shards,
			Unlock = completion.Unlock,
		})
	end
end

-- Adds `amount` to a counter stat and runs quests + achievements for it.
-- During onboarding only the counter moves: rewards wait until the bridge
-- is lit so the tutorial economy stays exact (CheckAll runs on completion).
function StatService.Bump(player: Player, stat: string, amount: number?)
	local n = amount or 1
	if n ~= n or n <= 0 then
		return
	end
	local grants: { AchievementRules.Grant } = {}
	local completions: { QuestRules.Completion } = {}
	PlayerDataService.Mutate(player, function(profile)
		ProfileSchema.Bump(profile, stat, n)
		if not profile.TutorialComplete then
			return
		end
		completions = QuestRules.Progress(profile, stat, n, rng)
		grants = AchievementRules.Check(profile, stat, os.time())
		-- Quest payouts move credits/shards; let those ladders catch up.
		if #completions > 0 then
			for _, follow in { "LifetimeCredits", "LifetimeShards" } do
				for _, grant in AchievementRules.Check(profile, follow, os.time()) do
					table.insert(grants, grant)
				end
			end
		end
	end)
	announce(player, grants, completions)
	for _, fn in listeners do
		task.spawn(fn, player, stat, n)
	end
end

-- Quest-only progress for values that live outside Stats (e.g. CreditsEarned).
function StatService.Quest(player: Player, stat: string, amount: number)
	StatService.Bump(player, stat, amount)
end

-- Re-checks achievements for a profile field that changed (Credits, StationTier...).
function StatService.Check(player: Player, ...: string)
	local stats = { ... }
	local grants: { AchievementRules.Grant } = {}
	PlayerDataService.Mutate(player, function(profile)
		if not profile.TutorialComplete then
			return
		end
		for _, stat in stats do
			for _, grant in AchievementRules.Check(profile, stat, os.time()) do
				table.insert(grants, grant)
			end
		end
	end)
	announce(player, grants, {})
end

function StatService.CheckAll(player: Player)
	StatService.Check(player, table.unpack(AchievementRules.AllStats()))
end

function StatService.Init()
	PlayerDataService.OnLoaded(function(player, profile)
		QuestRules.Refresh(profile, os.time(), player.UserId)
		PlayerDataService.MarkDirty(player)
		task.defer(StatService.CheckAll, player)
	end)
	-- Roll quests over at UTC midnight / Monday for pilots who stay online.
	task.spawn(function()
		while true do
			task.wait(30)
			for _, session in PlayerDataService._sessions do
				if QuestRules.Refresh(session.Profile, os.time(), session.UserId) then
					session.Dirty = true
					JuiceService.Banner(session.Player, "New quests are live", "gold")
				end
			end
		end
	end)
end

return StatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">SummonService</string>
            <string name="Source"><![CDATA[--!strict
-- Robux-only server summons with a clean queue: one Void Starfall and one
-- Luck Surge can run at a time; extra purchases wait their turn and the HUD
-- shows the queue. Starfall drop odds are shown before purchase.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local MonetizationConfig = require(Voidline.Config.MonetizationConfig)
local HubLayout = require(Voidline.Modules.HubLayout)
local OreRegistry = require(Voidline.Content.OreRegistry)

local SoftContestService = require(script.Parent.SoftContestService)
local RockService = require(script.Parent.RockService)
local JuiceService = require(script.Parent.JuiceService)
local WorldState = require(script.Parent.WorldState)

local SummonService = {}

type Entry = { Kind: string, BuyerName: string, BuyerId: number }

local STARFALL = "SummonVoidStarfall"
local SURGE = "ServerLuckSurge"
local STARFALL_METEOR_HEALTH = 3000

local queues: { [string]: { Entry } } = { [STARFALL] = {}, [SURGE] = {} }
local running: { [string]: Entry? } = {}
local rng = Random.new()

local function publishQueue()
	Workspace:SetAttribute("StarfallQueue", #queues[STARFALL])
	Workspace:SetAttribute("SurgeQueue", #queues[SURGE])
end

local function celestialOreId(): string
	local pool = OreRegistry.ByTier[5]
	return pool[rng:NextInteger(1, #pool)].Id
end

local runNext: (kind: string) -> ()

local function runStarfall(entry: Entry)
	local config = MonetizationConfig.Starfall
	local product = MonetizationConfig.GetProduct(STARFALL) :: MonetizationConfig.DevProduct
	local duration = product.DurationSeconds
	Workspace:SetAttribute("StarfallEndsAt", Workspace:GetServerTimeNow() + duration)
	JuiceService.BannerAll(("%s summoned a VOID STARFALL"):format(entry.BuyerName), "gold")
	local spawned: { RockService.Rock } = {}
	local gap = duration / (config.Meteors + 1)
	for i = 1, config.Meteors do
		task.delay(gap * (i - 1), function()
			local rock = SoftContestService.Spawn({
				Kind = "Meteor",
				Position = HubLayout.MeteorSlot(i, config.Meteors) + Vector3.new(0, 6, 0),
				Size = 7,
				Health = STARFALL_METEOR_HEALTH,
				OrePool = config.OrePerMeteor,
				ShardPool = config.ShardsPerMeteor,
				OreId = if rng:NextNumber() < config.CelestialOreChance then celestialOreId() else nil,
				RelicChance = config.RelicChancePerMeteor,
				Reach = 52,
				Priority = 3,
				Label = "Void Starfall",
				Stat = "StarfallsJoined",
			})
			table.insert(spawned, rock)
		end)
	end
	task.delay(duration, function()
		for _, rock in spawned do
			SoftContestService.Expire(rock)
		end
		Workspace:SetAttribute("StarfallEndsAt", 0)
		running[STARFALL] = nil
		runNext(STARFALL)
	end)
end

local function runSurge(entry: Entry)
	local product = MonetizationConfig.GetProduct(SURGE) :: MonetizationConfig.DevProduct
	WorldState.SurgeEndsAt = Workspace:GetServerTimeNow() + product.DurationSeconds
	WorldState.Publish()
	JuiceService.BannerAll(("%s started a SERVER LUCK SURGE · 2x finds"):format(entry.BuyerName), "gold")
	task.delay(product.DurationSeconds, function()
		running[SURGE] = nil
		runNext(SURGE)
	end)
end

function runNext(kind: string)
	publishQueue()
	if running[kind] then
		return
	end
	local entry = table.remove(queues[kind], 1)
	if not entry then
		return
	end
	running[kind] = entry
	publishQueue()
	if kind == STARFALL then
		runStarfall(entry)
	else
		runSurge(entry)
	end
end

-- Called by MonetizationService after a receipt is recorded.
function SummonService.Enqueue(productKey: string, buyer: Player): number
	local queue = queues[productKey]
	if not queue then
		return 0
	end
	table.insert(queue, { Kind = productKey, BuyerName = buyer.DisplayName, BuyerId = buyer.UserId })
	local position = #queue + (if running[productKey] then 1 else 0)
	if position > 1 then
		JuiceService.BannerAll(
			("%s queued a %s (#%d in line)"):format(
				buyer.DisplayName,
				(MonetizationConfig.GetProduct(productKey) :: any).Name,
				position
			),
			"info"
		)
	end
	runNext(productKey)
	return position
end

function SummonService.QueueLength(productKey: string): number
	local queue = queues[productKey]
	return (if queue then #queue else 0) + (if running[productKey] then 1 else 0)
end

function SummonService.Init()
	publishQueue()
	Workspace:SetAttribute("StarfallEndsAt", 0)
end

return SummonService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">TowService</string>
            <string name="Source"><![CDATA[--!strict
-- Gravity-Tether Towing. A tow is a server timeline written to the towed
-- part's attributes (start time on the server clock, duration, from, to).
-- The part stays anchored and is never moved or owned by a client on the
-- server; every client animates the same curve locally from those
-- attributes. Arrival (and its payout) happens on the server timer only.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local RockService = require(script.Parent.RockService)
local WorldState = require(script.Parent.WorldState)

local TowService = {}

export type TowSpec = {
	Player: Player,
	Part: BasePart,
	From: Vector3,
	To: Vector3,
	Duration: number,
	Ore: number?,
	OnArrive: () -> (),
}

local pendingOre: { [number]: number } = {}
local active = 0

function TowService.PendingOre(userId: number): number
	return pendingOre[userId] or 0
end

function TowService.ActiveCount(): number
	return active
end

function TowService.Start(spec: TowSpec)
	local part = spec.Part
	local userId = spec.Player.UserId
	local ore = spec.Ore or 0
	local duration = math.max(0.1, spec.Duration * WorldState.ZoneMult("SlowTow", spec.From, 1.5))
	part.CanCollide = false
	part.CanQuery = false
	part:SetAttribute("TowFrom", spec.From)
	part:SetAttribute("TowTo", spec.To)
	part:SetAttribute("TowDuration", duration)
	part:SetAttribute("TowOwner", userId)
	part:SetAttribute("TowStart", Workspace:GetServerTimeNow())
	pendingOre[userId] = (pendingOre[userId] or 0) + ore
	active += 1
	task.delay(duration, function()
		active -= 1
		pendingOre[userId] = math.max(0, (pendingOre[userId] or 0) - ore)
		if pendingOre[userId] == 0 then
			pendingOre[userId] = nil
		end
		RockService.ReleasePart(part)
		if spec.Player.Parent ~= Players then
			return
		end
		local ok, err = xpcall(spec.OnArrive :: () -> ...any, debug.traceback)
		if not ok then
			warn("[Voidline] tow arrival failed: " .. tostring(err))
		end
	end)
end

-- Tows a fresh chunk part (boss meteor / shared rock share) home.
function TowService.StartChunk(
	player: Player,
	oreId: string,
	from: Vector3,
	to: Vector3,
	duration: number,
	onArrive: () -> ()
)
	local chunk = RockService.Create({
		Kind = "Chunk",
		Position = from,
		Size = 2.4,
		OreId = oreId,
		Health = 1,
		OwnerUserId = player.UserId,
		Name = "TowedChunk",
	})
	RockService.Remove(chunk, true)
	chunk.Part:SetAttribute("Kind", "Chunk")
	TowService.Start({
		Player = player,
		Part = chunk.Part,
		From = from,
		To = to,
		Duration = duration,
		OnArrive = onArrive,
	})
end

function TowService.Init() end

return TowService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="80">
          <Properties>
            <string name="Name">TutorialService</string>
            <string name="Source"><![CDATA[--!strict
-- Diegetic ~45 s onboarding. TutorialRules owns the state machine; this
-- service relays step changes to the client (golden floor beams + ticker),
-- lights the Energy Bridge on completion and handles the tiny Skip button.
local AnalyticsService = game:GetService("AnalyticsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local TutorialRules = require(Voidline.Rules.TutorialRules)
local Remotes = require(Voidline.Remotes)

local ValidateRemote = require(script.Parent.Parent.Security.ValidateRemote)
local PlayerDataService = require(script.Parent.PlayerDataService)
local PlotService = require(script.Parent.PlotService)
local JuiceService = require(script.Parent.JuiceService)
local StatService = require(script.Parent.StatService)

local TutorialService = {}

-- The bridge ignition owns the screen; achievements earned during
-- onboarding are granted a beat later.
TutorialService.ACHIEVEMENT_DELAY = 3.5

local function funnel(player: Player, step: number, name: string)
	pcall(function()
		AnalyticsService:LogOnboardingFunnelStepEvent(player, step, name)
	end)
end

local function send(player: Player, profile: any, change: TutorialRules.Change?)
	Remotes.Get("TutorialProgress"):FireClient(player, {
		Step = profile.TutorialStep,
		Complete = profile.TutorialComplete,
		Skipped = profile.TutorialSkipped,
		Next = TutorialRules.NextUpgrade(profile),
		Bonus = if change then change.Bonus else 0,
	})
end

local function apply(player: Player, mutate: (any) -> TutorialRules.Change?)
	local profile = PlayerDataService.Get(player)
	if not profile or profile.TutorialComplete then
		return
	end
	local change: TutorialRules.Change? = nil
	PlayerDataService.Mutate(player, function(p)
		change = mutate(p)
	end)
	if not change then
		-- Flags may still have moved (e.g. an upgrade bought early).
		send(player, profile, nil)
		return
	end
	send(player, profile, change)
	local resolved = change :: TutorialRules.Change
	funnel(player, resolved.Step + 1, TutorialRules.Steps[resolved.Step].Ticker)
	if resolved.Completed then
		PlotService.IgniteBridge(player)
		JuiceService.Send(player, "BridgeIgnite", { Bonus = resolved.Bonus, Skipped = profile.TutorialSkipped })
		-- Persist the bonus right away so a quick leave cannot lose it.
		task.spawn(PlayerDataService.Save, player)
		task.delay(TutorialService.ACHIEVEMENT_DELAY, function()
			if PlayerDataService.IsLoaded(player) then
				StatService.CheckAll(player)
			end
		end)
	end
end

function TutorialService.OnOreStored(player: Player)
	apply(player, TutorialRules.OnOreStored)
end

function TutorialService.OnSold(player: Player)
	apply(player, TutorialRules.OnSold)
end

function TutorialService.OnUpgrade(player: Player, upgradeId: string)
	apply(player, function(profile)
		return TutorialRules.OnUpgrade(profile, upgradeId)
	end)
end

function TutorialService.Init()
	PlayerDataService.OnLoaded(function(player, profile)
		send(player, profile, nil)
		if not profile.TutorialComplete and profile.TutorialStep == 1 then
			funnel(player, 1, "Joined")
		end
	end)
	ValidateRemote.Bind("TutorialSkip", { Rate = 0.5, Burst = 2 }, function(player)
		apply(player, TutorialRules.Skip)
	end)
end

return TutorialService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="81">
          <Properties>
            <string name="Name">WarpService</string>
            <string name="Source"><![CDATA[--!strict
-- Warps: Home and Hub are always free. The Star Overlook and the Void Rift
-- open from their hub gates; the Deep-Space Warp Pass opens them (and the
-- Monolith plaza) from anywhere. Pilots who fall into the void are caught
-- and warped home instead of dying.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local HubLayout = require(Voidline.Modules.HubLayout)

local ValidateRemote = require(script.Parent.Parent.Security.ValidateRemote)
local PlayerDataService = require(script.Parent.PlayerDataService)
local PlotService = require(script.Parent.PlotService)
local RiftService = require(script.Parent.RiftService)
local JuiceService = require(script.Parent.JuiceService)

local WarpService = {}

local COOLDOWN = 2
local GATE_RANGE = 14
local VOID_CATCH_Y = -90
local CHECK_INTERVAL = 0.5
local WARP_PASS = "DeepSpaceWarpPass"

local lastWarp: { [number]: number } = {}

local function hubSpawn(): CFrame
	return CFrame.lookAt(HubLayout.Spawn + Vector3.new(0, 3, 0), Vector3.new(0, HubLayout.Spawn.Y + 3, 0))
end

local DESTINATIONS: { [string]: (Player) -> CFrame? } = {
	Home = function(player)
		local index = PlotService.IndexOf(player)
		return if index then PlotService.SpawnCFrame(index) else nil
	end,
	Hub = function()
		return hubSpawn()
	end,
	Monolith = function()
		local plaza = Vector3.new(0, 4.5, 16)
		return CFrame.lookAt(plaza, Vector3.new(0, 4.5, 0))
	end,
	Overlook = function()
		local arrival = HubLayout.Overlook + Vector3.new(0, 4, 6)
		return CFrame.lookAt(arrival, HubLayout.Overlook + Vector3.new(60, 4, -60))
	end,
	Rift = function()
		if not RiftService.IsOpen() then
			return nil
		end
		return CFrame.new(HubLayout.RiftPlatform(1) + Vector3.new(0, 4, 0))
	end,
}

local GATED: { [string]: Vector3 } = {
	Overlook = HubLayout.OverlookGate,
	Rift = HubLayout.RiftGate,
	Monolith = HubLayout.Spawn,
}

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

function WarpService.CanWarp(player: Player, destination: string): (boolean, string?)
	if not DESTINATIONS[destination] then
		return false, "unknown"
	end
	local gate = GATED[destination]
	if gate and not PlayerDataService.HasPerk(player, WARP_PASS) then
		local root = rootOf(player)
		if not root or (root.Position - gate).Magnitude > GATE_RANGE then
			return false, "pass"
		end
	end
	if destination == "Rift" and not RiftService.IsOpen() then
		return false, "closed"
	end
	return true, nil
end

function WarpService.Warp(player: Player, destination: string): boolean
	local now = os.clock()
	if now - (lastWarp[player.UserId] or -math.huge) < COOLDOWN then
		return false
	end
	local ok, reason = WarpService.CanWarp(player, destination)
	if not ok then
		JuiceService.Send(player, "WarpLocked", { Destination = destination, Reason = reason })
		return false
	end
	local target = DESTINATIONS[destination](player)
	local character = player.Character
	if not target or not character then
		return false
	end
	lastWarp[player.UserId] = now
	character:PivotTo(target)
	JuiceService.Send(player, "Warp", { Destination = destination })
	return true
end

local function makeGatePrompt(pad: Instance?, destination: string, text: string)
	if not pad or not pad:IsA("BasePart") then
		return
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "WarpPrompt"
	prompt.ActionText = text
	prompt.ObjectText = "Warp Gate"
	prompt.HoldDuration = 0.3
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = pad
	prompt.Triggered:Connect(function(player)
		WarpService.Warp(player, destination)
	end)
end

local function catchFallers()
	for _, player in Players:GetPlayers() do
		local root = rootOf(player)
		if root and root.Position.Y < VOID_CATCH_Y then
			local target = DESTINATIONS.Home(player) or hubSpawn()
			local character = player.Character
			if character then
				character:PivotTo(target)
				root.AssemblyLinearVelocity = Vector3.zero
				JuiceService.Send(player, "VoidCatch", {})
			end
		end
	end
end

function WarpService.Init()
	local map = Workspace:FindFirstChild("VoidlineMap")
	local hub = map and map:FindFirstChild("Hub")
	if hub then
		makeGatePrompt(hub:FindFirstChild("OverlookGate"), "Overlook", "Warp to the Overlook")
		makeGatePrompt(hub:FindFirstChild("RiftGate"), "Rift", "Enter the Void Rift")
	end
	local overlook = map and map:FindFirstChild("StarOverlook")
	if overlook then
		makeGatePrompt(overlook:FindFirstChild("ArrivalPad"), "Hub", "Return to the hub")
	end

	ValidateRemote.Bind(
		"WarpRequest",
		{ Rate = 1, Burst = 2, Args = { "string" }, MaxString = 16, RequireCharacter = true },
		function(player, destination)
			WarpService.Warp(player, destination)
		end
	)

	Players.PlayerRemoving:Connect(function(player)
		lastWarp[player.UserId] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(CHECK_INTERVAL)
			catchFallers()
		end
	end)
end

return WarpService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="82">
          <Properties>
            <string name="Name">WorldEventService</string>
            <string name="Source"><![CDATA[--!strict
-- Deep-space rotation, keyed to UTC so every server shows the same thing:
--   * every 6 min a new anomaly biome rolls in (sky, gravity, ore bias,
--     hazards every ~20-30 s);
--   * halfway through each slot a 90 s world event runs (Monolith Split,
--     boss meteors, Titan wreck, modifiers, Void Rift).
-- State is mirrored to Workspace attributes for the client HUD/lighting.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local GameConfig = require(Voidline.Config.GameConfig)
local HubLayout = require(Voidline.Modules.HubLayout)
local BiomeRegistry = require(Voidline.Content.BiomeRegistry)
local WorldEventRegistry = require(Voidline.Content.WorldEventRegistry)

local PlayerDataService = require(script.Parent.PlayerDataService)
local RockService = require(script.Parent.RockService)
local SoftContestService = require(script.Parent.SoftContestService)
local DroneService = require(script.Parent.DroneService)
local RiftService = require(script.Parent.RiftService)
local CodexService = require(script.Parent.CodexService)
local StatService = require(script.Parent.StatService)
local JuiceService = require(script.Parent.JuiceService)
local WorldState = require(script.Parent.WorldState)

local WorldEventService = {}

local SLOT_SECONDS = GameConfig.WorldEventIntervalSeconds
local EVENT_OFFSET = math.floor(SLOT_SECONDS / 2)
local BASE_GRAVITY = Workspace.Gravity

type ActiveEvent = {
	Event: WorldEventRegistry.WorldEvent,
	Slot: number,
	EndsAt: number,
	Rocks: { RockService.Rock },
	Participants: { [number]: boolean },
}

local currentSlot = -1
local eventSlotDone = -1
local active: ActiveEvent? = nil
local nextHazardAt = math.huge
local witnessed: { [number]: { [string]: boolean } } = {}
local rng = Random.new()

local function inZone(player: Player): (boolean, Vector3?)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return false, nil
	end
	local p = root.Position
	return Vector3.new(p.X, 0, p.Z).Magnitude <= HubLayout.ZoneRadius, p
end

local function applyGravity()
	local mult = if WorldState.Biome then WorldState.Biome.GravityMult else 1
	if active then
		mult *= active.Event.GravityMult
	end
	Workspace.Gravity = BASE_GRAVITY * mult
end

local function startAnomaly(slot: number)
	currentSlot = slot
	local biome = BiomeRegistry.ForSlot(slot)
	WorldState.Biome = biome
	Workspace:SetAttribute("AnomalyId", biome.Id)
	Workspace:SetAttribute("AnomalyEndsAt", (slot + 1) * SLOT_SECONDS)
	Workspace:SetAttribute("NextEventAt", slot * SLOT_SECONDS + EVENT_OFFSET)
	applyGravity()
	nextHazardAt = os.time() + biome.HazardInterval
	JuiceService.BannerAll(("ANOMALY · %s (%s)"):format(biome.ArchetypeName, biome.IntensityName), "void")
end

local function fireHazard()
	local biome = WorldState.Biome
	if not biome or #biome.HazardIds == 0 then
		return
	end
	local hazard = BiomeRegistry.Hazards.ById[biome.HazardIds[rng:NextInteger(1, #biome.HazardIds)]]
	if not hazard then
		return
	end
	local angle = rng:NextNumber(0, math.pi * 2)
	local radius = rng:NextNumber(20, 80)
	local center = Vector3.new(math.cos(angle) * radius, 6, math.sin(angle) * radius)
	JuiceService.All("Hazard", {
		Id = hazard.Id,
		Phase = "telegraph",
		Position = center,
		Radius = hazard.Radius,
		Seconds = hazard.TelegraphSeconds,
		Effect = hazard.Effect,
	})
	task.delay(hazard.TelegraphSeconds, function()
		local effect = hazard.Effect
		if effect == "DronePause" then
			DroneService.PauseZone(center, hazard.Radius, hazard.Duration)
		elseif effect == "StrikeBonus" then
			RockService.DamageInRadius(center, hazard.Radius, 0.15)
		elseif effect == "LuckSurge" or effect == "OreSurge" or effect == "SlowTow" then
			WorldState.AddZone(effect, center, hazard.Radius, hazard.Duration)
		end
		-- Pull / Knockback are applied by each client to its own character.
		JuiceService.All("Hazard", {
			Id = hazard.Id,
			Phase = "strike",
			Position = center,
			Radius = hazard.Radius,
			Seconds = hazard.Duration,
			Effect = effect,
		})
		for _, player in Players:GetPlayers() do
			local ok, position = inZone(player)
			if ok and position and (position - center).Magnitude <= hazard.Radius + 10 then
				StatService.Bump(player, "HazardsSurvived", 1)
				CodexService.Discover(player, hazard.Id)
			end
		end
	end)
end

local function contestSpec(
	event: WorldEventRegistry.WorldEvent,
	kind: string,
	position: Vector3,
	health: number,
	size: number
): SoftContestService.ContestSpec
	local bias: { [number]: number }? = nil
	if event.CelestialBias > 1 then
		bias = { [5] = event.CelestialBias, [6] = event.CelestialBias }
	end
	return {
		Kind = kind,
		Position = position,
		Size = size,
		Health = health,
		OrePool = math.floor(health / 40),
		ShardPool = math.floor(health / 600),
		OreId = nil,
		RelicChance = if event.RelicGuaranteed then 1 else 0.12,
		Reach = if kind == "Core" then 80 else 52,
		Priority = 3,
		Label = event.Name,
		Bias = bias,
	}
end

local function startEvent(event: WorldEventRegistry.WorldEvent, slot: number)
	local now = os.time()
	local state: ActiveEvent = {
		Event = event,
		Slot = slot,
		EndsAt = now + event.Duration,
		Rocks = {},
		Participants = {},
	}
	active = state
	eventSlotDone = slot
	WorldState.EventId = event.Id
	WorldState.EventCreditMult = event.CreditMult
	WorldState.EventLuckMult = event.LuckMult
	WorldState.Publish()
	Workspace:SetAttribute("EventId", event.Id)
	Workspace:SetAttribute("EventEndsAt", state.EndsAt)
	applyGravity()
	JuiceService.BannerAll(event.Banner, "gold")
	JuiceService.All("WorldEvent", { Id = event.Id, Phase = "start", EndsAt = state.EndsAt })

	if event.Kind == "Monolith" then
		Workspace:SetAttribute("MonolithSplit", true)
		table.insert(
			state.Rocks,
			SoftContestService.Spawn(contestSpec(event, "Core", HubLayout.VoidCore, event.CoreHealth, 7))
		)
	elseif event.Kind == "Shower" then
		for i = 1, event.Meteors do
			local spec = contestSpec(event, "Meteor", HubLayout.MeteorSlot(i, event.Meteors), event.MeteorHealth, 8)
			table.insert(state.Rocks, SoftContestService.Spawn(spec))
		end
	elseif event.Kind == "Contest" then
		local spec = contestSpec(event, "Core", Vector3.new(0, 24, -62), event.CoreHealth, 16)
		table.insert(state.Rocks, SoftContestService.Spawn(spec))
	elseif event.Kind == "Rift" then
		RiftService.Open()
	end
end

local function endEvent()
	local state = active
	if not state then
		return
	end
	active = nil
	for _, rock in state.Rocks do
		SoftContestService.Expire(rock)
	end
	if state.Event.Kind == "Monolith" then
		Workspace:SetAttribute("MonolithSplit", false)
	elseif state.Event.Kind == "Rift" then
		RiftService.Close()
	end
	WorldState.EventId = ""
	WorldState.EventCreditMult = 1
	WorldState.EventLuckMult = 1
	WorldState.Publish()
	Workspace:SetAttribute("EventId", "")
	Workspace:SetAttribute("EventEndsAt", 0)
	applyGravity()
	JuiceService.All("WorldEvent", { Id = state.Event.Id, Phase = "end" })
	for userId in state.Participants do
		local player = Players:GetPlayerByUserId(userId)
		if player then
			StatService.Bump(player, "EventsJoined", 1)
			CodexService.Discover(player, state.Event.Id)
		end
	end
end

-- Witness tracking: being in the deep-space zone during an anomaly/event.
local function trackWitnesses()
	local biome = WorldState.Biome
	for _, player in Players:GetPlayers() do
		if not PlayerDataService.IsLoaded(player) then
			continue
		end
		local ok = inZone(player)
		if not ok then
			continue
		end
		if active then
			active.Participants[player.UserId] = true
		end
		if biome then
			local seen = witnessed[player.UserId]
			if not seen then
				seen = {}
				witnessed[player.UserId] = seen
			end
			if not seen[biome.Id] then
				seen[biome.Id] = true
				StatService.Bump(player, "AnomaliesSeen", 1)
				StatService.Bump(player, "Archetype:" .. biome.Archetype, 1)
				CodexService.Discover(player, biome.Id)
			end
		end
	end
end

function WorldEventService.Active(): WorldEventRegistry.WorldEvent?
	return if active then active.Event else nil
end

-- Studio-only: force an event now (Workspace attribute VoidlineForceEvent).
function WorldEventService.Force(eventId: string): boolean
	local event = WorldEventRegistry.ById[eventId]
	if not event then
		return false
	end
	endEvent()
	startEvent(event, currentSlot)
	return true
end

function WorldEventService.Tick(now: number)
	local slot = math.floor(now / SLOT_SECONDS)
	if slot ~= currentSlot then
		if active then
			endEvent()
		end
		startAnomaly(slot)
	end
	local eventStart = slot * SLOT_SECONDS + EVENT_OFFSET
	if not active and eventSlotDone ~= slot and now >= eventStart then
		local event = WorldEventRegistry.ForSlot(slot)
		if now < eventStart + event.Duration then
			startEvent(event, slot)
		else
			eventSlotDone = slot
		end
	end
	if active and now >= active.EndsAt then
		endEvent()
	end
	if now >= nextHazardAt and WorldState.Biome then
		nextHazardAt = now + WorldState.Biome.HazardInterval
		fireHazard()
	end
	trackWitnesses()
end

function WorldEventService.Init()
	Players.PlayerRemoving:Connect(function(player)
		witnessed[player.UserId] = nil
	end)
	if RunService:IsStudio() then
		Workspace:GetAttributeChangedSignal("VoidlineForceEvent"):Connect(function()
			local id = Workspace:GetAttribute("VoidlineForceEvent")
			if type(id) == "string" and id ~= "" then
				WorldEventService.Force(id)
				Workspace:SetAttribute("VoidlineForceEvent", nil)
			end
		end)
	end
	task.spawn(function()
		while true do
			WorldEventService.Tick(os.time())
			task.wait(1)
		end
	end)
end

return WorldEventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="83">
          <Properties>
            <string name="Name">WorldState</string>
            <string name="Source"><![CDATA[--!strict
-- Server-wide modifiers shared by mining services without making them depend
-- on each other. WorldEventService / SummonService write; everyone reads.
-- Mirrored to Workspace attributes so clients can show them.
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local MiningRules = require(Voidline.Rules.MiningRules)
local BiomeRegistry = require(Voidline.Content.BiomeRegistry)

local PlayerDataService = require(script.Parent.PlayerDataService)

local WorldState = {
	EventCreditMult = 1,
	EventLuckMult = 1,
	SurgeEndsAt = 0,
	Biome = nil :: BiomeRegistry.Biome?,
	EventId = "",
	-- Set by SquadService: true when a squadmate flies nearby.
	SquadLinked = function(_player: Player): boolean
		return false
	end,
	-- Hazard zones (LuckSurge, OreSurge, SlowTow) written by WorldEventService.
	Zones = {} :: { { Effect: string, Center: Vector3, Radius: number, Until: number } },
}

-- Multiplier from active hazard zones covering `position`.
function WorldState.ZoneMult(effect: string, position: Vector3, mult: number): number
	local now = os.clock()
	local result = 1
	for i = #WorldState.Zones, 1, -1 do
		local zone = WorldState.Zones[i]
		if now >= zone.Until then
			table.remove(WorldState.Zones, i)
		elseif zone.Effect == effect and (position - zone.Center).Magnitude <= zone.Radius then
			result = mult
		end
	end
	return result
end

function WorldState.AddZone(effect: string, center: Vector3, radius: number, seconds: number)
	table.insert(WorldState.Zones, { Effect = effect, Center = center, Radius = radius, Until = os.clock() + seconds })
end

function WorldState.SurgeActive(): boolean
	return Workspace:GetServerTimeNow() < WorldState.SurgeEndsAt
end

function WorldState.CreditBoost(): number
	local biomeMult = if WorldState.Biome then WorldState.Biome.CreditMult else 1
	return WorldState.EventCreditMult * biomeMult
end

-- Shard/relic luck for a pilot (passes, squad link, server surge, events).
function WorldState.Luck(player: Player, position: Vector3?): number
	local perks = PlayerDataService.Perks(player)
	local luck = MiningRules.LuckMultiplier(perks, WorldState.SquadLinked(player), WorldState.SurgeActive())
	luck *= WorldState.EventLuckMult
	if position then
		luck *= WorldState.ZoneMult("LuckSurge", position, 2)
	end
	return luck
end

function WorldState.RelicMult(): number
	return if WorldState.Biome then WorldState.Biome.RelicMult else 1
end

function WorldState.Publish()
	Workspace:SetAttribute("EventCreditMult", WorldState.EventCreditMult)
	Workspace:SetAttribute("EventLuckMult", WorldState.EventLuckMult)
	Workspace:SetAttribute("LuckSurgeEndsAt", WorldState.SurgeEndsAt)
end

function WorldState.Init()
	PlayerDataService.CreditBoostProvider = WorldState.CreditBoost
	WorldState.Publish()
end

return WorldState
]]></string>
