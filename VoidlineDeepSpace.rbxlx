        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">MapBuilder</string>
            <string name="Source"><![CDATA[local Workspace = game:GetService("Workspace")
local ServerStorage = game:GetService("ServerStorage")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local GameConfig = require(Voidline.Config.GameConfig)

local MapBuilder = {}

local function part(props): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = props.CanCollide ~= false
	p.Material = props.Material or Enum.Material.SmoothPlastic
	p.Color = props.Color or GameConfig.Colors.Obsidian
	p.Size = props.Size or Vector3.new(4, 1, 4)
	p.CFrame = props.CFrame or CFrame.new()
	p.Name = props.Name or "Part"
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props.Transparency then
		p.Transparency = props.Transparency
	end
	if props.Shape then
		p.Shape = props.Shape
	end
	p.Parent = props.Parent
	return p
end

local function billboard(parent: Instance, text: string, color: Color3?, heightStuds: number?, maxDistance: number?)
	local bb = Instance.new("BillboardGui")
	bb.Name = "Label_" .. string.gsub(text, "%s+", "_")
	bb.Size = UDim2.fromOffset(180, 32)
	bb.StudsOffset = Vector3.new(0, heightStuds or 5, 0)
	bb.AlwaysOnTop = false -- prevents every hub label stacking on screen
	bb.MaxDistance = maxDistance or 90
	bb.LightInfluence = 0
	bb.Parent = parent
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 0.35
	label.BackgroundColor3 = GameConfig.Colors.Obsidian
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = color or GameConfig.Colors.Gold
	label.Text = text
	label.Parent = bb
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = label
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 6)
	pad.PaddingRight = UDim.new(0, 6)
	pad.Parent = label
	return bb
end

function MapBuilder.Build()
	if Workspace:FindFirstChild("VoidlineMap") then
		return Workspace.VoidlineMap
	end

	local root = Instance.new("Folder")
	root.Name = "VoidlineMap"
	root.Parent = Workspace

	-- Hub floor
	local hub = Instance.new("Folder")
	hub.Name = "Hub"
	hub.Parent = root

	part({
		Name = "HubPad",
		Parent = hub,
		Size = Vector3.new(GameConfig.HubRadius * 2, 2, GameConfig.HubRadius * 2),
		CFrame = CFrame.new(0, 0, 0),
		Color = GameConfig.Colors.Obsidian,
		Material = Enum.Material.Metal,
	})

	-- Voidline Monolith
	local monolithFolder = Instance.new("Folder")
	monolithFolder.Name = "VoidlineMonolith"
	monolithFolder.Parent = hub

	local monolith = part({
		Name = "MonolithCore",
		Parent = monolithFolder,
		Size = Vector3.new(18, 72, 18),
		CFrame = CFrame.new(0, 37, 0),
		Color = GameConfig.Colors.Obsidian,
		Material = Enum.Material.Slate,
	})
	-- Gold trim bands
	for i = 1, 4 do
		part({
			Name = "GoldBand" .. i,
			Parent = monolithFolder,
			Size = Vector3.new(20, 1.2, 20),
			CFrame = CFrame.new(0, 10 + i * 14, 0),
			Color = GameConfig.Colors.Gold,
			Material = Enum.Material.Neon,
		})
	end
	billboard(monolith, "THE VOIDLINE MONOLITH", nil, 42, 140)

	part({
		Name = "RebirthPad",
		Parent = monolithFolder,
		Size = Vector3.new(14, 1, 14),
		CFrame = CFrame.new(16, 1.5, 0),
		Color = GameConfig.Colors.Gold,
		Material = Enum.Material.Neon,
	})
	billboard(monolithFolder.RebirthPad, "VOID REBIRTH", nil, 4, 60)

	part({
		Name = "ForgeAnchor",
		Parent = monolithFolder,
		Size = Vector3.new(12, 1, 12),
		CFrame = CFrame.new(-16, 1.5, 0),
		Color = GameConfig.Colors.VoidAccent,
		Material = Enum.Material.Neon,
	})
	billboard(monolithFolder.ForgeAnchor, "ARTIFACT FORGE", nil, 4, 60)

	part({
		Name = "CodeTerminal",
		Parent = monolithFolder,
		Size = Vector3.new(8, 10, 2),
		CFrame = CFrame.new(0, 6, 22),
		Color = GameConfig.Colors.Obsidian,
		Material = Enum.Material.Metal,
	})
	billboard(monolithFolder.CodeTerminal, "VOIDLINE CODES", nil, 8, 55)

	part({
		Name = "SummonPads",
		Parent = monolithFolder,
		Size = Vector3.new(10, 1, 10),
		CFrame = CFrame.new(0, 1.5, -22),
		Color = GameConfig.Colors.GoldBright,
		Material = Enum.Material.Neon,
	})
	billboard(monolithFolder.SummonPads, "SERVER SUMMONS", nil, 4, 55)

	part({
		Name = "EventCore",
		Parent = monolithFolder,
		Size = Vector3.new(6, 6, 6),
		CFrame = CFrame.new(0, 8, 0),
		Color = GameConfig.Colors.Gold,
		Material = Enum.Material.Neon,
		Shape = Enum.PartType.Ball,
		CanCollide = false,
	})

	local boards = Instance.new("Folder")
	boards.Name = "LeaderboardAnchors"
	boards.Parent = hub
	local boardNames = { "TopCredits", "TopRebirths", "CodexDiscoveries", "TopSummoners" }
	for i, name in boardNames do
		local angle = ((i - 1) / #boardNames) * math.pi * 2
		local anchor = part({
			Name = name,
			Parent = boards,
			Size = Vector3.new(10, 14, 1),
			CFrame = CFrame.new(math.cos(angle) * 36, 10, math.sin(angle) * 36)
				* CFrame.Angles(0, -angle + math.pi / 2, 0),
			Color = GameConfig.Colors.Obsidian,
		})
		billboard(anchor, name, nil, 9, 70)
	end

	part({
		Name = "VIPLoungePad",
		Parent = hub,
		Size = Vector3.new(20, 1, 20),
		CFrame = CFrame.new(40, 1.5, 40),
		Color = GameConfig.Colors.Gold,
		Material = Enum.Material.Neon,
	})
	billboard(hub.VIPLoungePad, "VOID VIP LOUNGE", nil, 4, 50)

	local monument = part({
		Name = "KillshotMonument",
		Parent = hub,
		Size = Vector3.new(6, 16, 6),
		CFrame = CFrame.new(-40, 9, 40),
		Color = GameConfig.Colors.Obsidian,
		Material = Enum.Material.Metal,
	})
	billboard(monument, "Created by Killshot2336", nil, 10, 70)

	-- Deep Space zone
	local deep = Instance.new("Folder")
	deep.Name = "DeepSpace"
	deep.Parent = root
	part({
		Name = "SoftContestZone",
		Parent = deep,
		Size = Vector3.new(90, 1, 90),
		CFrame = CFrame.new(0, 0.5, 0),
		Color = Color3.fromRGB(20, 10, 40),
		Transparency = 0.35,
		CanCollide = false,
	})
	local rareSpawns = Instance.new("Folder")
	rareSpawns.Name = "RareAsteroidSpawns"
	rareSpawns.Parent = deep
	for i = 1, 8 do
		local angle = (i / 8) * math.pi * 2
		local pos = Vector3.new(math.cos(angle) * 55, 18, math.sin(angle) * 55)
		local rock = part({
			Name = "VoidAsteroid_" .. i,
			Parent = rareSpawns,
			Size = Vector3.new(10, 10, 10),
			CFrame = CFrame.new(pos),
			Color = Color3.fromRGB(40, 20, 70),
			Material = Enum.Material.Rock,
			Shape = Enum.PartType.Ball,
		})
		rock:SetAttribute("Sector", "VoidRim")
		rock:SetAttribute("MaxHealth", 5000)
		rock:SetAttribute("Health", 5000)
		rock:SetAttribute("Shared", true)
	end
	part({
		Name = "EventMeteorAnchor",
		Parent = deep,
		Size = Vector3.new(2, 2, 2),
		CFrame = CFrame.new(0, 40, 0),
		Transparency = 1,
		CanCollide = false,
	})

	-- Kyria overlook (secret)
	local kyria = Instance.new("Folder")
	kyria.Name = "KyriaOverlook"
	kyria.Parent = root
	local overlook = part({
		Name = "StarlightOverlook",
		Parent = kyria,
		Size = Vector3.new(16, 1, 16),
		CFrame = CFrame.new(180, 60, -180),
		Color = Color3.fromRGB(255, 230, 180),
		Material = Enum.Material.Neon,
	})
	overlook:SetAttribute("SecretAura", true)
	-- Quiet marker only — no Kyria branding in UI
	billboard(overlook, "…", Color3.fromRGB(255, 240, 200), 3, 40)

	local star = part({
		Name = "HiddenStar",
		Parent = kyria,
		Size = Vector3.new(40, 40, 40),
		CFrame = CFrame.new(220, 140, -220),
		Color = Color3.fromRGB(255, 236, 180),
		Material = Enum.Material.Neon,
		Shape = Enum.PartType.Ball,
		CanCollide = false,
	})
	star.Transparency = 0.15

	-- Plots ring
	local plotsFolder = Instance.new("Folder")
	plotsFolder.Name = "Plots"
	plotsFolder.Parent = root

	local templates = ServerStorage:FindFirstChild("Voidline")
	if not templates then
		templates = Instance.new("Folder")
		templates.Name = "Voidline"
		templates.Parent = ServerStorage
	end

	for i = 1, GameConfig.PlotCount do
		local angle = ((i - 1) / GameConfig.PlotCount) * math.pi * 2
		local center = Vector3.new(
			math.cos(angle) * GameConfig.PlotRingRadius,
			0,
			math.sin(angle) * GameConfig.PlotRingRadius
		)
		local plot = Instance.new("Folder")
		plot.Name = "Plot_" .. i
		plot.Parent = plotsFolder
		plot:SetAttribute("PlotIndex", i)
		plot:SetAttribute("Claimed", false)

		part({
			Name = "StationBase",
			Parent = plot,
			Size = Vector3.new(60, 2, 60),
			CFrame = CFrame.new(center + Vector3.new(0, 1, 0)),
			Color = GameConfig.Colors.Obsidian,
			Material = Enum.Material.Metal,
		})

		local claim = part({
			Name = "ClaimPad",
			Parent = plot,
			Size = Vector3.new(12, 1, 12),
			CFrame = CFrame.new(center + Vector3.new(0, 2.2, 18)),
			Color = GameConfig.Colors.Gold,
			Material = Enum.Material.Neon,
		})
		claim:SetAttribute("PlotIndex", i)
		-- No claim billboard: plots auto-claim; keeps hub readable

		local station = Instance.new("Folder")
		station.Name = "Station"
		station.Parent = plot

		local refinery = part({
			Name = "Refinery",
			Parent = station,
			Size = Vector3.new(14, 8, 14),
			CFrame = CFrame.new(center + Vector3.new(-16, 5, -8)),
			Color = GameConfig.Colors.Obsidian,
			Material = Enum.Material.Metal,
		})
		billboard(refinery, "STATION REFINERY", nil, 6, 45)

		local grinder = part({
			Name = "GrinderCore",
			Parent = station,
			Size = Vector3.new(12, 10, 12),
			CFrame = CFrame.new(center + Vector3.new(16, 6, -8)),
			Color = Color3.fromRGB(30, 30, 40),
			Material = Enum.Material.DiamondPlate,
		})
		billboard(grinder, "GRINDER CORE", nil, 6, 45)

		local upgrades = Instance.new("Folder")
		upgrades.Name = "UpgradePads"
		upgrades.Parent = station
		local upgradeDefs = {
			{ "Drill", Vector3.new(-18, 0, 8) },
			{ "Cargo", Vector3.new(-6, 0, 8) },
			{ "DroneSlot", Vector3.new(6, 0, 8) },
			{ "StationTier", Vector3.new(18, 0, 8) },
		}
		for _, def in upgradeDefs do
			local up = part({
				Name = def[1],
				Parent = upgrades,
				Size = Vector3.new(8, 1, 8),
				CFrame = CFrame.new(center + def[2] + Vector3.new(0, 2.2, 0)),
				Color = GameConfig.Colors.Gold,
				Material = Enum.Material.Neon,
			})
			up:SetAttribute("UpgradeId", def[1])
			-- Proximity prompts name the pads; skip world labels to avoid clutter
		end

		local tuner = part({
			Name = "LaserTuner",
			Parent = station,
			Size = Vector3.new(6, 1, 6),
			CFrame = CFrame.new(center + Vector3.new(0, 2.2, -18)),
			Color = Color3.fromRGB(90, 220, 255),
			Material = Enum.Material.Neon,
		})
		billboard(tuner, "LASER COLOR", nil, 3, 35)

		part({
			Name = "WarpGatePlaceholder",
			Parent = station,
			Size = Vector3.new(10, 16, 2),
			CFrame = CFrame.new(center + Vector3.new(22, 9, 16)),
			Color = Color3.fromRGB(40, 40, 60),
			Transparency = 0.4,
		})

		local relics = Instance.new("Folder")
		relics.Name = "RelicPedestals"
		relics.Parent = station

		local spawn = part({
			Name = "PlayerSpawn",
			Parent = plot,
			Size = Vector3.new(6, 1, 6),
			CFrame = CFrame.new(center + Vector3.new(0, 2.5, 10)),
			Color = GameConfig.Colors.GoldBright,
			Material = Enum.Material.Neon,
			CanCollide = false,
		})
		spawn.Transparency = 0.3

		-- Personal asteroid belt
		local belt = Instance.new("Folder")
		belt.Name = "PersonalBelt"
		belt.Parent = plot
		for a = 1, 6 do
			local aAng = (a / 6) * math.pi * 2
			local aPos = center + Vector3.new(math.cos(aAng) * 36, 10, math.sin(aAng) * 36)
			local asteroid = part({
				Name = "Asteroid_" .. a,
				Parent = belt,
				Size = Vector3.new(7, 7, 7),
				CFrame = CFrame.new(aPos),
				Color = Color3.fromRGB(70, 70, 80),
				Material = Enum.Material.Rock,
				Shape = Enum.PartType.Ball,
			})
			asteroid:SetAttribute("Sector", "Starter")
			asteroid:SetAttribute("MaxHealth", 40)
			asteroid:SetAttribute("Health", 40)
			asteroid:SetAttribute("Shared", false)
			asteroid:SetAttribute("PlotIndex", i)
		end

		-- Energy bridge path (visual beam parts)
		local bridge = Instance.new("Folder")
		bridge.Name = "BridgeAttach"
		bridge.Parent = plot
		local outward = center.Unit
		local bridgeStart = center - outward * 28
		local bridgeEnd = outward * (GameConfig.HubRadius + 4)
		local mid = (bridgeStart + bridgeEnd) / 2
		local length = (bridgeEnd - bridgeStart).Magnitude
		local beam = part({
			Name = "EnergyBridge",
			Parent = bridge,
			Size = Vector3.new(4, 0.6, length),
			CFrame = CFrame.lookAt(mid, bridgeEnd) * CFrame.new(0, 2, 0),
			Color = GameConfig.Colors.Gold,
			Material = Enum.Material.Neon,
			Transparency = 0.65,
			CanCollide = false,
		})
		beam:SetAttribute("Ignited", false)
	end

	-- Spawn location for unclaimed players near monument
	local spawnLoc = Instance.new("SpawnLocation")
	spawnLoc.Name = "VoidlineSpawn"
	spawnLoc.Anchored = true
	spawnLoc.Size = Vector3.new(12, 1, 12)
	spawnLoc.CFrame = CFrame.new(-40, 1.5, 52)
	spawnLoc.Color = GameConfig.Colors.Gold
	spawnLoc.Material = Enum.Material.Neon
	spawnLoc.Duration = 0
	spawnLoc.Parent = hub

	print("[Voidline] MapBuilder: VoidlineMap ready (12 plots)")
	return root
end

return MapBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local MonetizationConfig = require(Voidline.Config.MonetizationConfig)
local Remotes = require(Voidline.Remotes)
local RateLimiter = require(Voidline.Modules.RateLimiter)
local PlayerDataService = require(script.Parent.PlayerDataService)
local WorldEventService = require(script.Parent.WorldEventService)

local MonetizationService = {
	_limiter = RateLimiter.new(0.5),
}

local function grantPass(player: Player, passId: string)
	PlayerDataService.Mutate(player, function(d)
		d.OwnedPerks[passId] = true
	end)
	PlayerDataService.Save(player)
	Remotes.Get("JuiceEvent"):FireClient(player, { Kind = "PassOwned", Id = passId })
end

function MonetizationService.Init()
	Remotes.Get("PurchaseWithTokens").OnServerEvent:Connect(function(player, passId)
		if not MonetizationService._limiter:Allow(player.UserId) then
			return
		end
		if typeof(passId) ~= "string" then
			return
		end
		local pass = MonetizationConfig.GetPass(passId)
		local data = PlayerDataService.Get(player)
		if not pass or not data then
			return
		end
		if data.OwnedPerks[passId] then
			return
		end
		if data.VoidlineTokens < pass.Tokens then
			return
		end
		PlayerDataService.Mutate(player, function(d)
			d.VoidlineTokens -= pass.Tokens
			d.OwnedPerks[passId] = true
		end)
		PlayerDataService.Save(player)
		Remotes.Get("JuiceEvent"):FireClient(player, { Kind = "PassOwned", Id = passId })
	end)

	Remotes.Get("PromptRobuxPurchase").OnServerEvent:Connect(function(player, kind, id)
		if not MonetizationService._limiter:Allow(player.UserId) then
			return
		end
		if kind == "Pass" then
			local pass = MonetizationConfig.GetPass(id)
			if not pass or pass.GamePassId == 0 then
				-- Studio/dev fallback: grant for testing when ID unset
				grantPass(player, id)
				Remotes.Get("JuiceEvent"):FireClient(player, {
					Kind = "DevGrant",
					Message = "Placeholder GamePassId — granted for Studio test",
				})
				return
			end
			MarketplaceService:PromptGamePassPurchase(player, pass.GamePassId)
		elseif kind == "Product" then
			local product = nil
			for _, p in MonetizationConfig.DevProducts do
				if p.Id == id then
					product = p
					break
				end
			end
			if not product or product.ProductId == 0 then
				if id == "SummonVoidStarfall" then
					WorldEventService.QueueSummon(player, "VoidStarfall")
				elseif id == "ServerLuckSurge" then
					WorldEventService.QueueSummon(player, "LuckSurge")
				end
				return
			end
			MarketplaceService:PromptProductPurchase(player, product.ProductId)
		end
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, wasPurchased)
		if not wasPurchased then
			return
		end
		for _, pass in MonetizationConfig.Passes do
			if pass.GamePassId == passId then
				grantPass(player, pass.Id)
				break
			end
		end
	end)

	MarketplaceService.ProcessReceipt = function(receipt)
		local player = Players:GetPlayerByUserId(receipt.PlayerId)
		if not player then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		for _, product in MonetizationConfig.DevProducts do
			if product.ProductId == receipt.ProductId then
				if product.Id == "SummonVoidStarfall" then
					WorldEventService.QueueSummon(player, "VoidStarfall")
				elseif product.Id == "ServerLuckSurge" then
					WorldEventService.QueueSummon(player, "LuckSurge")
				end
				return Enum.ProductPurchaseDecision.PurchaseGranted
			end
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
end

return MonetizationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">PlayerDataService</string>
            <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local GameConfig = require(Voidline.Config.GameConfig)
local RebirthConfig = require(Voidline.Config.RebirthConfig)
local PerformanceConfig = require(Voidline.Config.PerformanceConfig)
local DroneConfig = require(Voidline.Config.DroneConfig)
local Remotes = require(Voidline.Remotes)

local STORE_NAME = "VoidlinePlayer_v1"
local store = DataStoreService:GetDataStore(STORE_NAME)

local PlayerDataService = {
	_profiles = {} :: { [number]: any },
	_saving = {} :: { [number]: boolean },
}

local function dayKey(): string
	return os.date("!%Y-%m-%d")
end

local function defaultProfile()
	return {
		Credits = 0,
		Ore = 0,
		VoidShards = 0,
		Artifacts = 0,
		VoidlineTokens = 0,
		Rebirths = 0,
		CreditMult = 1,
		StationTier = 1,
		DrillLevel = 1,
		CargoLevel = 1,
		DroneSlots = DroneConfig.StarterSlots,
		DroneTier = 1,
		GalaxyFlags = {
			Starter = true,
			Nebula = false,
			VoidRim = false,
			Celestial = false,
		},
		OwnedPerks = {},
		RedeemedCodes = {},
		TutorialStep = 1,
		TutorialComplete = false,
		Settings = {
			PerfMode = PerformanceConfig.DefaultPerfMode,
			HideJetpack = false,
			ClipMode = false,
			LaserColor = DroneConfig.DefaultLaserColor,
		},
		Cosmetics = { Title = nil },
		ForgeTokensEarnedToday = 0,
		ForgeDayKey = dayKey(),
		DailyStreak = 0,
		LastLoginDay = "",
		TrialVouchers = {},
		Codex = {},
		Relics = {},
		Formation = 1,
		Version = 1,
	}
end

function PlayerDataService.Get(player: Player)
	return PlayerDataService._profiles[player.UserId]
end

function PlayerDataService.Replicate(player: Player)
	local data = PlayerDataService.Get(player)
	if not data then
		return
	end
	Remotes.Get("DataSnapshot"):FireClient(player, data)
end

function PlayerDataService.Load(player: Player)
	local key = "p_" .. player.UserId
	local ok, saved = pcall(function()
		return store:GetAsync(key)
	end)
	local data = defaultProfile()
	if ok and typeof(saved) == "table" then
		for k, v in saved do
			data[k] = v
		end
	end
	-- Daily streak on load
	local today = dayKey()
	if data.LastLoginDay ~= today then
		local yesterday = os.date("!%Y-%m-%d", os.time() - 86400)
		if data.LastLoginDay == yesterday then
			data.DailyStreak = math.min(7, (data.DailyStreak or 0) + 1)
		else
			data.DailyStreak = 1
		end
		data.LastLoginDay = today
	end
	if data.ForgeDayKey ~= today then
		data.ForgeDayKey = today
		data.ForgeTokensEarnedToday = 0
	end
	data.CreditMult = RebirthConfig.CreditMultiplier(data.Rebirths or 0)
	PlayerDataService._profiles[player.UserId] = data
	PlayerDataService.Replicate(player)
	return data
end

function PlayerDataService.Save(player: Player)
	local data = PlayerDataService.Get(player)
	if not data or PlayerDataService._saving[player.UserId] then
		return
	end
	PlayerDataService._saving[player.UserId] = true
	local key = "p_" .. player.UserId
	local payload = table.clone(data)
	payload.Ore = data.Ore -- session ore persists too for fairness
	local ok, err = pcall(function()
		store:UpdateAsync(key, function()
			return payload
		end)
	end)
	PlayerDataService._saving[player.UserId] = false
	if not ok then
		warn("[Voidline] Save failed", player.Name, err)
	end
end

function PlayerDataService.Mutate(player: Player, mutator: (any) -> ())
	local data = PlayerDataService.Get(player)
	if not data then
		return
	end
	mutator(data)
	PlayerDataService.Replicate(player)
end

function PlayerDataService.HasPerk(player: Player, perkId: string): boolean
	local data = PlayerDataService.Get(player)
	if not data then
		return false
	end
	if data.OwnedPerks[perkId] then
		return true
	end
	local voucherExp = data.TrialVouchers[perkId]
	if voucherExp and voucherExp > os.time() then
		return true
	end
	return false
end

function PlayerDataService.Init()
	Remotes.Get("SettingsUpdate").OnServerEvent:Connect(function(player, patch)
		if typeof(patch) ~= "table" then
			return
		end
		PlayerDataService.Mutate(player, function(d)
			if typeof(patch.PerfMode) == "boolean" then
				d.Settings.PerfMode = patch.PerfMode
			end
			if typeof(patch.HideJetpack) == "boolean" then
				d.Settings.HideJetpack = patch.HideJetpack
			end
			if typeof(patch.ClipMode) == "boolean" then
				d.Settings.ClipMode = patch.ClipMode
			end
			if typeof(patch.LaserColor) == "string" then
				d.Settings.LaserColor = patch.LaserColor
			end
		end)
	end)

	Players.PlayerAdded:Connect(function(player)
		PlayerDataService.Load(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		PlayerDataService.Save(player)
		PlayerDataService._profiles[player.UserId] = nil
	end)
	for _, player in Players:GetPlayers() do
		task.spawn(PlayerDataService.Load, player)
	end
	task.spawn(function()
		while true do
			task.wait(GameConfig.AutosaveSeconds)
			for _, player in Players:GetPlayers() do
				task.spawn(PlayerDataService.Save, player)
			end
		end
	end)
	game:BindToClose(function()
		for _, player in Players:GetPlayers() do
			PlayerDataService.Save(player)
		end
	end)
end

return PlayerDataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">PlotService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local Remotes = require(Voidline.Remotes)
local RateLimiter = require(Voidline.Modules.RateLimiter)
local PlayerDataService = require(script.Parent.PlayerDataService)

local PlotService = {
	Owners = {} :: { [number]: Player },
	ByPlayer = {} :: { [number]: number },
	_limiter = RateLimiter.new(0.5),
}

local function getPlot(index: number): Folder?
	local map = Workspace:FindFirstChild("VoidlineMap")
	if not map then
		return nil
	end
	local plots = map:FindFirstChild("Plots")
	return plots and plots:FindFirstChild("Plot_" .. index)
end

function PlotService.GetPlayerPlot(player: Player): Folder?
	local idx = PlotService.ByPlayer[player.UserId]
	if not idx then
		return nil
	end
	return getPlot(idx)
end

function PlotService.TeleportToPlot(player: Player, plotIndex: number)
	local plot = getPlot(plotIndex)
	if not plot then
		return
	end
	local spawn = plot:FindFirstChild("PlayerSpawn")
	local char = player.Character or player.CharacterAdded:Wait()
	local hrp = char:WaitForChild("HumanoidRootPart")
	if spawn and spawn:IsA("BasePart") then
		hrp.CFrame = spawn.CFrame + Vector3.new(0, 3, 0)
	end
end

function PlotService.Claim(player: Player, plotIndex: number): boolean
	if PlotService.ByPlayer[player.UserId] then
		return false
	end
	if PlotService.Owners[plotIndex] then
		return false
	end
	local plot = getPlot(plotIndex)
	if not plot then
		return false
	end
	PlotService.Owners[plotIndex] = player
	PlotService.ByPlayer[player.UserId] = plotIndex
	plot:SetAttribute("Claimed", true)
	plot:SetAttribute("OwnerUserId", player.UserId)
	PlayerDataService.Mutate(player, function(data)
		data.PlotIndex = plotIndex
	end)
	PlotService.TeleportToPlot(player, plotIndex)
	Remotes.Get("JuiceEvent"):FireClient(player, { Kind = "ClaimPlot", PlotIndex = plotIndex })
	return true
end

function PlotService.IgniteBridge(player: Player)
	local plot = PlotService.GetPlayerPlot(player)
	if not plot then
		return
	end
	local bridge = plot:FindFirstChild("BridgeAttach")
	local beam = bridge and bridge:FindFirstChild("EnergyBridge")
	if beam and beam:IsA("BasePart") then
		beam.Transparency = 0.15
		beam:SetAttribute("Ignited", true)
	end
	Remotes.Get("JuiceEvent"):FireClient(player, { Kind = "BridgeIgnition" })
end

function PlotService.Init()
	Remotes.Get("ClaimPlot").OnServerEvent:Connect(function(player, plotIndex)
		if not PlotService._limiter:Allow(player.UserId) then
			return
		end
		if typeof(plotIndex) ~= "number" then
			return
		end
		plotIndex = math.floor(plotIndex)
		if plotIndex < 1 or plotIndex > 12 then
			return
		end
		PlotService.Claim(player, plotIndex)
	end)

	-- Auto-claim first free plot on join for instant action
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			task.wait(0.5)
			if PlotService.ByPlayer[player.UserId] then
				PlotService.TeleportToPlot(player, PlotService.ByPlayer[player.UserId])
				return
			end
			for i = 1, 12 do
				if not PlotService.Owners[i] then
					PlotService.Claim(player, i)
					break
				end
			end
		end)
	end)

	Players.PlayerRemoving:Connect(function(player)
		local idx = PlotService.ByPlayer[player.UserId]
		if idx then
			PlotService.Owners[idx] = nil
			local plot = getPlot(idx)
			if plot then
				plot:SetAttribute("Claimed", false)
				plot:SetAttribute("OwnerUserId", nil)
			end
		end
		PlotService.ByPlayer[player.UserId] = nil
		PlotService._limiter:Clear(player.UserId)
	end)
end

return PlotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">RebirthService</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local RebirthConfig = require(Voidline.Config.RebirthConfig)
local Remotes = require(Voidline.Remotes)
local RateLimiter = require(Voidline.Modules.RateLimiter)
local PlayerDataService = require(script.Parent.PlayerDataService)

local RebirthService = {
	_limiter = RateLimiter.new(2),
}

function RebirthService.Init()
	Remotes.Get("RequestRebirth").OnServerEvent:Connect(function(player)
		if not RebirthService._limiter:Allow(player.UserId) then
			return
		end
		local data = PlayerDataService.Get(player)
		if not data or data.StationTier < RebirthConfig.RequiredStationTier then
			return
		end
		local nextRebirth = data.Rebirths + 1
		local shards = RebirthConfig.ShardPayout(nextRebirth)
		PlayerDataService.Mutate(player, function(d)
			d.Rebirths = nextRebirth
			d.CreditMult = RebirthConfig.CreditMultiplier(nextRebirth)
			d.Credits = 0
			d.Ore = 0
			d.StationTier = 1
			d.DrillLevel = 1
			d.CargoLevel = 1
			-- Keep drone slots as quality-of-life; design said basic drill/cargo + pads reset
			d.VoidShards += shards
			d.Cosmetics.Title = "VOID " .. tostring(nextRebirth)
			d.GalaxyFlags.Nebula = false
			d.GalaxyFlags.VoidRim = false
			d.GalaxyFlags.Celestial = false
			d.GalaxyFlags.Starter = true
		end)
		PlayerDataService.Save(player)
		Remotes.Get("JuiceEvent"):FireAllClients({
			Kind = "RebirthShockwave",
			PlayerName = player.DisplayName,
			Rebirths = nextRebirth,
		})
	end)
end

return RebirthService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">SoftContestService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local ContributionSplit = require(Voidline.Modules.ContributionSplit)
local Remotes = require(Voidline.Remotes)
local PlayerDataService = require(script.Parent.PlayerDataService)
local EconomyService = require(script.Parent.EconomyService)

local SoftContestService = {
	_damage = {} :: { [BasePart]: { [number]: number } },
}

function SoftContestService.AddDamage(target: BasePart, player: Player, amount: number)
	local map = SoftContestService._damage[target]
	if not map then
		map = {}
		SoftContestService._damage[target] = map
	end
	map[player.UserId] = (map[player.UserId] or 0) + amount
	Remotes.Get("SoftContestUpdate"):FireAllClients({
		Target = target,
		Damage = map,
	})
end

function SoftContestService.Resolve(target: BasePart)
	local map = SoftContestService._damage[target] or {}
	local shares = ContributionSplit.Compute(map)
	local poolOre = 80
	local topId = nil
	local topShare = -1
	for userId, share in shares do
		if share > topShare then
			topShare = share
			topId = userId
		end
	end
	for userId, share in shares do
		local player = Players:GetPlayerByUserId(userId)
		if player then
			local ore = math.max(1, math.floor(poolOre * share))
			local shards = if share >= 0.2 then 2 else 1
			if PlayerDataService.HasPerk(player, "ShardRelicLuck2x") then
				shards *= 2
			end
			EconomyService.AddOre(player, ore)
			PlayerDataService.Mutate(player, function(d)
				d.VoidShards += shards
			end)
			Remotes.Get("JuiceEvent"):FireClient(player, {
				Kind = "CoreChunk",
				Position = target.Position,
				Ore = ore,
				IsTop = userId == topId,
			})
		end
	end
	SoftContestService._damage[target] = nil
	local maxHp = target:GetAttribute("MaxHealth") or 5000
	-- Respawn timer
	target.Transparency = 0.8
	task.delay(20, function()
		if target and target.Parent then
			target:SetAttribute("Health", maxHp)
			target.Transparency = 0
		end
	end)
end

function SoftContestService.Init()
	-- no remotes; driven by DroneService
end

return SoftContestService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">SquadService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local SquadConfig = require(Voidline.Config.SquadConfig)
local Remotes = require(Voidline.Remotes)
local RateLimiter = require(Voidline.Modules.RateLimiter)

local SquadService = {
	_squads = {} :: { [string]: { number } }, -- squadId -> userIds
	_byPlayer = {} :: { [number]: string },
	_limiter = RateLimiter.new(0.5),
}

local function replicate(squadId: string)
	local members = SquadService._squads[squadId] or {}
	local names = {}
	for _, userId in members do
		local p = Players:GetPlayerByUserId(userId)
		if p then
			table.insert(names, p.DisplayName)
		end
	end
	for _, userId in members do
		local p = Players:GetPlayerByUserId(userId)
		if p then
			Remotes.Get("SquadUpdate"):FireClient(p, {
				SquadId = squadId,
				Members = names,
				LuckBonus = SquadConfig.LinkedShardLuckBonus,
			})
		end
	end
end

function SquadService.GetLuckBonus(player: Player): number
	local sid = SquadService._byPlayer[player.UserId]
	if not sid then
		return 0
	end
	local members = SquadService._squads[sid]
	if members and #members >= SquadConfig.MinSize then
		return SquadConfig.LinkedShardLuckBonus
	end
	return 0
end

function SquadService.Init()
	Remotes.Get("SquadInvite").OnServerEvent:Connect(function(player, targetName)
		if not SquadService._limiter:Allow(player.UserId) then
			return
		end
		if typeof(targetName) ~= "string" then
			return
		end
		local target = nil
		for _, p in Players:GetPlayers() do
			if string.lower(p.Name) == string.lower(targetName)
				or string.lower(p.DisplayName) == string.lower(targetName) then
				target = p
				break
			end
		end
		if not target or target == player then
			return
		end
		local sid = SquadService._byPlayer[player.UserId]
		if not sid then
			sid = "squad_" .. player.UserId .. "_" .. tostring(os.time())
			SquadService._squads[sid] = { player.UserId }
			SquadService._byPlayer[player.UserId] = sid
		end
		local members = SquadService._squads[sid]
		if #members >= SquadConfig.MaxSize then
			return
		end
		if SquadService._byPlayer[target.UserId] then
			return
		end
		table.insert(members, target.UserId)
		SquadService._byPlayer[target.UserId] = sid
		replicate(sid)
	end)

	Remotes.Get("SquadLeave").OnServerEvent:Connect(function(player)
		local sid = SquadService._byPlayer[player.UserId]
		if not sid then
			return
		end
		local members = SquadService._squads[sid]
		if members then
			for i = #members, 1, -1 do
				if members[i] == player.UserId then
					table.remove(members, i)
				end
			end
			if #members == 0 then
				SquadService._squads[sid] = nil
			else
				replicate(sid)
			end
		end
		SquadService._byPlayer[player.UserId] = nil
		Remotes.Get("SquadUpdate"):FireClient(player, { SquadId = nil, Members = {} })
	end)

	Remotes.Get("SquadKick").OnServerEvent:Connect(function(player, targetName)
		local sid = SquadService._byPlayer[player.UserId]
		if not sid then
			return
		end
		-- Leader is creator (first member)
		local members = SquadService._squads[sid]
		if not members or members[1] ~= player.UserId then
			return
		end
		for _, p in Players:GetPlayers() do
			if p.Name == targetName or p.DisplayName == targetName then
				for i = #members, 1, -1 do
					if members[i] == p.UserId then
						table.remove(members, i)
					end
				end
				SquadService._byPlayer[p.UserId] = nil
				Remotes.Get("SquadUpdate"):FireClient(p, { SquadId = nil, Members = {} })
				replicate(sid)
				break
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		local sid = SquadService._byPlayer[player.UserId]
		if not sid then
			return
		end
		local members = SquadService._squads[sid]
		if members then
			for i = #members, 1, -1 do
				if members[i] == player.UserId then
					table.remove(members, i)
				end
			end
			if #members == 0 then
				SquadService._squads[sid] = nil
			else
				replicate(sid)
			end
		end
		SquadService._byPlayer[player.UserId] = nil
	end)
end

return SquadService
]]></string>
          </Properties>
        </Item>
