            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local Remotes = require(Voidline.Remotes)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local CameraController = {
	_action = false,
	_baseFov = 70,
}

function CameraController.Init()
	Remotes.Get("JuiceEvent").OnClientEvent:Connect(function(payload)
		if typeof(payload) ~= "table" then
			return
		end
		if payload.Kind == "Laser" and payload.Formation == 2 then
			CameraController._action = true
		elseif payload.Kind == "CoreChunk" or payload.Kind == "Shatter" then
			CameraController._action = true
			task.delay(1.2, function()
				CameraController._action = false
			end)
		elseif payload.Kind == "BridgeIgnition" then
			CameraController._action = true
			task.delay(1.5, function()
				CameraController._action = false
			end)
		end
	end)

	RunService.RenderStepped:Connect(function()
		camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local target = if CameraController._action then 80 else CameraController._baseFov
		camera.FieldOfView = camera.FieldOfView + (target - camera.FieldOfView) * 0.08
	end)
end

return CameraController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="66">
            <Properties>
              <string name="Name">HUDController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local FormatNumber = require(Voidline.Modules.FormatNumber)
local OreMath = require(Voidline.Modules.OreMath)
local GameConfig = require(Voidline.Config.GameConfig)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local HUDController = {
	_gui = nil :: ScreenGui?,
	_data = nil,
	_clip = false,
}

local function ensureGui()
	if HUDController._gui then
		return HUDController._gui
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "VoidlineHUD"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.Parent = playerGui

	local pill = Instance.new("Frame")
	pill.Name = "TopPill"
	pill.AnchorPoint = Vector2.new(0.5, 0)
	pill.Position = UDim2.new(0.5, 0, 0, 16)
	pill.Size = UDim2.fromOffset(520, 44)
	pill.BackgroundColor3 = GameConfig.Colors.Obsidian
	pill.BackgroundTransparency = 0.15
	pill.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Color = GameConfig.Colors.Gold
	stroke.Thickness = 1
	stroke.Parent = pill
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = pill

	local label = Instance.new("TextLabel")
	label.Name = "Stats"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 16
	label.TextColor3 = GameConfig.Colors.GoldBright
	label.Text = "CREDITS 0  |  CARGO 0/10  |  DRONES 1  |  SHARDS 0"
	label.Parent = pill

	local cargoBar = Instance.new("Frame")
	cargoBar.Name = "CargoBarBg"
	cargoBar.AnchorPoint = Vector2.new(0.5, 0)
	cargoBar.Position = UDim2.new(0.5, 0, 0, 64)
	cargoBar.Size = UDim2.fromOffset(280, 6)
	cargoBar.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
	cargoBar.Parent = gui
	local barCorner = Instance.new("UICorner")
	barCorner.CornerRadius = UDim.new(1, 0)
	barCorner.Parent = cargoBar
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = GameConfig.Colors.Gold
	fill.BorderSizePixel = 0
	fill.Parent = cargoBar
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(1, 0)
	fillCorner.Parent = fill

	local ticker = Instance.new("TextLabel")
	ticker.Name = "TutorialTicker"
	ticker.AnchorPoint = Vector2.new(0.5, 0)
	ticker.Position = UDim2.new(0.5, 0, 0, 78)
	ticker.Size = UDim2.fromOffset(420, 22)
	ticker.BackgroundTransparency = 1
	ticker.Font = Enum.Font.GothamMedium
	ticker.TextSize = 14
	ticker.TextColor3 = GameConfig.Colors.Gold
	ticker.Text = "[1/4] HARVESTING ORE"
	ticker.Parent = gui

	local banner = Instance.new("TextLabel")
	banner.Name = "EventBanner"
	banner.AnchorPoint = Vector2.new(0.5, 0)
	banner.Position = UDim2.new(0.5, 0, 0, -60)
	banner.Size = UDim2.fromOffset(560, 36)
	banner.BackgroundColor3 = GameConfig.Colors.Obsidian
	banner.BackgroundTransparency = 0.1
	banner.Font = Enum.Font.GothamBold
	banner.TextSize = 18
	banner.TextColor3 = GameConfig.Colors.GoldBright
	banner.Text = ""
	banner.Visible = false
	banner.Parent = gui
	local bStroke = Instance.new("UIStroke")
	bStroke.Color = GameConfig.Colors.Gold
	bStroke.Parent = banner

	HUDController._gui = gui
	return gui
end

local TICKER = {
	[1] = "[1/4] HARVESTING ORE",
	[2] = "[2/4] REFINE AT PAD",
	[3] = "[3/4] DEPLOY 2ND DRONE",
	[4] = "[4/4] ENERGY BRIDGE ONLINE",
}

function HUDController.SetData(data)
	HUDController._data = data
	local gui = ensureGui()
	if HUDController._clip then
		gui.Enabled = false
		return
	end
	gui.Enabled = true
	local cap = OreMath.CargoCap(data.CargoLevel)
	gui.TopPill.Stats.Text = string.format(
		"CREDITS %s  |  CARGO %d/%d  |  DRONES %d  |  SHARDS %s",
		FormatNumber.Compact(data.Credits),
		data.Ore,
		cap,
		data.DroneSlots,
		FormatNumber.Compact(data.VoidShards)
	)
	gui.CargoBarBg.Fill.Size = UDim2.fromScale(math.clamp(data.Ore / math.max(1, cap), 0, 1), 1)
	if data.TutorialComplete then
		gui.TutorialTicker.Visible = false
	else
		gui.TutorialTicker.Visible = true
		gui.TutorialTicker.Text = TICKER[data.TutorialStep] or TICKER[1]
	end
end

function HUDController.SetClipMode(on: boolean)
	HUDController._clip = on
	local gui = ensureGui()
	gui.Enabled = not on
end

function HUDController.ShowBanner(text: string, seconds: number?)
	local gui = ensureGui()
	local banner = gui.EventBanner
	banner.Text = text
	banner.Visible = true
	banner.Position = UDim2.new(0.5, 0, 0, 12)
	task.delay(seconds or 3, function()
		banner.Visible = false
		banner.Position = UDim2.new(0.5, 0, 0, -60)
	end)
end

function HUDController.Init()
	ensureGui()
end

return HUDController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">HotbarController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local Remotes = require(Voidline.Remotes)
local GameConfig = require(Voidline.Config.GameConfig)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local HotbarController = {
	_onOpenStore = nil :: (() -> ())?,
	_onOpenSettings = nil :: (() -> ())?,
	_onOpenSquad = nil :: (() -> ())?,
}

local function mkButton(parent, name, text, order)
	local b = Instance.new("TextButton")
	b.Name = name
	b.Size = UDim2.fromOffset(72, 56)
	b.BackgroundColor3 = GameConfig.Colors.Obsidian
	b.BackgroundTransparency = 0.1
	b.Text = text
	b.TextColor3 = GameConfig.Colors.GoldBright
	b.Font = Enum.Font.GothamBold
	b.TextSize = 12
	b.LayoutOrder = order
	b.Parent = parent
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 8)
	c.Parent = b
	local s = Instance.new("UIStroke")
	s.Color = GameConfig.Colors.Gold
	s.Thickness = 1
	s.Parent = b
	return b
end

function HotbarController.Init(hooks)
	HotbarController._onOpenStore = hooks.OpenStore
	HotbarController._onOpenSettings = hooks.OpenSettings
	HotbarController._onOpenSquad = hooks.OpenSquad

	local gui = Instance.new("ScreenGui")
	gui.Name = "VoidlineHotbar"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.Parent = playerGui

	local bar = Instance.new("Frame")
	bar.Name = "Bar"
	bar.AnchorPoint = Vector2.new(0.5, 1)
	bar.Position = UDim2.new(0.5, 0, 1, -24)
	bar.Size = UDim2.fromOffset(520, 64)
	bar.BackgroundTransparency = 1
	bar.Parent = gui

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Padding = UDim.new(0, 8)
	layout.Parent = bar

	local f1 = mkButton(bar, "F1", "1\nSCATTER", 1)
	local f2 = mkButton(bar, "F2", "2\nBEAM", 2)
	local f3 = mkButton(bar, "F3", "3\nHALO", 3)
	local squad = mkButton(bar, "Squad", "SQUAD", 4)
	local shop = mkButton(bar, "Shop", "SHOP", 5)
	local settings = mkButton(bar, "Settings", "SET", 6)
	local upgrade = mkButton(bar, "Upgrade", "U\nUPGRADE", 7)
	local sprint = mkButton(bar, "Sprint", "SPRINT", 8)
	local clip = mkButton(bar, "Clip", "CLIP", 9)

	local function setFormation(n)
		Remotes.Get("SetFormation"):FireServer(n)
	end
	f1.MouseButton1Click:Connect(function()
		setFormation(1)
	end)
	f2.MouseButton1Click:Connect(function()
		setFormation(2)
	end)
	f3.MouseButton1Click:Connect(function()
		setFormation(3)
	end)
	squad.MouseButton1Click:Connect(function()
		if HotbarController._onOpenSquad then
			HotbarController._onOpenSquad()
		end
	end)
	shop.MouseButton1Click:Connect(function()
		if HotbarController._onOpenStore then
			HotbarController._onOpenStore()
		end
	end)
	settings.MouseButton1Click:Connect(function()
		if HotbarController._onOpenSettings then
			HotbarController._onOpenSettings()
		end
	end)
	upgrade.MouseButton1Click:Connect(function()
		Remotes.Get("QuickUpgrade"):FireServer()
	end)

	local sprinting = false
	local function toggleSprint()
		sprinting = not sprinting
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.WalkSpeed = if sprinting then 28 else 16
		end
		Remotes.Get("PlayerInput"):FireServer()
	end
	sprint.MouseButton1Click:Connect(toggleSprint)

	local clipOn = false
	clip.MouseButton1Click:Connect(function()
		clipOn = not clipOn
		hooks.SetClipMode(clipOn)
		gui.Enabled = not clipOn
	end)

	UserInputService.InputBegan:Connect(function(input, gp)
		if gp then
			return
		end
		Remotes.Get("PlayerInput"):FireServer()
		if input.KeyCode == Enum.KeyCode.One then
			setFormation(1)
		elseif input.KeyCode == Enum.KeyCode.Two then
			setFormation(2)
		elseif input.KeyCode == Enum.KeyCode.Three then
			setFormation(3)
		elseif input.KeyCode == Enum.KeyCode.U then
			Remotes.Get("QuickUpgrade"):FireServer()
		elseif input.KeyCode == Enum.KeyCode.LeftShift then
			toggleSprint()
		end
	end)

	UserInputService.InputChanged:Connect(function()
		Remotes.Get("PlayerInput"):FireServer()
	end)

	-- Touch-friendly: show sprint/upgrade always on mobile
	if UserInputService.TouchEnabled then
		sprint.Visible = true
		upgrade.Visible = true
	end

	HotbarController._gui = gui
end

function HotbarController.SetVisible(on: boolean)
	if HotbarController._gui then
		HotbarController._gui.Enabled = on
	end
end

return HotbarController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">OnboardingController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local Remotes = require(Voidline.Remotes)
local JuiceConfig = require(Voidline.Config.JuiceConfig)
local GameConfig = require(Voidline.Config.GameConfig)

local player = Players.LocalPlayer

local OnboardingController = {
	_step = 1,
	_beam = nil :: Beam?,
	_a0 = nil :: Attachment?,
	_a1 = nil :: Attachment?,
	_skipBtn = nil,
}

local function getPlot(): Folder?
	local map = Workspace:FindFirstChild("VoidlineMap")
	local plots = map and map:FindFirstChild("Plots")
	if not plots then
		return nil
	end
	for _, plot in plots:GetChildren() do
		if plot:GetAttribute("OwnerUserId") == player.UserId then
			return plot
		end
	end
	return nil
end

local function ensureBeam()
	if OnboardingController._beam then
		return
	end
	local char = player.Character or player.CharacterAdded:Wait()
	local hrp = char:WaitForChild("HumanoidRootPart")
	local a0 = Instance.new("Attachment")
	a0.Name = "VoidlineBeamA0"
	a0.Parent = hrp
	local a1 = Instance.new("Attachment")
	a1.Name = "VoidlineBeamA1"
	a1.Parent = hrp
	local beam = Instance.new("Beam")
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Color = ColorSequence.new(JuiceConfig.TutorialBeamColor)
	beam.Width0 = 1.2
	beam.Width1 = 1.2
	beam.FaceCamera = true
	beam.Parent = hrp
	OnboardingController._beam = beam
	OnboardingController._a0 = a0
	OnboardingController._a1 = a1
end

function OnboardingController.SetStep(step: number)
	OnboardingController._step = step
	if step >= 4 then
		if OnboardingController._beam then
			OnboardingController._beam.Enabled = false
		end
		if OnboardingController._skipBtn then
			OnboardingController._skipBtn.Visible = false
		end
	end
end

function OnboardingController.Init()
	local gui = player:WaitForChild("PlayerGui")
	local skip = Instance.new("TextButton")
	skip.Name = "TutorialSkip"
	skip.Size = UDim2.fromOffset(72, 24)
	skip.Position = UDim2.new(0.5, 210, 0, 80)
	skip.BackgroundTransparency = 0.3
	skip.BackgroundColor3 = GameConfig.Colors.Obsidian
	skip.TextColor3 = GameConfig.Colors.Gold
	skip.Font = Enum.Font.Gotham
	skip.TextSize = 12
	skip.Text = "Skip"
	skip.Parent = gui:FindFirstChild("VoidlineHUD") or gui
	skip.MouseButton1Click:Connect(function()
		Remotes.Get("QuickUpgrade"):FireServer()
		-- Soft skip: still need drone; fire sell if cargo full path incomplete
		OnboardingController.SetStep(4)
	end)
	OnboardingController._skipBtn = skip

	Remotes.Get("TutorialProgress").OnClientEvent:Connect(function(step)
		OnboardingController.SetStep(step)
	end)

	RunService.RenderStepped:Connect(function()
		if OnboardingController._step >= 4 then
			return
		end
		ensureBeam()
		local plot = getPlot()
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not plot or not hrp or not OnboardingController._a1 then
			return
		end
		local target: BasePart? = nil
		if OnboardingController._step <= 1 then
			local belt = plot:FindFirstChild("PersonalBelt")
			target = belt and belt:FindFirstChildWhichIsA("BasePart")
		elseif OnboardingController._step == 2 then
			local station = plot:FindFirstChild("Station")
			target = station and station:FindFirstChild("Refinery")
		else
			local station = plot:FindFirstChild("Station")
			local pads = station and station:FindFirstChild("UpgradePads")
			target = pads and (pads:FindFirstChild("DroneSlot") or pads:FindFirstChild("Drill"))
		end
		if target and target:IsA("BasePart") then
			OnboardingController._a1.WorldPosition = target.Position + Vector3.new(0, 2, 0)
			if OnboardingController._beam then
				OnboardingController._beam.Enabled = true
			end
		end
	end)
end

return OnboardingController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="69">
            <Properties>
              <string name="Name">SettingsController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local Remotes = require(Voidline.Remotes)
local GameConfig = require(Voidline.Config.GameConfig)
local DroneConfig = require(Voidline.Config.DroneConfig)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local SettingsController = { _gui = nil, _perf = false, _hideJet = false }

function SettingsController.Toggle()
	if SettingsController._gui then
		SettingsController._gui.Enabled = not SettingsController._gui.Enabled
	end
end

function SettingsController.Init()
	local gui = Instance.new("ScreenGui")
	gui.Name = "VoidlineSettings"
	gui.ResetOnSpawn = false
	gui.Enabled = false
	gui.Parent = playerGui

	local panel = Instance.new("Frame")
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.fromOffset(360, 280)
	panel.BackgroundColor3 = GameConfig.Colors.Obsidian
	panel.Parent = gui
	Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 12)
	local stroke = Instance.new("UIStroke")
	stroke.Color = GameConfig.Colors.Gold
	stroke.Parent = panel

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, -16, 0, 32)
	title.Position = UDim2.fromOffset(12, 8)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBold
	title.TextSize = 20
	title.TextColor3 = GameConfig.Colors.Gold
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Text = "SETTINGS"
	title.Parent = panel

	local function toggleBtn(y, label, callback)
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(1, -24, 0, 40)
		b.Position = UDim2.fromOffset(12, y)
		b.BackgroundColor3 = Color3.fromRGB(24, 24, 32)
		b.TextColor3 = GameConfig.Colors.GoldBright
		b.Font = Enum.Font.GothamMedium
		b.TextSize = 14
		b.Text = label
		b.Parent = panel
		Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
		b.MouseButton1Click:Connect(function()
			callback(b)
		end)
		return b
	end

	toggleBtn(56, "Performance Mode: OFF", function(b)
		SettingsController._perf = not SettingsController._perf
		b.Text = "Performance Mode: " .. (SettingsController._perf and "ON" or "OFF")
		Lighting.Bloom.Enabled = not SettingsController._perf
		Remotes.Get("SettingsUpdate"):FireServer({ PerfMode = SettingsController._perf })
	end)

	toggleBtn(108, "Hide Jetpack: OFF", function(b)
		SettingsController._hideJet = not SettingsController._hideJet
		b.Text = "Hide Jetpack: " .. (SettingsController._hideJet and "ON" or "OFF")
		Remotes.Get("SettingsUpdate"):FireServer({ HideJetpack = SettingsController._hideJet })
		player:SetAttribute("HideJetpack", SettingsController._hideJet)
	end)

	local close = Instance.new("TextButton")
	close.Size = UDim2.new(1, -24, 0, 40)
	close.Position = UDim2.fromOffset(12, 220)
	close.BackgroundColor3 = GameConfig.Colors.Gold
	close.TextColor3 = GameConfig.Colors.Obsidian
	close.Font = Enum.Font.GothamBold
	close.Text = "CLOSE"
	close.Parent = panel
	Instance.new("UICorner", close).CornerRadius = UDim.new(0, 8)
	close.MouseButton1Click:Connect(function()
		gui.Enabled = false
	end)

	-- Ensure bloom exists for perf toggle
	if not Lighting:FindFirstChildOfClass("BloomEffect") then
		local bloom = Instance.new("BloomEffect")
		bloom.Intensity = 0.6
		bloom.Size = 24
		bloom.Threshold = 1.2
		bloom.Parent = Lighting
	end

	SettingsController._gui = gui
end

return SettingsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="70">
            <Properties>
              <string name="Name">StationInteractController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local Remotes = require(Voidline.Remotes)
local DroneConfig = require(Voidline.Config.DroneConfig)

local player = Players.LocalPlayer

local StationInteractController = {}

local function addPrompt(part: BasePart, action: string, objectText: string)
	if part:FindFirstChildOfClass("ProximityPrompt") then
		return
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.ObjectText = objectText
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.Parent = part
end

function StationInteractController.Init()
	task.spawn(function()
		local map = Workspace:WaitForChild("VoidlineMap", 30)
		if not map then
			return
		end
		for _, plot in map.Plots:GetChildren() do
			local station = plot:FindFirstChild("Station")
			if station then
				local refinery = station:FindFirstChild("Refinery")
				if refinery then
					addPrompt(refinery, "Sell Ore", "Station Refinery")
				end
				local pads = station:FindFirstChild("UpgradePads")
				if pads then
					for _, pad in pads:GetChildren() do
						if pad:IsA("BasePart") then
							addPrompt(pad, "Upgrade", pad.Name)
						end
					end
				end
				local tuner = station:FindFirstChild("LaserTuner")
				if tuner and tuner:IsA("BasePart") then
					addPrompt(tuner, "Cycle Laser Color", "Laser Tuner")
				end
			end
		end
		local monolith = map.Hub:FindFirstChild("VoidlineMonolith")
		if monolith then
			if monolith:FindFirstChild("RebirthPad") then
				addPrompt(monolith.RebirthPad, "Void Rebirth", "Monolith")
			end
			if monolith:FindFirstChild("ForgeAnchor") then
				addPrompt(monolith.ForgeAnchor, "Forge Artifact", "Artifact Forge")
				local turnIn = Instance.new("ProximityPrompt")
				turnIn.Name = "TurnIn"
				turnIn.ActionText = "Turn In Artifact"
				turnIn.ObjectText = "Token Redemption"
				turnIn.HoldDuration = 0
				turnIn.MaxActivationDistance = 14
				turnIn.RequiresLineOfSight = false
				turnIn.Parent = monolith.ForgeAnchor
			end
			if monolith:FindFirstChild("CodeTerminal") then
				addPrompt(monolith.CodeTerminal, "Enter Code", "Voidline Codes")
			end
			if monolith:FindFirstChild("SummonPads") then
				addPrompt(monolith.SummonPads, "Summon Starfall", "Server Summons")
			end
		end
	end)

	ProximityPromptService.PromptTriggered:Connect(function(prompt, triggerPlayer)
		if triggerPlayer ~= player then
			return
		end
		local part = prompt.Parent
		if not part or not part:IsA("BasePart") then
			return
		end
		local name = part.Name
		if name == "Refinery" then
			Remotes.Get("SellOre"):FireServer()
		elseif part:GetAttribute("UpgradeId") then
			Remotes.Get("RequestUpgrade"):FireServer(part:GetAttribute("UpgradeId"))
		elseif name == "RebirthPad" then
			Remotes.Get("RequestRebirth"):FireServer()
		elseif name == "ForgeAnchor" and prompt.Name == "TurnIn" then
			Remotes.Get("TurnInArtifact"):FireServer()
		elseif name == "ForgeAnchor" then
			Remotes.Get("RequestForge"):FireServer()
		elseif name == "CodeTerminal" then
			-- Simple Studio-friendly cycle of launch codes via attribute index
			local codes = { "VOIDLINE", "KILLSHOT", "LAUNCH" }
			local idx = (part:GetAttribute("CodeIdx") or 0) + 1
			if idx > #codes then
				idx = 1
			end
			part:SetAttribute("CodeIdx", idx)
			Remotes.Get("RedeemCode"):FireServer(codes[idx])
		elseif name == "SummonPads" then
			Remotes.Get("PromptRobuxPurchase"):FireServer("Product", "SummonVoidStarfall")
		elseif name == "LaserTuner" then
			local colors = {}
			for k in DroneConfig.LaserColors do
				table.insert(colors, k)
			end
			table.sort(colors)
			local idx = (part:GetAttribute("ColorIdx") or 0) + 1
			if idx > #colors then
				idx = 1
			end
			part:SetAttribute("ColorIdx", idx)
			Remotes.Get("SetLaserColor"):FireServer(colors[idx])
		elseif name == "VIPLoungePad" then
			Remotes.Get("RedeemDaily"):FireServer()
		end
	end)
end

return StationInteractController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">StoreController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local MonetizationConfig = require(Voidline.Config.MonetizationConfig)
local Remotes = require(Voidline.Remotes)
local GameConfig = require(Voidline.Config.GameConfig)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local StoreController = { _gui = nil }

function StoreController.Toggle()
	local gui = StoreController._gui
	if not gui then
		return
	end
	gui.Enabled = not gui.Enabled
end

function StoreController.Init()
	local gui = Instance.new("ScreenGui")
	gui.Name = "VoidlineStore"
	gui.ResetOnSpawn = false
	gui.Enabled = false
	gui.Parent = playerGui

	local panel = Instance.new("Frame")
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.fromOffset(560, 420)
	panel.BackgroundColor3 = GameConfig.Colors.Obsidian
	panel.Parent = gui
	Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 12)
	local stroke = Instance.new("UIStroke")
	stroke.Color = GameConfig.Colors.Gold
	stroke.Parent = panel

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, -20, 0, 36)
	title.Position = UDim2.fromOffset(10, 8)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBold
	title.TextSize = 22
	title.TextColor3 = GameConfig.Colors.Gold
	title.Text = "VOIDLINE STORE"
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = panel

	local close = Instance.new("TextButton")
	close.Size = UDim2.fromOffset(36, 36)
	close.Position = UDim2.new(1, -44, 0, 8)
	close.Text = "X"
	close.Font = Enum.Font.GothamBold
	close.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
	close.TextColor3 = GameConfig.Colors.GoldBright
	close.Parent = panel
	close.MouseButton1Click:Connect(function()
		gui.Enabled = false
	end)

	local scroll = Instance.new("ScrollingFrame")
	scroll.Position = UDim2.fromOffset(12, 52)
	scroll.Size = UDim2.new(1, -24, 1, -64)
	scroll.BackgroundTransparency = 1
	scroll.ScrollBarThickness = 4
	scroll.CanvasSize = UDim2.fromOffset(0, 0)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.Parent = panel
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 8)
	list.Parent = scroll

	for _, pass in MonetizationConfig.Passes do
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, -8, 0, 64)
		row.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
		row.Parent = scroll
		Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)
		local name = Instance.new("TextLabel")
		name.BackgroundTransparency = 1
		name.Position = UDim2.fromOffset(10, 8)
		name.Size = UDim2.new(0.5, 0, 0, 22)
		name.Font = Enum.Font.GothamBold
		name.TextSize = 14
		name.TextXAlignment = Enum.TextXAlignment.Left
		name.TextColor3 = GameConfig.Colors.GoldBright
		name.Text = pass.Name
		name.Parent = row

		local robux = Instance.new("TextButton")
		robux.Size = UDim2.fromOffset(120, 28)
		robux.Position = UDim2.new(1, -260, 0, 18)
		robux.Text = pass.Robux .. " R$"
		robux.Font = Enum.Font.GothamBold
		robux.TextSize = 12
		robux.BackgroundColor3 = GameConfig.Colors.Gold
		robux.TextColor3 = GameConfig.Colors.Obsidian
		robux.Parent = row
		Instance.new("UICorner", robux).CornerRadius = UDim.new(0, 6)
		robux.MouseButton1Click:Connect(function()
			Remotes.Get("PromptRobuxPurchase"):FireServer("Pass", pass.Id)
		end)

		local tokens = Instance.new("TextButton")
		tokens.Size = UDim2.fromOffset(120, 28)
		tokens.Position = UDim2.new(1, -130, 0, 18)
		tokens.Text = pass.Tokens .. " Tokens"
		tokens.Font = Enum.Font.GothamBold
		tokens.TextSize = 12
		tokens.BackgroundColor3 = GameConfig.Colors.VoidAccent
		tokens.TextColor3 = Color3.new(1, 1, 1)
		tokens.Parent = row
		Instance.new("UICorner", tokens).CornerRadius = UDim.new(0, 6)
		tokens.MouseButton1Click:Connect(function()
			Remotes.Get("PurchaseWithTokens"):FireServer(pass.Id)
		end)
	end

	for _, product in MonetizationConfig.DevProducts do
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, -8, 0, 56)
		row.BackgroundColor3 = Color3.fromRGB(28, 18, 40)
		row.Parent = scroll
		Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)
		local name = Instance.new("TextLabel")
		name.BackgroundTransparency = 1
		name.Position = UDim2.fromOffset(10, 14)
		name.Size = UDim2.new(0.55, 0, 0, 22)
		name.Font = Enum.Font.GothamBold
		name.TextSize = 14
		name.TextXAlignment = Enum.TextXAlignment.Left
		name.TextColor3 = GameConfig.Colors.Gold
		name.Text = product.Name .. " (Robux only)"
		name.Parent = row
		local buy = Instance.new("TextButton")
		buy.Size = UDim2.fromOffset(120, 28)
		buy.Position = UDim2.new(1, -130, 0, 14)
		buy.Text = product.Robux .. " R$"
		buy.Font = Enum.Font.GothamBold
		buy.BackgroundColor3 = GameConfig.Colors.Gold
		buy.TextColor3 = GameConfig.Colors.Obsidian
		buy.Parent = row
		Instance.new("UICorner", buy).CornerRadius = UDim.new(0, 6)
		buy.MouseButton1Click:Connect(function()
			Remotes.Get("PromptRobuxPurchase"):FireServer("Product", product.Id)
		end)
	end

	StoreController._gui = gui
end

return StoreController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="72">
            <Properties>
              <string name="Name">ThrusterCosmeticController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local ThrusterCosmeticController = {}

local function attachPack(character: Model)
	if character:FindFirstChild("VoidlineThrusterPack") then
		return
	end
	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	if not torso then
		return
	end
	local pack = Instance.new("Part")
	pack.Name = "VoidlineThrusterPack"
	pack.Size = Vector3.new(1.4, 1.8, 0.6)
	pack.Color = Color3.fromRGB(12, 12, 18)
	pack.Material = Enum.Material.Metal
	pack.CanCollide = false
	pack.Massless = true
	pack.Parent = character
	local weld = Instance.new("Weld")
	weld.Part0 = torso
	weld.Part1 = pack
	weld.C0 = CFrame.new(0, 0.2, 0.75)
	weld.Parent = pack
	local glow = Instance.new("Part")
	glow.Name = "GoldTrim"
	glow.Size = Vector3.new(1.5, 0.2, 0.65)
	glow.Color = Color3.fromRGB(232, 186, 74)
	glow.Material = Enum.Material.Neon
	glow.CanCollide = false
	glow.Massless = true
	glow.Parent = character
	local weld2 = Instance.new("Weld")
	weld2.Part0 = pack
	weld2.Part1 = glow
	weld2.Parent = glow
end

function ThrusterCosmeticController.Init()
	local function onChar(char)
		task.wait(0.2)
		attachPack(char)
	end
	if player.Character then
		onChar(player.Character)
	end
	player.CharacterAdded:Connect(onChar)

	RunService.RenderStepped:Connect(function()
		local char = player.Character
		if not char then
			return
		end
		local pack = char:FindFirstChild("VoidlineThrusterPack")
		local trim = char:FindFirstChild("GoldTrim")
		local hide = player:GetAttribute("HideJetpack") == true
		if pack and pack:IsA("BasePart") then
			pack.Transparency = if hide then 1 else 0
		end
		if trim and trim:IsA("BasePart") then
			trim.Transparency = if hide then 1 else 0
		end
	end)
end

return ThrusterCosmeticController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="73">
            <Properties>
              <string name="Name">VFXController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Voidline = ReplicatedStorage:WaitForChild("Voidline")
local Remotes = require(Voidline.Remotes)
local GameConfig = require(Voidline.Config.GameConfig)

local player = Players.LocalPlayer

local VFXController = {}

local function floatingText(pos: Vector3, text: string, color: Color3)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.Transparency = 1
	p.Size = Vector3.new(1, 1, 1)
	p.Position = pos
	p.Parent = workspace
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(120, 40)
	bb.AlwaysOnTop = true
	bb.Parent = p
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = color
	label.Text = text
	label.Parent = bb
	TweenService:Create(p, TweenInfo.new(0.8), { Position = pos + Vector3.new(0, 6, 0) }):Play()
	task.delay(0.85, function()
		p:Destroy()
	end)
end

function VFXController.Init(hud)
	Remotes.Get("JuiceEvent").OnClientEvent:Connect(function(payload)
		if typeof(payload) ~= "table" then
			return
		end
		if payload.Kind == "Shatter" or payload.Kind == "CoreChunk" then
			if payload.Position then
				floatingText(payload.Position, "+" .. tostring(payload.Ore) .. " ORE", GameConfig.Colors.GoldBright)
			end
			if payload.IsTop then
				floatingText(payload.Position or Vector3.zero, "#1 TOP MINER", GameConfig.Colors.Gold)
			end
		elseif payload.Kind == "Sold" then
			floatingText(
				player.Character and player.Character:GetPivot().Position or Vector3.zero,
				"+" .. tostring(payload.Amount) .. " C",
				GameConfig.Colors.Gold
			)
		elseif payload.Kind == "EventBanner" then
			hud.ShowBanner(payload.Text or "WORLD EVENT", 3)
		elseif payload.Kind == "TutorialComplete" then
			hud.ShowBanner("TUTORIAL COMPLETE — +100 CREDITS", 3)
		elseif payload.Kind == "RebirthShockwave" then
			hud.ShowBanner((payload.PlayerName or "?") .. " REBIRTH VOID " .. tostring(payload.Rebirths), 3)
		elseif payload.Kind == "AfkIdle" then
			hud.ShowBanner("DRONES IN IDLE ORBIT — MOVE TO RESUME", 3)
		elseif payload.Kind == "CodeSuccess" then
			hud.ShowBanner(payload.Message or "CODE REDEEMED", 3)
		elseif payload.Kind == "DailySuccess" then
			hud.ShowBanner("DAILY STREAK DAY " .. tostring(payload.Day), 3)
		elseif payload.Kind == "ForgeCooling" then
			hud.ShowBanner("FORGE COOLING (REDUCED SPEED)", 3)
		end
	end)

	Remotes.Get("WorldEventState").OnClientEvent:Connect(function(state)
		if state.Active then
			hud.ShowBanner(string.upper(state.Kind or "EVENT") .. " — " .. (state.Summoner or "VOIDLINE"), 3)
		end
	end)
end

return VFXController
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
